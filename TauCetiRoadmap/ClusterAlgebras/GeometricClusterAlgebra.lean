public import TauCetiRoadmap.ClusterAlgebras.GeometricSeed
public import TauCetiRoadmap.LaurentPhenomenon.MixedLaurent
public import TauCetiRoadmap.LaurentPhenomenon.Chart

/-!
# Geometric cluster algebras over the coefficient rings `R_S`

Let `s` be a geometric seed (`GeometricSeed`) in a field `F` of characteristic zero: an extended
matrix `B_ext` on `M = K ⊔ J` (mutable indices embedded by `row`, frozen indices
`J = FrozenIndex row`) and algebraically independent values `x : M → F`, mutated by §1.4's
exchange relation `x_k x'_k = ∏ x_i^{[b_ik]_+} + ∏ x_i^{[-b_ik]_+}`. The frozen values `z_j`
define the evaluation `frozenEval : R[Trop(J)] = R[ℤ ^ J] → F`, `z_j ↦ x_j`, for any base ring `R`
with `Algebra R F`.

For a set `S` of frozen indices, `coefficientRing R S` is the image in `F` of §0.3's
`R_S = R[z_j : j ∈ J][z_s⁻¹ : s ∈ S]` (`mixedLaurent`); it is isomorphic to `R_S`
(`coefficientEquiv`) for `R = ℤ` (`frozenEval_injective_int`) and for a field `𝕜` over which the
values are algebraically independent (`frozenEval_injective`). The geometric cluster algebra
`A_{R_S}` (`clusterAlgebra`, base `R = ℤ`) or `A_{𝕜_S}` (base `R = 𝕜`) is the subalgebra of `F`
over this coefficient ring generated by the mutable values of all reachable seeds (§1.3). As a
set it is the `R`-subalgebra generated by those values, the `z_j` and the `z_s⁻¹`
(`coe_clusterAlgebra`); `A_{𝕜_S}` is generated over `𝕜` by `A_{R_S}`
(`coe_adjoin_clusterAlgebra_int`), and neither changes when `s` is replaced by a reachable seed
(`coefficientRing_mutateWord`, `coe_clusterAlgebra_mutateWord`). For `S ⊆ T`, `A_{R_T}` is the
localization of `A_{R_S}` at the `z_t`, `t ∈ T \ S` (`isLocalization_clusterAlgebra`); no such
statement is made for upper cluster algebras.

The U-layer charts `chartRing (algebraMap R F).range x` invert every frozen value: they are the
charts `L_{R_J,s}` over `R_J` (`chartRing_eq_chartRing_coefficientRing_univ`).
-/

@[expose] public section

namespace TauCeti.Cluster

open TauCeti.Laurent

variable {M K F : Type*} [Fintype M] [DecidableEq M] [Field F] [Algebra ℚ F] {row : K ↪ M}
  {d : K → ℤ}

/-- The frozen indices `J = M ∖ row(K)` of an extended matrix. -/
abbrev FrozenIndex (row : K ↪ M) : Type _ := {j : M // j ∉ Set.range row}

/-- A set of indices `S ⊆ M`, read as a set of frozen indices. -/
def frozenSet (row : K ↪ M) (S : Set M) : Set (FrozenIndex row) :=
  Subtype.val ⁻¹' S

namespace GeometricSeed

/-! ### The coefficient rings -/

section Coefficients

variable (s : GeometricSeed (F := F) row d)

/-- The frozen values `z_j`, `j ∈ J`, as units of `F`. -/
noncomputable def frozenUnits (j : FrozenIndex row) : Fˣ :=
  s.units j

variable (R : Type*) [CommRing R] [Algebra R F]

/-- The evaluation `R[Trop(J)] = R[ℤ ^ J] → F` at the frozen values, `z_j ↦ x_j`. -/
noncomputable def frozenEval : AddMonoidAlgebra R (FrozenIndex row →₀ ℤ) →ₐ[R] F where
  __ := LaurentEvaluation.eval (algebraMap R F) s.frozenUnits
  commutes' r := by simp [AddMonoidAlgebra.coe_algebraMap]

omit [DecidableEq M] [Fintype M] in
theorem frozenEval_single_single (j : FrozenIndex row) (n : ℤ) :
    s.frozenEval R (AddMonoidAlgebra.single (Finsupp.single j n) 1) = s.coordinate j ^ n := by
  simp [frozenEval, frozenUnits]

/-- **The coefficient ring of `A_{R_S}`**: the image of `R_S = R[z_j][z_s⁻¹ : s ∈ S]` (§0.3) in
`F` under the frozen values. Only the frozen indices in `S` are inverted. -/
noncomputable def coefficientRing (S : Set M) : Subalgebra R F :=
  (mixedLaurent R (frozenSet row S)).map (s.frozenEval R)

omit [DecidableEq M] [Fintype M] in
/-- The coefficient ring is generated over `R` by the `z_j` and the `z_s⁻¹`, `s ∈ S`. -/
theorem coefficientRing_eq_adjoin [Finite M] (S : Set M) :
    s.coefficientRing R S = Algebra.adjoin R
      (s.coordinate '' (Set.range row)ᶜ ∪
        (fun j ↦ (s.coordinate j)⁻¹) '' (S \ Set.range row)) := by
  classical
  let : Fintype M := Fintype.ofFinite M
  rw [coefficientRing, mixedLaurent_eq_adjoin, AlgHom.map_adjoin, Set.image_union]
  have h₁ : s.frozenEval R ''
      Set.range (fun j ↦ (AddMonoidAlgebra.single (Finsupp.single j 1) 1 :
        AddMonoidAlgebra R (FrozenIndex row →₀ ℤ))) = s.coordinate '' (Set.range row)ᶜ := by
    ext x
    constructor
    · rintro ⟨_, ⟨j, rfl⟩, rfl⟩
      exact ⟨j, j.2, by rw [frozenEval_single_single, zpow_one]⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨_, ⟨⟨j, hj⟩, rfl⟩, by rw [frozenEval_single_single, zpow_one]⟩
  have h₂ : s.frozenEval R ''
      ((fun j ↦ (AddMonoidAlgebra.single (Finsupp.single j (-1)) 1 :
        AddMonoidAlgebra R (FrozenIndex row →₀ ℤ))) '' frozenSet row S) =
        (fun j ↦ (s.coordinate j)⁻¹) '' (S \ Set.range row) := by
    ext x
    constructor
    · rintro ⟨_, ⟨j, hj, rfl⟩, rfl⟩
      exact ⟨j, ⟨hj, j.2⟩, by rw [frozenEval_single_single, zpow_neg_one]⟩
    · rintro ⟨j, hj, rfl⟩
      exact ⟨_, ⟨⟨j, hj.2⟩, hj.1, rfl⟩, by rw [frozenEval_single_single, zpow_neg_one]⟩
  rw [h₁, h₂]

omit [DecidableEq M] [Fintype M] in
theorem coordinate_mem_coefficientRing [Finite M] (S : Set M) {j : M} (hj : j ∉ Set.range row) :
    s.coordinate j ∈ s.coefficientRing R S := by
  classical
  let : Fintype M := Fintype.ofFinite M
  rw [coefficientRing_eq_adjoin]
  exact Algebra.subset_adjoin (Or.inl ⟨j, hj, rfl⟩)

omit [DecidableEq M] [Fintype M] in
theorem inv_coordinate_mem_coefficientRing [Finite M] {S : Set M} {j : M} (hj : j ∈ S)
    (hj' : j ∉ Set.range row) : (s.coordinate j)⁻¹ ∈ s.coefficientRing R S := by
  classical
  let : Fintype M := Fintype.ofFinite M
  rw [coefficientRing_eq_adjoin]
  exact Algebra.subset_adjoin (Or.inr ⟨j, ⟨hj, hj'⟩, rfl⟩)

omit [DecidableEq M] [Fintype M] in
/-- Over `ℤ`, the frozen evaluation is injective: the `z_j` are algebraically independent. -/
theorem frozenEval_injective_int [Finite M] : Function.Injective (s.frozenEval ℤ) := by
  let : Fintype M := Fintype.ofFinite M
  classical
  have : Fintype (FrozenIndex row) := Fintype.ofFinite _
  have h := integerLaurent_eval_injective_of_algebraicIndependent s.frozenUnits
    (s.independent.comp _ Subtype.val_injective)
  rw [← algebraMap_int_eq] at h
  exact h

omit [DecidableEq M] [Fintype M] in
/-- Over a field `𝕜` over which the values are algebraically independent (a geometric seed over
`𝕜`), the frozen evaluation is injective. -/
theorem frozenEval_injective [Finite M] {𝕜 : Type*} [Field 𝕜] [Algebra 𝕜 F]
    (h : AlgebraicIndependent 𝕜 s.coordinate) : Function.Injective (s.frozenEval 𝕜) := by
  let : Fintype M := Fintype.ofFinite M
  classical
  have : Fintype (FrozenIndex row) := Fintype.ofFinite _
  exact laurentEvaluation_injective_of_algebraicIndependent (K := 𝕜)
    (fun j : FrozenIndex row ↦ s.coordinate j) (h.comp _ Subtype.val_injective)

/-- When the frozen evaluation is injective, the coefficient ring is `R_S`. -/
noncomputable def coefficientEquiv (S : Set M) (h : Function.Injective (s.frozenEval R)) :
    mixedLaurent R (frozenSet row S) ≃ₐ[R] s.coefficientRing R S :=
  Subalgebra.equivMapOfInjective _ _ h

omit [DecidableEq M] [Fintype M] in
@[simp] theorem coe_coefficientEquiv (S : Set M) (h : Function.Injective (s.frozenEval R))
    (f : mixedLaurent R (frozenSet row S)) :
    (s.coefficientEquiv R S h f : F) = s.frozenEval R f :=
  rfl

omit [DecidableEq M] [Fintype M] in
/-- **The charts `L_{R_J,s}`.** The chart ring of all coordinates (mutable and frozen) over the
image of `R`, which the U-layer three-chart theorems use, is the chart ring of the mutable
coordinates over the coefficient ring `R_J` (every frozen value inverted). -/
theorem chartRing_eq_chartRing_coefficientRing_univ [Finite M] :
    chartRing (algebraMap R F).range s.coordinate =
      chartRing (s.coefficientRing R Set.univ).toSubring (fun k ↦ s.coordinate (row k)) := by
  classical
  let : Fintype M := Fintype.ofFinite M
  apply le_antisymm
  · refine chartRing_le (fun _ ⟨r, hr⟩ ↦ coefficient_mem_chartRing _ _ ?_) (fun j ↦ ?_)
      (fun j ↦ ?_)
    · exact hr ▸ Subalgebra.algebraMap_mem _ r
    · by_cases hj : j ∈ Set.range row
      · obtain ⟨k, rfl⟩ := hj
        exact coordinate_mem_chartRing _ _ k
      · exact coefficient_mem_chartRing _ _ (s.coordinate_mem_coefficientRing R _ hj)
    · by_cases hj : j ∈ Set.range row
      · obtain ⟨k, rfl⟩ := hj
        exact inverse_mem_chartRing _ _ k
      · exact coefficient_mem_chartRing _ _
          (s.inv_coordinate_mem_coefficientRing R (Set.mem_univ j) hj)
  · refine chartRing_le ?_ (fun k ↦ coordinate_mem_chartRing _ _ (row k))
      (fun k ↦ inverse_mem_chartRing _ _ (row k))
    rw [coefficientRing_eq_adjoin, Algebra.adjoin_eq_ring_closure, Subring.closure_le]
    rintro _ (⟨r, rfl⟩ | ⟨j, -, rfl⟩ | ⟨j, -, rfl⟩)
    · exact coefficient_mem_chartRing _ _ ⟨r, rfl⟩
    · exact coordinate_mem_chartRing _ _ j
    · exact inverse_mem_chartRing _ _ j

end Coefficients

variable [Fintype K] [DecidableEq K] (hd : ∀ k, 0 < d k) (s : GeometricSeed (F := F) row d)
  (R : Type*) [CommRing R] [Algebra R F]

omit [Fintype K] in
/-- Mutation does not change the frozen values. -/
theorem mutateWord_coordinate_of_notMem (w : List K) {j : M} (hj : j ∉ Set.range row) :
    (mutateWord (fun k t ↦ t.mutate hd k) w s).coordinate j = s.coordinate j := by
  induction w generalizing s with
  | nil => rfl
  | cons k w ih =>
    rw [mutateWord_cons, ih]
    exact Function.update_of_ne (fun h ↦ hj ⟨k, h.symm⟩) _ _

omit [Fintype K] in
theorem frozenUnits_mutateWord [Finite K] (w : List K) :
    (mutateWord (fun k t ↦ t.mutate hd k) w s).frozenUnits = s.frozenUnits := by
  let : Fintype K := Fintype.ofFinite K
  exact funext fun j ↦ Units.ext (s.mutateWord_coordinate_of_notMem hd w j.2)

omit [Fintype K] in
theorem image_frozen_mutateWord [Finite K] (w : List K) :
    (mutateWord (fun k t ↦ t.mutate hd k) w s).coordinate '' (Set.range row)ᶜ =
      s.coordinate '' (Set.range row)ᶜ := by
  let : Fintype K := Fintype.ofFinite K
  exact Set.image_congr fun _ hj ↦ s.mutateWord_coordinate_of_notMem hd w hj

omit [Fintype K] in
theorem image_inv_frozen_mutateWord [Finite K] (w : List K) (S : Set M) :
    (fun j ↦ ((mutateWord (fun k t ↦ t.mutate hd k) w s).coordinate j)⁻¹) '' (S \ Set.range row) =
      (fun j ↦ (s.coordinate j)⁻¹) '' (S \ Set.range row) := by
  let : Fintype K := Fintype.ofFinite K
  exact Set.image_congr fun _ hj ↦ by rw [s.mutateWord_coordinate_of_notMem hd w hj.2]

omit [Fintype K] in
/-- Re-rooting does not change the coefficient ring. -/
theorem coefficientRing_mutateWord [Finite K] (w : List K) (S : Set M) :
    (mutateWord (fun k t ↦ t.mutate hd k) w s).coefficientRing R S = s.coefficientRing R S := by
  let : Fintype K := Fintype.ofFinite K
  rw [coefficientRing_eq_adjoin, coefficientRing_eq_adjoin, image_frozen_mutateWord,
    image_inv_frozen_mutateWord]

/-! ### The cluster algebras -/

/-- The mutable values of all seeds reachable from `s`. -/
def clusterVariables : Set F :=
  {x | ∃ w : List K, ∃ k : K, x = (mutateWord (fun k t ↦ t.mutate hd k) w s).coordinate (row k)}

/-- The generators of the geometric cluster algebras over the base ring: the mutable values of
all reachable seeds, the frozen values `z_j` and the inverses `z_j⁻¹`, `j ∈ S` frozen. -/
def clusterGenerators (S : Set M) : Set F :=
  s.clusterVariables hd ∪ s.coordinate '' (Set.range row)ᶜ ∪
    (fun j ↦ (s.coordinate j)⁻¹) '' (S \ Set.range row)

/-- **The geometric cluster algebra** `A_{R_S}` (base `R = ℤ`) or `A_{𝕜_S}` (base `R = 𝕜`): the
subalgebra of `F` over the coefficient ring `R_S` (`coefficientRing`) generated by the mutable
values of all reachable seeds. -/
noncomputable def clusterAlgebra (S : Set M) : Subalgebra (s.coefficientRing R S) F :=
  Algebra.adjoin (s.coefficientRing R S) (s.clusterVariables hd)

omit [Fintype K] in
theorem mem_clusterAlgebra_of_mem_coefficientRing {S : Set M} {x : F}
    (hx : x ∈ s.coefficientRing R S) : x ∈ s.clusterAlgebra hd R S :=
  Subalgebra.algebraMap_mem _ (⟨x, hx⟩ : s.coefficientRing R S)

omit [Fintype K] in
/-- Every value of every reachable seed lies in the geometric cluster algebra. -/
theorem coordinate_mutateWord_mem_clusterAlgebra [Finite K] (S : Set M) (w : List K) (j : M) :
    (mutateWord (fun k t ↦ t.mutate hd k) w s).coordinate j ∈ s.clusterAlgebra hd R S := by
  let : Fintype K := Fintype.ofFinite K
  by_cases hj : j ∈ Set.range row
  · obtain ⟨k, rfl⟩ := hj
    exact Algebra.subset_adjoin ⟨w, k, rfl⟩
  · rw [s.mutateWord_coordinate_of_notMem hd w hj]
    exact s.mem_clusterAlgebra_of_mem_coefficientRing hd R
      (s.coordinate_mem_coefficientRing R S hj)

omit [Fintype K] in
theorem coordinate_mem_clusterAlgebra [Finite K] (S : Set M) (j : M) :
    s.coordinate j ∈ s.clusterAlgebra hd R S := by
  let : Fintype K := Fintype.ofFinite K
  exact s.coordinate_mutateWord_mem_clusterAlgebra hd R S [] j

omit [Fintype K] in
theorem inv_coordinate_mem_clusterAlgebra [Finite K] {S : Set M} {j : M} (hj : j ∈ S)
    (hj' : j ∉ Set.range row) : (s.coordinate j)⁻¹ ∈ s.clusterAlgebra hd R S := by
  let : Fintype K := Fintype.ofFinite K
  exact s.mem_clusterAlgebra_of_mem_coefficientRing hd R (s.inv_coordinate_mem_coefficientRing R
    hj hj')

variable {s hd R} in
omit [Fintype K] in
theorem clusterAlgebra_le {S : Set M} {T : Subalgebra (s.coefficientRing R S) F}
    (h : ∀ w k, (mutateWord (fun k t ↦ t.mutate hd k) w s).coordinate (row k) ∈ T) :
    s.clusterAlgebra hd R S ≤ T :=
  Algebra.adjoin_le fun _ ⟨w, k, hx⟩ ↦ hx ▸ h w k

omit [Fintype K] in
/-- **`A_{R_S}` as a set** is the `R`-subalgebra generated by the reachable mutable values, the
`z_j` and the `z_s⁻¹`. -/
theorem coe_clusterAlgebra [Finite K] (S : Set M) :
    (s.clusterAlgebra hd R S : Set F) = Algebra.adjoin R (s.clusterGenerators hd S) := by
  let : Fintype K := Fintype.ofFinite K
  have hC : s.coefficientRing R S ≤ Algebra.adjoin R (s.clusterGenerators hd S) := by
    rw [coefficientRing_eq_adjoin, clusterGenerators, Set.union_assoc]
    exact Algebra.adjoin_mono Set.subset_union_right
  ext x
  constructor
  · intro hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx => exact Algebra.subset_adjoin (Or.inl (Or.inl hx))
    | algebraMap c => exact hC c.2
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy
  · intro hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with (hx | ⟨j, hj, rfl⟩) | ⟨j, ⟨hj, hj'⟩, rfl⟩
      · exact Algebra.subset_adjoin hx
      · exact s.coordinate_mem_clusterAlgebra hd R S j
      · exact s.inv_coordinate_mem_clusterAlgebra hd R hj hj'
    | algebraMap r =>
      exact s.mem_clusterAlgebra_of_mem_coefficientRing hd R (Subalgebra.algebraMap_mem _ r)
    | add x y _ _ hx hy => exact add_mem hx hy
    | mul x y _ _ hx hy => exact mul_mem hx hy

omit [Fintype K] in
/-- `A_{R_S}` is the subring generated by the reachable mutable values, the `z_j` and the
`z_s⁻¹`. -/
theorem toSubring_clusterAlgebra_int [Finite K] (S : Set M) :
    (s.clusterAlgebra hd ℤ S).toSubring = Subring.closure (s.clusterGenerators hd S) := by
  let : Fintype K := Fintype.ofFinite K
  ext x
  rw [Subalgebra.mem_toSubring, ← SetLike.mem_coe, coe_clusterAlgebra, SetLike.mem_coe,
    Algebra.adjoin_int]
  rfl

omit [Fintype K] in
/-- `A_{𝕜_S}` (or the cluster algebra over any base ring `R`) is generated over `R` by
`A_{R_S}`. -/
theorem coe_adjoin_clusterAlgebra_int [Finite K] (S : Set M) :
    (Algebra.adjoin R (s.clusterAlgebra hd ℤ S : Set F) : Set F) = s.clusterAlgebra hd R S := by
  let : Fintype K := Fintype.ofFinite K
  rw [coe_clusterAlgebra hd s ℤ, Algebra.adjoin_adjoin_of_tower, coe_clusterAlgebra]

omit [Fintype K] in
theorem coe_clusterAlgebra_mono [Finite K] {S S' : Set M} (h : S ⊆ S') :
    (s.clusterAlgebra hd R S : Set F) ⊆ s.clusterAlgebra hd R S' := by
  let : Fintype K := Fintype.ofFinite K
  rw [coe_clusterAlgebra, coe_clusterAlgebra]
  exact Algebra.adjoin_mono (Set.union_subset_union_right _
    (Set.image_mono (Set.sdiff_subset_sdiff_left h)))

/-! ### Re-rooting -/

omit [Fintype K] in
theorem clusterVariables_mutateWord [Finite K] (w : List K) :
    (mutateWord (fun k t ↦ t.mutate hd k) w s).clusterVariables hd = s.clusterVariables hd := by
  let : Fintype K := Fintype.ofFinite K
  ext x
  constructor
  · rintro ⟨v, k, rfl⟩
    exact ⟨w ++ v, k, by rw [mutateWord_append]⟩
  · rintro ⟨v, k, rfl⟩
    refine ⟨w.reverse ++ v, k, ?_⟩
    rw [mutateWord_append, mutateWord_reverse _ fun k t ↦ t.mutate_involutive hd k]

omit [Fintype K] in
theorem clusterGenerators_mutateWord [Finite K] (w : List K) (S : Set M) :
    (mutateWord (fun k t ↦ t.mutate hd k) w s).clusterGenerators hd S =
      s.clusterGenerators hd S := by
  let : Fintype K := Fintype.ofFinite K
  rw [clusterGenerators, clusterGenerators, clusterVariables_mutateWord, image_frozen_mutateWord,
    image_inv_frozen_mutateWord]

omit [Fintype K] in
/-- **Re-rooting.** `A_{R_S}` does not change when `s` is replaced by a reachable seed; its
coefficient ring does not change either (`coefficientRing_mutateWord`). -/
theorem coe_clusterAlgebra_mutateWord [Finite K] (w : List K) (S : Set M) :
    ((mutateWord (fun k t ↦ t.mutate hd k) w s).clusterAlgebra hd R S : Set F) =
      s.clusterAlgebra hd R S := by
  let : Fintype K := Fintype.ofFinite K
  rw [coe_clusterAlgebra, coe_clusterAlgebra, clusterGenerators_mutateWord]

omit [Fintype K] in
theorem toSubring_clusterAlgebra_mutateWord [Finite K] (w : List K) (S : Set M) :
    ((mutateWord (fun k t ↦ t.mutate hd k) w s).clusterAlgebra hd R S).toSubring =
      (s.clusterAlgebra hd R S).toSubring := by
  let : Fintype K := Fintype.ofFinite K
  exact SetLike.coe_injective (s.coe_clusterAlgebra_mutateWord hd R w S)

/-! ### Frozen localization -/

omit [Fintype K] in
theorem toSubring_clusterAlgebra_mono [Finite K] {S T : Set M} (h : S ⊆ T) :
    (s.clusterAlgebra hd R S).toSubring ≤ (s.clusterAlgebra hd R T).toSubring := by
  let : Fintype K := Fintype.ofFinite K
  exact fun _ hx ↦ s.coe_clusterAlgebra_mono hd R h hx

/-- The submonoid of `A_{R_S}` generated by the frozen values `z_t`, `t ∈ T`. -/
noncomputable def frozenSubmonoid (S T : Set M) : Submonoid (s.clusterAlgebra hd R S).toSubring :=
  Submonoid.closure ((fun t ↦ (⟨s.coordinate t, s.coordinate_mem_clusterAlgebra hd R S t⟩ :
    (s.clusterAlgebra hd R S).toSubring)) '' (T \ Set.range row))

/-- Every element of `A_{R_T}` lands in `A_{R_S}` after multiplication by a product of the
`z_t`, `t ∈ T \ S`. -/
theorem exists_mul_mem_clusterAlgebra {S T : Set M} {y : F}
    (hy : y ∈ s.clusterAlgebra hd R T) :
    ∃ m ∈ s.frozenSubmonoid hd R S (T \ S), y * (m : F) ∈ s.clusterAlgebra hd R S := by
  have hS : ∀ x ∈ s.clusterGenerators hd S, x ∈ s.clusterAlgebra hd R S := fun x hx ↦ by
    rw [← SetLike.mem_coe, coe_clusterAlgebra]
    exact Algebra.subset_adjoin hx
  rw [← SetLike.mem_coe, coe_clusterAlgebra] at hy
  induction hy using Algebra.adjoin_induction with
  | mem x hx =>
    rcases hx with (hx | hx) | ⟨j, ⟨hjT, hj'⟩, rfl⟩
    · exact ⟨1, one_mem _, by simpa using hS x (Or.inl (Or.inl hx))⟩
    · exact ⟨1, one_mem _, by simpa using hS x (Or.inl (Or.inr hx))⟩
    · by_cases hjS : j ∈ S
      · exact ⟨1, one_mem _, by simpa using hS _ (Or.inr ⟨j, ⟨hjS, hj'⟩, rfl⟩)⟩
      · refine ⟨_, Submonoid.subset_closure ⟨j, ⟨⟨hjT, hjS⟩, hj'⟩, rfl⟩, ?_⟩
        change (s.coordinate j)⁻¹ * s.coordinate j ∈ _
        rw [inv_mul_cancel₀ (nonzero_coordinate_of_algebraicIndependent _ s.independent j)]
        exact one_mem _
  | algebraMap r =>
    refine ⟨1, one_mem _, ?_⟩
    rw [OneMemClass.coe_one, mul_one]
    exact s.mem_clusterAlgebra_of_mem_coefficientRing hd R (Subalgebra.algebraMap_mem _ r)
  | add x y _ _ hx hy =>
    obtain ⟨m₁, hm₁, h₁⟩ := hx
    obtain ⟨m₂, hm₂, h₂⟩ := hy
    refine ⟨m₁ * m₂, mul_mem hm₁ hm₂, ?_⟩
    have : (x + y) * ((m₁ * m₂ : s.clusterAlgebra hd R S) : F) =
        x * m₁ * m₂ + y * m₂ * m₁ := by
      push_cast
      ring
    rw [this]
    exact add_mem (mul_mem h₁ m₂.2) (mul_mem h₂ m₁.2)
  | mul x y _ _ hx hy =>
    obtain ⟨m₁, hm₁, h₁⟩ := hx
    obtain ⟨m₂, hm₂, h₂⟩ := hy
    refine ⟨m₁ * m₂, mul_mem hm₁ hm₂, ?_⟩
    have : x * y * ((m₁ * m₂ : s.clusterAlgebra hd R S) : F) = x * m₁ * (y * m₂) := by
      push_cast
      ring
    rw [this]
    exact mul_mem h₁ h₂

/-- **Frozen localization (§1.4).** For `S ⊆ T`, `A_{R_T}` is the localization of `A_{R_S}` at
the frozen values `z_t`, `t ∈ T \ S`. The same holds over any base ring, e.g. for `A_{𝕜_S}`. -/
theorem isLocalization_clusterAlgebra {S T : Set M} (h : S ⊆ T) :
    letI := (Subring.inclusion (s.toSubring_clusterAlgebra_mono hd R h)).toAlgebra
    IsLocalization (s.frozenSubmonoid hd R S (T \ S)) (s.clusterAlgebra hd R T).toSubring := by
  let := (Subring.inclusion (s.toSubring_clusterAlgebra_mono hd R h)).toAlgebra
  refine (isLocalization_iff _ _).2 ⟨?_, fun z ↦ ?_, fun {x y} hxy ↦ ⟨1, ?_⟩⟩
  · rintro ⟨y, hy⟩
    induction hy using Submonoid.closure_induction with
    | mem y hy =>
      obtain ⟨j, ⟨⟨hjT, -⟩, hj'⟩, rfl⟩ := hy
      refine isUnit_iff_exists_inv.2
        ⟨⟨_, s.inv_coordinate_mem_clusterAlgebra hd R hjT hj'⟩, Subtype.ext ?_⟩
      rw [Subring.coe_mul, RingHom.algebraMap_toAlgebra, Subring.coe_inclusion, Subring.coe_one]
      exact mul_inv_cancel₀ (nonzero_coordinate_of_algebraicIndependent _ s.independent j)
    | one => simp
    | mul x y _ _ hx hy => simpa using hx.mul hy
  · obtain ⟨m, hm, hmem⟩ := s.exists_mul_mem_clusterAlgebra hd R (S := S) z.2
    refine ⟨(⟨_, hmem⟩, ⟨m, hm⟩), Subtype.ext ?_⟩
    rw [Subring.coe_mul, RingHom.algebraMap_toAlgebra, Subring.coe_inclusion,
      Subring.coe_inclusion]
  · rw [OneMemClass.coe_one, one_mul, one_mul]
    exact Subring.inclusion_injective _ hxy

end GeometricSeed

