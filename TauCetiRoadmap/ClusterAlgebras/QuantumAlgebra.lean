module

public import TauCetiRoadmap.ClusterAlgebras.QuantumLaurent
public import TauCetiRoadmap.LaurentPhenomenon.Quantum.Coefficients

/-!
# Quantum cluster algebras and quantum upper cluster algebras

For a quantum seed `s` in a division ring `D` over `Zv`, the frozen indices are those outside the
range of `row`. For a set `S` of frozen indices, the quantum cluster algebra `A_{v,S}` is the
`Zv`-subalgebra of `D` generated by all reachable mutable coordinates, all frozen coordinates and
the inverses of the frozen coordinates in `S`. The quantum upper cluster algebra `U_v` is the
intersection of the integral quantum tori `T_t` of all reachable seeds `t`, as `Zv`-subalgebras.
Both are invariant under replacing `s` by a reachable seed. Quantum cluster monomials are the
normalized monomials of reachable seeds with nonnegative mutable exponents and nonnegative frozen
exponents outside `S`; they lie in `A_{v,S}` and are carried along reindexing and ambient maps.
From the quantum Laurent phenomenon (Q3), `A_{v,S} ≤ U_v = UB_v(s)` for every `S`.

Seeds are transported along relabellings `σ : M ≃ M'`, `τ : K ≃ K'` compatible with `row`, which
relabel the symmetrizer (`ExchangeFrame.reindex`, through the lattice reindexing
`QuantumTorus.domCongr`), and along `Zv`-algebra maps of division rings
    (`ExchangeFrame.map`). Both commute with mutation, and
`A_{v,S}` and `U_v` are carried to the corresponding algebras of the transported seed.
-/

@[expose] public section

namespace TauCeti.Cluster.ExchangeFrame

open TauCeti TauCeti.Laurent TauCeti.QuantumTorus

noncomputable section

variable {D : Type*} [DivisionRing D] [Algebra Zv D]
  {M K : Type*} [Fintype M] [DecidableEq M] [Fintype K] [DecidableEq K]
  {row : K ↪ M}

/-! ### The integral quantum torus as a subalgebra -/

section Chart

variable (s : ExchangeFrame (u₀ := vUnit) D row)

/-- The integral quantum torus `T_s = Zv[X_i^{±1}]` as a `Zv`-subalgebra: the range of the
chart. -/
def chartAlgebra : Subalgebra Zv D := s.chart.range
omit [Fintype K] [DecidableEq K] in
@[simp] theorem toSubring_chartAlgebra : s.chartAlgebra.toSubring = s.chartRing :=
  s.range_chart

omit [Fintype K] [DecidableEq K] in
theorem mem_chartAlgebra {x : D} : x ∈ s.chartAlgebra ↔ x ∈ s.chartRing := by
  rw [← s.toSubring_chartAlgebra]
  rfl

omit [Fintype K] [DecidableEq K] in
theorem monomial_mem_chartAlgebra (a : M → ℤ) : s.monomial a ∈ s.chartAlgebra :=
  ⟨_, rfl⟩

end Chart

/-! ### Reachable seeds -/

section Reachable

/-- Mutation does not change the frozen coordinates. -/
theorem mutateWord_coordinate_of_notMem (s : ExchangeFrame (u₀ := vUnit) D row) (w : List K) {j : M}
    (hj : j ∉ Set.range row) :
    (mutateWord (fun k t ↦ ExchangeFrame.mutate t k) w s).coordinate j = s.coordinate j := by
  induction w generalizing s with
  | nil => rfl
  | cons k w ih =>
    rw [mutateWord_cons, ih, mutate_coordinate_of_ne _ _ fun h ↦ hj ⟨k, h.symm⟩]

theorem Reachable.coordinate_of_notMem {s t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t)
    {j : M} (hj : j ∉ Set.range row) : t.coordinate j = s.coordinate j := by
  obtain ⟨w, rfl⟩ := h
  exact mutateWord_coordinate_of_notMem s w hj

/-- **Quantum Laurentness between reachable seeds.** Every coordinate of a seed reachable from
`s` lies in the integral quantum torus `T_s`. -/
theorem Reachable.coordinate_mem_chartRing {s t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable
  s t)
    (j : M) : (t.coordinate j : D) ∈ s.chartRing := by
  obtain ⟨w, rfl⟩ := h
  exact s.coordinate_mutateWord_mem_chartRing w j

theorem Reachable.coordinate_mem_chartAlgebra {s t : ExchangeFrame (u₀ := vUnit) D row} (h :
  Reachable s t)
    (j : M) : (t.coordinate j : D) ∈ s.chartAlgebra :=
  s.mem_chartAlgebra.2 (h.coordinate_mem_chartRing j)

end Reachable

/-! ### The quantum cluster algebra `A_{v,S}` -/

section ClusterAlgebra

variable (s : ExchangeFrame (u₀ := vUnit) D row)

/-- The reachable mutable quantum cluster variables `X_{k;t}`. -/
def clusterVariables : Set D :=
  {x | ∃ t, Reachable s t ∧ ∃ k : K, x = (t.coordinate (row k) : D)}

/-- The generators of `A_{v,S}`: the reachable mutable variables, the frozen variables and the
inverses of the variables indexed by `S`. -/
def clusterGenerators (S : Set M) : Set D :=
  s.clusterVariables ∪ (fun j ↦ (s.coordinate j : D)) '' (Set.range row)ᶜ ∪
    (fun j ↦ (s.coordinate j : D)⁻¹) '' S

/-- **The quantum cluster algebra** `A_{v,S}`: the `Zv`-subalgebra of `D` generated by all
reachable mutable variables, all frozen variables and the inverses of the frozen variables in
`S` (a set of frozen indices). The frozen variables need not be central. -/
def clusterAlgebra (S : Set M) : Subalgebra Zv D :=
  Algebra.adjoin Zv (s.clusterGenerators S)

variable {s}

theorem coordinate_mem_clusterVariables {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t)
  (k : K) :
    (t.coordinate (row k) : D) ∈ s.clusterVariables :=
  ⟨t, h, k, rfl⟩

theorem Reachable.clusterVariables_eq {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t) :
    t.clusterVariables = s.clusterVariables := by
  ext x
  constructor
  · rintro ⟨u, hu, k, rfl⟩
    exact ⟨u, h.trans hu, k, rfl⟩
  · rintro ⟨u, hu, k, rfl⟩
    exact ⟨u, h.symm.trans hu, k, rfl⟩

theorem Reachable.clusterGenerators_eq {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t)
    {S : Set M} (hS : S ⊆ (Set.range row)ᶜ) :
    t.clusterGenerators S = s.clusterGenerators S := by
  have hfr : ∀ j ∈ (Set.range row)ᶜ, (t.coordinate j : D) = s.coordinate j := fun j hj ↦ by
    rw [h.coordinate_of_notMem hj]
  unfold clusterGenerators
  rw [h.clusterVariables_eq]
  congr 1
  · congr 1
    exact Set.image_congr hfr
  · exact Set.image_congr fun j hj ↦ congrArg (·⁻¹) (hfr j (hS hj))

/-- **Re-rooting.** `A_{v,S}` does not change when `s` is replaced by a reachable seed. -/
theorem Reachable.clusterAlgebra_eq {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t)
    {S : Set M} (hS : S ⊆ (Set.range row)ᶜ) : t.clusterAlgebra S = s.clusterAlgebra S := by
  rw [clusterAlgebra, clusterAlgebra, h.clusterGenerators_eq hS]

variable (s)

theorem clusterVariables_subset_clusterAlgebra (S : Set M) :
    s.clusterVariables ⊆ s.clusterAlgebra S :=
  fun _ hx ↦ Algebra.subset_adjoin (Or.inl (Or.inl hx))

theorem coordinate_mem_clusterAlgebra_of_notMem (S : Set M) {j : M} (hj : j ∉ Set.range row) :
    (s.coordinate j : D) ∈ s.clusterAlgebra S :=
  Algebra.subset_adjoin (Or.inl (Or.inr ⟨j, hj, rfl⟩))

theorem inv_coordinate_mem_clusterAlgebra {S : Set M} {j : M} (hj : j ∈ S) :
    (s.coordinate j : D)⁻¹ ∈ s.clusterAlgebra S :=
  Algebra.subset_adjoin (Or.inr ⟨j, hj, rfl⟩)

variable {s}

/-- Every coordinate of a reachable seed lies in `A_{v,S}`. -/
theorem Reachable.coordinate_mem_clusterAlgebra {t : ExchangeFrame (u₀ := vUnit) D row} (h :
  Reachable s t)
    (S : Set M) (j : M) : (t.coordinate j : D) ∈ s.clusterAlgebra S := by
  by_cases hj : j ∈ Set.range row
  · obtain ⟨k, rfl⟩ := hj
    exact s.clusterVariables_subset_clusterAlgebra S (coordinate_mem_clusterVariables h k)
  · rw [h.coordinate_of_notMem hj]
    exact s.coordinate_mem_clusterAlgebra_of_notMem S hj

theorem clusterAlgebra_mono {S S' : Set M} (h : S ⊆ S') :
    s.clusterAlgebra S ≤ s.clusterAlgebra S' := by
  refine Algebra.adjoin_mono ?_
  unfold clusterGenerators
  exact Set.union_subset_union_right _ (Set.image_mono h)

variable (s)

/-- `A_{v,∅}` is the ring generated by `Zv` and all reachable coordinates. -/
theorem toSubring_clusterAlgebra_empty :
    (s.clusterAlgebra ∅).toSubring =
      TauCeti.Cluster.clusterRing (algebraMap Zv D).range
        (fun t : ExchangeFrame (u₀ := vUnit) D row ↦ fun i ↦ (t.coordinate i : D))
        (fun k t ↦ t.mutate k) s := by
  rw [clusterAlgebra, Algebra.adjoin_eq_ring_closure, TauCeti.Cluster.clusterRing]
  apply le_antisymm
  · refine Subring.closure_le.2 ?_
    rintro x (hx | ((⟨t, ⟨w, rfl⟩, k, rfl⟩ | ⟨j, -, rfl⟩) | ⟨j, hj, -⟩))
    · exact Subring.subset_closure (Or.inl hx)
    · exact Subring.subset_closure (Or.inr ⟨w, row k, rfl⟩)
    · exact Subring.subset_closure (Or.inr ⟨[], j, rfl⟩)
    · exact hj.elim
  · refine Subring.closure_le.2 ?_
    rintro x (hx | ⟨w, j, rfl⟩)
    · exact Subring.subset_closure (Or.inl hx)
    · have := (reachable_mutateWord s w).coordinate_mem_clusterAlgebra ∅ j
      rw [← Subalgebra.mem_toSubring, clusterAlgebra, Algebra.adjoin_eq_ring_closure] at this
      exact this

end ClusterAlgebra

/-! ### Quantum cluster monomials -/

section ClusterMonomial

variable (s : ExchangeFrame (u₀ := vUnit) D row)

/-- **Quantum cluster monomials** of `A_{v,S}`: the normalized monomials `M_t(a)` of reachable
seeds `t` with nonnegative mutable exponents and nonnegative frozen exponents outside `S`. -/
def IsClusterMonomial (S : Set M) (x : D) : Prop :=
  ∃ t, Reachable s t ∧ ∃ a : M → ℤ, (∀ k, 0 ≤ a (row k)) ∧ (∀ j ∉ S, 0 ≤ a j) ∧
    x = t.monomial a

variable {s}

theorem Reachable.isClusterMonomial_iff {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t)
    {S : Set M} {x : D} : t.IsClusterMonomial S x ↔ s.IsClusterMonomial S x := by
  constructor
  · rintro ⟨u, hu, rest⟩
    exact ⟨u, h.trans hu, rest⟩
  · rintro ⟨u, hu, rest⟩
    exact ⟨u, h.symm.trans hu, rest⟩

theorem isClusterMonomial_coordinate {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t)
    (S : Set M) (k : K) : s.IsClusterMonomial S (t.coordinate (row k)) := by
  refine ⟨t, h, Pi.single (row k) 1, fun l ↦ ?_, fun j _ ↦ ?_, (t.monomial_single _).symm⟩
  · by_cases hl : row l = row k
    · rw [hl, Pi.single_eq_same]
      exact zero_le_one
    · rw [Pi.single_eq_of_ne hl]
  · by_cases hj : j = row k
    · rw [hj, Pi.single_eq_same]
      exact zero_le_one
    · rw [Pi.single_eq_of_ne hj]

/-- Quantum cluster monomials lie in `A_{v,S}`. -/
theorem IsClusterMonomial.mem_clusterAlgebra {S : Set M} {x : D}
    (h : s.IsClusterMonomial S x) : x ∈ s.clusterAlgebra S := by
  obtain ⟨t, ht, a, hmut, hfr, rfl⟩ := h
  have hpow : ∀ i, ((t.coordinate i ^ a i : Dˣ) : D) ∈ s.clusterAlgebra S := by
    intro i
    rw [Units.val_zpow_eq_zpow_val]
    rcases le_or_gt 0 (a i) with hi | hi
    · obtain ⟨n, hn⟩ := Int.eq_ofNat_of_zero_le hi
      rw [hn, zpow_natCast]
      exact Subalgebra.pow_mem _ (ht.coordinate_mem_clusterAlgebra S i) n
    · have hiS : i ∈ S := by
        by_contra hiS
        exact absurd (hfr i hiS) (not_le.2 hi)
      have hir : i ∉ Set.range row := by
        rintro ⟨k, rfl⟩
        exact absurd (hmut k) (not_le.2 hi)
      obtain ⟨n, hn⟩ := Int.exists_eq_neg_ofNat hi.le
      rw [hn, zpow_neg, zpow_natCast, ← inv_pow, ht.coordinate_of_notMem hir]
      exact Subalgebra.pow_mem _ (s.inv_coordinate_mem_clusterAlgebra hiS) n
  have hprod : ∀ l : List M,
      ((orderedProd t.coordinate l a : Dˣ) : D) ∈ s.clusterAlgebra S := by
    intro l
    induction l with
    | nil => simp
    | cons i l ih =>
      rw [orderedProd_cons, Units.val_mul]
      exact Subalgebra.mul_mem _ (hpow i) ih
  rw [monomial, chart, lift_monomial, normalizedProd, Algebra.smul_def]
  exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ _) (hprod _)

end ClusterMonomial

/-! ### The quantum upper cluster algebra -/

section UpperAlgebra

variable (s : ExchangeFrame (u₀ := vUnit) D row)

/-- **The quantum upper cluster algebra** `U_v = ⋂_t T_t`, over all seeds `t` reachable from
`s`, as an intersection of `Zv`-subalgebras. -/
def upperAlgebra : Subalgebra Zv D :=
  ⨅ w : List K, (mutateWord (fun k t ↦ ExchangeFrame.mutate t k) w s).chartAlgebra

/-- The finite quantum upper bound `UB_v(s) = T_s ∩ ⋂_k T_{μ_k(s)}` as a `Zv`-subalgebra. -/
def upperBoundAlgebra : Subalgebra Zv D :=
  s.chartAlgebra ⊓ ⨅ k, (s.mutate k).chartAlgebra

variable {s}

theorem mem_upperAlgebra {x : D} :
    x ∈ s.upperAlgebra ↔ ∀ t, Reachable s t → x ∈ t.chartRing := by
  simp only [upperAlgebra, Algebra.mem_iInf, mem_chartAlgebra]
  constructor
  · rintro h t ⟨w, rfl⟩
    exact h w
  · intro h w
    exact h _ (reachable_mutateWord s w)

theorem mem_upperBoundAlgebra {x : D} :
    x ∈ s.upperBoundAlgebra ↔ x ∈ s.upperBound := by
  simp only [upperBoundAlgebra, Algebra.mem_inf, Algebra.mem_iInf, mem_chartAlgebra,
    mem_upperBound]

variable (s)

theorem toSubring_upperBoundAlgebra : (s.upperBoundAlgebra).toSubring = s.upperBound :=
  SetLike.ext fun _ ↦ mem_upperBoundAlgebra

theorem toSubring_upperAlgebra :
    (s.upperAlgebra).toSubring =
      TauCeti.Cluster.upperClusterRing (algebraMap Zv D).range
        (fun t : ExchangeFrame (u₀ := vUnit) D row ↦ fun i ↦ (t.coordinate i : D))
        (fun k t ↦ t.mutate k) s :=
  SetLike.ext fun _ ↦ by
    rw [Subalgebra.mem_toSubring, TauCeti.Cluster.mem_upperClusterRing, upperAlgebra,
      Algebra.mem_iInf]
    simp only [mem_chartAlgebra]
    rfl

/-- **Q3 for the upper algebra.** `U_v = UB_v(s)`. -/
theorem upperAlgebra_eq_upperBoundAlgebra : s.upperAlgebra = s.upperBoundAlgebra := by
  apply Subalgebra.toSubring_injective
  rw [toSubring_upperAlgebra, toSubring_upperBoundAlgebra, s.upperClusterRing_eq_upperBound]

theorem upperAlgebra_le_chartAlgebra : s.upperAlgebra ≤ s.chartAlgebra := fun _ hx ↦
  s.mem_chartAlgebra.2 (mem_upperAlgebra.1 hx s (Reachable.refl s))

variable {s}

/-- **Re-rooting.** `U_v` does not change when `s` is replaced by a reachable seed. -/
theorem Reachable.upperAlgebra_eq {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t) :
    t.upperAlgebra = s.upperAlgebra := by
  ext x
  simp only [mem_upperAlgebra]
  exact ⟨fun H u hu ↦ H u (h.symm.trans hu), fun H u hu ↦ H u (h.trans hu)⟩

theorem Reachable.upperBoundAlgebra_eq {t : ExchangeFrame (u₀ := vUnit) D row} (h : Reachable s t) :
    t.upperBoundAlgebra = s.upperBoundAlgebra := by
  rw [← upperAlgebra_eq_upperBoundAlgebra, ← upperAlgebra_eq_upperBoundAlgebra,
    h.upperAlgebra_eq]

theorem Reachable.upperAlgebra_le_chartAlgebra {t : ExchangeFrame (u₀ := vUnit) D row} (h :
  Reachable s t) :
    s.upperAlgebra ≤ t.chartAlgebra := by
  rw [← h.upperAlgebra_eq]
  exact t.upperAlgebra_le_chartAlgebra

variable (s)

/-- **`A_{v,S} ⊆ U_v`** for every set `S` of frozen indices. -/
theorem clusterAlgebra_le_upperAlgebra {S : Set M} (hS : S ⊆ (Set.range row)ᶜ) :
    s.clusterAlgebra S ≤ s.upperAlgebra := by
  refine Algebra.adjoin_le ?_
  rintro x ((⟨t, ht, k, rfl⟩ | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩) <;>
    rw [SetLike.mem_coe, mem_upperAlgebra] <;> intro u hu
  · exact (hu.symm.trans ht).coordinate_mem_chartRing (row k)
  · change (s.coordinate j : D) ∈ _
    rw [← hu.coordinate_of_notMem hj]
    exact coordinate_mem_chartRing _ _ j
  · change (s.coordinate j : D)⁻¹ ∈ _
    rw [← hu.coordinate_of_notMem (hS hj)]
    exact inverse_mem_chartRing _ _ j

/-- **`A_{v,S} ⊆ U_v = UB_v(s)`.** -/
theorem clusterAlgebra_le_upperBoundAlgebra {S : Set M} (hS : S ⊆ (Set.range row)ᶜ) :
    s.clusterAlgebra S ≤ s.upperBoundAlgebra :=
  s.upperAlgebra_eq_upperBoundAlgebra ▸ s.clusterAlgebra_le_upperAlgebra hS

theorem clusterAlgebra_le_chartAlgebra {S : Set M} (hS : S ⊆ (Set.range row)ᶜ) :
    s.clusterAlgebra S ≤ s.chartAlgebra :=
  (s.clusterAlgebra_le_upperAlgebra hS).trans (s.upperAlgebra_le_chartAlgebra)

end UpperAlgebra

end

end TauCeti.Cluster.ExchangeFrame

/-! ### Reindexing of exchange data -/

namespace TauCeti.Cluster

section Reindex

variable {M K M' K' : Type*} (σ : M ≃ M') (τ : K ≃ K')

/-- The relabelling `a ↦ a ∘ σ⁻¹` of exponent vectors along `σ : M ≃ M'`. -/
def exponentReindex : (M → ℤ) ≃+ (M' → ℤ) :=
  (LinearEquiv.funCongrLeft ℤ ℤ σ.symm).toAddEquiv

@[simp] theorem exponentReindex_apply (a : M → ℤ) (i : M') :
    exponentReindex σ a i = a (σ.symm i) :=
  rfl

theorem exponentReindex_single [DecidableEq M] [DecidableEq M'] (i : M) :
    exponentReindex σ (Pi.single i 1) = Pi.single (σ i) 1 := by
  funext i'
  simp only [exponentReindex_apply, Pi.single_apply, Equiv.symm_apply_eq]

theorem matrixForm_reindex [Fintype M] [DecidableEq M] [Fintype M'] [DecidableEq M']
    (Λ : Matrix M M ℤ) (a b : M → ℤ) :
    matrixForm (Λ.reindex σ σ) (exponentReindex σ a) (exponentReindex σ b) =
      matrixForm Λ a b := by
  simp only [matrixForm_eq_sum, exponentReindex_apply, Matrix.reindex_apply,
    Matrix.submatrix_apply]
  exact (Equiv.sum_comp σ.symm (fun i ↦ ∑ j', a i * Λ i (σ.symm j') * b (σ.symm j'))).trans
    (Finset.sum_congr rfl fun i _ ↦ Equiv.sum_comp σ.symm (fun j ↦ a i * Λ i j * b j))

theorem IsAlternatingMatrix.reindex {Λ : Matrix M M ℤ} (hΛ : IsAlternatingMatrix Λ) :
    IsAlternatingMatrix (Λ.reindex σ σ) :=
  fun _ _ ↦ hΛ _ _

variable {row : K ↪ M} {row' : K' ↪ M'} (hrow : ∀ k, row' (τ k) = σ (row k))

include hrow in
theorem range_row_eq_image : Set.range row' = σ '' Set.range row := by
  ext j'
  constructor
  · rintro ⟨k', rfl⟩
    obtain ⟨k, rfl⟩ := τ.surjective k'
    exact ⟨row k, ⟨k, rfl⟩, (hrow k).symm⟩
  · rintro ⟨_, ⟨k, rfl⟩, rfl⟩
    exact ⟨τ k, hrow k⟩

include hrow in
theorem compl_range_row_eq_image : (Set.range row')ᶜ = σ '' (Set.range row)ᶜ := by
  rw [range_row_eq_image σ τ hrow, Set.image_compl_eq σ.bijective]

include hrow in
/-- Relabelling of an extended exchange matrix along `σ`, `τ`; the symmetrizer is relabelled
along `τ`. -/
def ExtendedExchangeMatrix.reindex (B : ExtendedExchangeMatrix row) :
    ExtendedExchangeMatrix row' where
  matrix := B.matrix.reindex σ τ
  symmetrizer := B.symmetrizer ∘ τ.symm
  symmetrizer_pos _ := B.symmetrizer_pos _
  symmetrized i' j' := by
    obtain ⟨i, rfl⟩ := τ.surjective i'
    obtain ⟨j, rfl⟩ := τ.surjective j'
    simp only [Function.comp_apply, Matrix.reindex_apply, Matrix.submatrix_apply, hrow,
      Equiv.symm_apply_apply]
    exact B.symmetrized i j

@[simp] theorem ExtendedExchangeMatrix.reindex_matrix (B : ExtendedExchangeMatrix row) :
    (B.reindex σ τ hrow).matrix = B.matrix.reindex σ τ := rfl

@[simp] theorem ExtendedExchangeMatrix.reindex_symmetrizer (B : ExtendedExchangeMatrix row) :
    (B.reindex σ τ hrow).symmetrizer = B.symmetrizer ∘ τ.symm := rfl

theorem IsColumnCompatible.reindex [Fintype M] [DecidableEq M] [Fintype M'] [DecidableEq M']
    {B : ExtendedExchangeMatrix row} {Λ : Matrix M M ℤ} {w : K → ℤ}
    (hc : IsColumnCompatible B Λ w) :
    IsColumnCompatible (B.reindex σ τ hrow) (Λ.reindex σ σ) (w ∘ τ.symm) := by
  intro k' l'
  obtain ⟨k, rfl⟩ := τ.surjective k'
  obtain ⟨l, rfl⟩ := σ.surjective l'
  simp only [ExtendedExchangeMatrix.reindex_matrix,
    Function.comp_apply, Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply]
  rw [Equiv.sum_comp σ.symm (fun i ↦ B.matrix i k * Λ i l), hc k l]
  simp only [hrow, σ.injective.eq_iff]

include hrow in
theorem exchangeExponentPos_reindex [DecidableEq M] [DecidableEq M'] (B : Matrix M K ℤ) (k : K) :
    exchangeExponentPos row' (B.reindex σ τ) (τ k) =
      exponentReindex σ (exchangeExponentPos row B k) := by
  funext i'
  have h := congrFun (exponentReindex_single σ (row k)) i'
  simp only [exponentReindex_apply] at h
  simp only [exchangeExponentPos, exponentReindex_apply, Pi.add_apply, Pi.neg_apply, hrow,
    Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply, h]

include hrow in
theorem exchangeExponentNeg_reindex [DecidableEq M] [DecidableEq M'] (B : Matrix M K ℤ) (k : K) :
    exchangeExponentNeg row' (B.reindex σ τ) (τ k) =
      exponentReindex σ (exchangeExponentNeg row B k) := by
  funext i'
  have h := congrFun (exponentReindex_single σ (row k)) i'
  simp only [exponentReindex_apply] at h
  simp only [exchangeExponentNeg, exponentReindex_apply, Pi.add_apply, Pi.neg_apply, hrow,
    Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply, h]

include hrow in
theorem extendedMatrixMutation_reindex [DecidableEq M] [DecidableEq K] [DecidableEq M']
    [DecidableEq K'] (B : Matrix M K ℤ) (k : K) :
    extendedMatrixMutation row' (B.reindex σ τ) (τ k) =
      (extendedMatrixMutation row B k).reindex σ τ := by
  ext i' j'
  obtain ⟨i, rfl⟩ := σ.surjective i'
  obtain ⟨j, rfl⟩ := τ.surjective j'
  simp only [extendedMatrixMutation, Matrix.reindex_apply, Matrix.submatrix_apply,
    Equiv.symm_apply_apply, hrow, σ.injective.eq_iff, τ.injective.eq_iff]

include hrow in
theorem mutationLeft_reindex [DecidableEq M] [DecidableEq M'] (B : Matrix M K ℤ) (k : K)
    (ε : ℤ) :
    mutationLeft row' (B.reindex σ τ) (τ k) ε = (mutationLeft row B k ε).reindex σ σ := by
  ext i' j'
  obtain ⟨i, rfl⟩ := σ.surjective i'
  obtain ⟨j, rfl⟩ := σ.surjective j'
  simp only [mutationLeft, Matrix.reindex_apply, Matrix.submatrix_apply, Equiv.symm_apply_apply,
    hrow, σ.injective.eq_iff]

include hrow in
theorem formMutation_reindex [Fintype M] [DecidableEq M] [Fintype M'] [DecidableEq M']
    (B : Matrix M K ℤ) (Λ : Matrix M M ℤ) (k : K) (ε : ℤ) :
    formMutation row' (B.reindex σ τ) (Λ.reindex σ σ) (τ k) ε =
      (formMutation row B Λ k ε).reindex σ σ := by
  rw [formMutation, formMutation, mutationLeft_reindex σ τ hrow]
  simp only [Matrix.reindex_apply, Matrix.transpose_submatrix, Matrix.submatrix_mul_equiv]

end Reindex

end TauCeti.Cluster

namespace TauCeti.Cluster.ExchangeFrame

open TauCeti TauCeti.Laurent TauCeti.QuantumTorus

noncomputable section

variable {D : Type*} [DivisionRing D] [Algebra Zv D]
  {M K : Type*} [Fintype M] [DecidableEq M] {row : K ↪ M}

/-! ### Reindexing of seeds -/

section Reindex

variable {M' K' : Type*} [Fintype M'] [DecidableEq M'] {row' : K' ↪ M'}
  (σ : M ≃ M') (τ : K ≃ K') (hrow : ∀ k, row' (τ k) = σ (row k))
  (s : ExchangeFrame (u₀ := vUnit) D row)

theorem isQuasiCommuting_reindex :
    IsQuasiCommuting vUnit (matrixForm (s.form.reindex σ σ)) (s.coordinate ∘ σ.symm) := by
  intro i j
  rw [matrixForm_single_single, Matrix.reindex_apply, Matrix.submatrix_apply,
    ← matrixForm_single_single s.form]
  exact s.quasiCommuting (σ.symm i) (σ.symm j)

/-- The chart of the relabelled tuple is the chart of `s` after the lattice reindexing. -/
theorem lift_reindex :
    QuantumTorus.lift (s.alternating.reindex σ).isAlt (s.coordinate ∘ σ.symm)
        (s.isQuasiCommuting_reindex σ) =
      s.chart.comp
        (domCongr (exponentReindex σ) (matrixForm_reindex σ s.form)).symm.toAlgHom := by
  refine (eq_lift _ _ _ fun i ↦ ?_).symm
  obtain ⟨j, rfl⟩ := σ.surjective i
  have h1 : (domCongr (u := vUnit) (exponentReindex σ) (matrixForm_reindex σ s.form)).symm
      (QuantumTorus.monomial (Pi.single (σ j) 1)) = QuantumTorus.monomial (Pi.single j 1) := by
    rw [AlgEquiv.symm_apply_eq, domCongr_monomial, exponentReindex_single]
  rw [AlgHom.comp_apply, AlgEquiv.toAlgHom_apply, h1]
  change s.monomial (Pi.single j 1) = (s.coordinate (σ.symm (σ j)) : D)
  rw [Equiv.symm_apply_apply]
  exact s.monomial_single j

/-- **Reindexing** of a quantum seed along `σ : M ≃ M'` and `τ : K ≃ K'` with
`row' ∘ τ = σ ∘ row`: `B_ext`, its symmetrizer and `Λ` are relabelled and `X'_{σ i} = X_i`. -/
def reindex : ExchangeFrame (u₀ := vUnit) D row' where
  exchange := s.exchange.reindex σ τ hrow
  form := s.form.reindex σ σ
  alternating := s.alternating.reindex σ
  formWeight := s.formWeight ∘ τ.symm
  compatible := s.compatible.reindex σ τ hrow
  independentColumns := by
    let e := LinearEquiv.piCongrLeft' ℚ (fun _ : M ↦ ℚ) σ
    convert! (s.independentColumns.map' e.toLinearMap
      (LinearMap.ker_eq_bot.mpr e.injective)).comp τ.symm τ.symm.injective using 1
  coordinate := s.coordinate ∘ σ.symm
  quasiCommuting := s.isQuasiCommuting_reindex σ
  faithful := by
    rw [s.lift_reindex σ]
    exact s.chart_injective.comp (AlgEquiv.injective _)

@[simp] theorem reindex_exchange :
    (s.reindex σ τ hrow).exchange = s.exchange.reindex σ τ hrow :=
  rfl

@[simp] theorem reindex_form : (s.reindex σ τ hrow).form = s.form.reindex σ σ :=
  rfl

@[simp] theorem reindex_coordinate (i : M) :
    (s.reindex σ τ hrow).coordinate (σ i) = s.coordinate i := by
  simp [reindex]

theorem reindex_chart :
    (s.reindex σ τ hrow).chart =
      s.chart.comp
        (domCongr (exponentReindex σ) (matrixForm_reindex σ s.form)).symm.toAlgHom :=
  s.lift_reindex σ

theorem reindex_chart_domCongr (f : quantumTorus Zv vUnit (matrixForm s.form)) :
    (s.reindex σ τ hrow).chart
        (domCongr (exponentReindex σ) (matrixForm_reindex σ s.form) f) = s.chart f := by
  change QuantumTorus.lift (s.alternating.reindex σ).isAlt (s.coordinate ∘ σ.symm)
    (s.isQuasiCommuting_reindex σ) (domCongr _ _ f) = _
  rw [s.lift_reindex σ, AlgHom.comp_apply, AlgEquiv.toAlgHom_apply, AlgEquiv.symm_apply_apply]

@[simp] theorem reindex_monomial (a : M → ℤ) :
    (s.reindex σ τ hrow).monomial (exponentReindex σ a) = s.monomial a := by
  have h := s.reindex_chart_domCongr σ τ hrow (QuantumTorus.monomial a)
  rw [domCongr_monomial] at h
  exact h

theorem reindex_chartRing : (s.reindex σ τ hrow).chartRing = s.chartRing :=
  Laurent.chartRing_congr_range _
    (σ.symm.surjective.range_comp fun i ↦ (s.coordinate i : D))

theorem reindex_chartAlgebra : (s.reindex σ τ hrow).chartAlgebra = s.chartAlgebra := by
  ext x
  rw [mem_chartAlgebra, mem_chartAlgebra, reindex_chartRing]

theorem reindex_exchangeCoordinate (k : K) :
    (s.reindex σ τ hrow).exchangeCoordinate (τ k) = s.exchangeCoordinate k := by
  rw [exchangeCoordinate, exchangeCoordinate, reindex_exchange,
    ExtendedExchangeMatrix.reindex_matrix, exchangeExponentPos_reindex σ τ hrow,
        exchangeExponentNeg_reindex σ τ hrow,
    reindex_monomial, reindex_monomial]

variable [Fintype K] [DecidableEq K] [Fintype K'] [DecidableEq K']

/-- Reindexing commutes with mutation. -/
theorem reindex_mutate (k : K) :
    (s.mutate k).reindex σ τ hrow = (s.reindex σ τ hrow).mutate (τ k) := by
  refine ExchangeFrame.ext (ExtendedExchangeMatrix.ext ?_ rfl) ?_ ?_
  · exact (extendedMatrixMutation_reindex σ τ hrow s.exchange.matrix k).symm
  · exact (formMutation_reindex σ τ hrow s.exchange.matrix s.form k 1).symm
  · funext i'
    obtain ⟨i, rfl⟩ := σ.surjective i'
    apply Units.ext
    rw [reindex_coordinate]
    by_cases hi : i = row k
    · subst hi
      rw [mutate_coordinate_row, ← hrow, mutate_coordinate_row, reindex_exchangeCoordinate]
    · rw [mutate_coordinate_of_ne _ _ hi,
        mutate_coordinate_of_ne _ _ (by rw [hrow]; exact σ.injective.ne hi),
        reindex_coordinate]

theorem reindex_mutateWord (w : List K) :
    (mutateWord (fun k t ↦ ExchangeFrame.mutate t k) w s).reindex σ τ hrow =
      mutateWord (fun k t ↦ ExchangeFrame.mutate t k) (w.map τ) (s.reindex σ τ hrow) := by
  induction w generalizing s with
  | nil => rfl
  | cons k w ih => rw [List.map_cons, mutateWord_cons, mutateWord_cons, ih, reindex_mutate]

variable {σ τ hrow}

/-- The seeds reachable from a reindexed seed are the reindexings of the reachable seeds. -/
theorem reachable_reindex_iff {t' : ExchangeFrame (u₀ := vUnit) D row'} :
    Reachable (s.reindex σ τ hrow) t' ↔
      ∃ t, Reachable s t ∧ t.reindex σ τ hrow = t' := by
  constructor
  · rintro ⟨w', rfl⟩
    refine ⟨_, reachable_mutateWord s (w'.map τ.symm), ?_⟩
    rw [reindex_mutateWord σ τ hrow s, List.map_map, Equiv.self_comp_symm,
      List.map_id]
  · rintro ⟨t, ⟨w, rfl⟩, rfl⟩
    rw [reindex_mutateWord σ τ hrow s]
    exact reachable_mutateWord _ _

theorem clusterVariables_reindex :
    (s.reindex σ τ hrow).clusterVariables = s.clusterVariables := by
  ext x
  constructor
  · rintro ⟨t', ht', k', rfl⟩
    obtain ⟨t, ht, rfl⟩ := (reachable_reindex_iff s).1 ht'
    obtain ⟨k, rfl⟩ := τ.surjective k'
    refine ⟨t, ht, k, ?_⟩
    rw [hrow, reindex_coordinate]
  · rintro ⟨t, ht, k, rfl⟩
    refine ⟨_, (reachable_reindex_iff s).2 ⟨t, ht, rfl⟩, τ k, ?_⟩
    rw [hrow, reindex_coordinate]

/-- **Reindexing.** The relabelled seed has the same quantum cluster algebra, with the frozen
set relabelled. -/
theorem clusterAlgebra_reindex (S : Set M) :
    (s.reindex σ τ hrow).clusterAlgebra (σ '' S) = s.clusterAlgebra S := by
  rw [clusterAlgebra, clusterAlgebra, clusterGenerators, clusterGenerators,
    clusterVariables_reindex, compl_range_row_eq_image σ τ hrow, Set.image_image,
    Set.image_image]
  simp only [reindex_coordinate]

/-- **Reindexing.** The relabelled seed has the same quantum upper cluster algebra. -/
theorem upperAlgebra_reindex :
    (s.reindex σ τ hrow).upperAlgebra = s.upperAlgebra := by
  ext x
  simp only [mem_upperAlgebra]
  constructor
  · intro H t ht
    rw [← reindex_chartRing σ τ hrow t]
    exact H _ ((reachable_reindex_iff s).2 ⟨t, ht, rfl⟩)
  · intro H t' ht'
    obtain ⟨t, ht, rfl⟩ := (reachable_reindex_iff s).1 ht'
    rw [reindex_chartRing]
    exact H t ht

/-- **Reindexing.** The quantum cluster monomials of the relabelled seed, for the relabelled
frozen set, are those of `s`. -/
theorem isClusterMonomial_reindex_iff (S : Set M) {x : D} :
    (s.reindex σ τ hrow).IsClusterMonomial (σ '' S) x ↔ s.IsClusterMonomial S x := by
  constructor
  · rintro ⟨t', ht', a', hmut, hfr, rfl⟩
    obtain ⟨t, ht, rfl⟩ := (reachable_reindex_iff s).1 ht'
    refine ⟨t, ht, fun i ↦ a' (σ i), fun k ↦ ?_, fun j hj ↦ ?_, ?_⟩
    · simpa only [hrow] using hmut (τ k)
    · exact hfr (σ j) fun ⟨j', hj', he⟩ ↦ hj (σ.injective he ▸ hj')
    · rw [← t.reindex_monomial σ τ hrow (fun i ↦ a' (σ i))]
      congr 1
      funext i'
      simp only [exponentReindex_apply, Equiv.apply_symm_apply]
  · rintro ⟨t, ht, a, hmut, hfr, rfl⟩
    refine ⟨_, (reachable_reindex_iff s).2 ⟨t, ht, rfl⟩, exponentReindex σ a, fun k' ↦ ?_,
      fun j' hj' ↦ ?_, (t.reindex_monomial σ τ hrow a).symm⟩
    · obtain ⟨k, rfl⟩ := τ.surjective k'
      rw [exponentReindex_apply, hrow, Equiv.symm_apply_apply]
      exact hmut k
    · rw [exponentReindex_apply]
      exact hfr _ fun h ↦ hj' ⟨_, h, σ.apply_symm_apply j'⟩

end Reindex

/-! ### Transport along maps of ambient division rings -/

section Map

variable {D' : Type*} [DivisionRing D'] [Algebra Zv D'] (φ : D →ₐ[Zv] D')
  (s : ExchangeFrame (u₀ := vUnit) D row)

theorem isQuasiCommuting_map :
    IsQuasiCommuting vUnit (matrixForm s.form)
      (fun i ↦ Units.map (φ : D →* D') (s.coordinate i)) := by
  intro i j
  simp only [Units.coe_map, MonoidHom.coe_ofClass]
  rw [← map_mul, s.quasiCommuting i j, map_smul, map_mul]

theorem lift_map :
    QuantumTorus.lift s.isAlt (fun i ↦ Units.map (φ : D →* D') (s.coordinate i))
        (s.isQuasiCommuting_map φ) = φ.comp s.chart := by
  refine (eq_lift _ _ _ fun i ↦ ?_).symm
  simp only [AlgHom.comp_apply, Units.coe_map, MonoidHom.coe_ofClass]
  exact congrArg φ (s.monomial_single i)

/-- **Ambient transport** of a quantum seed along a `Zv`-algebra map of division rings, which is
injective. -/
def map : ExchangeFrame (u₀ := vUnit) D' row where
  exchange := s.exchange
  form := s.form
  alternating := s.alternating
  formWeight := s.formWeight
  compatible := s.compatible
  independentColumns := s.independentColumns
  coordinate i := Units.map (φ : D →* D') (s.coordinate i)
  quasiCommuting := s.isQuasiCommuting_map φ
  faithful := by
    rw [s.lift_map φ]
    exact φ.toRingHom.injective.comp s.chart_injective

@[simp] theorem map_exchange : (s.map φ).exchange = s.exchange := rfl
@[simp] theorem map_form : (s.map φ).form = s.form := rfl
@[simp] theorem map_coordinate (i : M) : ((s.map φ).coordinate i : D') = φ (s.coordinate i) :=
  rfl

theorem map_chart : (s.map φ).chart = φ.comp s.chart :=
  s.lift_map φ

@[simp] theorem map_monomial (a : M → ℤ) : (s.map φ).monomial a = φ (s.monomial a) :=
  DFunLike.congr_fun (s.map_chart φ) (QuantumTorus.monomial a)

theorem map_chartAlgebra : (s.map φ).chartAlgebra = s.chartAlgebra.map φ := by
  unfold chartAlgebra
  rw [map_chart]
  exact AlgHom.range_comp s.chart φ

theorem map_exchangeCoordinate (k : K) :
    (s.map φ).exchangeCoordinate k = φ (s.exchangeCoordinate k) := by
  rw [exchangeCoordinate, exchangeCoordinate, map_add, map_exchange, map_monomial, map_monomial]

variable [Fintype K] [DecidableEq K]

/-- Ambient transport commutes with mutation. -/
theorem map_mutate (k : K) :
    (s.mutate k).map φ = (s.map φ).mutate k := by
  refine ExchangeFrame.ext rfl rfl ?_
  funext i
  apply Units.ext
  rw [map_coordinate]
  by_cases hi : i = row k
  · subst hi
    rw [mutate_coordinate_row, mutate_coordinate_row, map_exchangeCoordinate]
  · rw [mutate_coordinate_of_ne _ _ hi, mutate_coordinate_of_ne _ _ hi, map_coordinate]

theorem map_mutateWord (w : List K) :
    (mutateWord (fun k t ↦ ExchangeFrame.mutate t k) w s).map φ =
      mutateWord (fun k t ↦ ExchangeFrame.mutate t k) w (s.map φ) := by
  induction w generalizing s with
  | nil => rfl
  | cons k w ih => rw [mutateWord_cons, mutateWord_cons, ih, map_mutate]

variable {φ}

/-- The seeds reachable from a transported seed are the transports of the reachable seeds. -/
theorem reachable_map_iff {t' : ExchangeFrame (u₀ := vUnit) D' row} :
    Reachable (s.map φ) t' ↔ ∃ t, Reachable s t ∧ t.map φ = t' := by
  constructor
  · rintro ⟨w, rfl⟩
    exact ⟨_, reachable_mutateWord s w, map_mutateWord φ s w⟩
  · rintro ⟨t, ⟨w, rfl⟩, rfl⟩
    rw [map_mutateWord]
    exact reachable_mutateWord _ _

theorem clusterVariables_map : (s.map φ).clusterVariables = φ '' s.clusterVariables := by
  ext x
  constructor
  · rintro ⟨t', ht', k, rfl⟩
    obtain ⟨t, ht, rfl⟩ := (reachable_map_iff s).1 ht'
    exact ⟨_, ⟨t, ht, k, rfl⟩, (map_coordinate φ t _).symm⟩
  · rintro ⟨_, ⟨t, ht, k, rfl⟩, rfl⟩
    exact ⟨_, (reachable_map_iff s).2 ⟨t, ht, rfl⟩, k, map_coordinate φ t _⟩

/-- **Ambient transport.** `A_{v,S}` of the transported seed is the image of `A_{v,S}`. -/
theorem clusterAlgebra_map (S : Set M) :
    (s.map φ).clusterAlgebra S = (s.clusterAlgebra S).map φ := by
  rw [clusterAlgebra, clusterAlgebra, ← Algebra.adjoin_image, clusterGenerators,
    clusterGenerators, Set.image_union, Set.image_union, clusterVariables_map, Set.image_image,
    Set.image_image]
  simp only [map_coordinate, map_inv₀]

/-- **Ambient transport.** `U_v` of the transported seed is the image of `U_v`. -/
theorem upperAlgebra_map : (s.map φ).upperAlgebra = (s.upperAlgebra).map φ := by
  rw [upperAlgebra, upperAlgebra, Algebra.map_iInf _ φ.toRingHom.injective]
  congr 1
  funext w
  rw [← map_mutateWord, map_chartAlgebra]

/-- **Ambient transport.** The quantum cluster monomials of the transported seed are the images
of those of `s`. -/
theorem isClusterMonomial_map_iff (S : Set M) {x' : D'} :
    (s.map φ).IsClusterMonomial S x' ↔ ∃ x, s.IsClusterMonomial S x ∧ φ x = x' := by
  constructor
  · rintro ⟨t', ht', a, hmut, hfr, rfl⟩
    obtain ⟨t, ht, rfl⟩ := (reachable_map_iff s).1 ht'
    exact ⟨_, ⟨t, ht, a, hmut, hfr, rfl⟩, (map_monomial φ t a).symm⟩
  · rintro ⟨_, ⟨t, ht, a, hmut, hfr, rfl⟩, rfl⟩
    exact ⟨_, (reachable_map_iff s).2 ⟨t, ht, rfl⟩, a, hmut, hfr, (map_monomial φ t a).symm⟩

theorem setOf_isClusterMonomial_map (S : Set M) :
    {x' | (s.map φ).IsClusterMonomial S x'} = φ '' {x | s.IsClusterMonomial S x} :=
  Set.ext fun _ ↦ isClusterMonomial_map_iff s S

end Map

end

end TauCeti.Cluster.ExchangeFrame
