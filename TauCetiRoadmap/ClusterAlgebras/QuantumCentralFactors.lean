module

public import TauCetiRoadmap.ClusterAlgebras.QuantumSubsetRing

/-!
# Central factors of the quantum one-exchange (Q1)

For a quantum seed `s`, a mutable `k` with column `b = b_{•k}`, and `α⁻ = -e_k + [-b]_+`, the
exchanged coordinate factors as `X'_k = (1 + v^{d_k} M(b)) M(α⁻)`, and

`(X'_k) ^ r = P_{k,r} M(α⁻) ^ r`, with `P_{k,r} = ∏_{h=1} ^ r (1 + v^{(2h-1) d_k} M(b))`.

Q1 is stated over `C' = subsetRing S`, the subring generated by `Z_v` and `X_l^{±1}` for `l` in a
set `S` of coordinates with `row k ∉ S` that contains the support of `b`; for
`S = {l | l ≠ row k}` it is the ring `otherRing (row k)` of all other coordinates. The factors
of `P_{k,r}` lie in `C'` and are central there. The ordered products `P_r` of the one-exchange
(`TauCeti.Laurent.SkewExchange`) are `P_r = P_{k,r} M(α⁻) ^ r X_k ^ r`
(`orderedProduct_eq_centralProduct_mul`) with `M(α⁻) ^ r X_k ^ r` a unit of `C'`, so the criterion
`ExchangeData.mem_chartRing_y_iff` reads: `∑ c_m X_k ^ m` with `c_m ∈ C'` lies in
`C'[X_k^{±1}] ∩ C'[X'^{±1}_k]` iff `c_{-r} ∈ C' P_{k,r}` for every `r > 0`
(`expand_mem_inf_iff`, `mem_chartRing_exchangeCoordinate_iff`). For `C' = otherRing (row k)`
this is `mem_mutate_chartRing_iff`.
-/

@[expose] public section

namespace TauCeti.Cluster.QuantumSeed

open TauCeti TauCeti.QuantumTorus TauCeti.Laurent

noncomputable section

variable {D : Type*} [DivisionRing D] [Algebra Zv D] {M K : Type*} [Fintype M] [DecidableEq M]
  {row : K ↪ M} (s : QuantumSeed D row)

/-- `X'_k` normalizes the ring of any `S` with `row k ∉ S`. -/
theorem exchangeCoordinate_normalizes_subsetRing (k : K) {S : Set M}
    (hk : row k ∉ S) : Normalizes (s.subsetRing S) (s.exchangeCoordinate k) :=
  s.normalizes_subsetRing (s.exchangeCoordinate_ne_zero k)
    (fun j ↦ vUnit ^ (2 * matrixForm s.form (exchangeExponentPos row s.exchange.matrix k)
      (Pi.single j 1)))
    (fun _ hj ↦ s.exchangeCoordinate_mul_coordinate k (fun h ↦ hk (h ▸ hj)))

/-! ### The column monomial `M(b_{•k})` -/

/-- `M(b_{•k})` commutes with every element of the ring `C` of the coordinates other than
`X_k`. -/
theorem commute_monomial_col (k : K) {c : D} (hc : c ∈ s.otherRing (row k)) :
    Commute (s.monomial fun l ↦ s.exchange.matrix l k) c := by
  have hX : ∀ l : M, l ≠ row k →
      Commute (s.monomial fun l ↦ s.exchange.matrix l k) (s.coordinate l : D) := by
    intro l hl
    have h := s.monomial_mul_coordinate (fun l ↦ s.exchange.matrix l k) l
    rw [s.compatible.matrixForm_col, Pi.single_eq_of_ne (Ne.symm hl)] at h
    simpa [Commute, SemiconjBy] using h
  have hle :
      s.otherRing (row k) ≤ Subring.centralizer {s.monomial fun l ↦ s.exchange.matrix l k} := by
    refine chartRing_le ?_ (fun l ↦ ?_) (fun l ↦ ?_)
    · rintro _ ⟨r, rfl⟩
      rw [Subring.mem_centralizer_iff]
      rintro g rfl
      exact (Algebra.commutes r _).symm
    · rw [Subring.mem_centralizer_iff]
      rintro g rfl
      exact hX l l.2
    · rw [Subring.mem_centralizer_iff]
      rintro g rfl
      exact (hX l l.2).inv_right₀
  exact ((Subring.mem_centralizer_iff.1 (hle hc)) _ rfl)

theorem monomial_col_mem_otherRing (k : K) :
    (s.monomial fun l ↦ s.exchange.matrix l k) ∈ s.otherRing (row k) :=
  s.monomial_mem_otherRing (s.exchange.diagonal k)

/-- `M(α⁻) M(b_{•k}) = v^{2 d_k} M(b_{•k}) M(α⁻)`. -/
theorem monomial_exchangeExponentNeg_mul_monomial_col (k : K) :
    s.monomial (exchangeExponentNeg row s.exchange.matrix k) *
        s.monomial (fun l ↦ s.exchange.matrix l k) =
      algebraMap Zv D ((vUnit ^ (2 * s.exchange.symmetrizer k) : Zvˣ) : Zv) *
        (s.monomial (fun l ↦ s.exchange.matrix l k) *
          s.monomial (exchangeExponentNeg row s.exchange.matrix k)) := by
  rw [monomial_mul_monomial_comm, s.compatible.matrixForm_col_right s.alternating,
    exchangeExponentNeg_row (s.exchange.diagonal k)]
  congr 4
  ring

/-! ### The binomial factors -/

/-- The binomial `1 + v ^ n M(b_{•k})`. -/
def binomialFactor (k : K) (n : ℤ) : D :=
  1 + algebraMap Zv D ((vUnit ^ n : Zvˣ) : Zv) * s.monomial (fun l ↦ s.exchange.matrix l k)

theorem binomialFactor_mem_otherRing (k : K) (n : ℤ) :
    s.binomialFactor k n ∈ s.otherRing (row k) :=
  Subring.add_mem _ (Subring.one_mem _)
    (Subring.mul_mem _ (s.algebraMap_mem_otherRing _ _) (s.monomial_col_mem_otherRing k))

/-- The binomial factors are central in the ring of the coordinates other than `X_k`. -/
theorem commute_binomialFactor (k : K) (n : ℤ) {c : D} (hc : c ∈ s.otherRing (row k)) :
    Commute (s.binomialFactor k n) c :=
  (Commute.one_left c).add_left
    ((Algebra.commute_algebraMap_left _ c).mul_left (s.commute_monomial_col k hc))

theorem commute_binomialFactor_binomialFactor (k : K) (m n : ℤ) :
    Commute (s.binomialFactor k m) (s.binomialFactor k n) :=
  s.commute_binomialFactor k m (s.binomialFactor_mem_otherRing k n)

/-- `X'_k = (1 + v^{d_k} M(b_{•k})) M(α⁻)`. -/
theorem exchangeCoordinate_eq_binomialFactor_mul (k : K) :
    s.exchangeCoordinate k =
      s.binomialFactor k (s.exchange.symmetrizer k) *
        s.monomial (exchangeExponentNeg row s.exchange.matrix k) := by
  have hmul := s.monomial_mul_monomial (fun l ↦ s.exchange.matrix l k)
    (exchangeExponentNeg row s.exchange.matrix k)
  rw [s.compatible.matrixForm_col,
    exchangeExponentNeg_row (s.exchange.diagonal k), add_comm,
    ← exchangeExponentPos_eq_neg_add] at hmul
  have hpos : s.monomial (exchangeExponentPos row s.exchange.matrix k) =
      algebraMap Zv D ((vUnit ^ s.exchange.symmetrizer k : Zvˣ) : Zv) *
        (s.monomial (fun l ↦ s.exchange.matrix l k) *
          s.monomial (exchangeExponentNeg row s.exchange.matrix k)) := by
    rw [hmul, ← mul_assoc, ← map_mul, ← Units.val_mul, ← zpow_add]
    simp
  rw [exchangeCoordinate, hpos, binomialFactor, add_mul, one_mul, mul_assoc, add_comm]

/-- Moving `M(α⁻) ^ r` past a binomial factor raises its exponent by `2 r d_k`. -/
theorem monomial_exchangeExponentNeg_pow_mul_binomialFactor (k : K) (n : ℤ)
    (r : ℕ) :
    s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r * s.binomialFactor k n =
      s.binomialFactor k (n + 2 * r * s.exchange.symmetrizer k) *
        s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r := by
  induction r generalizing n with
  | zero => simp
  | succ r ih =>
    have hstep : s.monomial (exchangeExponentNeg row s.exchange.matrix k) * s.binomialFactor k n =
        s.binomialFactor k (n + 2 * s.exchange.symmetrizer k) *
          s.monomial (exchangeExponentNeg row s.exchange.matrix k) := by
      rw [binomialFactor, binomialFactor, mul_add, mul_one, add_mul, one_mul]
      congr 1
      rw [← mul_assoc, ← Algebra.commutes, mul_assoc,
        s.monomial_exchangeExponentNeg_mul_monomial_col k, ← mul_assoc, ← map_mul,
        ← Units.val_mul, ← zpow_add, mul_assoc]
    rw [pow_succ, mul_assoc, hstep, ← mul_assoc, ih, mul_assoc]
    congr 2
    push_cast
    ring

/-! ### The central products `P_{k,r}` -/

/-- The central product `P_{k,r} = ∏_{h=1} ^ r (1 + v^{(2h-1) d_k} M(b_{•k}))`, written with
`h - 1 ∈ [0, r)`. The factors commute (`commute_binomialFactor_binomialFactor`). -/
def centralProduct (k : K) (r : ℕ) : D :=
  ((List.range r).map fun h : ℕ ↦
    s.binomialFactor k ((2 * (h : ℤ) + 1) * s.exchange.symmetrizer k)).prod

@[simp] theorem centralProduct_zero (k : K) : s.centralProduct k 0 = 1 := rfl
theorem centralProduct_succ (k : K) (r : ℕ) :
    s.centralProduct k (r + 1) =
      s.centralProduct k r * s.binomialFactor k ((2 * (r : ℤ) + 1) * s.exchange.symmetrizer k) := by
  simp [centralProduct, List.range_succ]

theorem centralProduct_mem_otherRing (k : K) (r : ℕ) :
    s.centralProduct k r ∈ s.otherRing (row k) := by
  induction r with
  | zero => exact Subring.one_mem _
  | succ r ih =>
    rw [centralProduct_succ]
    exact Subring.mul_mem _ ih (s.binomialFactor_mem_otherRing k _)

/-- `P_{k,r}` is central in the ring of the coordinates other than `X_k`. -/
theorem commute_centralProduct (k : K) (r : ℕ) {c : D} (hc : c ∈ s.otherRing (row k)) :
    Commute (s.centralProduct k r) c := by
  induction r with
  | zero => exact Commute.one_left c
  | succ r ih =>
    rw [centralProduct_succ]
    exact ih.mul_left (s.commute_binomialFactor k _ hc)

/-- **Q1, powers of the exchanged coordinate.** `(X'_k) ^ r = P_{k,r} M(-e_k + [-b_{•k}]_+) ^ r`. -/
theorem exchangeCoordinate_pow (k : K) (r : ℕ) :
    s.exchangeCoordinate k ^ r =
      s.centralProduct k r * s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r := by
  induction r with
  | zero => simp
  | succ r ih =>
    rw [pow_succ, ih, s.exchangeCoordinate_eq_binomialFactor_mul k, mul_assoc,
      ← mul_assoc (s.monomial _ ^ r), s.monomial_exchangeExponentNeg_pow_mul_binomialFactor k,
      centralProduct_succ, pow_succ]
    simp only [mul_assoc]
    congr 3
    ring

/-! ### Q1 over the ring of a set of coordinates -/

section SubsetRing

variable {S : Set M}

theorem binomialFactor_mem_subsetRing (k : K) (hS : ∀ l ∉ S, s.exchange.matrix l k = 0) (n : ℤ) :
    s.binomialFactor k n ∈ s.subsetRing S :=
  Subring.add_mem _ (Subring.one_mem _)
    (Subring.mul_mem _ (s.algebraMap_mem_subsetRing _ _) (s.monomial_mem_subsetRing hS))

theorem centralProduct_mem_subsetRing (k : K) (hS : ∀ l ∉ S, s.exchange.matrix l k = 0) (r : ℕ) :
    s.centralProduct k r ∈ s.subsetRing S := by
  induction r with
  | zero => exact Subring.one_mem _
  | succ r ih =>
    rw [centralProduct_succ]
    exact Subring.mul_mem _ ih (s.binomialFactor_mem_subsetRing k hS _)

/-- The factors of `P_{k,r}` are central in the ring of any `S` with `row k ∉ S`. -/
theorem commute_binomialFactor_of_mem_subsetRing (k : K) (hk : row k ∉ S) (n : ℤ) {c : D}
    (hc : c ∈ s.subsetRing S) : Commute (s.binomialFactor k n) c :=
  s.commute_binomialFactor k n (s.subsetRing_le_otherRing hk hc)

theorem commute_centralProduct_of_mem_subsetRing (k : K) (hk : row k ∉ S) (r : ℕ) {c : D}
    (hc : c ∈ s.subsetRing S) : Commute (s.centralProduct k r) c :=
  s.commute_centralProduct k r (s.subsetRing_le_otherRing hk hc)

/-- **The one-exchange data over `C'`** (§0.5 for Q1): for `row k ∉ S` and `S` containing the
support of `b_{•k}`, `X_k` and `E = X'_k X_k` satisfy §0.5's hypotheses over the ring of `S`. -/
theorem exchangeData_subsetRing (k : K) (hk : row k ∉ S)
    (hS : ∀ l ∉ S, s.exchange.matrix l k = 0) :
    SkewExchange.ExchangeData (s.subsetRing S) (s.coordinate (row k) : D)
      (s.exchangeCoordinate k * s.coordinate (row k)) where
  x_normalizes := s.coordinate_normalizes_subsetRing S (row k)
  x_leftFree := fun f hf h0 ↦ s.leftFree_coordinate (row k) f
    (fun m ↦ s.subsetRing_le_otherRing hk (hf m)) h0
  E_mem := by
    rw [s.exchangeCoordinate_mul_coordinate_eq]
    exact Subring.add_mem _
      (Subring.mul_mem _ (s.algebraMap_mem_subsetRing _ _)
        (s.monomial_mem_subsetRing fun l hl ↦ by simp [hS l hl, positivePart]))
      (Subring.mul_mem _ (s.algebraMap_mem_subsetRing _ _)
        (s.monomial_mem_subsetRing fun l hl ↦ by simp [hS l hl, positivePart]))
  E_normalizes := (s.exchangeCoordinate_normalizes_subsetRing k hk).mul
    (s.coordinate_normalizes_subsetRing S (row k))

end SubsetRing

/-- **Q1, the ordered products.** The ordered products of the one-exchange are
`P_r = P_{k,r} M(-e_k + [-b_{•k}]_+) ^ r X_k ^ r`. -/
theorem orderedProduct_eq_centralProduct_mul (k : K) (r : ℕ) :
    SkewExchange.orderedProduct (s.coordinate (row k) : D)
        (s.exchangeCoordinate k * s.coordinate (row k)) r =
      s.centralProduct k r *
        (s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r *
          (s.coordinate (row k) : D) ^ r) := by
  have hx : (s.coordinate (row k) : D) ≠ 0 := Units.ne_zero _
  have hy := (s.exchangeData k).y_pow r
  rw [s.exchangeData_y, s.exchangeCoordinate_pow k] at hy
  rw [← mul_assoc, hy, mul_assoc, ← zpow_natCast, ← zpow_add₀ hx, neg_add_cancel, zpow_zero,
    mul_one]

/-- `P_{k,r} X_k^{-r} = (M(-e_k + [-b_{•k}]_+) ^ r X_k ^ r)⁻¹ (X'_k) ^ r`. -/
theorem centralProduct_mul_zpow_neg (k : K) (r : ℕ) :
    s.centralProduct k r * (s.coordinate (row k) : D) ^ (-(r : ℤ)) =
      (s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r *
        (s.coordinate (row k) : D) ^ r)⁻¹ * s.exchangeCoordinate k ^ r := by
  have hu := s.monomial_pow_mul_coordinate_pow_mem k (s.exchange_eq_zero_of_not_mem_ne k) r
  have hu0 : s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r *
      (s.coordinate (row k) : D) ^ r ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (s.monomial_ne_zero _)) (pow_ne_zero _ (Units.ne_zero _))
  have hy := (s.exchangeData k).y_pow r
  rw [s.exchangeData_y, s.orderedProduct_eq_centralProduct_mul k r] at hy
  set u := s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r *
    (s.coordinate (row k) : D) ^ r
  rw [hy, (s.commute_centralProduct k r hu).eq, mul_assoc u, inv_mul_cancel_left₀ hu0]

/-- Divisibility by the ordered product `P_r` in the ring of `S` is divisibility by the central
product `P_{k,r}`. -/
theorem exists_eq_mul_orderedProduct_iff (k : K) {S : Set M}
    (hk : row k ∉ S) (hS : ∀ l ∉ S, s.exchange.matrix l k = 0) (r : ℕ) (a : D) :
    (∃ c ∈ s.subsetRing S, a = c * SkewExchange.orderedProduct
      (s.coordinate (row k) : D) (s.exchangeCoordinate k * s.coordinate (row k)) r) ↔
      ∃ c ∈ s.subsetRing S, a = c * s.centralProduct k r := by
  have hw := s.monomial_pow_mul_coordinate_pow_mem k hS r
  have hwi := s.inv_monomial_pow_mul_coordinate_pow_mem k hS r
  have hw0 : s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r *
      (s.coordinate (row k) : D) ^ r ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ (s.monomial_ne_zero _)) (pow_ne_zero _ (Units.ne_zero _))
  have hcomm := (s.commute_centralProduct_of_mem_subsetRing k hk r hw).eq
  rw [s.orderedProduct_eq_centralProduct_mul k r]
  set u := s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r *
    (s.coordinate (row k) : D) ^ r
  constructor
  · rintro ⟨c, hc, rfl⟩
    exact ⟨c * u, Subring.mul_mem _ hc hw, by rw [hcomm, mul_assoc c u]⟩
  · rintro ⟨c, hc, rfl⟩
    refine ⟨c * u⁻¹, Subring.mul_mem _ hc hwi, ?_⟩
    rw [hcomm, mul_assoc c u⁻¹, ← mul_assoc u⁻¹ u, inv_mul_cancel₀ hw0, one_mul]

/-- **Q1, the coefficient criterion over `C'`.** Let `C'` be the ring of a set `S` of coordinates
with `row k ∉ S` containing the support of `b_{•k}`. An element `f ∈ C'[X_k^{±1}]` lies in
`C'[X'^{±1}_k]` iff, expanding `f = ∑ c_m X_k ^ m` with left coefficients in `C'`,
`c_{-r} ∈ C' P_{k,r}` for every `r > 0`. -/
theorem mem_chartRing_exchangeCoordinate_iff (k : K) {S : Set M}
    (hk : row k ∉ S) (hS : ∀ l ∉ S, s.exchange.matrix l k = 0) {f : D}
    (hf : f ∈ Laurent.chartRing (s.subsetRing S) (fun _ : Unit ↦ (s.coordinate (row k) : D))) :
    f ∈ Laurent.chartRing (s.subsetRing S) (fun _ : Unit ↦ s.exchangeCoordinate k) ↔
      ∀ r : ℕ, 0 < r → ∃ c ∈ s.subsetRing S,
        SkewExchange.coeff (s.subsetRing S) (s.coordinate (row k) : D) f (-(r : ℤ)) =
          c * s.centralProduct k r := by
  rw [← s.exchangeData_y k, (s.exchangeData_subsetRing k hk hS).mem_chartRing_y_iff hf]
  exact forall₂_congr fun r _ ↦ s.exists_eq_mul_orderedProduct_iff k hk hS r _

/-- **Q1, the coefficient criterion over `C'`, intersection form.** For `c_m ∈ C'`,
`∑ c_m X_k ^ m ∈ C'[X_k^{±1}] ∩ C'[X'^{±1}_k]` iff `c_{-r} ∈ C' P_{k,r}` for every `r > 0`. -/
theorem expand_mem_inf_iff (k : K) {S : Set M} (hk : row k ∉ S)
    (hS : ∀ l ∉ S, s.exchange.matrix l k = 0) {g : ℤ →₀ D} (hg : ∀ m, g m ∈ s.subsetRing S) :
    SkewExchange.expand (s.coordinate (row k) : D) g ∈
        Laurent.chartRing (s.subsetRing S) (fun _ : Unit ↦ (s.coordinate (row k) : D)) ⊓
          Laurent.chartRing (s.subsetRing S) (fun _ : Unit ↦ s.exchangeCoordinate k) ↔
      ∀ r : ℕ, 0 < r → ∃ c ∈ s.subsetRing S, g (-(r : ℤ)) = c * s.centralProduct k r := by
  have hE := s.exchangeData_subsetRing k hk hS
  have hf : SkewExchange.expand (s.coordinate (row k) : D) g ∈
      Laurent.chartRing (s.subsetRing S) (fun _ : Unit ↦ (s.coordinate (row k) : D)) :=
    (SkewExchange.mem_chartRing_iff hE.x_normalizes).2 ⟨g, hg, rfl⟩
  rw [Subring.mem_inf, and_iff_right hf, s.mem_chartRing_exchangeCoordinate_iff k hk hS hf,
    SkewExchange.coeff_expand hE.x_leftFree hg]

/-- **Q1, the coefficient criterion with central factors.** An element `f` of the chart ring of
`s` lies in the chart ring of `μ_k(s)` iff, expanding `f = ∑ c_m X_k ^ m` with left coefficients in
the ring `C` of the other coordinates, `c_{-r} ∈ C P_{k,r}` for every `r > 0`. -/
theorem mem_mutate_chartRing_iff [Fintype K] [DecidableEq K] (k : K) {f : D}
    (hf : f ∈ s.chartRing) :
    f ∈ (s.mutate k).chartRing ↔ ∀ r : ℕ, 0 < r → ∃ c ∈ s.otherRing (row k),
      SkewExchange.coeff (s.otherRing (row k)) (s.coordinate (row k) : D) f (-(r : ℤ)) =
        c * s.centralProduct k r := by
  rw [s.chartRing_eq_regroup (row k)] at hf
  rw [(s.mutate k).chartRing_eq_regroup (row k), mutate_otherRing, mutate_coordinate_row]
  exact s.mem_chartRing_exchangeCoordinate_iff k (S := {l | l ≠ row k}) (by simp)
    (s.exchange_eq_zero_of_not_mem_ne k) hf

end

end TauCeti.Cluster.QuantumSeed
