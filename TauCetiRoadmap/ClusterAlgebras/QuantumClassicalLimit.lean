/-!
# The classical limit of quantum cluster algebras (L5)

Let `s` be a quantum seed in a `Zv`-division ring `D`, `S` a set of frozen indices, and
`ε : ℤ[ℤ ^ M] → F` a ring map to a field sending `x^{e_a}` to `x_a`. Since `A_{v,S} ⊆ T_s`, every
element of the quantum cluster algebra `A_{v,S}` has an expansion in the initial chart; applying
`sp` and then `ε` gives a ring map `A_{v,S} → F`. When the `x_a` are algebraically independent
over `ℚ`, it sends each reachable quantum variable to the classical geometric variable with the
same word and label, and its image is the classical geometric cluster algebra with the same
extended matrix and inverted frozen set `S`. It vanishes on `(v - 1) A_{v,S}`, so it factors
through `A_{v,S} / (v - 1) A_{v,S}`; injectivity of the induced map is not claimed.

On §1.4's carriers: for a geometric seed `g` (`GeometricSeed`) with the extended matrix of `s` and
values `ε(x^{e_a})`, `geometricClusterRing` is `A_{R_S}` of `g` (`GeometricSeed.clusterAlgebra`
over the image of `R_S = ℤ[z_j][z_s⁻¹ : s ∈ S]`), so the image of `A_{v,S}` is `A_{R_S}`
(`ExchangeFrame.range_classicalLimit_eq_clusterAlgebra`) and it generates `A_{𝕜_S}` over a field
`𝕜` (`ExchangeFrame.coe_adjoin_range_classicalLimit`); the classical limit is a surjection
`A_{v,S} → A_{R_S}` (`ExchangeFrame.classicalLimitToClusterAlgebra`) factoring through
`A_{v,S} / (v - 1) A_{v,S}`. It sends `X_j` to `z_j` and `X_s⁻¹` to `z_s⁻¹`, so it maps the
coefficients of `A_{v,S}` onto `R_S`.
-/

@[expose] public section

namespace TauCeti.Cluster

open TauCeti TauCeti.QuantumTorus TauCeti.Laurent

noncomputable section

/-! ### Classical geometric cluster algebras -/

section GeometricClusterRing

variable {M K F : Type*} [Fintype M] [DecidableEq M] [DecidableEq K] [Field F] (row : K ↪ M)

/-- The classical geometric cluster algebra with initial extended matrix `B_ext`, initial values `x`
and inverted frozen indices `S`: the subring of `F` generated by the coordinates after all words
(the mutable ones and the unchanged frozen ones) and the inverses `x_j⁻¹`, `j ∈ S`. -/
def geometricClusterRing (B : Matrix M K ℤ) (x : M → F) (S : Set M) : Subring F :=
  clusterRing (Subring.closure ((fun j ↦ (x j)⁻¹) '' S)) Prod.snd (geometricExchange row) (B, x)

variable {row} {B : Matrix M K ℤ} {x : M → F} {S : Set M}

theorem geometricPattern_snd_mem_geometricClusterRing (w : List K) (j : M) :
    (geometricPattern row B x w).2 j ∈ geometricClusterRing row B x S :=
  Subring.subset_closure (Or.inr ⟨w, j, rfl⟩)

theorem inv_mem_geometricClusterRing {j : M} (hj : j ∈ S) :
    (x j)⁻¹ ∈ geometricClusterRing row B x S :=
  Subring.subset_closure (Or.inl (Subring.subset_closure ⟨j, hj, rfl⟩))

theorem geometricClusterRing_le {T : Subring F}
    (h₁ : ∀ w j, (geometricPattern row B x w).2 j ∈ T) (h₂ : ∀ j ∈ S, (x j)⁻¹ ∈ T) :
    geometricClusterRing row B x S ≤ T := by
  refine Subring.closure_le.2 (Set.union_subset (Subring.closure_le.2 ?_) ?_)
  · rintro _ ⟨j, hj, rfl⟩
    exact h₂ j hj
  · rintro _ ⟨w, j, rfl⟩
    exact h₁ w j

end GeometricClusterRing

/-! ### The ideal `(v - 1) A` -/

section VSubOne

variable (A : Type*) [Ring A] [Algebra Zv A]

/-- The two-sided ideal `(v - 1) A` of a `Zv`-algebra `A`. -/
def vSubOneIdeal : Ideal A :=
  Ideal.span {algebraMap Zv A ((vUnit : Zv) - 1)}

instance : (vSubOneIdeal A).IsTwoSided :=
  ⟨fun b ha ↦ by
    obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.1 ha
    refine Ideal.mem_span_singleton'.2 ⟨r * b, ?_⟩
    rw [mul_assoc, mul_assoc, Algebra.commutes]⟩

end VSubOne

/-! ### The classical limit on `A_{v,S}` -/

section Limit

variable {D : Type*} [DivisionRing D] [Algebra Zv D]
  {M K : Type*} [Fintype M] [DecidableEq M] [Fintype K] [DecidableEq K]
  {row : K ↪ M} {F : Type*} [Field F]

namespace ExchangeFrame

variable (s : ExchangeFrame (u₀ := vUnit) D row) {S : Set M}
  (hS : S ⊆ (Set.range row)ᶜ) (ε : AddMonoidAlgebra ℤ (M → ℤ) →+* F)

/-- **The classical limit on `A_{v,S}`**: expansion in the chart of `s`, then `sp`, then `ε`. -/
def classicalLimit : s.clusterAlgebra S →+* F :=
  (ε.comp (sp _)).comp
    (s.expansion.toAlgHom.toRingHom.comp
      (Subalgebra.inclusion (s.clusterAlgebra_le_chartAlgebra hS)).toRingHom)

variable {s hS ε}

theorem classicalLimit_apply (y : s.clusterAlgebra S) :
    s.classicalLimit hS ε y =
      ε (sp _ (s.expansion (Subalgebra.inclusion (s.clusterAlgebra_le_chartAlgebra hS) y))) :=
  rfl

/-- The classical limit of `y` is `z` whenever `y` is the image of a quantum Laurent polynomial
whose classical limit evaluates to `z`. -/
theorem classicalLimit_eq_of_chartSpecializes {y : s.clusterAlgebra S} {z : F}
    (h : ChartSpecializes s.chart ε (y : D) z) : s.classicalLimit hS ε y = z := by
  obtain ⟨f, hf, rfl⟩ := h
  rw [classicalLimit_apply, s.expansion_eq_iff.2 hf]

theorem classicalLimit_algebraMap (c : Zv) :
    s.classicalLimit hS ε (algebraMap Zv (s.clusterAlgebra S) c) = (evalOne c : F) :=
  classicalLimit_eq_of_chartSpecializes (ChartSpecializes.algebraMap c)

/-- The classical limit vanishes on `(v - 1) A_{v,S}`. -/
theorem classicalLimit_eq_zero_of_mem {y : s.clusterAlgebra S}
    (hy : y ∈ vSubOneIdeal (s.clusterAlgebra S)) : s.classicalLimit hS ε y = 0 := by
  obtain ⟨r, rfl⟩ := Ideal.mem_span_singleton'.1 hy
  rw [map_mul, classicalLimit_algebraMap, map_sub, evalOne_vUnit, map_one]
  simp

variable (s hS ε) in
/-- The induced map `A_{v,S} / (v - 1) A_{v,S} → F`. Its injectivity is not claimed. -/
def classicalLimitQuotient : s.clusterAlgebra S ⧸ vSubOneIdeal (s.clusterAlgebra S) →+* F :=
  Ideal.Quotient.lift _ (s.classicalLimit hS ε) fun _ ↦ classicalLimit_eq_zero_of_mem

@[simp] theorem classicalLimitQuotient_mk (y : s.clusterAlgebra S) :
    s.classicalLimitQuotient hS ε (Ideal.Quotient.mk _ y) = s.classicalLimit hS ε y :=
  rfl

variable {x : M → F} (hε : ∀ a, ε (AddMonoidAlgebra.single (Pi.single a 1) 1) = x a)
include hε

/-- The classical limit of an initial coordinate `X_j` is `x_j`. -/
theorem classicalLimit_coordinate (j : M) :
    s.classicalLimit hS ε
      ⟨s.coordinate j, (Reachable.refl s).coordinate_mem_clusterAlgebra S j⟩ = x j :=
  classicalLimit_eq_of_chartSpecializes
    ⟨QuantumTorus.monomial (Pi.single j 1), s.monomial_single j, by rw [sp_monomial, hε]⟩

/-- The classical limit of `X_j⁻¹`, `j ∈ S`, is `x_j⁻¹`. -/
theorem classicalLimit_inv_coordinate {j : M} (hj : j ∈ S) :
    s.classicalLimit hS ε ⟨(s.coordinate j : D)⁻¹, s.inv_coordinate_mem_clusterAlgebra hj⟩ =
      (x j)⁻¹ := by
  have h₁ : (⟨(s.coordinate j : D)⁻¹, s.inv_coordinate_mem_clusterAlgebra hj⟩ :
      s.clusterAlgebra S) *
      ⟨s.coordinate j, (Reachable.refl s).coordinate_mem_clusterAlgebra S j⟩ = 1 :=
    Subtype.ext (inv_mul_cancel₀ (Units.ne_zero _))
  have h₂ := congrArg (s.classicalLimit hS ε) h₁
  rw [map_mul, map_one, classicalLimit_coordinate hε] at h₂
  exact eq_inv_of_mul_eq_one_left h₂

variable [Algebra ℚ F] (hx : AlgebraicIndependent ℚ x)
include hx

/-- **L5 on `A_{v,S}`.** The classical limit sends the quantum variable `X_{j;w}` to the classical
geometric variable `x_{j;w}` with the same word and label. -/
theorem classicalLimit_coordinate_mutateWord (w : List K) (j : M) :
    s.classicalLimit hS ε
      ⟨(mutateWord (fun k t ↦ ExchangeFrame.mutate t k) w s).coordinate j,
        (reachable_mutateWord s w).coordinate_mem_clusterAlgebra S j⟩ =
      (geometricPattern row s.exchange.matrix x w).2 j :=
  classicalLimit_eq_of_chartSpecializes
    (mutateWord_chartSpecializes_of_algebraicIndependent ε hε hx w j)

/-- **The image of `A_{v,S}`** under the classical limit is the classical geometric cluster
algebra with the same extended matrix and inverted frozen set. -/
theorem range_classicalLimit :
    (s.classicalLimit hS ε).range = geometricClusterRing row s.exchange.matrix x S := by
  refine le_antisymm ?_ (geometricClusterRing_le
    (fun w j ↦ ⟨_, classicalLimit_coordinate_mutateWord hε hx w j⟩)
    (fun j hj ↦ ⟨_, classicalLimit_inv_coordinate hε hj⟩))
  rintro _ ⟨⟨y, hy⟩, rfl⟩
  refine Algebra.adjoin_induction (s := s.clusterGenerators S)
    (p := fun y hy ↦ s.classicalLimit hS ε ⟨y, hy⟩ ∈ geometricClusterRing row s.exchange.matrix x S)
    ?_ ?_ ?_ ?_ hy
  · rintro y ((⟨t, ⟨w, rfl⟩, k, rfl⟩ | ⟨j, hj, rfl⟩) | ⟨j, hj, rfl⟩)
    · rw [classicalLimit_coordinate_mutateWord hε hx w (row k)]
      exact geometricPattern_snd_mem_geometricClusterRing w _
    · rw [classicalLimit_coordinate hε j]
      exact geometricPattern_snd_mem_geometricClusterRing [] j
    · rw [classicalLimit_inv_coordinate hε hj]
      exact inv_mem_geometricClusterRing hj
  · intro c
    rw [classicalLimit_eq_of_chartSpecializes (ChartSpecializes.algebraMap c)]
    exact intCast_mem _ _
  · intro y z hy hz ihy ihz
    have h := add_mem ihy ihz
    rwa [← map_add] at h
  · intro y z hy hz ihy ihz
    have h := mul_mem ihy ihz
    rwa [← map_mul] at h

variable (s hS ε) in
/-- The classical limit as a surjection of `A_{v,S}` onto the classical geometric cluster
algebra. -/
def classicalLimitOnto : s.clusterAlgebra S →+* geometricClusterRing row s.exchange.matrix x S :=
  (s.classicalLimit hS ε).codRestrict _ fun y ↦
    range_classicalLimit (s := s) (hS := hS) hε hx ▸ ⟨y, rfl⟩

theorem classicalLimitOnto_surjective :
    Function.Surjective (s.classicalLimitOnto hS ε hε hx) := by
  rintro ⟨z, hz⟩
  rw [← range_classicalLimit (s := s) (hS := hS) hε hx] at hz
  obtain ⟨y, rfl⟩ := hz
  exact ⟨y, rfl⟩

/-- The induced map `A_{v,S} / (v - 1) A_{v,S} → F` has the same image. -/
theorem range_classicalLimitQuotient :
    (s.classicalLimitQuotient hS ε).range = geometricClusterRing row s.exchange.matrix x S := by
  rw [← range_classicalLimit (s := s) (hS := hS) hε hx]
  ext z
  constructor
  · rintro ⟨q, rfl⟩
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective q
    exact ⟨y, rfl⟩
  · rintro ⟨y, rfl⟩
    exact ⟨Ideal.Quotient.mk _ y, rfl⟩

end ExchangeFrame

end Limit

/-! ### The image on §1.4's carriers -/

section GeometricSeed

variable {M K F : Type*} [Fintype M] [DecidableEq M] [Fintype K] [DecidableEq K] [Field F]
  [Algebra ℚ F] {row : K ↪ M} {d : K → ℤ} (hd : ∀ k, 0 < d k)

omit [Fintype K] in
/-- **Bridge to §1.4.** For a set `S` of frozen indices, the classical geometric cluster ring of
the extended matrix and values of a geometric seed is its geometric cluster algebra `A_{R_S}`. -/
theorem geometricClusterRing_eq_clusterAlgebra [Finite K] (g : GeometricSeed (F := F) row d) {S
  : Set M}
    (hS : S ⊆ (Set.range row)ᶜ) :
    geometricClusterRing row g.exchange g.coordinate S = (g.clusterAlgebra hd ℤ S).toSubring := by
  let : Fintype K := Fintype.ofFinite K
  apply le_antisymm
  · refine geometricClusterRing_le (fun w j ↦ ?_)
      (fun j hj ↦ g.inv_coordinate_mem_clusterAlgebra hd ℤ hj (hS hj))
    rw [g.geometricPattern_eq hd]
    exact g.coordinate_mutateWord_mem_clusterAlgebra hd ℤ S w j
  · rw [GeometricSeed.toSubring_clusterAlgebra_int]
    refine Subring.closure_le.2 ?_
    rintro _ ((⟨w, k, rfl⟩ | ⟨j, -, rfl⟩) | ⟨j, ⟨hj, -⟩, rfl⟩)
    · have h := geometricPattern_snd_mem_geometricClusterRing (row := row) (B := g.exchange)
        (x := g.coordinate) (S := S) w (row k)
      rwa [g.geometricPattern_eq hd] at h
    · exact geometricPattern_snd_mem_geometricClusterRing [] j
    · exact inv_mem_geometricClusterRing hj

variable {D : Type*} [DivisionRing D] [Algebra Zv D]

namespace ExchangeFrame

variable {s : ExchangeFrame (u₀ := vUnit) D row} {S : Set M} {hS : S ⊆ (Set.range row)ᶜ}
  {ε : AddMonoidAlgebra ℤ (M → ℤ) →+* F} {g : GeometricSeed (F := F) row s.exchange.symmetrizer}
  (hg : g.exchange = s.exchange.matrix)
  (hεg : ∀ a, ε (AddMonoidAlgebra.single (Pi.single a 1) 1) = g.coordinate a)
include hg hεg

/-- **L5 on `A_{v,S}`, with §1.4's carriers.** The classical limit sends `X_{j;w}` to the value
with the same word and label of the geometric seed `g` with the extended matrix of `s`. -/
theorem classicalLimit_coordinate_mutateWord_geometricSeed (w : List K) (j : M) :
    s.classicalLimit hS ε
      ⟨(mutateWord (fun k t ↦ ExchangeFrame.mutate t k) w s).coordinate j,
        (reachable_mutateWord s w).coordinate_mem_clusterAlgebra S j⟩ =
      (mutateWord (fun k t ↦ t.mutate s.exchange.symmetrizer_pos k) w g).coordinate j :=
  classicalLimit_eq_of_chartSpecializes (mutateWord_chartSpecializes_geometricSeed ε hg hεg w j)

/-- **The image of `A_{v,S}` is `A_{R_S}`** of the geometric seed with the same extended matrix
and inverted frozen set `S`. -/
theorem range_classicalLimit_eq_clusterAlgebra :
    (s.classicalLimit hS ε).range =
      (g.clusterAlgebra s.exchange.symmetrizer_pos ℤ S).toSubring := by
  rw [range_classicalLimit (s := s) (hS := hS) hεg g.independent, ← hg,
    geometricClusterRing_eq_clusterAlgebra s.exchange.symmetrizer_pos g hS]

/-- Over any base ring `R`, in particular a field `𝕜`, the image of `A_{v,S}` generates the
geometric cluster algebra `A_{𝕜_S}` over `R`. -/
theorem coe_adjoin_range_classicalLimit (R : Type*) [CommRing R] [Algebra R F] :
    (Algebra.adjoin R ((s.classicalLimit hS ε).range : Set F) : Set F) =
      g.clusterAlgebra s.exchange.symmetrizer_pos R S := by
  rw [← g.coe_adjoin_clusterAlgebra_int s.exchange.symmetrizer_pos R S,
    range_classicalLimit_eq_clusterAlgebra (hS := hS) hg hεg]
  rfl

theorem classicalLimit_mem_clusterAlgebra (y : s.clusterAlgebra S) :
    s.classicalLimit hS ε y ∈ g.clusterAlgebra s.exchange.symmetrizer_pos ℤ S := by
  have h := RingHom.mem_range_self (s.classicalLimit hS ε) y
  rwa [range_classicalLimit_eq_clusterAlgebra (hS := hS) hg hεg] at h

variable (s hS ε) in
/-- **The classical limit `A_{v,S} → A_{R_S}`** onto the geometric cluster algebra of `g`. -/
def classicalLimitToClusterAlgebra :
    s.clusterAlgebra S →+* g.clusterAlgebra s.exchange.symmetrizer_pos ℤ S :=
  (s.classicalLimit hS ε).codRestrict _ (classicalLimit_mem_clusterAlgebra (hS := hS) hg hεg)

@[simp] theorem coe_classicalLimitToClusterAlgebra (y : s.clusterAlgebra S) :
    (s.classicalLimitToClusterAlgebra hS ε hg hεg y : F) = s.classicalLimit hS ε y :=
  rfl

theorem classicalLimitToClusterAlgebra_surjective :
    Function.Surjective (s.classicalLimitToClusterAlgebra hS ε hg hεg) := by
  rintro ⟨z, hz⟩
  rw [← Subalgebra.mem_toSubring,
    ← range_classicalLimit_eq_clusterAlgebra (hS := hS) hg hεg] at hz
  obtain ⟨y, rfl⟩ := hz
  exact ⟨y, rfl⟩

variable (s hS ε) in
/-- The induced surjection `A_{v,S} / (v - 1) A_{v,S} → A_{R_S}`. Its injectivity is not
claimed. -/
def classicalLimitQuotientToClusterAlgebra :
    s.clusterAlgebra S ⧸ vSubOneIdeal (s.clusterAlgebra S) →+*
      g.clusterAlgebra s.exchange.symmetrizer_pos ℤ S :=
  Ideal.Quotient.lift _ (s.classicalLimitToClusterAlgebra hS ε hg hεg) fun _ hy ↦
    Subtype.ext (classicalLimit_eq_zero_of_mem hy)

theorem classicalLimitQuotientToClusterAlgebra_surjective :
    Function.Surjective (s.classicalLimitQuotientToClusterAlgebra hS ε hg hεg) := by
  intro z
  obtain ⟨y, rfl⟩ := classicalLimitToClusterAlgebra_surjective (hS := hS) hg hεg z
  exact ⟨Ideal.Quotient.mk _ y, rfl⟩

end ExchangeFrame

end GeometricSeed

end

end TauCeti.Cluster
