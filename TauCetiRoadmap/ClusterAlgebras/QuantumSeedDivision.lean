module

public import TauCetiRoadmap.ClusterAlgebras.QuantumSeed

/-!
# The division subring of a quantum seed

The division subring of `D` generated by the coefficients `Zv` and the coordinates `X_i` of a
quantum seed is the division subring generated by its integral chart ring, and it is unchanged by
mutation (§1.5): the new coordinates lie in the old chart ring and mutation is involutive.
The coefficients are needed: the exchanged coordinate involves the scalars `v^{Λ(e_k, ·)}` of
the normalized monomials, which need not lie in the division subring generated by the `X_i` alone.
-/

@[expose] public section

namespace TauCeti.Cluster.QuantumSeed

open TauCeti TauCeti.Laurent

variable {D : Type*} [DivisionRing D] [Algebra Zv D] {M K : Type*} [Fintype M] [DecidableEq M]
  {row : K ↪ M} (s : QuantumSeed D row)

/-- The division subring of `D` generated by `Zv` and the coordinates `X_i` of `s`. -/
def subfield : Subfield D :=
  Subfield.closure (Set.range (algebraMap Zv D) ∪ Set.range fun i ↦ (s.coordinate i : D))

theorem algebraMap_mem_subfield (r : Zv) : algebraMap Zv D r ∈ s.subfield :=
  Subfield.subset_closure (Or.inl ⟨r, rfl⟩)

theorem coordinate_mem_subfield (i : M) : (s.coordinate i : D) ∈ s.subfield :=
  Subfield.subset_closure (Or.inr ⟨i, rfl⟩)

theorem chartRing_le_subfield : s.chartRing ≤ s.subfield.toSubring :=
  chartRing_le (by rintro _ ⟨r, rfl⟩; exact s.algebraMap_mem_subfield r)
    s.coordinate_mem_subfield fun i ↦ s.subfield.inv_mem (s.coordinate_mem_subfield i)

theorem monomial_mem_subfield (a : M → ℤ) : s.monomial a ∈ s.subfield :=
  s.chartRing_le_subfield (s.monomial_mem_chartRing a)

/-- The division subring of `s` is generated by its integral chart ring. -/
theorem subfield_eq_closure_chartRing : s.subfield = Subfield.closure (s.chartRing : Set D) := by
  refine le_antisymm (Subfield.closure_le.2 (Set.union_subset ?_ ?_))
    (Subfield.closure_le.2 s.chartRing_le_subfield)
  · rintro _ ⟨r, rfl⟩
    exact Subfield.subset_closure (coefficient_mem_chartRing _ _ ⟨r, rfl⟩)
  · rintro _ ⟨i, rfl⟩
    exact Subfield.subset_closure (coordinate_mem_chartRing _ _ i)

variable [Fintype K] [DecidableEq K]

theorem mutate_subfield_le (k : K) : (s.mutate k).subfield ≤ s.subfield := by
  refine Subfield.closure_le.2 (Set.union_subset ?_ ?_)
  · rintro _ ⟨r, rfl⟩
    exact s.algebraMap_mem_subfield r
  · rintro _ ⟨j, rfl⟩
    exact s.chartRing_le_subfield (s.mutate_coordinate_mem_chartRing k j)

/-- **Mutation preserves the division subring** generated by `Zv` and the coordinates. -/
theorem mutate_subfield (k : K) : (s.mutate k).subfield = s.subfield := by
  refine le_antisymm (s.mutate_subfield_le k) ?_
  have h := (s.mutate k).mutate_subfield_le k
  rwa [mutate_mutate] at h

/-- Every seed reached by a mutation word has the division subring of the initial seed. -/
theorem mutateWord_subfield (w : List K) :
    (mutateWord (fun k t ↦ QuantumSeed.mutate t k) w s).subfield = s.subfield := by
  induction w generalizing s with
  | nil => rfl
  | cons k w ih => rw [mutateWord_cons, ih, mutate_subfield]

end TauCeti.Cluster.QuantumSeed
