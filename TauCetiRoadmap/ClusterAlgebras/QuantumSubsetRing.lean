module

public import TauCetiRoadmap.ClusterAlgebras.QuantumSeed

/-!
# Coordinate subrings of faithful quantum charts

Support, normalizers and monomial units for a chosen set of coordinates.
-/

@[expose] public section

namespace TauCeti.Cluster.QuantumSeed

open TauCeti TauCeti.QuantumTorus TauCeti.Laurent

noncomputable section

variable {D : Type*} [DivisionRing D] [Algebra Zv D] {M K : Type*} [Fintype M] [DecidableEq M]
  {row : K ↪ M} (s : QuantumSeed D row)

/-! ### The ring of a set of coordinates -/

/-- The integral chart ring of the coordinates in `S`: the subring generated by `Z_v` and
`X_l^{±1}` for `l ∈ S`. -/
def subsetRing (S : Set M) : Subring D :=
  Laurent.chartRing (algebraMap Zv D).range (fun l : S ↦ (s.coordinate l : D))

theorem otherRing_eq_subsetRing (i : M) : s.otherRing i = s.subsetRing {l | l ≠ i} := rfl
theorem algebraMap_mem_subsetRing (S : Set M) (r : Zv) : algebraMap Zv D r ∈ s.subsetRing S :=
  coefficient_mem_chartRing _ _ ⟨r, rfl⟩

/-- A normalized monomial whose exponent vanishes off `S` lies in the ring of `S`. -/
theorem monomial_mem_subsetRing {S : Set M} {a : M → ℤ} (ha : ∀ l ∉ S, a l = 0) :
    s.monomial a ∈ s.subsetRing S := by
  have hl : ∀ l : List M, ((orderedProd s.coordinate l a : Dˣ) : D) ∈ s.subsetRing S := by
    intro l
    induction l with
    | nil => exact Subring.one_mem _
    | cons c l ih =>
      rw [orderedProd_cons, Units.val_mul]
      refine Subring.mul_mem _ ?_ ih
      by_cases hc : c ∈ S
      · rw [Units.val_zpow_eq_zpow_val]
        exact coordinate_zpow_mem_chartRing _ (fun j : S ↦ (s.coordinate j : D)) ⟨c, hc⟩ (a c)
      · rw [ha c hc, zpow_zero, Units.val_one]
        exact Subring.one_mem _
  rw [monomial, chart, lift_monomial, normalizedProd, Algebra.smul_def]
  exact Subring.mul_mem _ (s.algebraMap_mem_subsetRing S _) (hl _)

theorem subsetRing_le_otherRing {S : Set M} {i : M} (hi : i ∉ S) :
    s.subsetRing S ≤ s.otherRing i := by
  refine chartRing_le ?_ (fun l ↦ ?_) (fun l ↦ ?_)
  · rintro _ ⟨r, rfl⟩
    exact s.algebraMap_mem_otherRing i r
  · exact coordinate_mem_chartRing _ (fun j : {j // j ≠ i} ↦ (s.coordinate j : D))
      ⟨l, fun h ↦ hi (h ▸ l.2)⟩
  · exact inverse_mem_chartRing _ (fun j : {j // j ≠ i} ↦ (s.coordinate j : D))
      ⟨l, fun h ↦ hi (h ▸ l.2)⟩

/-- An element commuting with every `X_l`, `l ∈ S`, up to scalar units normalizes the ring of
`S`. -/
theorem normalizes_subsetRing {S : Set M} {z : D} (hz : z ≠ 0) (w : M → Zvˣ)
    (hw : ∀ l ∈ S, z * s.coordinate l = algebraMap Zv D (w l : Zv) * (s.coordinate l * z)) :
    Normalizes (s.subsetRing S) z := by
  have h := normalizes_closure (R := Zv) (C := (algebraMap Zv D).range)
    (T := Set.range (fun l : S ↦ (s.coordinate l : D)) ∪
      Set.range (fun l : S ↦ (s.coordinate l : D)⁻¹))
    (normalizes_algebraMap_range hz) (fun r ↦ ⟨r, rfl⟩) ?_
  · rwa [← Set.union_assoc] at h
  rintro g (⟨l, rfl⟩ | ⟨l, rfl⟩)
  · exact ⟨w l, hw l l.2⟩
  · refine ⟨(w l)⁻¹, ?_⟩
    have hX : (s.coordinate l : D) ≠ 0 := Units.ne_zero _
    have h1 : (s.coordinate l : D)⁻¹ * z =
        algebraMap Zv D (w l : Zv) * (z * (s.coordinate l : D)⁻¹) := by
      calc (s.coordinate l : D)⁻¹ * z =
            (s.coordinate l : D)⁻¹ * (z * s.coordinate l) * (s.coordinate l : D)⁻¹ := by
            simp only [mul_assoc, mul_inv_cancel₀ hX, mul_one]
        _ = (s.coordinate l : D)⁻¹ * (algebraMap Zv D (w l : Zv) * (s.coordinate l * z)) *
            (s.coordinate l : D)⁻¹ := by rw [hw l l.2]
        _ = algebraMap Zv D (w l : Zv) * (z * (s.coordinate l : D)⁻¹) := by
            rw [Algebra.left_comm]
            simp only [mul_assoc, inv_mul_cancel_left₀ hX]
    rw [h1, ← mul_assoc, ← map_mul, ← Units.val_mul, inv_mul_cancel, Units.val_one, map_one,
      one_mul]

/-- Every coordinate normalizes the ring of `S`. -/
theorem coordinate_normalizes_subsetRing (S : Set M) (c : M) :
    Normalizes (s.subsetRing S) (s.coordinate c : D) :=
  s.normalizes_subsetRing (Units.ne_zero _)
    (fun j ↦ vUnit ^ (2 * matrixForm s.form (Pi.single c 1) (Pi.single j 1)))
    (fun j _ ↦ by rw [s.quasiCommuting c j, Algebra.smul_def])

/-- The column `b_{•k}` vanishes off `{l | l ≠ row k}`. -/
theorem exchange_eq_zero_of_not_mem_ne (k : K) :
    ∀ l ∉ {l | l ≠ row k}, s.exchange.matrix l k = 0 := fun l hl ↦ by
  rw [Set.mem_ofPred_eq, not_not] at hl
  rw [hl]
  exact s.exchange.diagonal k

variable {S : Set M}

theorem monomial_pow_mul_coordinate_pow (k : K) (r : ℕ) :
    s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r * (s.coordinate (row k) : D) ^ r =
      algebraMap Zv D ((vUnit ^ matrixForm s.form
          ((r : ℤ) • exchangeExponentNeg row s.exchange.matrix k)
          ((r : ℤ) • Pi.single (row k) 1) : Zvˣ) : Zv) *
        s.monomial ((r : ℤ) • fun l ↦ positivePart (-s.exchange.matrix l k)) := by
  have hpow : s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r =
      s.monomial ((r : ℤ) • exchangeExponentNeg row s.exchange.matrix k) := by
    rw [monomial, ← map_pow, ← QuantumTorus.monomial_nsmul s.isAlt, natCast_zsmul]
    rfl
  rw [hpow, ← zpow_natCast, ← s.monomial_zsmul_single, monomial_mul_monomial, ← smul_add,
    add_comm (exchangeExponentNeg row s.exchange.matrix k), single_add_exchangeExponentNeg]

/-- The unit `M(-e_k + [-b_{•k}]_+) ^ r X_k ^ r` lies in the ring of `S`. -/
theorem monomial_pow_mul_coordinate_pow_mem (k : K) (hS : ∀ l ∉ S, s.exchange.matrix l k = 0)
    (r : ℕ) :
    s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r * (s.coordinate (row k) : D) ^ r ∈
      s.subsetRing S := by
  rw [monomial_pow_mul_coordinate_pow]
  exact Subring.mul_mem _ (s.algebraMap_mem_subsetRing _ _)
    (s.monomial_mem_subsetRing fun l hl ↦ by simp [hS l hl, positivePart])

/-- The inverse of the unit `M(-e_k + [-b_{•k}]_+) ^ r X_k ^ r` lies in the ring of `S`. -/
theorem inv_monomial_pow_mul_coordinate_pow_mem (k : K) (hS : ∀ l ∉ S, s.exchange.matrix l k = 0)
    (r : ℕ) :
    (s.monomial (exchangeExponentNeg row s.exchange.matrix k) ^ r *
        (s.coordinate (row k) : D) ^ r)⁻¹ ∈ s.subsetRing S := by
  rw [monomial_pow_mul_coordinate_pow, mul_inv_rev, monomial_inv, algebraMap_units_inv]
  exact Subring.mul_mem _
    (s.monomial_mem_subsetRing fun l hl ↦ by simp [hS l hl, positivePart])
    (s.algebraMap_mem_subsetRing _ _)

end

end TauCeti.Cluster.QuantumSeed
