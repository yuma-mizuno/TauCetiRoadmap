public import Mathlib.Algebra.MvPolynomial.Eval

/-!
# Upper bounds and intersections of reachable Laurent charts

The finite upper bound and the upper cluster ring are defined independently of
Laurentness. This file proves the consequences of upper-bound invariance. The
local algebra establishing invariance is a separate obligation, not a field of
the seed data. No Caterpillar theorem is imported. Only the polynomial exchange
law needs a field; the lattice arguments work in any division ring.

The abstract statements (Q3) are for an involutive pattern of subrings: any family
`T : V → Subring F` of a ring along involutions, with generators `g`. Every hypothesis is
required only at the states reached from a fixed `s` by a finite word. The statements for Laurent
charts `chartRing C (x t)` are corollaries.
-/

@[expose] public section

namespace TauCeti.Cluster
open TauCeti.Laurent

variable {F I J V : Type*}

section Ring

variable [Ring F]

/-- The ring generated by coefficients and all reachable mutable coordinates. -/
def clusterRing (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (s : V) : Subring F :=
  Subring.closure ((C : Set F) ∪ {a | ∃ w : List I, ∃ i, a = x (mutateWord mutation w s) i})

theorem mutateWord_append_singleton (mutation : I → V → V) (w : List I) (i : I) (s : V) :
    mutateWord mutation (w ++ [i]) s = mutation i (mutateWord mutation w s) := by
  rw [mutateWord_append]
  rfl

/-! ### Involutive patterns of subrings -/

/-- The finite upper bound `UB(s) = T_s ⊓ ⨅ i, T_{μ_i s}` of a family of subrings. -/
def patternUpperBound (T : V → Subring F) (mutation : I → V → V) (s : V) : Subring F :=
  T s ⊓ ⨅ i, T (mutation i s)

/-- The intersection of the rings `T_t` over the states `t` reached from `s` by a finite word. -/
def patternUpperRing (T : V → Subring F) (mutation : I → V → V) (s : V) : Subring F :=
  ⨅ w : List I, T (mutateWord mutation w s)

section Pattern

variable (T : V → Subring F) (mutation : I → V → V)

@[simp] theorem mem_patternUpperBound {s : V} {a : F} :
    a ∈ patternUpperBound T mutation s ↔ a ∈ T s ∧ ∀ i, a ∈ T (mutation i s) := by
  simp [patternUpperBound]

@[simp] theorem mem_patternUpperRing {s : V} {a : F} :
    a ∈ patternUpperRing T mutation s ↔ ∀ w : List I, a ∈ T (mutateWord mutation w s) := by
  simp [patternUpperRing]

theorem patternUpperBound_le (s : V) : patternUpperBound T mutation s ≤ T s := inf_le_left
theorem patternUpperRing_le (s : V) (w : List I) :
    patternUpperRing T mutation s ≤ T (mutateWord mutation w s) := fun _ ha ↦
  (mem_patternUpperRing T mutation).1 ha w

theorem patternUpperRing_le_patternUpperBound (s : V) :
    patternUpperRing T mutation s ≤ patternUpperBound T mutation s := fun _ ha ↦
  (mem_patternUpperBound T mutation).2 ⟨(mem_patternUpperRing T mutation).1 ha [],
    fun i ↦ (mem_patternUpperRing T mutation).1 ha [i]⟩

/-- At a single state `t`, the three-chart equalities for the pairs `(i, j)` with `j ≠ i` give
`UB(t) ≤ UB(μ_i t)`. -/
theorem patternUpperBound_le_mutation (hinv : ∀ i, Function.Involutive (mutation i))
    (t : V) (i : I)
    (hthree : ∀ j, j ≠ i →
      T t ⊓ T (mutation i t) ⊓ T (mutation j t) =
        T (mutation i t) ⊓ T t ⊓ T (mutation j (mutation i t))) :
    patternUpperBound T mutation t ≤ patternUpperBound T mutation (mutation i t) :=
  UpperBoundPattern.upperBound_le_mutation T mutation hinv t i
    (fun j hji ↦ (hthree j hji).le.trans inf_le_right)

/-- **Q3, local invariance.** If the three-chart equalities
`T_t ⊓ T_{μ_i t} ⊓ T_{μ_j t} = T_{μ_i t} ⊓ T_t ⊓ T_{μ_j μ_i t}` hold at every state `t` reached
from `s` and all `j ≠ i`, then `UB(μ_i t) = UB(t)` at every such `t`. -/
theorem patternUpperBound_mutation_of_three_chart
    (hinv : ∀ i, Function.Involutive (mutation i)) (s : V)
    (hthree : ∀ (w : List I) (i j : I), j ≠ i →
      T (mutateWord mutation w s) ⊓ T (mutation i (mutateWord mutation w s)) ⊓
          T (mutation j (mutateWord mutation w s)) =
        T (mutation i (mutateWord mutation w s)) ⊓ T (mutateWord mutation w s) ⊓
          T (mutation j (mutation i (mutateWord mutation w s))))
    (w : List I) (i : I) :
    patternUpperBound T mutation (mutation i (mutateWord mutation w s)) =
      patternUpperBound T mutation (mutateWord mutation w s) := by
  apply le_antisymm _ (patternUpperBound_le_mutation T mutation hinv _ i (hthree w i))
  have h := patternUpperBound_le_mutation T mutation hinv _ i (by
    simpa only [mutateWord_append_singleton] using hthree (w ++ [i]) i)
  rwa [hinv i (mutateWord mutation w s)] at h

/-- Invariance under each mutation at every state reached from `s` makes the upper bound
constant on those states. -/
theorem patternUpperBound_mutateWord (s : V)
    (hmut : ∀ (w : List I) (i : I),
      patternUpperBound T mutation (mutation i (mutateWord mutation w s)) =
        patternUpperBound T mutation (mutateWord mutation w s))
    (w : List I) :
    patternUpperBound T mutation (mutateWord mutation w s) = patternUpperBound T mutation s := by
  induction w using List.reverseRecOn with
  | nil => rfl
  | append_singleton w i ih => rw [mutateWord_append_singleton, hmut w i, ih]

/-- **Q3, invariance.** The three-chart equalities at the states reached from `s` make `UB`
constant on those states. -/
theorem patternUpperBound_mutateWord_of_three_chart
    (hinv : ∀ i, Function.Involutive (mutation i)) (s : V)
    (hthree : ∀ (w : List I) (i j : I), j ≠ i →
      T (mutateWord mutation w s) ⊓ T (mutation i (mutateWord mutation w s)) ⊓
          T (mutation j (mutateWord mutation w s)) =
        T (mutation i (mutateWord mutation w s)) ⊓ T (mutateWord mutation w s) ⊓
          T (mutation j (mutation i (mutateWord mutation w s))))
    (w : List I) :
    patternUpperBound T mutation (mutateWord mutation w s) = patternUpperBound T mutation s :=
  patternUpperBound_mutateWord T mutation s
    (patternUpperBound_mutation_of_three_chart T mutation hinv s hthree) w

/-- Invariance turns the intersection over all reachable states into the finite upper bound. -/
theorem patternUpperRing_eq_patternUpperBound (s : V)
    (hmut : ∀ (w : List I) (i : I),
      patternUpperBound T mutation (mutation i (mutateWord mutation w s)) =
        patternUpperBound T mutation (mutateWord mutation w s)) :
    patternUpperRing T mutation s = patternUpperBound T mutation s := by
  refine le_antisymm (patternUpperRing_le_patternUpperBound T mutation s) fun a ha ↦ ?_
  refine (mem_patternUpperRing T mutation).2 fun w ↦ patternUpperBound_le T mutation _ ?_
  rwa [patternUpperBound_mutateWord T mutation s hmut w]

/-- A generator of a state reached from `s` lies in the upper bound of that state, when the
generators of each such state lie in its ring and those of its neighbours lie in it too. -/
theorem generator_mem_patternUpperBound (g : V → J → F)
    (hinv : ∀ i, Function.Involutive (mutation i)) (s : V)
    (hg : ∀ (w : List I) (j : J), g (mutateWord mutation w s) j ∈ T (mutateWord mutation w s))
    (hone : ∀ (w : List I) (i : I) (j : J),
      g (mutation i (mutateWord mutation w s)) j ∈ T (mutateWord mutation w s))
    (w : List I) (j : J) :
    g (mutateWord mutation w s) j ∈ patternUpperBound T mutation (mutateWord mutation w s) := by
  refine (mem_patternUpperBound T mutation).2 ⟨hg w j, fun i ↦ ?_⟩
  have h := hone (w ++ [i]) i j
  rwa [mutateWord_append_singleton, hinv i (mutateWord mutation w s)] at h

/-- **Q3, Laurentness.** With `UB` invariant at the states reached from `s`, every generator of
every such state lies in the ring of every such state. -/
theorem generator_mem_of_patternUpperBound (g : V → J → F)
    (hinv : ∀ i, Function.Involutive (mutation i)) (s : V)
    (hg : ∀ (w : List I) (j : J), g (mutateWord mutation w s) j ∈ T (mutateWord mutation w s))
    (hone : ∀ (w : List I) (i : I) (j : J),
      g (mutation i (mutateWord mutation w s)) j ∈ T (mutateWord mutation w s))
    (hmut : ∀ (w : List I) (i : I),
      patternUpperBound T mutation (mutation i (mutateWord mutation w s)) =
        patternUpperBound T mutation (mutateWord mutation w s))
    (u w : List I) (j : J) :
    g (mutateWord mutation w s) j ∈ T (mutateWord mutation u s) := by
  have h := generator_mem_patternUpperBound T mutation g hinv s hg hone w j
  rw [patternUpperBound_mutateWord T mutation s hmut w,
    ← patternUpperBound_mutateWord T mutation s hmut u] at h
  exact patternUpperBound_le T mutation _ h

/-- The ring generated by `C` and all reachable generators lies in `⋂_t T_t`. -/
theorem clusterRing_le_patternUpperRing (C : Subring F) (g : V → J → F)
    (hinv : ∀ i, Function.Involutive (mutation i)) (s : V)
    (hC : C ≤ patternUpperBound T mutation s)
    (hg : ∀ (w : List I) (j : J), g (mutateWord mutation w s) j ∈ T (mutateWord mutation w s))
    (hone : ∀ (w : List I) (i : I) (j : J),
      g (mutation i (mutateWord mutation w s)) j ∈ T (mutateWord mutation w s))
    (hmut : ∀ (w : List I) (i : I),
      patternUpperBound T mutation (mutation i (mutateWord mutation w s)) =
        patternUpperBound T mutation (mutateWord mutation w s)) :
    clusterRing C g mutation s ≤ patternUpperRing T mutation s := by
  rw [patternUpperRing_eq_patternUpperBound T mutation s hmut]
  refine Subring.closure_le.2 ?_
  rintro a (ha | ⟨w, j, rfl⟩)
  · exact hC ha
  · have h := generator_mem_patternUpperBound T mutation g hinv s hg hone w j
    rwa [patternUpperBound_mutateWord T mutation s hmut w] at h

end Pattern

end Ring

section DivisionRing

variable [DivisionRing F]

/-- The initial Laurent chart and its one-step neighbors. -/
def upperBound (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (s : V) : Subring F :=
  chartRing C (x s) ⊓ ⨅ i, chartRing C (x (mutation i s))

/-- The intersection over all finite mutation words, including the empty word. -/
def upperClusterRing (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (s : V) : Subring F :=
  ⨅ w : List I, chartRing C (x (mutateWord mutation w s))

theorem upperBound_eq_patternUpperBound (C : Subring F) (x : V → J → F)
    (mutation : I → V → V) (s : V) :
    upperBound C x mutation s = patternUpperBound (fun t ↦ chartRing C (x t)) mutation s := rfl

theorem upperClusterRing_eq_patternUpperRing (C : Subring F) (x : V → J → F)
    (mutation : I → V → V) (s : V) :
    upperClusterRing C x mutation s = patternUpperRing (fun t ↦ chartRing C (x t)) mutation s :=
  rfl

@[simp] theorem mem_upperBound {C : Subring F} {x : V → J → F}
    {mutation : I → V → V} {s : V} {a : F} :
    a ∈ upperBound C x mutation s ↔
      a ∈ chartRing C (x s) ∧ ∀ i, a ∈ chartRing C (x (mutation i s)) := by
  simp [upperBound]

@[simp] theorem mem_upperClusterRing {C : Subring F} {x : V → J → F}
    {mutation : I → V → V} {s : V} {a : F} :
    a ∈ upperClusterRing C x mutation s ↔
      ∀ w : List I, a ∈ chartRing C (x (mutateWord mutation w s)) := by
  simp [upperClusterRing]

theorem upperBound_le_chart (C : Subring F) (x : V → J → F)
    (mutation : I → V → V) (s : V) :
    upperBound C x mutation s ≤ chartRing C (x s) := inf_le_left

theorem coefficient_le_upperBound (C : Subring F) (x : V → J → F)
    (mutation : I → V → V) (s : V) : C ≤ upperBound C x mutation s := by
  intro a ha
  exact mem_upperBound.mpr ⟨coefficient_mem_chartRing _ _ ha,
    fun _ => coefficient_mem_chartRing _ _ ha⟩

theorem upperClusterRing_le_upperBound (C : Subring F) (x : V → J → F)
    (mutation : I → V → V) (s : V) :
    upperClusterRing C x mutation s ≤ upperBound C x mutation s := by
  intro a ha
  have h := mem_upperClusterRing.mp ha
  exact mem_upperBound.mpr ⟨h [], fun i => h [i]⟩

/-- An initial variable lies in every adjacent chart by the reverse exchange. -/
theorem coordinate_mem_upperBound
    (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (hinv : ∀ i, Function.Involutive (mutation i))
    (hone : ∀ s i j, x (mutation i s) j ∈ chartRing C (x s))
    (s : V) (j : J) : x s j ∈ upperBound C x mutation s := by
  apply mem_upperBound.mpr
  refine ⟨coordinate_mem_chartRing C (x s) j, fun i => ?_⟩
  simpa only [hinv i s] using hone (mutation i s) i j

/-- Local three-chart equalities imply upper-bound invariance. Rank zero and
rank one need no special auxiliary variables in this formulation. The local
equalities are to be proved by one-exchange intersections and rank-two algebra.
`patternUpperBound_mutation_of_three_chart` needs them only at reachable states. -/
theorem upperBound_mutation_of_three_chart
    (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (hinv : ∀ i, Function.Involutive (mutation i))
    (hthree : ∀ s i j, j ≠ i →
      chartRing C (x s) ⊓ chartRing C (x (mutation i s)) ⊓ chartRing C (x (mutation j s)) =
      chartRing C (x (mutation i s)) ⊓ chartRing C (x s) ⊓
        chartRing C (x (mutation j (mutation i s))))
    (s : V) (i : I) : upperBound C x mutation (mutation i s) = upperBound C x mutation s :=
  patternUpperBound_mutation_of_three_chart (fun t ↦ chartRing C (x t)) mutation hinv s
    (fun _ i j hji ↦ hthree _ i j hji) [] i

/-- Propagation of a proved local upper-bound equality along an arbitrary word. -/
theorem upperBound_mutateWord
    (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (hmutation : ∀ s i, upperBound C x mutation (mutation i s) = upperBound C x mutation s)
    (w : List I) (s : V) :
    upperBound C x mutation (mutateWord mutation w s) = upperBound C x mutation s :=
  patternUpperBound_mutateWord (fun t ↦ chartRing C (x t)) mutation s
    (fun _ i ↦ hmutation _ i) w

/-- Mutation invariance turns the infinite intersection into the finite upper bound. -/
theorem upperClusterRing_eq_upperBound
    (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (hmutation : ∀ s i, upperBound C x mutation (mutation i s) = upperBound C x mutation s)
    (s : V) : upperClusterRing C x mutation s = upperBound C x mutation s :=
  patternUpperRing_eq_patternUpperBound (fun t ↦ chartRing C (x t)) mutation s
    (fun _ i ↦ hmutation _ i)

/-- Laurentness from upper-bound invariance; no path-shortening argument occurs. -/
theorem laurent_of_upperBound_invariant
    (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (hinv : ∀ i, Function.Involutive (mutation i))
    (hone : ∀ s i j, x (mutation i s) j ∈ chartRing C (x s))
    (hmutation : ∀ s i, upperBound C x mutation (mutation i s) = upperBound C x mutation s)
    (s : V) (w : List I) (j : J) : x (mutateWord mutation w s) j ∈ chartRing C (x s) :=
  generator_mem_of_patternUpperBound (fun t ↦ chartRing C (x t)) mutation x hinv s
    (fun _ j ↦ coordinate_mem_chartRing C _ j) (fun _ i j ↦ hone _ i j)
    (fun _ i ↦ hmutation _ i) [] w j

theorem clusterRing_le_upperClusterRing
    (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (hinv : ∀ i, Function.Involutive (mutation i))
    (hone : ∀ s i j, x (mutation i s) j ∈ chartRing C (x s))
    (hmutation : ∀ s i, upperBound C x mutation (mutation i s) = upperBound C x mutation s)
    (s : V) : clusterRing C x mutation s ≤ upperClusterRing C x mutation s :=
  clusterRing_le_patternUpperRing (fun t ↦ chartRing C (x t)) mutation C x hinv s
    (coefficient_le_upperBound C x mutation s) (fun _ j ↦ coordinate_mem_chartRing C _ j)
    (fun _ i j ↦ hone _ i j) (fun _ i ↦ hmutation _ i)

end DivisionRing

section Field

variable [Field F]

theorem polynomial_eval_mem_chart (C : Subring F) (x : I → F)
    (p : MvPolynomial I C) : MvPolynomial.eval₂ C.subtype x p ∈ chartRing C x := by
  induction p using MvPolynomial.induction_on with
  | C a => simpa using coefficient_mem_chartRing C x a.property
  | add p q hp hq => simpa using (chartRing C x).add_mem hp hq
  | mul_X p i hp =>
    simpa using (chartRing C x).mul_mem hp (coordinate_mem_chartRing C x i)

/-- One-step Laurentness follows immediately from the polynomial exchange law. -/
theorem coordinate_mutation_mem_chart
    (C : Subring F) (x : V → J → F) (mutation : I → V → V)
    (row : I ↪ J) (E : V → I → MvPolynomial J C)
    (hother : ∀ s i j, j ≠ row i → x (mutation i s) j = x s j)
    (hexchange : ∀ s i, x (mutation i s) (row i) =
      MvPolynomial.eval₂ C.subtype (x s) (E s i) / x s (row i))
    (s : V) (i : I) (j : J) : x (mutation i s) j ∈ chartRing C (x s) := by
  by_cases h : j = row i
  · subst j
    rw [hexchange, div_eq_mul_inv]
    exact (chartRing C (x s)).mul_mem (polynomial_eval_mem_chart C (x s) (E s i))
      (inverse_mem_chartRing C (x s) (row i))
  · rw [hother s i j h]
    exact coordinate_mem_chartRing C (x s) j

end Field

end TauCeti.Cluster
