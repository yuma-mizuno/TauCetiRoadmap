/-! The one-exchange intersection in two-coordinate chart notation. -/

@[expose] public section

namespace TauCeti.Cluster.UpperBound

open TauCeti.Laurent TauCeti.Laurent.OneExchange

section DivisionRing

variable {F : Type*} [DivisionRing F]

/-- The Boolean-indexed coordinate tuple with x at false and y at true. -/
def pairCoordinates (x y : F) : Bool → F := fun b ↦ if b then y else x
/-- The Laurent chart generated by x, y, their inverses, and the coefficient subring. -/
def pairChart (C : Subring F) (x y : F) : Subring F :=
  chartRing C (pairCoordinates x y)

/-- The Laurent chart generated by one coordinate and its inverse over the coefficient subring. -/
def singleChart (C : Subring F) (y : F) : Subring F :=
  chartRing C (fun _ : Unit ↦ y)

theorem pairChart_swap (C : Subring F) (x y : F) :
    pairChart C x y = pairChart C y x := by
  apply le_antisymm <;> apply chartRing_le
  · intro a ha
    exact coefficient_mem_chartRing C _ ha
  · intro b
    cases b
    · exact coordinate_mem_chartRing C (pairCoordinates y x) true
    · exact coordinate_mem_chartRing C (pairCoordinates y x) false
  · intro b
    cases b
    · exact inverse_mem_chartRing C (pairCoordinates y x) true
    · exact inverse_mem_chartRing C (pairCoordinates y x) false
  · intro a ha
    exact coefficient_mem_chartRing C _ ha
  · intro b
    cases b
    · exact coordinate_mem_chartRing C (pairCoordinates x y) true
    · exact coordinate_mem_chartRing C (pairCoordinates x y) false
  · intro b
    cases b
    · exact inverse_mem_chartRing C (pairCoordinates x y) true
    · exact inverse_mem_chartRing C (pairCoordinates x y) false

theorem pairChart_regroup (C : Subring F) (x y : F) :
    pairChart C x y = chartRing (singleChart C y) (fun _ : Unit ↦ x) := by
  apply le_antisymm
  · apply chartRing_le
    · intro a ha
      exact coefficient_mem_chartRing _ _ (coefficient_mem_chartRing C _ ha)
    · intro b
      cases b
      · exact coordinate_mem_chartRing _ _ ()
      · exact coefficient_mem_chartRing _ _ (coordinate_mem_chartRing C _ ())
    · intro b
      cases b
      · exact inverse_mem_chartRing _ _ ()
      · exact coefficient_mem_chartRing _ _ (inverse_mem_chartRing C _ ())
  · apply chartRing_le
    · apply chartRing_le
      · intro a ha
        exact coefficient_mem_chartRing C _ ha
      · intro _
        exact coordinate_mem_chartRing C (pairCoordinates x y) true
      · intro _
        exact inverse_mem_chartRing C (pairCoordinates x y) true
    · intro _
      exact coordinate_mem_chartRing C (pairCoordinates x y) false
    · intro _
      exact inverse_mem_chartRing C (pairCoordinates x y) false

end DivisionRing

noncomputable section
variable {F : Type*} [Field F]

/-- Clearing denominators upgrades polynomial independence over a subring to
independence over its fraction field. -/
theorem fraction_polynomial_injective (D : Subring F) (x : F) (hx : x ≠ 0)
    (hD : Function.Injective (Polynomial.eval₂RingHom D.subtype x)) :
    Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients D) (Units.mk0 x hx)) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro p hp
  have hp0 : Polynomial.eval₂ (fractionCoefficients D) x p = 0 := by
    simpa [Polynomial.eval₂RingHom] using hp
  have hn := IsLocalization.integerNormalization_eval₂_eq_zero
    (nonZeroDivisors D) (fractionCoefficients D) p hp0
  have hcomp : (fractionCoefficients D).comp
      (algebraMap D (FractionRing D)) = D.subtype := by
    ext a
    exact fractionCoefficients_algebraMap D a
  rw [hcomp] at hn
  have hn0 : IsLocalization.integerNormalization (nonZeroDivisors D) p = 0 :=
    (injective_iff_map_eq_zero _).mp hD _ (by
      simpa [Polynomial.eval₂RingHom] using hn)
  exact (IsFractionRing.integerNormalization_eq_zero_iff).mp hn0

/-- Polynomial independence descends from an intermediate coefficient field
to any subring contained in it. -/
theorem polynomial_injective_of_intermediateField
    {K : Type*} [Field K] [Algebra K F]
    (D : Subring F) (J : IntermediateField K F) (hDJ : D ≤ J.toSubring)
    (x : F) (htrans : Transcendental J x) :
    Function.Injective (Polynomial.eval₂RingHom D.subtype x) := by
  have hJ : Function.Injective (Polynomial.eval₂RingHom (algebraMap J F) x) := by
    intro p q hpq
    apply (transcendental_iff_injective.mp htrans)
    simpa [Polynomial.aeval_def, Polynomial.eval₂RingHom] using hpq
  let f : D →+* J := Subring.inclusion hDJ
  have hf : Function.Injective f := Subring.inclusion_injective hDJ
  apply (injective_iff_map_eq_zero _).mpr
  intro p hp
  have hcomp : (algebraMap J F).comp f = D.subtype := by
    ext a
    rfl
  have hpJ : Polynomial.eval₂RingHom (algebraMap J F) x (p.map f) = 0 := by
    simpa [Polynomial.eval₂RingHom, Polynomial.eval₂_map, hcomp] using hp
  have hpmap : p.map f = 0 := (injective_iff_map_eq_zero _).mp hJ _ hpJ
  exact (Polynomial.map_injective f hf) (by simpa using hpmap)

/-- Independence over an intermediate field restricts to the fraction field
of any subring contained in that intermediate field. -/
theorem independent_over_fraction_subring
    {K : Type*} [Field K] [Algebra K F]
    {I : Type*} (D : Subring F) (J : IntermediateField K F)
    (hDJ : D ≤ J.toSubring) (x : I → F)
    (hAI : AlgebraicIndependent J x) :
    let : Algebra (FractionRing D) F := (fractionCoefficients D).toAlgebra
    AlgebraicIndependent (FractionRing D) x := by
  let g : D →+* J := Subring.inclusion hDJ
  let f : FractionRing D →+* J := IsFractionRing.lift (Subring.inclusion_injective hDJ)
  let : Algebra (FractionRing D) J := f.toAlgebra
  let : Algebra (FractionRing D) F := (fractionCoefficients D).toAlgebra
  have hcomp : (algebraMap J F).comp f = fractionCoefficients D := by
    apply IsFractionRing.ringHom_ext (A := D) (K := FractionRing D)
    intro d
    simp [f, Subring.inclusion, fractionCoefficients_algebraMap]
  let : IsScalarTower (FractionRing D) J F :=
    IsScalarTower.of_algebraMap_eq (fun a ↦ by
      change fractionCoefficients D a = (algebraMap J F) (f a)
      exact (congrArg (fun q : FractionRing D →+* F ↦ q a) hcomp).symm)
  exact hAI.restrictScalars f.injective

/-- Algebraic independence of the pair over the fraction field of `C`
implies the exact polynomial injectivity used by the one-exchange theorem. -/
theorem pair_independent_first_polynomial
    (C : Subring F) (x y : F) (hx : x ≠ 0)
    (hAI : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C) (pairCoordinates x y)) :
    Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C y))
        (Units.mk0 x hx)) := by
  let : Algebra (FractionRing C) F := (fractionCoefficients C).toAlgebra
  let J : IntermediateField (FractionRing C) F :=
    IntermediateField.adjoin (FractionRing C) ({y} : Set F)
  have htrans : Transcendental J x := by
    apply IntermediateField.transcendental_adjoin_iff.mpr
    have h := hAI.transcendental_adjoin (s := ({true} : Set Bool))
      (i := false) (by simp)
    have himage : pairCoordinates x y '' ({true} : Set Bool) = ({y} : Set F) := by
      ext z
      simp [pairCoordinates]
    rw [himage] at h
    simpa [pairCoordinates] using h
  have hDJ : singleChart C y ≤ J.toSubring := by
    apply chartRing_le
    · intro a ha
      have heq : (a : F) = fractionCoefficients C
          (algebraMap C (FractionRing C) ⟨a, ha⟩) := by simp
      rw [heq]
      exact J.algebraMap_mem _
    · intro _
      exact IntermediateField.subset_adjoin _ _ (by simp)
    · intro _
      exact J.inv_mem (IntermediateField.subset_adjoin _ _ (by simp))
  exact fraction_polynomial_injective (singleChart C y) x hx
    (polynomial_injective_of_intermediateField _ J hDJ x htrans)

theorem pair_independent_second_polynomial
    (C : Subring F) (x y : F) (hy : y ≠ 0)
    (hAI : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C) (pairCoordinates x y)) :
    Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C x))
        (Units.mk0 y hy)) := by
  let : Algebra (FractionRing C) F := (fractionCoefficients C).toAlgebra
  have hsw : AlgebraicIndependent (FractionRing C) (pairCoordinates y x) := by
    have h := hAI.comp (fun b : Bool ↦ !b) (by
      intro b c hbc
      cases b <;> cases c <;> simp_all)
    convert h using 1
    funext b
    cases b <;> rfl
  exact pair_independent_first_polynomial C y x hy hsw

/-- Removing two coordinates from an algebraically independent family leaves
their pair independent over the fraction field of the Laurent chart generated
by all the remaining coordinates. -/
theorem pair_independent_over_complement_field
    {K I : Type*} [Field K] [Algebra K F]
    (C : Subring F) (x : I → F)
    (i j : I) (hij : i ≠ j)
    (hC : ∀ a ∈ C, a ∈ (algebraMap K F).range)
    (hAI : AlgebraicIndependent K x) :
    let D := chartRing C (fun k : {k : I // k ≠ i ∧ k ≠ j} ↦ x k)
    let : Algebra (FractionRing D) F := (fractionCoefficients D).toAlgebra
    AlgebraicIndependent (FractionRing D) (pairCoordinates (x i) (x j)) := by
  classical
  let s : Set I := {k | k ≠ i ∧ k ≠ j}
  let J : IntermediateField K F := IntermediateField.adjoin K (x '' s)
  have hdisj : Disjoint s ({i, j} : Set I) := by
    rw [Set.disjoint_left]
    intro k hk hkij
    rcases hkij with rfl | rfl
    · exact hk.1 rfl
    · exact hk.2 rfl
  have hsub := hAI.adjoin_of_disjoint hdisj
  let pairIndex : Bool → ({i, j} : Set I) := fun b ↦
    if b then ⟨j, by simp⟩ else ⟨i, by simp⟩
  have hinj : Function.Injective pairIndex := by
    intro b b' hbb
    cases b <;> cases b' <;> simp_all [pairIndex]
  have hpair_adjoin : AlgebraicIndependent
      (Algebra.adjoin K (x '' s))
      (pairCoordinates (x i) (x j)) := by
    have hh := hsub.comp pairIndex hinj
    convert hh using 1
    funext b
    cases b <;> rfl
  have hpair_J : AlgebraicIndependent J (pairCoordinates (x i) (x j)) :=
    IntermediateField.algebraicIndependent_adjoin_iff.mpr hpair_adjoin
  let D : Subring F := chartRing C (fun k : {k : I // k ≠ i ∧ k ≠ j} ↦ x k)
  have hDJ : D ≤ J.toSubring := by
    apply chartRing_le
    · intro a ha
      obtain ⟨k, hk⟩ := hC a ha
      rw [← hk]
      exact J.algebraMap_mem k
    · intro k
      exact IntermediateField.subset_adjoin _ _ ⟨k, k.property, rfl⟩
    · intro k
      exact J.inv_mem (IntermediateField.subset_adjoin _ _ ⟨k, k.property, rfl⟩)
  exact independent_over_fraction_subring D J hDJ _ hpair_J

theorem pair_independent_over_complement
    {I : Type*} (C : Subring F) (x : I → F)
    (i j : I) (hij : i ≠ j)
    (hAI : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C) x) :
    let D := chartRing C (fun k : {k : I // k ≠ i ∧ k ≠ j} ↦ x k)
    let : Algebra (FractionRing D) F := (fractionCoefficients D).toAlgebra
    AlgebraicIndependent (FractionRing D) (pairCoordinates (x i) (x j)) := by
  classical
  let : Algebra (FractionRing C) F := (fractionCoefficients C).toAlgebra
  apply pair_independent_over_complement_field (K := FractionRing C) C x i j hij
  · intro a ha
    refine ⟨algebraMap C (FractionRing C) ⟨a, ha⟩, ?_⟩
    exact fractionCoefficients_algebraMap C ⟨a, ha⟩
  · exact hAI

/-- Identify a pair of integer exponents with a Boolean-indexed finite exponent vector. -/
def pairExponent : (ℤ × ℤ) →+ (Bool →₀ ℤ) where
  toFun m := (Finsupp.equivFunOnFinite).symm (fun b ↦ if b then m.2 else m.1)
  map_zero' := by
    ext b
    cases b <;> simp
  map_add' m n := by
    ext b
    cases b <;> simp

theorem pairExponent_injective : Function.Injective pairExponent := by
  intro m n hmn
  apply Prod.ext
  · have h := congrArg (fun p : Bool →₀ ℤ ↦ p false) hmn
    simpa [pairExponent] using h
  · have h := congrArg (fun p : Bool →₀ ℤ ↦ p true) hmn
    simpa [pairExponent] using h

theorem pairExponent_eq_sum (m : ℤ × ℤ) :
    pairExponent m = Finsupp.single false m.1 + Finsupp.single true m.2 := by
  ext b
  cases b <;> simp [pairExponent]

/-- Extend scalars to the coefficient fraction field and reindex bivariate Laurent exponents by
Bool.
-/
def pairLaurentMap (C : Subring F) :
    TauCeti.Laurent.CommutingExchange.BiLaurent C →+*
      AddMonoidAlgebra (FractionRing C) (Bool →₀ ℤ) :=
  (AddMonoidAlgebra.mapDomainRingHom (FractionRing C) pairExponent).comp
    (AddMonoidAlgebra.mapRingHom (ℤ × ℤ) (algebraMap C (FractionRing C)))

theorem pairLaurentMap_injective (C : Subring F) :
    Function.Injective (pairLaurentMap C) := by
  exact (AddMonoidAlgebra.mapDomain_injective pairExponent_injective).comp
    (AddMonoidAlgebra.map_injective _ (IsFractionRing.injective C (FractionRing C)))

theorem pairEval_factor (C : Subring F) (x y : Fˣ) :
    pairEval C x y =
      (TauCeti.Laurent.LaurentEvaluation.eval (fractionCoefficients C)
        (pairCoordinates x y)).comp (pairLaurentMap C) := by
  have hsingle (m : ℤ × ℤ) (a : C) :
      pairEval C x y (AddMonoidAlgebra.single m a) =
      ((TauCeti.Laurent.LaurentEvaluation.eval (fractionCoefficients C)
        (pairCoordinates x y)).comp (pairLaurentMap C))
          (AddMonoidAlgebra.single m a) := by
    rw [pairEval_single]
    simp only [RingHom.comp_apply, pairLaurentMap,
      AddMonoidAlgebra.mapRingHom_single, AddMonoidAlgebra.mapDomainRingHom_apply,
      AddMonoidAlgebra.mapDomain_single]
    rw [TauCeti.Laurent.LaurentEvaluation.eval_single,
      pairExponent_eq_sum, map_add,
      TauCeti.Laurent.LaurentEvaluation.exponentCharacter_single,
      TauCeti.Laurent.LaurentEvaluation.exponentCharacter_single]
    simp [fractionCoefficients_algebraMap, pairCoordinates, mul_assoc]
  apply AddMonoidAlgebra.ringHom_ext
  · exact fun a ↦ hsingle 0 a
  · exact fun m ↦ hsingle m 1

theorem pairEval_injective_of_independent (C : Subring F) (x y : Fˣ)
    (hAI : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C)
        (pairCoordinates (x : F) (y : F))) :
    Function.Injective (pairEval C x y) := by
  let : Algebra (FractionRing C) F := (fractionCoefficients C).toAlgebra
  have heval : Function.Injective
      (TauCeti.Laurent.LaurentEvaluation.eval (fractionCoefficients C)
        (pairCoordinates x y)) := by
    apply TauCeti.Cluster.laurent_eval_injective_of_algebraicIndependent
    · intro c
      exact TauCeti.Laurent.LaurentEvaluation.eval_constant _ _ c
    · convert hAI using 1
      funext b
      cases b <;> simp [pairCoordinates]
  rw [pairEval_factor]
  exact heval.comp (pairLaurentMap_injective C)

theorem exchangePairRing_single_eq_generated (C : Subring F) (x xs y : F) :
    exchangePairRing (singleChart C y) x xs = generated C {x, xs, y, y⁻¹} := by
  apply le_antisymm
  · apply Subring.closure_le.mpr
    rintro z (hz | hz)
    · apply chartRing_le (x := fun _ : Unit ↦ y) (L := generated C {x, xs, y, y⁻¹})
      · intro a ha
        exact coefficient_mem_generated C _ ha
      · intro _
        exact generator_mem_generated C _ (by simp)
      · intro _
        exact generator_mem_generated C _ (by simp)
      exact hz
    · simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl
      · exact generator_mem_generated C _ (by simp)
      · exact generator_mem_generated C _ (by simp)
  · apply generated_le
    · intro a ha
      exact Subring.subset_closure (Or.inl (coefficient_mem_chartRing C _ ha))
    · intro z hz
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
      rcases hz with rfl | rfl | rfl | rfl
      · exact Subring.subset_closure (Or.inr (by simp))
      · exact Subring.subset_closure (Or.inr (by simp))
      · exact Subring.subset_closure (Or.inl (coordinate_mem_chartRing C _ ()))
      · exact Subring.subset_closure (Or.inl (inverse_mem_chartRing C _ ()))

/-- Actual two-coordinate L1. The injectivity hypothesis is transcendence of
`x` over the fraction field of the Laurent ring in the other coordinate. -/
theorem pairChart_exchange_intersection (C : Subring F) (x y : F) (hx : x ≠ 0)
    (E : singleChart C y) (hE : (E : F) ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C y))
        (Units.mk0 x hx))) :
    pairChart C x y ⊓ pairChart C ((E : F) / x) y =
      generated C {x, (E : F) / x, y, y⁻¹} := by
  rw [pairChart_regroup C x y, pairChart_regroup C ((E : F) / x) y]
  exact (chartRing_exchangeIntersection (singleChart C y) x hx E hE hpoly).trans
    (exchangePairRing_single_eq_generated C x ((E : F) / x) y)

/-- The same intersection when the second displayed coordinate mutates. -/
theorem pairChart_exchange_second (C : Subring F) (x y : F) (hy : y ≠ 0)
    (E : singleChart C x) (hE : (E : F) ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C x))
        (Units.mk0 y hy))) :
    pairChart C x y ⊓ pairChart C x ((E : F) / y) =
      generated C {x, x⁻¹, y, (E : F) / y} := by
  rw [pairChart_swap C x y, pairChart_swap C x ((E : F) / y)]
  have h := pairChart_exchange_intersection C y x hy E hE hpoly
  rw [h]
  unfold generated
  congr 1
  ext z
  simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]
  tauto

theorem binomial_mem_singleChart (C : Subring F) (a b y : F) (n : ℕ)
    (ha : a ∈ C) (hb : b ∈ C) : a * y ^ n + b ∈ singleChart C y := by
  exact (singleChart C y).add_mem
    ((singleChart C y).mul_mem (coefficient_mem_chartRing C _ ha)
      ((singleChart C y).pow_mem (coordinate_mem_chartRing C _ ()) n))
    (coefficient_mem_chartRing C _ hb)

theorem binomial_nonzero_of_polynomial_injective
    (D : Subring F) (x : F) (hx : x ≠ 0) (d f : D) {e : ℕ}
    (he : 0 < e) (hf : (f : F) ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients D) (Units.mk0 x hx))) :
    (d : F) * x ^ e + f ≠ 0 := by
  let P : Polynomial (FractionRing D) :=
    Polynomial.C (algebraMap D (FractionRing D) d) * Polynomial.X ^ e +
      Polynomial.C (algebraMap D (FractionRing D) f)
  have hcoeff : P.coeff 0 = algebraMap D (FractionRing D) f := by
    simp [P, (Nat.ne_of_gt he).symm]
  have hP : P ≠ 0 := by
    intro hzero
    have hfK : algebraMap D (FractionRing D) f = 0 := by
      simpa [hcoeff] using congrArg (fun p : Polynomial (FractionRing D) ↦ p.coeff 0) hzero
    exact hf (by
      have hsub : f = 0 :=
        (injective_iff_map_eq_zero _).mp (IsFractionRing.injective D (FractionRing D)) f hfK
      simpa using congrArg Subtype.val hsub)
  intro hz
  have hEval : Polynomial.eval₂RingHom (fractionCoefficients D)
      (Units.mk0 x hx) P = 0 := by
    simpa [P, Polynomial.eval₂RingHom, fractionCoefficients_algebraMap] using hz
  exact hP ((injective_iff_map_eq_zero _).mp hpoly P hEval)

/-- The three concrete L1 identities consumed by `interacting_three_chart`.
Each transcendence witness is stated at the exact intermediate coefficient
ring on which the one-variable Laurent argument operates. -/
theorem interacting_three_chart_intersections
    (C : Subring F) (a b d f g h x xs y : F) {c e : ℕ}
    (hx : x ≠ 0) (hxs : xs ≠ 0) (hy : y ≠ 0)
    (ha : a ∈ C) (hb : b ∈ C) (hd : d ∈ C) (hf : f ∈ C)
    (hg : g ∈ C) (hh : h ∈ C)
    (hex : x * xs = a * y ^ c + b)
    (hey_nonzero : d * x ^ e + f ≠ 0)
    (hthird_nonzero : g * xs ^ e + h ≠ 0)
    (hpoly_x : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C y))
        (Units.mk0 x hx)))
    (hpoly_y : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C x))
        (Units.mk0 y hy)))
    (hpoly_y_xs : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C xs))
        (Units.mk0 y hy))) :
    (pairChart C x y ⊓ pairChart C xs y = generated C {x, xs, y, y⁻¹}) ∧
    (pairChart C x y ⊓ pairChart C x ((d * x ^ e + f)/y) =
      generated C {x, x⁻¹, y, (d * x ^ e + f)/y}) ∧
    (pairChart C xs y ⊓ pairChart C xs ((g * xs ^ e + h)/y) =
      generated C {xs, xs⁻¹, y, (g * xs ^ e + h)/y}) := by
  have hE1 : a * y ^ c + b ∈ singleChart C y :=
    binomial_mem_singleChart C a b y c ha hb
  have hE1nz : a * y ^ c + b ≠ 0 := by
    rw [← hex]
    exact mul_ne_zero hx hxs
  have hxsEq : (a * y ^ c + b) / x = xs := by
    rw [← hex]
    field_simp
  refine ⟨?_, ?_, ?_⟩
  · have h := pairChart_exchange_intersection C x y hx ⟨_, hE1⟩ hE1nz hpoly_x
    simpa only [hxsEq] using h
  · exact pairChart_exchange_second C x y hy
      ⟨_, binomial_mem_singleChart C d f x e hd hf⟩ hey_nonzero hpoly_y
  · exact pairChart_exchange_second C xs y hy
      ⟨_, binomial_mem_singleChart C g h xs e hg hh⟩ hthird_nonzero hpoly_y_xs

/-- The rank-two three-chart upper-bound equality for actual Laurent chart
rings. The only remaining geometric inputs are the three displayed
transcendence witnesses for the three birational coordinate pairs. -/
theorem interacting_three_pairCharts
    (C : Subring F) (a b d f g h x xs y ys : F) {c e : ℕ}
    (hc : 0 < c) (he : 0 < e)
    (hx : x ≠ 0) (hxs : xs ≠ 0) (hy : y ≠ 0) (hf : f ≠ 0) (hh : h ≠ 0)
    (ha : a ∈ C) (hb : b ∈ C) (hd : d ∈ C) (hfC : f ∈ C) (hfi : f⁻¹ ∈ C)
    (hg : g ∈ C) (hhC : h ∈ C) (hhi : h⁻¹ ∈ C)
    (hex : x * xs = a * y ^ c + b) (hey : y * ys = d * x ^ e + f)
    (hsecond_nonzero : d * x ^ e + f ≠ 0)
    (hthird_nonzero : g * xs ^ e + h ≠ 0)
    (hcompat : f * h = d * g * b ^ e)
    (hpoly_x : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C y))
        (Units.mk0 x hx)))
    (hpoly_y : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C x))
        (Units.mk0 y hy)))
    (hpoly_y_xs : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients (singleChart C xs))
        (Units.mk0 y hy))) :
    pairChart C x y ⊓ pairChart C xs y ⊓ pairChart C x ys =
      pairChart C xs y ⊓ pairChart C x y ⊓
        pairChart C xs ((g * xs ^ e + h)/y) := by
  have hys : (d * x ^ e + f) / y = ys := by
    rw [← hey]
    field_simp
  obtain ⟨hLx, hLy, hLxy⟩ := interacting_three_chart_intersections
    C a b d f g h x xs y hx hxs hy ha hb hd hfC hg hhC hex
    hsecond_nonzero hthird_nonzero hpoly_x hpoly_y hpoly_y_xs
  rw [hys] at hLy
  exact interacting_three_chart C
    (pairChart C x y) (pairChart C xs y) (pairChart C x ys)
    (pairChart C xs ((g * xs ^ e + h)/y))
    a b d f g h x xs y ys hc he hx hxs hy hf hh
    ha hb hd hfC hfi hg hhC hhi hex hey hcompat hLx hLy hLxy

/-- The same chart equality with algebraic independence of the two genuine
birational coordinate pairs as its geometric input. -/
theorem interacting_three_pairCharts_of_independent
    (C : Subring F) (a b d f g h x xs y ys : F) {c e : ℕ}
    (hc : 0 < c) (he : 0 < e)
    (hx : x ≠ 0) (hxs : xs ≠ 0) (hy : y ≠ 0) (hf : f ≠ 0) (hh : h ≠ 0)
    (ha : a ∈ C) (hb : b ∈ C) (hd : d ∈ C) (hfC : f ∈ C) (hfi : f⁻¹ ∈ C)
    (hg : g ∈ C) (hhC : h ∈ C) (hhi : h⁻¹ ∈ C)
    (hex : x * xs = a * y ^ c + b) (hey : y * ys = d * x ^ e + f)
    (hcompat : f * h = d * g * b ^ e)
    (hAI : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C) (pairCoordinates x y))
    (hAIx : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C) (pairCoordinates xs y)) :
    pairChart C x y ⊓ pairChart C xs y ⊓ pairChart C x ys =
      pairChart C xs y ⊓ pairChart C x y ⊓
        pairChart C xs ((g * xs ^ e + h)/y) := by
  have hsecond_nonzero : d * x ^ e + f ≠ 0 :=
    binomial_nonzero_of_polynomial_injective (singleChart C y) x hx
      ⟨d, coefficient_mem_chartRing C _ hd⟩
      ⟨f, coefficient_mem_chartRing C _ hfC⟩ he hf
      (pair_independent_first_polynomial C x y hx hAI)
  have hthird_nonzero : g * xs ^ e + h ≠ 0 :=
    binomial_nonzero_of_polynomial_injective (singleChart C y) xs hxs
      ⟨g, coefficient_mem_chartRing C _ hg⟩
      ⟨h, coefficient_mem_chartRing C _ hhC⟩ he hh
      (pair_independent_first_polynomial C xs y hxs hAIx)
  exact interacting_three_pairCharts C a b d f g h x xs y ys hc he
    hx hxs hy hf hh ha hb hd hfC hfi hg hhC hhi hex hey
    hsecond_nonzero hthird_nonzero hcompat
    (pair_independent_first_polynomial C x y hx hAI)
    (pair_independent_second_polynomial C x y hy hAI)
    (pair_independent_second_polynomial C xs y hy hAIx)

/-- The commuting rank-two comparison for the actual pair charts. The two
pair-independence hypotheses supply both the one-exchange identities and the
faithfulness of the bivariate Laurent evaluations. -/
theorem commuting_three_pairCharts_of_independent
    (C : Subring F) [DecompositionMonoid C]
    (x xs y : Fˣ) (E H : C) (hEH : IsRelPrime E H)
    (hex : (x : F) * xs = E) (hH : (H : F) ≠ 0)
    (hAI : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C)
        (pairCoordinates (x : F) (y : F)))
    (hAIx : let : Algebra (FractionRing C) F :=
      (fractionCoefficients C).toAlgebra
      AlgebraicIndependent (FractionRing C)
        (pairCoordinates (xs : F) (y : F))) :
    pairChart C x y ⊓ pairChart C xs y ⊓ pairChart C x ((H : F)/y) =
      pairChart C xs y ⊓ pairChart C x y ⊓ pairChart C xs ((H : F)/y) := by
  have hE : (E : F) ≠ 0 := by
    rw [← hex]
    exact mul_ne_zero (Units.ne_zero x) (Units.ne_zero xs)
  have hxsEq : (E : F) / x = xs := by
    rw [← hex]
    field_simp
  have hLx : pairChart C x y ⊓ pairChart C xs y =
      generated C {(x : F), (xs : F), (y : F), (y : F)⁻¹} := by
    have h := pairChart_exchange_intersection C x y (Units.ne_zero x)
      ⟨E, coefficient_mem_chartRing C _ E.property⟩ hE
      (pair_independent_first_polynomial C x y (Units.ne_zero x) hAI)
    simpa only [hxsEq] using h
  have hLy : pairChart C x y ⊓ pairChart C x ((H : F)/y) =
      generated C {(x : F), (x : F)⁻¹, (y : F), (H : F)/y} :=
    pairChart_exchange_second C x y (Units.ne_zero y)
      ⟨H, coefficient_mem_chartRing C _ H.property⟩ hH
      (pair_independent_second_polynomial C x y (Units.ne_zero y) hAI)
  have hLxy : pairChart C xs y ⊓ pairChart C xs ((H : F)/y) =
      generated C {(xs : F), (xs : F)⁻¹, (y : F), (H : F)/y} :=
    pairChart_exchange_second C xs y (Units.ne_zero y)
      ⟨H, coefficient_mem_chartRing C _ H.property⟩ hH
      (pair_independent_second_polynomial C xs y (Units.ne_zero y) hAIx)
  exact commuting_three_chart C
    (pairChart C x y) (pairChart C xs y) (pairChart C x ((H : F)/y))
    (pairChart C xs ((H : F)/y)) x xs y E H hEH hex
    (pairEval_injective_of_independent C x y hAI)
    (pairEval_injective_of_independent C xs y hAIx)
    hLx hLy hLxy

end
end TauCeti.Cluster.UpperBound
