public import Mathlib.Tactic

/-!
# Local upper-bound algebra

The rings here are subrings of one ambient ring. In particular, adjoining a generator
does not silently adjoin its inverse. This is needed for the adjacent-chart intersection.
`generated` and `fourRing` need no inverses. The replacement of the second exchange partner
inside a field is an instance of the seed-free `TauCeti.Laurent.ReplacementPremise.zss_mem`.
-/

@[expose] public section

namespace TauCeti.Cluster.UpperBound

variable {F : Type*}

section Ring

variable [Ring F]

/-- The polynomial ring generated by a coefficient subring and a finite set of
ring elements. -/
def generated (C : Subring F) (s : Set F) : Subring F :=
  Subring.closure ((C : Set F) ∪ s)

theorem coefficient_mem_generated (C : Subring F) (s : Set F)
    {z : F} (hz : z ∈ C) : z ∈ generated C s :=
  Subring.subset_closure (Or.inl hz)

theorem generator_mem_generated (C : Subring F) (s : Set F)
    {z : F} (hz : z ∈ s) : z ∈ generated C s :=
  Subring.subset_closure (Or.inr hz)

theorem generated_le (C : Subring F) (s : Set F) (R : Subring F)
    (hC : C ≤ R) (hs : s ⊆ R) : generated C s ≤ R := by
  apply Subring.closure_le.mpr
  rintro z (hz | hz)
  · exact hC hz
  · exact hs hz

theorem generated_mono (C : Subring F) {s t : Set F} (hst : s ⊆ t) :
    generated C s ≤ generated C t :=
  generated_le C s _ (fun _ h ↦ coefficient_mem_generated C t h)
    (fun _ h ↦ generator_mem_generated C t (hst h))

/-- Two generator sets give the same ring when each lies in the ring of the other. -/
theorem generated_eq_of_mem (C : Subring F) {s t : Set F}
    (hs : ∀ z ∈ s, z ∈ generated C t) (ht : ∀ z ∈ t, z ∈ generated C s) :
    generated C s = generated C t :=
  le_antisymm (generated_le C s _ (fun _ h ↦ coefficient_mem_generated C t h) fun z hz ↦ hs z hz)
    (generated_le C t _ (fun _ h ↦ coefficient_mem_generated C s h) fun z hz ↦ ht z hz)

/-- The four-generator algebra for two adjacent directions. -/
def fourRing (C : Subring F) (x xs y ys : F) : Subring F :=
  generated C {x, xs, y, ys}

theorem coefficient_mem_fourRing (C : Subring F) (x xs y ys : F)
    {z : F} (hz : z ∈ C) : z ∈ fourRing C x xs y ys :=
  coefficient_mem_generated C _ hz

theorem x_mem_fourRing (C : Subring F) (x xs y ys : F) :
    x ∈ fourRing C x xs y ys := generator_mem_generated C _ (by simp)

theorem xs_mem_fourRing (C : Subring F) (x xs y ys : F) :
    xs ∈ fourRing C x xs y ys := generator_mem_generated C _ (by simp)

theorem y_mem_fourRing (C : Subring F) (x xs y ys : F) :
    y ∈ fourRing C x xs y ys := generator_mem_generated C _ (by simp)

theorem ys_mem_fourRing (C : Subring F) (x xs y ys : F) :
    ys ∈ fourRing C x xs y ys := generator_mem_generated C _ (by simp)

/-- The four-generator ring is symmetric in the two directions. -/
theorem fourRing_comm (C : Subring F) (x xs y ys : F) :
    fourRing C x xs y ys = fourRing C y ys x xs := by
  unfold fourRing
  congr 1
  ext z
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  tauto

end Ring

section Field

variable [Field F]

open TauCeti.Laurent in
/-- The changed exchange partner belongs to the original four-generator ring. This is the
commutative instance of `TauCeti.Laurent.ReplacementPremise.zss_mem` with `x = x ^ e`,
`x* = xs ^ e`, `r = 1` and `g₀ = b ^ e`. -/
theorem replacement_forward (C : Subring F) (a b d f g h x xs y ys : F)
    {c e : ℕ} (hc : 0 < c) (hy : y ≠ 0) (hf : f ≠ 0)
    (ha : a ∈ C) (hb : b ∈ C) (hd : d ∈ C) (hfi : f⁻¹ ∈ C)
    (hg : g ∈ C)
    (hx : x * xs = a * y ^ c + b)
    (hys : y * ys = d * x ^ e + f)
    (hcompat : f * h = d * g * b ^ e) :
    (g * xs ^ e + h) / y ∈ fourRing C x xs y ys := by
  let R := fourRing C x xs y ys
  have hR : Subring.closure ((C : Set F) ∪ {xs ^ e, ys, y}) ≤ R := by
    apply generated_le C _ R (fun _ hz ↦ coefficient_mem_fourRing C x xs y ys hz)
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | hz | hz
    · exact R.pow_mem (xs_mem_fourRing C x xs y ys) e
    · exact hz ▸ ys_mem_fourRing C x xs y ys
    · exact hz ▸ y_mem_fourRing C x xs y ys
  by_cases hxe : x ^ e = 0
  · have hyys : y * ys = f := by rw [hys, hxe, mul_zero, zero_add]
    have hhC : h ∈ C := by
      rw [show h = f⁻¹ * (d * g * b ^ e) by rw [← hcompat, inv_mul_cancel_left₀ hf]]
      exact C.mul_mem hfi (C.mul_mem (C.mul_mem hd hg) (C.pow_mem hb e))
    have hform : (g * xs ^ e + h) / y = (g * xs ^ e + h) * f⁻¹ * ys := by
      rw [div_eq_iff hy, mul_assoc _ ys y, mul_comm ys y, hyys, inv_mul_cancel_right₀ hf]
    rw [hform]
    have hCR : ∀ z ∈ C, z ∈ R := fun z hz ↦ coefficient_mem_fourRing C x xs y ys hz
    exact R.mul_mem (R.mul_mem (R.add_mem (R.mul_mem (hCR g hg)
      (R.pow_mem (xs_mem_fourRing C x xs y ys) e)) (hCR h hhC)) (hCR _ hfi))
      (ys_mem_fourRing C x xs y ys)
  have hyN : Normalizes C y := Normalizes.of_ne_zero hy
  obtain ⟨w, hw, hpow⟩ := exists_pow_eq_add_mul hyN hb
    (Subring.mul_mem _ (le_skewPolyRing C y ha)
      (Subring.pow_mem _ (generator_mem_skewPolyRing C y) (c - 1))) e
  have hprem : ReplacementPremise C (x ^ e) (xs ^ e) y ys ((g * xs ^ e + h) / y) 1 (b ^ e) f d g
      h :=
    { x_normalizes := Normalizes.of_ne_zero hxe
      z_normalizes := hyN
      pow_mul_pow_sub_mem := ⟨w, hw, by
        have hyc : y * y ^ (c - 1) = y ^ c := by rw [← pow_succ', Nat.sub_add_cancel hc]
        rw [pow_one, pow_one, ← mul_pow, mul_comm xs x, hx, ← hyc]
        rw [show a * (y * y ^ (c - 1)) + b = b + y * (a * y ^ (c - 1)) by ring, hpow]
        ring⟩
      n1_ne_zero := hf
      n1_inv_mem := hfi
      n2_mem := hd
      m1_mem := hg
      zs_mul := by rw [pow_one, mul_comm ys y, hys]; ring
      zss_mul := by rw [pow_one, div_mul_cancel₀ _ hy, mul_comm (xs ^ e) g]
      compat := by
        rw [pow_one]
        calc b ^ e * (x ^ e)⁻¹ * (g * f⁻¹) * x ^ e * d =
              f⁻¹ * (d * g * b ^ e) * ((x ^ e)⁻¹ * x ^ e) := by ring
          _ = h := by rw [← hcompat, inv_mul_cancel_left₀ hf, inv_mul_cancel₀ hxe, mul_one] }
  exact hR hprem.zss_mem

/-- L2c: replacement of the second exchange partner leaves the four-generator
ring unchanged. This uses both explicit polynomial corrections; no intersection
equality is assumed. -/
theorem fourRing_replacement (C : Subring F) (a b d f g h x xs y ys : F)
    {c e : ℕ} (hc : 0 < c) (hy : y ≠ 0) (hf : f ≠ 0) (hh : h ≠ 0)
    (ha : a ∈ C) (hb : b ∈ C) (hd : d ∈ C) (hfi : f⁻¹ ∈ C)
    (hg : g ∈ C) (hhi : h⁻¹ ∈ C)
    (hx : x * xs = a * y ^ c + b)
    (hys : y * ys = d * x ^ e + f)
    (hcompat : f * h = d * g * b ^ e) :
    fourRing C x xs y ys = fourRing C x xs y ((g * xs ^ e + h) / y) := by
  let yss := (g * xs ^ e + h) / y
  have hyss : y * yss = g * xs ^ e + h := by
    dsimp [yss]
    exact mul_div_cancel₀ _ hy
  have hcompat' : h * f = g * d * b ^ e := by
    calc
      h * f = f * h := mul_comm _ _
      _ = d * g * b ^ e := hcompat
      _ = g * d * b ^ e := by ring
  have hold : yss ∈ fourRing C x xs y ys :=
    replacement_forward C a b d f g h x xs y ys hc hy hf ha hb hd hfi hg hx hys hcompat
  have hnew : ys ∈ fourRing C xs x y yss := by
    have hformula : (d * x ^ e + f) / y = ys := by
      apply (div_eq_iff hy).mpr
      simpa only [mul_comm ys] using hys.symm
    rw [← hformula]
    exact replacement_forward C a b g h d f xs x y yss hc hy hh
      ha hb hg hhi hd (mul_comm xs x ▸ hx) hyss hcompat'
  have hswap (u v : F) : fourRing C u v y yss = fourRing C v u y yss := by
    unfold fourRing generated
    congr 1
    ext z
    simp only [Set.mem_union, Set.mem_insert_iff, Set.mem_singleton_iff]
    tauto
  apply le_antisymm
  · apply generated_le C _ _
      (fun _ hz ↦ coefficient_mem_fourRing C x xs y yss hz)
    intro z hz
    change z ∈ fourRing C x xs y yss
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with h | h | h | h
    · rw [h]; exact x_mem_fourRing C x xs y yss
    · rw [h]; exact xs_mem_fourRing C x xs y yss
    · rw [h]; exact y_mem_fourRing C x xs y yss
    · rw [h, ← hswap]; exact hnew
  · apply generated_le C _ _
      (fun _ hz ↦ coefficient_mem_fourRing C x xs y ys hz)
    intro z hz
    change z ∈ fourRing C x xs y ys
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with h | h | h | h
    · rw [h]; exact x_mem_fourRing C x xs y ys
    · rw [h]; exact xs_mem_fourRing C x xs y ys
    · rw [h]; exact y_mem_fourRing C x xs y ys
    · rw [h]; exact hold

end Field

end TauCeti.Cluster.UpperBound
