module

public import TauCetiRoadmap.ClusterAlgebras.UpperBoundCharts

/-! Regrouping every unchanged coordinate into the coefficient ring reduces
an arbitrary-rank chart comparison to two coordinates in the same field. -/

@[expose] public section

noncomputable section
namespace TauCeti.Cluster.UpperBound
open TauCeti.Laurent
variable {F M : Type*} [Field F] [DecidableEq M]

/-- The Laurent chart generated by every coordinate except the two selected indices. -/
def pairComplementRing (C : Subring F) (x : M → F) (i j : M) : Subring F :=
  chartRing C (fun a : {a : M // a ≠ i ∧ a ≠ j} => x a)

omit [DecidableEq M] in
theorem pairComplementRing_le (C : Subring F) (x : M → F) (i j : M) :
    pairComplementRing C x i j ≤ chartRing C x := by
  apply chartRing_le
  · exact fun _ h => coefficient_mem_chartRing C x h
  · exact fun a => coordinate_mem_chartRing C x a
  · exact fun a => inverse_mem_chartRing C x a

omit [DecidableEq M] in
theorem chartRing_pair_regroup (C : Subring F) (x : M → F) (i j : M) :
    chartRing C x = pairChart (pairComplementRing C x i j) (x i) (x j) := by
  classical
  let D := pairComplementRing C x i j
  apply le_antisymm
  · apply chartRing_le
    · intro a ha
      exact coefficient_mem_chartRing D _ (coefficient_mem_chartRing C _ ha)
    · intro k
      by_cases hki : k = i
      · subst k
        exact coordinate_mem_chartRing D _ false
      by_cases hkj : k = j
      · subst k
        exact coordinate_mem_chartRing D _ true
      exact coefficient_mem_chartRing D _
        (coordinate_mem_chartRing C (fun a : {a : M // a ≠ i ∧ a ≠ j} => x a) ⟨k, hki, hkj⟩)
    · intro k
      by_cases hki : k = i
      · subst k
        exact inverse_mem_chartRing D _ false
      by_cases hkj : k = j
      · subst k
        exact inverse_mem_chartRing D _ true
      exact coefficient_mem_chartRing D _
        (inverse_mem_chartRing C (fun a : {a : M // a ≠ i ∧ a ≠ j} => x a) ⟨k, hki, hkj⟩)
  · apply chartRing_le
    · exact pairComplementRing_le C x i j
    · intro b
      cases b
      · exact coordinate_mem_chartRing C x i
      · exact coordinate_mem_chartRing C x j
    · intro b
      cases b
      · exact inverse_mem_chartRing C x i
      · exact inverse_mem_chartRing C x j

theorem pairComplementRing_update_left (C : Subring F) (x : M → F) (i j : M) (v : F) :
    pairComplementRing C (Function.update x i v) i j = pairComplementRing C x i j := by
  unfold pairComplementRing
  congr 1
  funext a
  exact Function.update_of_ne a.property.1 v x

theorem pairComplementRing_update_right (C : Subring F) (x : M → F) (i j : M) (v : F) :
    pairComplementRing C (Function.update x j v) i j = pairComplementRing C x i j := by
  unfold pairComplementRing
  congr 1
  funext a
  exact Function.update_of_ne a.property.2 v x

theorem chartRing_pair_update_left (C : Subring F) (x : M → F) (i j : M)
    (hij : i ≠ j) (v : F) :
    chartRing C (Function.update x i v) =
      pairChart (pairComplementRing C x i j) v (x j) := by
  rw [chartRing_pair_regroup C _ i j, pairComplementRing_update_left]
  simp only [Function.update_self, Function.update_of_ne hij.symm]

theorem chartRing_pair_update_right (C : Subring F) (x : M → F) (i j : M)
    (hij : i ≠ j) (v : F) :
    chartRing C (Function.update x j v) =
      pairChart (pairComplementRing C x i j) (x i) v := by
  rw [chartRing_pair_regroup C _ i j, pairComplementRing_update_right]
  simp only [Function.update_self, Function.update_of_ne hij]

theorem chartRing_pair_update_both (C : Subring F) (x : M → F) (i j : M)
    (hij : i ≠ j) (v z : F) :
    chartRing C (Function.update (Function.update x i v) j z) =
      pairChart (pairComplementRing C x i j) v z := by
  rw [chartRing_pair_update_right C _ i j hij, pairComplementRing_update_left]
  simp only [Function.update_self]

end TauCeti.Cluster.UpperBound
