/-! # Birational -/

@[expose] public section

namespace TauCeti.Laurent
open Polynomial
noncomputable section

/--
The inversion argument works over a domain, including the algebra generated by other coordinates.
-/
theorem transcendental_exchange_of_map_ne_zero
    {R L : Type*} [CommRing R] [IsDomain R] [Field L] [Algebra R L]
    {x : L} (hx : Transcendental R x) {c : R} (hc : algebraMap R L c ≠ 0) :
    Transcendental R (algebraMap R L c / x) := by
  intro h
  have hx' : x ≠ 0 := fun hzero ↦ hx (hzero ▸ isAlgebraic_zero)
  have hh := (isAlgebraic_algebraMap (A := L) c).mul h.inv
  have heq : algebraMap R L c * (algebraMap R L c / x)⁻¹ = x := by field_simp
  exact hx (heq ▸ hh)

/-- Replacing one member of an algebraically independent family by E/x preserves independence
when E is any nonzero element of the algebra generated by the other members. -/
theorem algebraicIndependent_option_exchange
    {K L I : Type*} [Field K] [Field L] [Algebra K L]
    {a : L} {x : I → L}
    (h : AlgebraicIndependent K (fun o : Option I ↦ o.elim a x))
    (c : Algebra.adjoin K (Set.range x)) (hc : c ≠ 0) :
    AlgebraicIndependent K (fun o : Option I ↦ o.elim ((c : L) / a) x) := by
  obtain ⟨hx, ha⟩ := AlgebraicIndependent.option_iff.mp h
  apply (hx.option_iff_transcendental _).mpr
  exact transcendental_exchange_of_map_ne_zero ha
    (fun hz ↦ hc (Subtype.ext hz))

/-- Polynomial exchange numerators are nonzero and preserve independence by the original
independent family's evaluation embedding. -/
theorem algebraicIndependent_option_polynomial_exchange
    {K L I : Type*} [Field K] [Field L] [Algebra K L]
    {a : L} {x : I → L}
    (h : AlgebraicIndependent K (fun o : Option I ↦ o.elim a x))
    (E : MvPolynomial I K) (hE : E ≠ 0) :
    AlgebraicIndependent K
      (fun o : Option I ↦ o.elim (MvPolynomial.aeval x E / a) x) := by
  have hx : AlgebraicIndependent K x := (AlgebraicIndependent.option_iff.mp h).1
  have hc : hx.aevalEquiv E ≠ 0 := fun hz ↦ hE (hx.aevalEquiv.injective (by simpa using hz))
  have hval : (hx.aevalEquiv E : L) = MvPolynomial.aeval x E := hx.algebraMap_aevalEquiv E
  simpa only [hval] using
    algebraicIndependent_option_exchange h (hx.aevalEquiv E) hc

/-- A polynomial independent of the exchanged index evaluates in the algebra of the others. -/
theorem exchange_eval_mem_adjoin
    {K L I : Type*} [Field K] [Field L] [Algebra K L]
    (x : I → L) (k : I) (E : MvPolynomial I K) (hk : k ∉ E.vars) :
    MvPolynomial.aeval x E ∈ Algebra.adjoin K (Set.range (fun i : {i // i ≠ k} ↦ x i)) := by
  classical
  have heval : MvPolynomial.aeval x E = MvPolynomial.aeval (Function.update x k 0) E := by
    apply MvPolynomial.eval₂Hom_congr' rfl (fun i hi _ ↦ ?_) rfl
    have hik : i ≠ k := fun hik ↦ hk (hik ▸ hi)
    exact (Function.update_of_ne hik 0 x).symm
  rw [heval]
  apply MvPolynomial.eval₂_mem
  · intro m hm
    exact (Algebra.adjoin K _).algebraMap_mem _
  · intro i
    by_cases hik : i = k
    · subst i
      simp
    · rw [Function.update_of_ne hik]
      exact Algebra.subset_adjoin ⟨⟨i, hik⟩, rfl⟩

/-- Genuine selected-coordinate exchange closure of algebraically independent charts. -/
theorem algebraicIndependent_update_exchange
    {K L I : Type*} [Field K] [Field L] [Algebra K L] [DecidableEq I]
    {x : I → L} (h : AlgebraicIndependent K x) (k : I)
    (E : MvPolynomial I K) (hE : E ≠ 0) (hk : k ∉ E.vars) :
    AlgebraicIndependent K (Function.update x k (MvPolynomial.aeval x E / x k)) := by
  let e := Equiv.optionSubtypeNe k
  have ho : AlgebraicIndependent K
      (fun o : Option {i // i ≠ k} ↦ o.elim (x k) (fun i ↦ x i)) := by
    convert h.comp e e.injective using 1
    funext o
    cases o <;> rfl
  let c : Algebra.adjoin K (Set.range (fun i : {i // i ≠ k} ↦ x i)) :=
    ⟨MvPolynomial.aeval x E, exchange_eval_mem_adjoin x k E hk⟩
  have hc : c ≠ 0 := by
    intro hc
    apply hE
    apply h
    simpa [c] using congrArg Subtype.val hc
  have hn := algebraicIndependent_option_exchange ho c hc
  convert hn.comp e.symm e.symm.injective using 1
  funext i
  by_cases hik : i = k
  · subst i
    simp [e, c]
  · simp [e, c, Equiv.optionSubtypeNe_symm_of_ne hik, hik]

/-- A numerator independent of k is unchanged by updating coordinate k. -/
theorem exchange_aeval_update
    {K L I : Type*} [Field K] [Field L] [Algebra K L] [DecidableEq I]
    (x : I → L) (k : I) (E : MvPolynomial I K) (hk : k ∉ E.vars) (a : L) :
    MvPolynomial.aeval (Function.update x k a) E = MvPolynomial.aeval x E := by
  apply MvPolynomial.eval₂Hom_congr' rfl (fun i hi _ ↦ ?_) rfl
  exact Function.update_of_ne (fun hik : i = k ↦ hk (hik ▸ hi)) a x

/-- The same numerator gives an actual involutive coordinate update. -/
theorem update_exchange_twice
    {K L I : Type*} [Field K] [Field L] [Algebra K L] [DecidableEq I]
    {x : I → L} (h : AlgebraicIndependent K x) (k : I)
    (E : MvPolynomial I K) (hE : E ≠ 0) (hk : k ∉ E.vars) :
    let x' := Function.update x k (MvPolynomial.aeval x E / x k)
    Function.update x' k (MvPolynomial.aeval x' E / x' k) = x := by
  dsimp only
  rw [exchange_aeval_update x k E hk]
  have hc : MvPolynomial.aeval x E ≠ 0 := fun hz ↦ hE (h (by simpa using hz))
  funext i
  by_cases hik : i = k
  · subst i
    simp only [Function.update_self]
    by_cases hxk : x k = 0
    · simp [hxk]
    · field_simp
  · simp [Function.update_of_ne hik]

/-- An exchange and its inverse generate the same field over the unchanged coordinates. -/
theorem adjoin_exchange_eq
    {K L : Type*} [Field K] [Field L] [Algebra K L]
    (s : Set L) {x c : L} (hc : c ≠ 0) (hcs : c ∈ IntermediateField.adjoin K s) :
    IntermediateField.adjoin K (insert (c / x) s) =
      IntermediateField.adjoin K (insert x s) := by
  have hsx : IntermediateField.adjoin K s ≤ IntermediateField.adjoin K (insert x s) :=
    IntermediateField.adjoin_le_iff.mpr (fun a ha ↦
      IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ ha))
  have hsz : IntermediateField.adjoin K s ≤ IntermediateField.adjoin K (insert (c / x) s) :=
    IntermediateField.adjoin_le_iff.mpr (fun a ha ↦
      IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ ha))
  apply le_antisymm
  · apply IntermediateField.adjoin_le_iff.mpr
    intro a ha
    rcases Set.mem_insert_iff.mp ha with hax | ha
    · rw [hax]
      exact (IntermediateField.adjoin K (insert x s)).div_mem (hsx hcs)
        (IntermediateField.subset_adjoin K _ (Set.mem_insert x s))
    · exact IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ ha)
  · apply IntermediateField.adjoin_le_iff.mpr
    intro a ha
    rcases Set.mem_insert_iff.mp ha with hax | ha
    · rw [hax]
      have h := (IntermediateField.adjoin K (insert (c / x) s)).div_mem (hsz hcs)
        (IntermediateField.subset_adjoin K _ (Set.mem_insert (c / x) s))
      have heq : c / (c / x) = x := by
        by_cases hx : x = 0
        · simp [hx]
        · field_simp
      have hmem : c / (c / x) ∈
          (IntermediateField.adjoin K (insert (c / x) s) : Set L) := h
      rw [heq] at hmem
      exact hmem
    · exact IntermediateField.subset_adjoin K _ (Set.mem_insert_of_mem _ ha)

theorem range_update_exchange {I L : Type*} [DecidableEq I] (x : I → L) (k : I) (a : L) :
    Set.range (Function.update x k a) = insert a (Set.range (fun i : {i // i ≠ k} ↦ x i)) := by
  ext y
  constructor
  · rintro ⟨i, rfl⟩
    by_cases hik : i = k
    · subst i
      simp
    · rw [Function.update_of_ne hik]
      exact Set.mem_insert_of_mem _ ⟨⟨i, hik⟩, rfl⟩
  · intro hy
    rcases Set.mem_insert_iff.mp hy with rfl | hy
    · exact ⟨k, by simp⟩
    · obtain ⟨i, rfl⟩ := hy
      exact ⟨i, Function.update_of_ne i.property a x⟩

/-- Selected-coordinate polynomial exchange preserves the generated field. -/
theorem adjoin_range_update_exchange
    {K L I : Type*} [Field K] [Field L] [Algebra K L] [DecidableEq I]
    {x : I → L} (h : AlgebraicIndependent K x) (k : I)
    (E : MvPolynomial I K) (hE : E ≠ 0) (hk : k ∉ E.vars) :
    IntermediateField.adjoin K
      (Set.range (Function.update x k (MvPolynomial.aeval x E / x k))) =
      IntermediateField.adjoin K (Set.range x) := by
  let s := Set.range (fun i : {i // i ≠ k} ↦ x i)
  have hs : Algebra.adjoin K s ≤ (IntermediateField.adjoin K s).toSubalgebra :=
    Algebra.adjoin_le (fun a ha ↦ IntermediateField.subset_adjoin K s ha)
  have hc : MvPolynomial.aeval x E ≠ 0 := fun hz ↦ hE (h (by simpa using hz))
  have hm : MvPolynomial.aeval x E ∈ IntermediateField.adjoin K s :=
    hs (exchange_eval_mem_adjoin x k E hk)
  rw [range_update_exchange]
  have hrange : Set.range x = insert (x k) s := by
    simpa using range_update_exchange x k (x k)
  rw [hrange]
  exact adjoin_exchange_eq s hc hm

/--
Inverting a transcendental element and multiplying by a nonzero base scalar preserves
transcendence.
-/
theorem transcendental_exchange {K L : Type*} [Field K] [Field L] [Algebra K L]
    {x : L} (hx : Transcendental K x) {c : K} (hc : c ≠ 0) :
    Transcendental K (algebraMap K L c / x) := by
  intro h
  have hc' : algebraMap K L c ≠ 0 := fun hzero ↦ hc ((algebraMap K L).injective (by simpa using
    hzero))
  have hx' : x ≠ 0 := fun hzero ↦ hx (hzero ▸ isAlgebraic_zero)
  have hh := (isAlgebraic_algebraMap (A := L) c).mul h.inv
  have heq : algebraMap K L c * (algebraMap K L c / x)⁻¹ = x := by
    field_simp
  exact hx (heq ▸ hh)

/-- The rational substitution X ↦ c/X, for nonzero c, extended to all rational functions. -/
def exchangeRatFuncHom {K : Type*} [Field K] (c : K) (hc : c ≠ 0) :
    RatFunc K →ₐ[K] RatFunc K :=
  RatFunc.liftAlgHom (aeval (RatFunc.C c / RatFunc.X))
    (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
      (transcendental_iff_injective.mp (transcendental_exchange RatFunc.transcendental_X hc)))

@[simp] theorem exchangeRatFuncHom_C {K : Type*} [Field K] (c : K) (hc : c ≠ 0) (a : K) :
    exchangeRatFuncHom c hc (RatFunc.C a) = RatFunc.C a :=
  (exchangeRatFuncHom c hc).commutes a

@[simp] theorem exchangeRatFuncHom_X {K : Type*} [Field K] (c : K) (hc : c ≠ 0) :
    exchangeRatFuncHom c hc RatFunc.X = RatFunc.C c / RatFunc.X := by
  unfold exchangeRatFuncHom
  simpa using (RatFunc.liftAlgHom_apply_div
    (aeval (RatFunc.C c / RatFunc.X) : K[X] →ₐ[K] RatFunc K)
    (nonZeroDivisors_le_comap_nonZeroDivisors_of_injective _
      (transcendental_iff_injective.mp
        (transcendental_exchange RatFunc.transcendental_X hc))) Polynomial.X 1)

theorem exchangeRatFuncHom_involutive {K : Type*} [Field K] (c : K) (hc : c ≠ 0) :
    Function.Involutive (exchangeRatFuncHom c hc) := by
  have heq : (exchangeRatFuncHom c hc).toRingHom.comp (exchangeRatFuncHom c hc).toRingHom =
      RingHom.id (RatFunc K) := by
    apply IsFractionRing.ringHom_ext (A := K[X])
    have hp : (((exchangeRatFuncHom c hc).toRingHom.comp
        (exchangeRatFuncHom c hc).toRingHom).comp (algebraMap K[X] (RatFunc K))) =
        algebraMap K[X] (RatFunc K) := by
      apply Polynomial.ringHom_ext
      · intro a
        simp
      · change exchangeRatFuncHom c hc (exchangeRatFuncHom c hc RatFunc.X) = RatFunc.X
        simp only [exchangeRatFuncHom_X, map_div₀, exchangeRatFuncHom_C]
        have hcc : RatFunc.C c ≠ 0 := fun hzero ↦ hc (RatFunc.C_injective (by simpa using hzero))
        field_simp
    intro p
    exact DFunLike.congr_fun hp p
  intro x
  exact DFunLike.congr_fun heq x

/-- The birational involution exchanging X and c/X. -/
def exchangeRatFuncEquiv {K : Type*} [Field K] (c : K) (hc : c ≠ 0) :
    RatFunc K ≃ₐ[K] RatFunc K :=
  AlgEquiv.ofBijective (exchangeRatFuncHom c hc) (exchangeRatFuncHom_involutive c hc).bijective

@[simp] theorem exchangeRatFuncEquiv_X {K : Type*} [Field K] (c : K) (hc : c ≠ 0) :
    exchangeRatFuncEquiv c hc RatFunc.X = RatFunc.C c / RatFunc.X :=
  exchangeRatFuncHom_X c hc

end
