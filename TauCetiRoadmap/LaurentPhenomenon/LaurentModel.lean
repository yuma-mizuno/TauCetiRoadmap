module

public import TauCetiRoadmap.LaurentPhenomenon.Chart
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import Mathlib.GroupTheory.MonoidLocalization.UniqueFactorization
public import Mathlib.RingTheory.Localization.Basic

/-! # Laurent Model -/

@[expose] public section

namespace TauCeti.Laurent
open MvPolynomial
noncomputable section

variable {F I : Type*} [Field F]

/-- The multiplicative submonoid generated by the polynomial variables. -/
def chartMonomials (C : Subring F) (I : Type*) : Submonoid (MvPolynomial I C) :=
  Submonoid.closure (Set.range MvPolynomial.X)

/-- The multivariate polynomial ring localized by inverting all coordinate monomials. -/
abbrev LaurentModel (C : Subring F) (I : Type*) := Localization (chartMonomials C I)

/-- Evaluate the polynomial variables in the actual Laurent chart generated by the given
coordinates.
-/
def polynomialChartHom (C : Subring F) (x : I → F) :
    MvPolynomial I C →+* chartRing C x :=
  MvPolynomial.eval₂Hom (C.inclusion (fun _ ha ↦ coefficient_mem_chartRing C x ha))
    (fun i ↦ ⟨x i, coordinate_mem_chartRing C x i⟩)

@[simp] theorem polynomialChartHom_val (C : Subring F) (x : I → F) (p : MvPolynomial I C) :
    (polynomialChartHom C x p : F) = MvPolynomial.eval₂ C.subtype x p := by
  change (Subring.subtype (chartRing C x)).comp (polynomialChartHom C x) p = _
  have h : (Subring.subtype (chartRing C x)).comp (polynomialChartHom C x) =
      MvPolynomial.eval₂Hom C.subtype x := by
    ext <;> simp [polynomialChartHom]
  exact DFunLike.congr_fun h p

theorem polynomialChartHom_monomial_unit (C : Subring F) (x : I → F)
    (hx : ∀ i, x i ≠ 0) (m : chartMonomials C I) :
    IsUnit (polynomialChartHom C x m) := by
  have hu : ∀ p ∈ chartMonomials C I, IsUnit (polynomialChartHom C x p) := by
    apply Submonoid.closure_induction
    · rintro p ⟨i, rfl⟩
      apply isUnit_iff_exists_inv.mpr
      refine ⟨⟨(x i)⁻¹, inverse_mem_chartRing C x i⟩, ?_⟩
      apply Subtype.ext
      simp [polynomialChartHom_val, hx i]
    · simp
    · intro a b _ _ ha hb
      simpa using ha.mul hb
  exact hu m m.property

/-- Extend polynomial chart evaluation by inverting its nonzero coordinate monomials. -/
def laurentModelHom (C : Subring F) (x : I → F) (hx : ∀ i, x i ≠ 0) :
    LaurentModel C I →+* chartRing C x :=
  IsLocalization.lift (polynomialChartHom_monomial_unit C x hx)

@[simp] theorem laurentModelHom_algebraMap (C : Subring F) (x : I → F) (hx : ∀ i, x i ≠ 0)
    (p : MvPolynomial I C) :
    laurentModelHom C x hx (algebraMap (MvPolynomial I C) (LaurentModel C I) p) =
      polynomialChartHom C x p := by
  exact IsLocalization.lift_eq _ p

theorem laurentModelHom_injective (C : Subring F) (x : I → F) (hx : ∀ i, x i ≠ 0)
    (hi : Function.Injective (MvPolynomial.eval₂Hom C.subtype x)) :
    Function.Injective (laurentModelHom C x hx) := by
  apply (IsLocalization.lift_injective_iff _).mpr
  intro p q
  constructor
  · intro h
    simpa using congrArg (laurentModelHom C x hx) h
  · intro h
    have hpq : p = q := hi (by
      simpa using congrArg (fun z : chartRing C x ↦ (z : F)) h)
    exact congrArg (algebraMap (MvPolynomial I C) (LaurentModel C I)) hpq

theorem laurentModelHom_surjective (C : Subring F) (x : I → F) (hx : ∀ i, x i ≠ 0) :
    Function.Surjective (laurentModelHom C x hx) := by
  let f : LaurentModel C I →+* F := (chartRing C x).subtype.comp (laurentModelHom C x hx)
  let rangeF : Subring F := @RingHom.range (LaurentModel C I) F _ _ f
  have hpoly (p : MvPolynomial I C) :
      f (algebraMap (MvPolynomial I C) (LaurentModel C I) p) = eval₂ C.subtype x p := by
    simp [f]
  have hle : chartRing C x ≤ rangeF := by
    apply chartRing_le
    · intro a ha
      refine ⟨algebraMap (MvPolynomial I C) (LaurentModel C I) (MvPolynomial.C ⟨a, ha⟩), ?_⟩
      simpa using hpoly (MvPolynomial.C ⟨a, ha⟩)
    · intro i
      refine ⟨algebraMap (MvPolynomial I C) (LaurentModel C I) (MvPolynomial.X i), ?_⟩
      simpa using hpoly (MvPolynomial.X i)
    · intro i
      have hmem : MvPolynomial.X i ∈ chartMonomials C I :=
        Submonoid.subset_closure ⟨i, rfl⟩
      obtain ⟨u, hu⟩ := IsLocalization.map_units (LaurentModel C I)
        (⟨MvPolynomial.X i, hmem⟩ : chartMonomials C I)
      refine ⟨↑u⁻¹, ?_⟩
      have hprod : x i * f ↑u⁻¹ = 1 := by
        have h := congrArg f u.val_inv
        rw [map_mul, map_one, hu, hpoly] at h
        simpa using h
      apply mul_left_cancel₀ (hx i)
      rw [hprod, mul_inv_cancel₀ (hx i)]
  intro y
  obtain ⟨z, hz⟩ := hle y.property
  exact ⟨z, Subtype.ext hz⟩

/-- The concrete Laurent chart is the localization at coordinate monomials. -/
def laurentModelEquiv (C : Subring F) (x : I → F) (hx : ∀ i, x i ≠ 0)
    (hi : Function.Injective (MvPolynomial.eval₂Hom C.subtype x)) :
    LaurentModel C I ≃+* chartRing C x :=
  RingEquiv.ofBijective (laurentModelHom C x hx)
    ⟨laurentModelHom_injective C x hx hi, laurentModelHom_surjective C x hx⟩

/-- Unique factorization in the chart is derived from its canonical localization model. -/
theorem chartRing_uniqueFactorizationMonoid (C : Subring F) [UniqueFactorizationMonoid C]
    (x : I → F) (hx : ∀ i, x i ≠ 0)
    (hi : Function.Injective (MvPolynomial.eval₂Hom C.subtype x)) :
    UniqueFactorizationMonoid (chartRing C x) :=
  (laurentModelEquiv C x hx hi).toMulEquiv.uniqueFactorizationMonoid inferInstance

end
end TauCeti.Laurent
