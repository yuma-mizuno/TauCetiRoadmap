/-!
# Mixed Laurent coefficient rings `R_S` (§0.3)

For a commutative ring `R`, a type `J` and `S ⊆ J`, `mixedLaurent R S` is the subalgebra
`R[z_j : j ∈ J][z_s⁻¹ : s ∈ S]` of the Laurent ring `R[ℤ ^ J] = AddMonoidAlgebra R (J →₀ ℤ)`, which
is `R[Trop(J)]` for `Trop(J) = Multiplicative (J →₀ ℤ)`: the elements supported on the exponents
`a` with `a_j ≥ 0` for `j ∉ S`. For `R = ℤ` it is the coefficient ring `R_S`, for a field `𝕜` it
is `𝕜_S`.

* Membership by support (`mem_mixedLaurent`), the monomial basis `mixedLaurentBasis` indexed by
  `mixedLaurentExponents S`, and generation by the `z_j` and the `z_s⁻¹`
  (`mixedLaurent_eq_adjoin`).
* `S = ∅`: `mixedLaurent R ∅` is the image of the polynomial ring (`mixedLaurentEmptyEquiv`,
  sending `x ^ n` to `z ^ n`); `S = J`: `mixedLaurent R univ = ⊤` (`mixedLaurentUnivEquiv`).
* Localization: `mixedLaurent R S` is the localization of `MvPolynomial J R` at the monoid
  generated by the `X_s`, `s ∈ S` (an `IsLocalization` instance; `mixedLaurentLocalizationEquiv`
  identifies it with Mathlib's `Localization`), and for `S ⊆ T`, `mixedLaurent R T` is the
  localization of `mixedLaurent R S` at the `z_t`, `t ∈ T \ S`
  (`isLocalization_mixedLaurent_of_subset`).
-/

@[expose] public section

namespace TauCeti.Laurent

open AddMonoidAlgebra

noncomputable section

variable {J : Type*}

/-! ### Exponents -/

/-- The exponent vectors `a : J →₀ ℤ` with `a_j ≥ 0` for every `j ∉ S`. -/
def mixedLaurentExponents (S : Set J) : AddSubmonoid (J →₀ ℤ) where
  carrier := {a | ∀ j ∉ S, 0 ≤ a j}
  add_mem' ha hb j hj := add_nonneg (ha j hj) (hb j hj)
  zero_mem' _ _ := le_rfl

theorem mem_mixedLaurentExponents {S : Set J} {a : J →₀ ℤ} :
    a ∈ mixedLaurentExponents S ↔ ∀ j ∉ S, 0 ≤ a j :=
  Iff.rfl

theorem mixedLaurentExponents_mono {S T : Set J} (h : S ⊆ T) :
    mixedLaurentExponents S ≤ mixedLaurentExponents T :=
  fun _ ha j hj ↦ ha j fun hS ↦ hj (h hS)

theorem single_mem_mixedLaurentExponents {S : Set J} {j : J} {n : ℤ} (h : j ∈ S ∨ 0 ≤ n) :
    Finsupp.single j n ∈ mixedLaurentExponents S := by
  classical
  intro i hi
  rw [Finsupp.single_apply]
  split_ifs with hji
  · subst hji
    exact h.resolve_left hi
  · exact le_rfl

theorem natExponentHom_mem_mixedLaurentExponents (S : Set J) (n : J →₀ ℕ) :
    natExponentHom J n ∈ mixedLaurentExponents S :=
  fun j _ ↦ by simp

/-! ### The mixed Laurent ring -/

variable (R : Type*) [CommRing R]

/-- **The mixed Laurent ring** `R[z_j : j ∈ J][z_s⁻¹ : s ∈ S] ⊆ R[ℤ ^ J]`: the elements whose
support consists of exponents `a` with `a_j ≥ 0` for `j ∉ S`. For `R = ℤ` this is §0.3's `R_S`,
for a field `𝕜` it is `𝕜_S`. -/
def mixedLaurent (S : Set J) : Subalgebra R (AddMonoidAlgebra R (J →₀ ℤ)) where
  carrier := {f | ∀ a ∈ f.coeff.support, a ∈ mixedLaurentExponents S}
  mul_mem' {x y} hx hy a ha := by
    classical
    obtain ⟨b, hb, c, hc, rfl⟩ := Finset.mem_add.1 (support_coeff_mul_subset x y ha)
    exact add_mem (hx b hb) (hy c hc)
  add_mem' {x y} hx hy a ha := by
    classical
    rw [coeff_add] at ha
    rcases Finset.mem_union.1 (Finsupp.support_add ha) with h | h
    exacts [hx a h, hy a h]
  algebraMap_mem' r a ha := by
    classical
    rw [coe_algebraMap, Function.comp_apply, coeff_single] at ha
    rw [Finset.mem_singleton.1 (Finsupp.support_single_subset ha)]
    exact zero_mem _

variable {R}

theorem mem_mixedLaurent {S : Set J} {f : AddMonoidAlgebra R (J →₀ ℤ)} :
    f ∈ mixedLaurent R S ↔ ∀ a ∈ f.coeff.support, a ∈ mixedLaurentExponents S :=
  Iff.rfl

variable (R)

theorem single_mem_mixedLaurent {S : Set J} {a : J →₀ ℤ} (ha : a ∈ mixedLaurentExponents S)
    (r : R) : single a r ∈ mixedLaurent R S := by
  classical
  intro b hb
  rw [coeff_single] at hb
  rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hb)]
  exact ha

theorem mixedLaurent_mono {S T : Set J} (h : S ⊆ T) : mixedLaurent R S ≤ mixedLaurent R T :=
  fun _ hf a ha ↦ mixedLaurentExponents_mono h (hf a ha)

theorem mixedLaurent_univ : mixedLaurent R (Set.univ : Set J) = ⊤ :=
  eq_top_iff.2 fun _ _ _ _ j hj ↦ absurd (Set.mem_univ j) hj

theorem toSubmodule_mixedLaurent (S : Set J) :
    Subalgebra.toSubmodule (mixedLaurent R S) =
      AddMonoidAlgebra.supported R R (mixedLaurentExponents S : Set (J →₀ ℤ)) := by
  ext f
  exact ⟨fun h _ ha ↦ h _ ha, fun h _ ha ↦ h ha⟩

/-- **The monomial basis** of `R_S`: the `z ^ a` with `a_j ≥ 0` for `j ∉ S`. -/
def mixedLaurentBasis (S : Set J) : Module.Basis (mixedLaurentExponents S) R (mixedLaurent R S) :=
  .ofRepr ((Subalgebra.toSubmoduleEquiv (mixedLaurent R S)).symm ≪≫ₗ
    LinearEquiv.ofEq _ _ (toSubmodule_mixedLaurent R S) ≪≫ₗ
    AddMonoidAlgebra.supportedEquivFinsupp (mixedLaurentExponents S : Set (J →₀ ℤ)))

@[simp] theorem coe_mixedLaurentBasis (S : Set J) (a : mixedLaurentExponents S) :
    (mixedLaurentBasis R S a : AddMonoidAlgebra R (J →₀ ℤ)) = single (a : J →₀ ℤ) 1 := by
  classical
  apply coeff_injective
  rw [mixedLaurentBasis, Module.Basis.coe_ofRepr]
  simp only [AddMonoidAlgebra.supportedEquivFinsupp, LinearEquiv.trans_symm,
    LinearEquiv.trans_apply, LinearEquiv.symm_symm]
  simp only [Subalgebra.toSubmoduleEquiv, coeff_single]
  exact Finsupp.supportedEquivFinsupp_symm_single (R := R) _ a 1

/-- The generator `z_j ^ n` of `R_S`, for `j ∈ S` or `n ≥ 0`. -/
def mixedLaurentVar {S : Set J} (j : J) {n : ℤ} (h : j ∈ S ∨ 0 ≤ n) : mixedLaurent R S :=
  ⟨single (Finsupp.single j n) 1, single_mem_mixedLaurent R (single_mem_mixedLaurentExponents h) 1⟩

@[simp] theorem coe_mixedLaurentVar {S : Set J} (j : J) {n : ℤ} (h : j ∈ S ∨ 0 ≤ n) :
    (mixedLaurentVar R j h : AddMonoidAlgebra R (J →₀ ℤ)) = single (Finsupp.single j n) 1 :=
  rfl

/-- A monomial `z ^ n`, `n ∈ ℕ ^ J`, is the product of the powers `z_j^{n_j}`. -/
theorem single_natExponentHom_eq_prod (n : J →₀ ℕ) :
    (single (natExponentHom J n) 1 : AddMonoidAlgebra R (J →₀ ℤ)) =
      ∏ j ∈ n.support, single (Finsupp.single j 1) 1 ^ n j := by
  simp_rw [single_pow, one_pow]
  rw [prod_single, Finset.prod_const_one]
  congr 1
  conv_lhs => rw [← n.sum_single]
  simp [natExponentHom, Finsupp.sum, map_sum, Finsupp.mapRange_single, Finsupp.smul_single]

/-- `R_S` is generated over `R` by the `z_j`, `j ∈ J`, and the `z_s⁻¹`, `s ∈ S`. -/
theorem mixedLaurent_eq_adjoin (S : Set J) :
    mixedLaurent R S = Algebra.adjoin R
      (Set.range (fun j ↦ (single (Finsupp.single j 1) 1 : AddMonoidAlgebra R (J →₀ ℤ))) ∪
        (fun j ↦ (single (Finsupp.single j (-1)) 1 : AddMonoidAlgebra R (J →₀ ℤ))) '' S) := by
  classical
  refine le_antisymm (fun f hf ↦ ?_) (Algebra.adjoin_le ?_)
  · rw [← sum_coeff_single f, Finsupp.sum]
    refine Subalgebra.sum_mem _ fun a ha ↦ ?_
    have hmono : single a (f.coeff a) = f.coeff a • (single a 1 : AddMonoidAlgebra R (J →₀ ℤ)) :=
      by rw [smul_single, smul_eq_mul, mul_one]
    rw [hmono]
    refine Subalgebra.smul_mem _ ?_ _
    have hprod : (single a 1 : AddMonoidAlgebra R (J →₀ ℤ)) =
        ∏ j ∈ a.support, single (Finsupp.single j (a j)) 1 := by
      rw [prod_single, Finset.prod_const_one]
      congr 1
      exact (Finsupp.sum_single a).symm
    rw [hprod]
    refine Subalgebra.prod_mem _ fun j _ ↦ ?_
    rcases le_or_gt 0 (a j) with hj | hj
    · have : (single (Finsupp.single j (a j)) 1 : AddMonoidAlgebra R (J →₀ ℤ)) =
          single (Finsupp.single j 1) 1 ^ (a j).toNat := by
        rw [single_pow, one_pow, Finsupp.smul_single, nsmul_eq_mul, mul_one,
          Int.toNat_of_nonneg hj]
      rw [this]
      exact pow_mem (Algebra.subset_adjoin (R := R) (Set.mem_union_left _ (Set.mem_range_self j))) _
    · have hjS : j ∈ S := by
        by_contra hjS
        exact absurd (hf a ha j hjS) (not_le.2 hj)
      have : (single (Finsupp.single j (a j)) 1 : AddMonoidAlgebra R (J →₀ ℤ)) =
          single (Finsupp.single j (-1)) 1 ^ (-a j).toNat := by
        rw [single_pow, one_pow, Finsupp.smul_single, nsmul_eq_mul, Int.toNat_of_nonneg (by omega)]
        congr 2
        ring
      rw [this]
      exact pow_mem (Algebra.subset_adjoin (R := R)
        (Set.mem_union_right _ (Set.mem_image_of_mem _ hjS))) _
  · rintro _ (⟨j, rfl⟩ | ⟨j, hj, rfl⟩)
    · exact single_mem_mixedLaurent R (single_mem_mixedLaurentExponents (Or.inr zero_le_one)) 1
    · exact single_mem_mixedLaurent R (single_mem_mixedLaurentExponents (Or.inl hj)) 1

/-! ### `S = ∅` and `S = J` -/

theorem mvPolynomialToLaurent_X (j : J) :
    mvPolynomialToLaurent R J (MvPolynomial.X j) = single (Finsupp.single j 1) 1 := by
  classical
  rw [MvPolynomial.X, mvPolynomialToLaurent_monomial]
  simp [natExponentHom, Finsupp.mapRange_single]

theorem mvPolynomialToLaurent_mem_mixedLaurent (S : Set J) (p : MvPolynomial J R) :
    mvPolynomialToLaurent R J p ∈ mixedLaurent R S := by
  classical
  intro a ha
  obtain ⟨n, -, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support ha)
  exact natExponentHom_mem_mixedLaurentExponents S n

/-- `R_∅` is the image of the polynomial ring `R[z_j : j ∈ J]`. -/
theorem range_mvPolynomialToLaurent :
    (mvPolynomialToLaurent R J).range = mixedLaurent R (∅ : Set J) := by
  classical
  refine le_antisymm ?_ fun f hf ↦ ?_
  · rintro _ ⟨p, rfl⟩
    exact mvPolynomialToLaurent_mem_mixedLaurent R ∅ p
  · rw [← sum_coeff_single f, Finsupp.sum]
    refine Subalgebra.sum_mem _ fun a ha ↦ (AlgHom.mem_range _).2 ⟨MvPolynomial.monomial
      (Finsupp.mapRange Int.toNat (by simp) a) (f.coeff a), ?_⟩
    rw [mvPolynomialToLaurent_monomial]
    congr 1
    ext j
    simp [Int.toNat_of_nonneg (hf a ha j (Set.notMem_empty j))]

/-- **`R_∅ ≃ R[z_j : j ∈ J]`**: the polynomial ring is the mixed Laurent ring with nothing
inverted, `x ^ n ↦ z ^ n`. -/
def mixedLaurentEmptyEquiv : MvPolynomial J R ≃ₐ[R] mixedLaurent R (∅ : Set J) :=
  (AlgEquiv.ofInjective _ mvPolynomialToLaurent_injective).trans
    (Subalgebra.equivOfEq _ _ (range_mvPolynomialToLaurent R))

@[simp] theorem coe_mixedLaurentEmptyEquiv (p : MvPolynomial J R) :
    (mixedLaurentEmptyEquiv R p : AddMonoidAlgebra R (J →₀ ℤ)) = mvPolynomialToLaurent R J p :=
  rfl

/-- The comparison `R_∅ ≃ R[z_j]` matches the monomial bases. -/
theorem mixedLaurentEmptyEquiv_monomial (n : J →₀ ℕ) :
    mixedLaurentEmptyEquiv R (MvPolynomial.monomial n 1) =
      mixedLaurentBasis R ∅ ⟨_, natExponentHom_mem_mixedLaurentExponents ∅ n⟩ := by
  apply Subtype.ext
  rw [coe_mixedLaurentEmptyEquiv, mvPolynomialToLaurent_monomial, coe_mixedLaurentBasis]

/-- **`R_J = R[ℤ ^ J]`**: inverting every `z_j` gives the whole Laurent ring. -/
def mixedLaurentUnivEquiv :
    mixedLaurent R (Set.univ : Set J) ≃ₐ[R] AddMonoidAlgebra R (J →₀ ℤ) :=
  (Subalgebra.equivOfEq _ _ (mixedLaurent_univ R)).trans Subalgebra.topEquiv

@[simp] theorem mixedLaurentUnivEquiv_apply (f : mixedLaurent R (Set.univ : Set J)) :
    mixedLaurentUnivEquiv R f = f :=
  rfl

/-- The comparison `R_J = R[ℤ ^ J]` matches the monomial bases. -/
theorem mixedLaurentUnivEquiv_mixedLaurentBasis (a : mixedLaurentExponents (Set.univ : Set J)) :
    mixedLaurentUnivEquiv R (mixedLaurentBasis R Set.univ a) = single (a : J →₀ ℤ) 1 :=
  coe_mixedLaurentBasis R Set.univ a

/-! ### Clearing denominators -/

/-- For `f ∈ R_T` and any `S`, multiplying by one monomial `z ^ n` with `n` supported on `T \ S`
moves `f` into `R_S`. -/
theorem exists_mul_single_mem_mixedLaurent {S T : Set J} {f : AddMonoidAlgebra R (J →₀ ℤ)}
    (hf : f ∈ mixedLaurent R T) :
    ∃ n : J →₀ ℕ, (∀ j, n j ≠ 0 → j ∈ T ∧ j ∉ S) ∧
      f * single (natExponentHom J n) 1 ∈ mixedLaurent R S := by
  classical
  let n₀ : J →₀ ℕ := ∑ a ∈ f.coeff.support, Finsupp.mapRange Int.toNat (by simp) (-a)
  refine ⟨n₀.filter fun j ↦ j ∈ T ∧ j ∉ S, fun j hj ↦ ?_, fun b hb ↦ ?_⟩
  · by_contra h
    exact hj (Finsupp.filter_apply_neg _ _ h)
  obtain ⟨a, ha, rfl⟩ := Finset.mem_image.1 (support_coeff_mul_single_subset f 1 _ hb)
  intro j hjS
  have hle : (-a j).toNat ≤ n₀ j := by
    simp only [n₀, Finsupp.finsetSum_apply]
    exact Finset.single_le_sum (f := fun b : J →₀ ℤ ↦ (Finsupp.mapRange Int.toNat (by simp) (-b)) j)
      (fun _ _ ↦ Nat.zero_le _) ha |>.trans_eq' (by simp)
  have htn := Int.self_le_toNat (-a j)
  simp only [Finsupp.add_apply, natExponentHom, Finsupp.mapRange.addMonoidHom_apply,
    Finsupp.mapRange_apply, Finsupp.filter_apply, Nat.coe_castAddMonoidHom]
  by_cases hjT : j ∈ T
  · rw [ite_eq_left_iff.2 fun h ↦ absurd ⟨hjT, hjS⟩ h]
    omega
  · have := hf a ha j hjT
    split_ifs <;> omega

/-! ### Localization -/

/-- The submonoid of `R[z_j]` generated by the variables `X_s`, `s ∈ S`. -/
def variablesSubmonoid (S : Set J) : Submonoid (MvPolynomial J R) :=
  Submonoid.closure (MvPolynomial.X '' S)

theorem monomial_mem_variablesSubmonoid {S : Set J} {n : J →₀ ℕ} (hn : ∀ j, n j ≠ 0 → j ∈ S) :
    MvPolynomial.monomial n 1 ∈ variablesSubmonoid R S := by
  rw [MvPolynomial.monomial_eq, MvPolynomial.C_1, one_mul, Finsupp.prod]
  exact Submonoid.prod_mem _ fun j hj ↦ pow_mem (Submonoid.subset_closure
    (Set.mem_image_of_mem _ (hn j (Finsupp.mem_support_iff.1 hj)))) _

/-- The inclusion `R[z_j] → R_S`. -/
def toMixedLaurent (S : Set J) : MvPolynomial J R →ₐ[R] mixedLaurent R S :=
  (mvPolynomialToLaurent R J).codRestrict _ (mvPolynomialToLaurent_mem_mixedLaurent R S)

instance (S : Set J) : Algebra (MvPolynomial J R) (mixedLaurent R S) :=
  (toMixedLaurent R S).toRingHom.toAlgebra

@[simp] theorem coe_algebraMap_mixedLaurent (S : Set J) (p : MvPolynomial J R) :
    (algebraMap (MvPolynomial J R) (mixedLaurent R S) p : AddMonoidAlgebra R (J →₀ ℤ)) =
      mvPolynomialToLaurent R J p :=
  rfl

theorem isUnit_mixedLaurentVar {S : Set J} {j : J} (hj : j ∈ S) {n : ℤ} (h : j ∈ S ∨ 0 ≤ n) :
    IsUnit (mixedLaurentVar R j h : mixedLaurent R S) := by
  refine isUnit_iff_exists_inv.2 ⟨mixedLaurentVar R j (n := -n) (Or.inl hj), Subtype.ext ?_⟩
  simp [single_mul_single, one_def]

/-- **`R_S` localizes the polynomial ring** at the monoid generated by the `z_s`, `s ∈ S`. -/
instance isLocalization_mixedLaurent (S : Set J) :
    IsLocalization (variablesSubmonoid R S) (mixedLaurent R S) := by
  classical
  refine (isLocalization_iff _ _).2 ⟨?_, fun z ↦ ?_, fun {x y} h ↦ ⟨1, ?_⟩⟩
  · rintro ⟨y, hy⟩
    induction hy using Submonoid.closure_induction with
    | mem y hy =>
      obtain ⟨j, hj, rfl⟩ := hy
      convert isUnit_mixedLaurentVar R hj (n := 1) (Or.inl hj) using 1
      exact Subtype.ext (mvPolynomialToLaurent_X R j)
    | one => simp
    | mul x y _ _ hx hy => simpa using hx.mul hy
  · obtain ⟨n, hn, hmem⟩ := exists_mul_single_mem_mixedLaurent R (S := ∅) z.2
    rw [← range_mvPolynomialToLaurent] at hmem
    obtain ⟨p, hp⟩ := hmem
    refine ⟨(p, ⟨_, monomial_mem_variablesSubmonoid R fun j h ↦ (hn j h).1⟩), Subtype.ext ?_⟩
    change (z : AddMonoidAlgebra R (J →₀ ℤ)) *
      mvPolynomialToLaurent R J (MvPolynomial.monomial n 1) = mvPolynomialToLaurent R J p
    rw [mvPolynomialToLaurent_monomial]
    exact hp.symm
  · rw [mvPolynomialToLaurent_injective (congrArg Subtype.val h)]

/-- `R_S` is Mathlib's localization of `R[z_j]` at the `z_s`, `s ∈ S`. -/
def mixedLaurentLocalizationEquiv (S : Set J) :
    Localization (variablesSubmonoid R S) ≃ₐ[MvPolynomial J R] mixedLaurent R S :=
  IsLocalization.algEquiv (variablesSubmonoid R S) _ _

/-- The submonoid of `R_S` generated by the `z_t`, `t ∈ T`. -/
def mixedLaurentVarsSubmonoid (S T : Set J) : Submonoid (mixedLaurent R S) :=
  Submonoid.closure ((fun t ↦ mixedLaurentVar R (S := S) t (n := 1) (Or.inr zero_le_one)) '' T)

/-- **Iterated localization.** For `S ⊆ T`, `R_T` is the localization of `R_S` at the `z_t`,
`t ∈ T \ S`. -/
theorem isLocalization_mixedLaurent_of_subset {S T : Set J} (h : S ⊆ T) :
    letI := (Subalgebra.inclusion (mixedLaurent_mono R h)).toRingHom.toAlgebra
    IsLocalization (mixedLaurentVarsSubmonoid R S (T \ S)) (mixedLaurent R T) := by
  classical
  let := (Subalgebra.inclusion (mixedLaurent_mono R h)).toRingHom.toAlgebra
  refine (isLocalization_iff _ _).2 ⟨?_, fun z ↦ ?_, fun {x y} hxy ↦ ⟨1, ?_⟩⟩
  · rintro ⟨y, hy⟩
    induction hy using Submonoid.closure_induction with
    | mem y hy =>
      obtain ⟨j, hj, rfl⟩ := hy
      exact isUnit_mixedLaurentVar R (S := T) hj.1 (n := 1) (Or.inr zero_le_one)
    | one => simp
    | mul x y _ _ hx hy => simpa using hx.mul hy
  · obtain ⟨n, hn, hmem⟩ := exists_mul_single_mem_mixedLaurent R (S := S) z.2
    have hm : (∏ j ∈ n.support,
        mixedLaurentVar R (S := S) j (n := 1) (Or.inr zero_le_one) ^ n j) ∈
          mixedLaurentVarsSubmonoid R S (T \ S) :=
      Submonoid.prod_mem _ fun j hj ↦ pow_mem (Submonoid.subset_closure
        (Set.mem_image_of_mem _ (show j ∈ T \ S from hn j (Finsupp.mem_support_iff.1 hj)))) _
    refine ⟨(⟨_, hmem⟩, ⟨_, hm⟩), Subtype.ext ?_⟩
    change (z : AddMonoidAlgebra R (J →₀ ℤ)) * ((∏ j ∈ n.support,
        mixedLaurentVar R (S := S) j (n := 1) (Or.inr zero_le_one) ^ n j :
          mixedLaurent R S) : AddMonoidAlgebra R (J →₀ ℤ)) =
        (z : AddMonoidAlgebra R (J →₀ ℤ)) * single (natExponentHom J n) 1
    rw [SubmonoidClass.coe_finsetProd]
    simp only [SubmonoidClass.coe_pow, coe_mixedLaurentVar, ← single_natExponentHom_eq_prod]
  · simp only [OneMemClass.coe_one, one_mul]
    exact Subalgebra.inclusion_injective _ hxy

end

end TauCeti.Laurent
