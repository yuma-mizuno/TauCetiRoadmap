module

public import TauCetiRoadmap.LaurentPhenomenon.SkewExchange
public import Mathlib.Algebra.Polynomial.Laurent
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.Tactic

/-!
# One-exchange charts in a common field

The commutative one-exchange (U1) as the instance of the embedded skew one-exchange
`TauCeti.Laurent.SkewExchange` with the trivial automorphism. Inside a field `F`, a nonzero
coordinate `x` that is transcendental over the fraction field of a subring `C` has powers free
over `C`, so for nonzero `E ∈ C`:

* `C[x^{±1}] ⊓ C[(E/x)^{±1}] = C[x, E/x]` (`chartRing_exchangeIntersection`), also after
  regrouping a multivariable chart at one coordinate (`chartRing_exchangeIntersection_update`);
* an element of `C[x^{±1}]` lies in `C[(E/x)^{±1}]` iff its coefficient at `x ^ (-r)` lies in
  `C * E ^ r` for every `r > 0` (`mem_chartRing_div_iff`).
-/

@[expose] public section

namespace TauCeti.Laurent.OneExchange

open scoped LaurentPolynomial

section DivisionRing

variable {F : Type*} [DivisionRing F]

/-- The coefficient ring obtained by grouping every coordinate except `i`.
The other coordinates and their inverses are part of this ring. -/
def otherCoordinateRing {I : Type*} (C : Subring F) (x : I → F) (i : I) : Subring F :=
  chartRing C (fun j : {j // j ≠ i} ↦ x j)

theorem chartRing_regroup {I : Type*} (C : Subring F) (x : I → F) (i : I) :
    chartRing C x =
      chartRing (otherCoordinateRing C x i) (fun _ : Unit ↦ x i) := by
  classical
  let D := otherCoordinateRing C x i
  apply le_antisymm
  · apply chartRing_le
    · intro a ha
      exact coefficient_mem_chartRing D _ (coefficient_mem_chartRing C _ ha)
    · intro j
      by_cases hj : j = i
      · subst j
        exact coordinate_mem_chartRing D _ ()
      · exact coefficient_mem_chartRing D _
          (coordinate_mem_chartRing C (fun k : {k // k ≠ i} ↦ x k) ⟨j, hj⟩)
    · intro j
      by_cases hj : j = i
      · subst j
        exact inverse_mem_chartRing D _ ()
      · exact coefficient_mem_chartRing D _
          (inverse_mem_chartRing C (fun k : {k // k ≠ i} ↦ x k) ⟨j, hj⟩)
  · apply chartRing_le
    · apply chartRing_le
      · intro a ha
        exact coefficient_mem_chartRing C x ha
      · intro j
        exact coordinate_mem_chartRing C x j
      · intro j
        exact inverse_mem_chartRing C x j
    · intro _
      exact coordinate_mem_chartRing C x i
    · intro _
      exact inverse_mem_chartRing C x i

theorem otherCoordinateRing_update {I : Type*} [DecidableEq I]
    (C : Subring F) (x : I → F) (i : I) (z : F) :
    otherCoordinateRing C (Function.update x i z) i = otherCoordinateRing C x i := by
  unfold otherCoordinateRing
  congr 1
  funext j
  simp [Function.update_of_ne j.property]

end DivisionRing

noncomputable section

variable {F : Type*} [Field F]

/-- The canonical coefficient embedding from the fraction field of a subring
to the ambient field. -/
def fractionCoefficients (C : Subring F) : FractionRing C →+* F :=
  IsFractionRing.lift C.subtype_injective

@[simp] theorem fractionCoefficients_algebraMap (C : Subring F) (a : C) :
    fractionCoefficients C (algebraMap C (FractionRing C) a) = a := by
  exact IsFractionRing.lift_algebraMap C.subtype_injective a

/-- The embedded polynomial ring generated by the two exchange variables. -/
def exchangePairRing (C : Subring F) (x y : F) : Subring F :=
  Subring.closure ((C : Set F) ∪ {x, y})

/-- Transcendence of `x` over the fraction field of `C` makes the integer powers of `x` free
over `C`. -/
theorem leftFree_of_injective (C : Subring F) {x : F} (hx : x ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients C) (Units.mk0 x hx))) :
    SkewExchange.LeftFree C x := by
  classical
  apply SkewExchange.leftFree_of_sum
  intro s c hc hsum i hi
  set N : ℕ := s.sup fun n ↦ (-n).toNat
  have hN : ∀ n ∈ s, 0 ≤ n + N := fun n hn ↦ by
    have : (-n).toNat ≤ N := Finset.le_sup (f := fun n ↦ (-n).toNat) hn
    omega
  let a : ℤ → FractionRing C := fun n ↦
    if h : c n ∈ C then algebraMap C (FractionRing C) ⟨c n, h⟩ else 0
  have ha : ∀ n ∈ s, fractionCoefficients C (a n) = c n := fun n hn ↦ by
    simp only [a, dite_eq_left (hc n hn), fractionCoefficients_algebraMap]
  let p : Polynomial (FractionRing C) := ∑ n ∈ s, Polynomial.monomial (n + N).toNat (a n)
  have hp : p = 0 := by
    apply hpoly
    rw [map_zero]
    simp only [p, Polynomial.coe_eval₂RingHom, Polynomial.eval₂_finsetSum,
      Polynomial.eval₂_monomial, Units.val_mk0]
    calc ∑ n ∈ s, fractionCoefficients C (a n) * x ^ (n + N).toNat =
          (∑ n ∈ s, c n * x ^ n) * x ^ (N : ℤ) := by
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl fun n hn ↦ ?_
          rw [ha n hn, mul_assoc, ← zpow_natCast, ← zpow_add₀ hx, Int.toNat_of_nonneg (hN n hn)]
      _ = 0 := by rw [hsum, zero_mul]
  have hcoeff := congrArg (fun q ↦ q.coeff (i + N).toNat) hp
  simp only [p, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial,
    Polynomial.coeff_zero] at hcoeff
  rw [Finset.sum_eq_single i (fun j hj hji ↦ ite_eq_right fun h ↦ hji (by
      have := hN j hj
      have := hN i hi
      omega)) (fun h ↦ absurd hi h), ite_eq_left rfl] at hcoeff
  simp only [a, dite_eq_left (hc i hi)] at hcoeff
  exact congrArg Subtype.val
    (IsFractionRing.injective C (FractionRing C) (hcoeff.trans (map_zero _).symm))

/-- The hypotheses of the skew one-exchange, with the trivial automorphism. -/
theorem exchangeData_of_injective (C : Subring F) {x : F} (hx : x ≠ 0)
    (E : C) (hE : (E : F) ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients C) (Units.mk0 x hx))) :
    SkewExchange.ExchangeData C x E :=
  ⟨Normalizes.of_ne_zero hx, leftFree_of_injective C hx hpoly, E.property,
    Normalizes.of_ne_zero hE⟩

/-- With the trivial automorphism the ordered products are powers: `P_r = E ^ r`. -/
theorem orderedProduct_eq_pow {x : F} (hx : x ≠ 0) (E : F) (r : ℕ) :
    SkewExchange.orderedProduct x E r = E ^ r := by
  induction r with
  | zero => rw [SkewExchange.orderedProduct, pow_zero]
  | succ r ih =>
    rw [SkewExchange.orderedProduct, ih, SkewExchange.conj, mul_comm _ E, mul_assoc,
      ← zpow_add₀ hx, add_neg_cancel, zpow_zero, mul_one, pow_succ]

/-- The coefficient criterion (U1): an element of `C[x^{±1}]` lies in `C[(E/x)^{±1}]` iff its
coefficient at `x ^ (-r)` lies in `C * E ^ r` for every `r > 0`. -/
theorem mem_chartRing_div_iff (C : Subring F) {x : F} (hx : x ≠ 0)
    (E : C) (hE : (E : F) ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients C) (Units.mk0 x hx)))
    {f : F} (hf : f ∈ chartRing C (fun _ : Unit ↦ x)) :
    f ∈ chartRing C (fun _ : Unit ↦ (E : F) / x) ↔
      ∀ r : ℕ, 0 < r → ∃ c ∈ C, SkewExchange.coeff C x f (-(r : ℤ)) = c * (E : F) ^ r := by
  simp only [div_eq_mul_inv, ← orderedProduct_eq_pow hx]
  exact (exchangeData_of_injective C hx E hE hpoly).mem_chartRing_y_iff hf

/-- L1 in the embedded `chartRing` vocabulary: if the coordinate is
transcendental over the fraction field of the coefficient ring, the two
adjacent Laurent charts intersect in the polynomial ring generated by their
exchange pair. -/
theorem chartRing_exchangeIntersection (C : Subring F) (x : F) (hx : x ≠ 0)
    (E : C) (hE : (E : F) ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom (fractionCoefficients C) (Units.mk0 x hx))) :
    chartRing C (fun _ : Unit ↦ x) ⊓
      chartRing C (fun _ : Unit ↦ (E : F) / x) =
        exchangePairRing C x ((E : F) / x) := by
  rw [div_eq_mul_inv]
  exact (exchangeData_of_injective C hx E hE hpoly).chartRing_inf_chartRing

/-- L1 after regrouping a multivariable chart at the chosen coordinate.
The algebraic-independence input is exactly injectivity of polynomial
evaluation over the fraction field of the other-coordinate chart. -/
theorem chartRing_exchangeIntersection_update {I : Type*} [DecidableEq I]
    (C : Subring F) (x : I → F) (i : I) (hx : x i ≠ 0)
    (E : otherCoordinateRing C x i) (hE : (E : F) ≠ 0)
    (hpoly : Function.Injective
      (Polynomial.eval₂RingHom
        (fractionCoefficients (otherCoordinateRing C x i))
        (Units.mk0 (x i) hx))) :
    chartRing C x ⊓
      chartRing C (Function.update x i ((E : F) / x i)) =
      exchangePairRing (otherCoordinateRing C x i) (x i) ((E : F) / x i) := by
  rw [chartRing_regroup C x i,
    chartRing_regroup C (Function.update x i ((E : F) / x i)) i,
    otherCoordinateRing_update]
  simp only [Function.update_self]
  exact chartRing_exchangeIntersection (otherCoordinateRing C x i) (x i) hx E hE hpoly

end
end TauCeti.Laurent.OneExchange
