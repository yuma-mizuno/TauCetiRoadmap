/-!
# Quantum polynomial and mixed Laurent subalgebras

For a basis `b : Module.Basis ι ℤ L` of the lattice and `S ⊆ ι`, the mixed subalgebra
`basisMixedSubalgebra R u Λ b S` of the quantum torus is the span of the monomials `X ^ a` whose
`b`-coordinates satisfy `a_i ≥ 0` for every `i ∉ S`: the variables `X^{b_i}`, `i ∈ S`, are
inverted, the others are not. The coordinate case `L = M → ℤ` with the standard basis is
`mixedSubalgebra R u Λ S` (an abbreviation); for `S = ∅` it is the quantum polynomial algebra, for
`S = M` the whole torus.

* Membership by support (`mem_basisMixedSubalgebra_iff`, `mem_mixedSubalgebra_iff`) and the
  monomial basis `mixedBasis`.
* **Universal property.** Elements `U_i` of an `R`-algebra with `U_i U_j = u^{2Λ_ij} U_j U_i`,
  units for `i ∈ S` and arbitrary for `i ∉ S`, define a unique algebra map `mixedLift` out of
  `T_S(R,u,Λ)` with `X_i ↦ U_i`. It sends `X ^ a` to the normalized ordered product
  `u^{-Σ_{i<j} a_i a_j Λ_ij} ∏_{i increasing} U_i^{a_i}` along every enumeration of `M`.
* **Localization.** The monoid generated by the `X_i`, `i ∈ T`, is a left Ore set in
  `T_S(R,u,Λ)`, because monomials are normal, and the Ore localization at it is
  `T_{S ∪ T}(R,u,Λ)` (`mixedLocalizationEquiv`).
* **A general basis.** The coordinates of `b` identify `basisMixedSubalgebra R u Λ b S` with the
  coordinate mixed subalgebra of `T(R,u,Λ_b)` on `ι → ℤ` (`mem_basisMixedSubalgebra`,
  `basisMixedEquiv`), which gives its monomial basis `basisMixedBasis`, its universal property
  `basisMixedLift` for `U_i U_j = u^{2Λ(b_i,b_j)} U_j U_i` with the ordered-product formula, and
  its localization at the monomials `X^{b_i}`, `i ∈ T` (`basisMixedLocalizationEquiv`).
-/

@[expose] public section

namespace TauCeti.QuantumTorus

open TauCeti

/-! ### Powers of quasi-commuting elements -/

section Powers

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A]

/-- If `x y = c • y x` for a scalar unit `c`, then `x y ^ n = c ^ n • y ^ n x`. -/
theorem mul_pow_eq_smul_of_mul_eq_smul {x y : A} {c : Rˣ} (h : x * y = (c : R) • (y * x))
    (n : ℕ) : x * y ^ n = ((c ^ n : Rˣ) : R) • (y ^ n * x) := by
  induction n with
  | zero => simp
  | succ n ih =>
    calc x * y ^ (n + 1) = (x * y ^ n) * y := by rw [pow_succ, mul_assoc]
      _ = ((c ^ n : Rˣ) : R) • (y ^ n * (x * y)) := by rw [ih, smul_mul_assoc, mul_assoc]
      _ = ((c ^ (n + 1) : Rˣ) : R) • (y ^ (n + 1) * x) := by
        rw [h, mul_smul_comm, smul_smul, ← Units.val_mul, ← pow_succ, ← mul_assoc, ← pow_succ]

/--
If `x y = c • y x` for a scalar unit `c`, then `x ^ m y ^ n = c^{mn} • y ^ n x ^ m` for `m n : ℕ`.
-/
theorem pow_mul_pow_eq_smul_of_mul_eq_smul {x y : A} {c : Rˣ} (h : x * y = (c : R) • (y * x))
    (m n : ℕ) : x ^ m * y ^ n = ((c ^ ((m : ℤ) * n) : Rˣ) : R) • (y ^ n * x ^ m) := by
  induction m with
  | zero => simp
  | succ m ih =>
    calc x ^ (m + 1) * y ^ n = x ^ m * (x * y ^ n) := by rw [pow_succ, mul_assoc]
      _ = ((c ^ n : Rˣ) : R) • ((x ^ m * y ^ n) * x) := by
        rw [mul_pow_eq_smul_of_mul_eq_smul h, mul_smul_comm, mul_assoc]
      _ = ((c ^ ((m + 1 : ℕ) * n : ℤ) : Rˣ) : R) • (y ^ n * x ^ (m + 1)) := by
        rw [ih, smul_mul_assoc, smul_smul, ← Units.val_mul, mul_assoc, ← pow_succ, ← zpow_natCast,
          ← zpow_add]
        congr 3
        push_cast
        ring

/--
If `x y = c • y x` for a unit `x` and a scalar unit `c`, then `x ^ m y ^ n = c^{mn} • y ^ n x ^
m`
for `m : ℤ` and `n : ℕ`. -/
theorem zpow_mul_pow_eq_smul_of_mul_eq_smul {x : Aˣ} {y : A} {c : Rˣ}
    (h : (x : A) * y = (c : R) • (y * x)) (m : ℤ) (n : ℕ) :
    ((x ^ m : Aˣ) : A) * y ^ n = ((c ^ (m * n) : Rˣ) : R) • (y ^ n * ((x ^ m : Aˣ) : A)) := by
  have hinv : ((x⁻¹ : Aˣ) : A) * y = ((c⁻¹ : Rˣ) : R) • (y * ((x⁻¹ : Aˣ) : A)) := by
    have e : y * ((x⁻¹ : Aˣ) : A) = (c : R) • (((x⁻¹ : Aˣ) : A) * y) := by
      calc y * ((x⁻¹ : Aˣ) : A) = ((x⁻¹ : Aˣ) : A) * ((x : A) * y) * ((x⁻¹ : Aˣ) : A) := by
            rw [Units.inv_mul_cancel_left]
        _ = (c : R) • (((x⁻¹ : Aˣ) : A) * y) := by
            rw [h, mul_smul_comm, smul_mul_assoc]
            simp [mul_assoc]
    rw [e, smul_smul, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul]
  cases m with
  | ofNat k =>
    simpa only [Int.ofNat_eq_natCast, zpow_natCast, Units.val_pow_eq_pow_val] using
      pow_mul_pow_eq_smul_of_mul_eq_smul h k n
  | negSucc k =>
    have := pow_mul_pow_eq_smul_of_mul_eq_smul hinv (k + 1) n
    rw [zpow_negSucc, ← inv_pow, Units.val_pow_eq_pow_val, this, inv_zpow', Int.negSucc_eq]
    congr 3

/--
If `x y = c • y x` for a unit `y` and a scalar unit `c`, then `x ^ m y ^ n = c^{mn} • y ^ n x ^
m`
for `m : ℕ` and `n : ℤ`. -/
theorem pow_mul_zpow_eq_smul_of_mul_eq_smul {x : A} {y : Aˣ} {c : Rˣ}
    (h : x * y = (c : R) • ((y : A) * x)) (m : ℕ) (n : ℤ) :
    x ^ m * ((y ^ n : Aˣ) : A) = ((c ^ ((m : ℤ) * n) : Rˣ) : R) • (((y ^ n : Aˣ) : A) * x ^ m) := by
  have h' : (y : A) * x = ((c⁻¹ : Rˣ) : R) • (x * y) := by
    rw [h, smul_smul, ← Units.val_mul, inv_mul_cancel, Units.val_one, one_smul]
  rw [zpow_mul_pow_eq_smul_of_mul_eq_smul h' n m, smul_smul, ← Units.val_mul, inv_zpow',
    ← zpow_add, mul_comm n, add_neg_cancel, zpow_zero, Units.val_one, one_smul]

end Powers

/-! ### Mixed powers and ordered products -/

section MixedProducts

variable {R : Type*} [CommRing R] {A : Type*} [Ring A] [Algebra R A] {M : Type*}

/-- Elements `U_i` of `A` quasi-commute according to `u` and `Λ`:
`U_i U_j = u^{2Λ_ij} U_j U_i`. For units this is `TauCeti.QuantumTorus.IsQuasiCommuting`. -/
def IsQuasiCommutingFamily [DecidableEq M] (u : Rˣ) (Λ : LinearMap.BilinForm ℤ (M → ℤ))
    (U : M → A) : Prop :=
  ∀ i j, U i * U j = ((u ^ (2 * Λ (Pi.single i 1) (Pi.single j 1)) : Rˣ) : R) • (U j * U i)

theorem IsQuasiCommuting.isQuasiCommutingFamily [DecidableEq M] {u : Rˣ}
    {Λ : LinearMap.BilinForm ℤ (M → ℤ)} {U : M → Aˣ} (hU : IsQuasiCommuting u Λ U) :
    IsQuasiCommutingFamily u Λ fun i ↦ (U i : A) :=
  hU

open Classical in
/-- The power `U_i ^ n`: an integral power of the unit `U_i` for `i ∈ S`, and the natural power
`U_i^{max(n,0)}` for `i ∉ S`. -/
noncomputable def mixedPow (S : Set M) (U : M → A) (hS : ∀ i ∈ S, IsUnit (U i)) (i : M)
    (n : ℤ) : A :=
  if h : i ∈ S then (((hS i h).unit ^ n : Aˣ) : A) else U i ^ n.toNat

variable {S : Set M} {U : M → A} {hS : ∀ i ∈ S, IsUnit (U i)}

theorem mixedPow_of_mem {i : M} (hi : i ∈ S) (n : ℤ) :
    mixedPow S U hS i n = (((hS i hi).unit ^ n : Aˣ) : A) := by
  simp [mixedPow, hi]

theorem mixedPow_of_notMem {i : M} (hi : i ∉ S) (n : ℤ) :
    mixedPow S U hS i n = U i ^ n.toNat := by
  simp [mixedPow, hi]

@[simp] theorem mixedPow_natCast (i : M) (n : ℕ) : mixedPow S U hS i n = U i ^ n := by
  by_cases hi : i ∈ S
  · rw [mixedPow_of_mem hi, zpow_natCast, Units.val_pow_eq_pow_val, IsUnit.unit_spec]
  · rw [mixedPow_of_notMem hi, Int.toNat_natCast]

@[simp] theorem mixedPow_zero (i : M) : mixedPow S U hS i 0 = 1 := by
  simpa using mixedPow_natCast (hS := hS) i 0

@[simp] theorem mixedPow_one (i : M) : mixedPow S U hS i 1 = U i := by
  simpa using mixedPow_natCast (hS := hS) i 1

theorem mixedPow_add {i : M} {m n : ℤ} (h : i ∈ S ∨ 0 ≤ m ∧ 0 ≤ n) :
    mixedPow S U hS i m * mixedPow S U hS i n = mixedPow S U hS i (m + n) := by
  by_cases hi : i ∈ S
  · simp only [mixedPow_of_mem hi, zpow_add, Units.val_mul]
  · obtain ⟨hm, hn⟩ := h.resolve_left hi
    lift m to ℕ using hm
    lift n to ℕ using hn
    rw [← Nat.cast_add, mixedPow_natCast, mixedPow_natCast, mixedPow_natCast, pow_add]

variable (S) in
/-- The exponents `a` with `a i ≥ 0` for every `i ∉ S`. -/
def mixedExponents : AddSubmonoid (M → ℤ) where
  carrier := {a | ∀ i ∉ S, 0 ≤ a i}
  add_mem' ha hb i hi := add_nonneg (ha i hi) (hb i hi)
  zero_mem' _ _ := le_rfl

theorem mem_mixedExponents {a : M → ℤ} : a ∈ mixedExponents S ↔ ∀ i ∉ S, 0 ≤ a i :=
  Iff.rfl

theorem mem_mixedExponents_iff_or {a : M → ℤ} : a ∈ mixedExponents S ↔ ∀ i, i ∈ S ∨ 0 ≤ a i :=
  ⟨fun h i ↦ (em (i ∈ S)).imp_right (h i), fun h i hi ↦ (h i).resolve_left hi⟩

theorem mixedExponents_mono {S' : Set M} (h : S ⊆ S') : mixedExponents S ≤ mixedExponents S' :=
  fun _ ha i hi ↦ ha i fun hS ↦ hi (h hS)

variable (S U hS) in
/-- The ordered product `∏_{i ∈ l} U_i^{a_i}` of mixed powers, in the order of the list `l`. -/
noncomputable def mixedOrderedProd (l : List M) (a : M → ℤ) : A :=
  (l.map fun i ↦ mixedPow S U hS i (a i)).prod

@[simp] theorem mixedOrderedProd_nil (a : M → ℤ) : mixedOrderedProd S U hS [] a = 1 := rfl
@[simp] theorem mixedOrderedProd_cons (i : M) (l : List M) (a : M → ℤ) :
    mixedOrderedProd S U hS (i :: l) a = mixedPow S U hS i (a i) * mixedOrderedProd S U hS l a := by
  simp [mixedOrderedProd]

@[simp] theorem mixedOrderedProd_zero (l : List M) : mixedOrderedProd S U hS l 0 = 1 := by
  induction l <;> simp_all

variable [DecidableEq M] {u : Rˣ} {Λ : LinearMap.BilinForm ℤ (M → ℤ)}

theorem zpow_two_mul_single (i j : M) (m n : ℤ) :
    (u ^ (2 * Λ (Pi.single i 1) (Pi.single j 1))) ^ (m * n) =
      u ^ (2 * Λ (m • Pi.single i 1) (n • Pi.single j 1)) := by
  rw [← zpow_mul]
  congr 1
  simp only [map_zsmul, LinearMap.smul_apply, smul_eq_mul]
  ring

/-- **Quasi-commutation of mixed powers.** -/
theorem IsQuasiCommutingFamily.mixedPow_mul_mixedPow (hU : IsQuasiCommutingFamily u Λ U)
    {i j : M} {m n : ℤ} (hm : i ∈ S ∨ 0 ≤ m) (hn : j ∈ S ∨ 0 ≤ n) :
    mixedPow S U hS i m * mixedPow S U hS j n =
      ((u ^ (2 * Λ (m • Pi.single i 1) (n • Pi.single j 1)) : Rˣ) : R) •
        (mixedPow S U hS j n * mixedPow S U hS i m) := by
  rw [← zpow_two_mul_single]
  have hij := hU i j
  by_cases hi : i ∈ S <;> by_cases hj : j ∈ S
  · rw [mixedPow_of_mem hi, mixedPow_of_mem hj]
    exact units_zpow_mul_zpow (by simpa only [IsUnit.unit_spec] using hij) m n
  · lift n to ℕ using hn.resolve_left hj
    rw [mixedPow_of_mem hi, mixedPow_natCast]
    exact zpow_mul_pow_eq_smul_of_mul_eq_smul (by simpa only [IsUnit.unit_spec] using hij) m n
  · lift m to ℕ using hm.resolve_left hi
    rw [mixedPow_of_mem hj, mixedPow_natCast]
    exact pow_mul_zpow_eq_smul_of_mul_eq_smul (by simpa only [IsUnit.unit_spec] using hij) m n
  · lift m to ℕ using hm.resolve_left hi
    lift n to ℕ using hn.resolve_left hj
    rw [mixedPow_natCast, mixedPow_natCast]
    exact pow_mul_pow_eq_smul_of_mul_eq_smul hij m n


theorem zsmul_single_mem_mixedExponents {i : M} {n : ℤ} (h : i ∈ S ∨ 0 ≤ n) :
    n • Pi.single i (1 : ℤ) ∈ mixedExponents S := by
  intro j hj
  by_cases hji : j = i
  · subst hji
    simpa using h.resolve_left hj
  · simp [hji]

theorem listExponent_mem_mixedExponents {a : M → ℤ} (ha : a ∈ mixedExponents S) (l : List M) :
    listExponent l a ∈ mixedExponents S := by
  induction l with
  | nil => exact zero_mem _
  | cons i l ih =>
    rw [listExponent_cons]
    exact add_mem (zsmul_single_mem_mixedExponents (mem_mixedExponents_iff_or.1 ha i)) ih

/-- The normalized ordered product `u^{-Σ_{i<j} a_i a_j Λ_ij} ∏_{i ∈ l} U_i^{a_i}`. -/
noncomputable def mixedNormalizedProd (u : Rˣ) (Λ : LinearMap.BilinForm ℤ (M → ℤ)) (S : Set M)
    (U : M → A) (hS : ∀ i ∈ S, IsUnit (U i)) (l : List M) (a : M → ℤ) : A :=
  ((u ^ (-orderCorrection Λ l a) : Rˣ) : R) • mixedOrderedProd S U hS l a

theorem mixedNormalizedProd_congr {U' : M → A} {hS' : ∀ i ∈ S, IsUnit (U' i)} (h : U = U')
    (l : List M) (a : M → ℤ) :
    mixedNormalizedProd u Λ S U hS l a = mixedNormalizedProd u Λ S U' hS' l a := by
  subst h
  rfl

@[simp] theorem mixedNormalizedProd_zero (l : List M) :
    mixedNormalizedProd u Λ S U hS l 0 = 1 := by
  simp [mixedNormalizedProd]

theorem mixedOrderedProd_single {l : List M} (hl : l.Nodup) (i : M) :
    mixedOrderedProd S U hS l (Pi.single i 1) = if i ∈ l then U i else 1 := by
  induction l with
  | nil => simp
  | cons j l ih =>
    obtain ⟨hj, hl⟩ := List.nodup_cons.1 hl
    rw [mixedOrderedProd_cons, ih hl]
    by_cases hji : j = i
    · subst hji
      simp [hj]
    · simp [Ne.symm hji, hji]

theorem mixedNormalizedProd_single {l : List M} (hl : l.Nodup) {i : M} (hi : i ∈ l) :
    mixedNormalizedProd u Λ S U hS l (Pi.single i 1) = U i := by
  rw [mixedNormalizedProd, orderCorrection_single hl, mixedOrderedProd_single hl]
  simp [hi]

theorem IsQuasiCommutingFamily.mixedOrderedProd_mul_mixedPow (hU : IsQuasiCommutingFamily u Λ U)
    (l : List M) {a : M → ℤ} (ha : a ∈ mixedExponents S) (i : M) {b : ℤ} (hb : i ∈ S ∨ 0 ≤ b) :
    mixedOrderedProd S U hS l a * mixedPow S U hS i b =
      ((u ^ (2 * Λ (listExponent l a) (b • Pi.single i 1)) : Rˣ) : R) •
        (mixedPow S U hS i b * mixedOrderedProd S U hS l a) := by
  induction l with
  | nil => simp
  | cons j l ih =>
    rw [mixedOrderedProd_cons, mul_assoc, ih, mul_smul_comm, ← mul_assoc,
      hU.mixedPow_mul_mixedPow (mem_mixedExponents_iff_or.1 ha j) hb, smul_mul_assoc, smul_smul,
      ← Units.val_mul, ← zpow_add, mul_assoc]
    congr 3
    simp only [listExponent_cons, map_add, LinearMap.add_apply]
    ring

theorem IsQuasiCommutingFamily.mixedOrderedProd_mul (hU : IsQuasiCommutingFamily u Λ U)
    (l : List M) {a b : M → ℤ} (ha : a ∈ mixedExponents S) (hb : b ∈ mixedExponents S) :
    mixedOrderedProd S U hS l a * mixedOrderedProd S U hS l b =
      ((u ^ orderTwist Λ l a b : Rˣ) : R) • mixedOrderedProd S U hS l (a + b) := by
  induction l with
  | nil => simp [orderTwist]
  | cons i l ih =>
    simp only [mixedOrderedProd_cons, Pi.add_apply]
    have e : mixedPow S U hS i (a i) * mixedOrderedProd S U hS l a *
        (mixedPow S U hS i (b i) * mixedOrderedProd S U hS l b) =
        mixedPow S U hS i (a i) * ((mixedOrderedProd S U hS l a * mixedPow S U hS i (b i)) *
          mixedOrderedProd S U hS l b) := by
      simp only [mul_assoc]
    have hab : i ∈ S ∨ 0 ≤ a i ∧ 0 ≤ b i := by
      by_cases hi : i ∈ S
      · exact Or.inl hi
      · exact Or.inr ⟨ha i hi, hb i hi⟩
    rw [e, hU.mixedOrderedProd_mul_mixedPow l ha i (mem_mixedExponents_iff_or.1 hb i),
      smul_mul_assoc, mul_smul_comm, mul_assoc, ih, ← mul_assoc, mixedPow_add hab]
    simp only [mul_smul_comm, smul_smul, ← Units.val_mul, ← zpow_add, orderTwist]

/-- **The cocycle identity of normalized ordered products** of mixed powers. -/
theorem IsQuasiCommutingFamily.mixedNormalizedProd_mul (hΛ : LinearMap.IsAlt Λ)
    (hU : IsQuasiCommutingFamily u Λ U) (l : List M) {a b : M → ℤ} (ha : a ∈ mixedExponents S)
    (hb : b ∈ mixedExponents S) :
    mixedNormalizedProd u Λ S U hS l a * mixedNormalizedProd u Λ S U hS l b =
      ((u ^ Λ (listExponent l a) (listExponent l b) : Rˣ) : R) •
        mixedNormalizedProd u Λ S U hS l (a + b) := by
  simp only [mixedNormalizedProd, smul_mul_assoc, mul_smul_comm, smul_smul,
    hU.mixedOrderedProd_mul l ha hb, ← Units.val_mul, ← zpow_add, orderTwist_eq hΛ]
  congr 3
  ring

end MixedProducts


/-! ### Mixed subalgebras for a basis of the lattice -/

section BasisSubalgebra

variable {R : Type*} [CommRing R] {u : Rˣ} {L : Type*} [AddCommGroup L]
  {Λ : LinearMap.BilinForm ℤ L} {ι : Type*} (b : Module.Basis ι ℤ L)

/-- The exponents `a` whose `b`-coordinates satisfy `a_i ≥ 0` for every `i ∉ S`. -/
def basisMixedExponents (S : Set ι) : AddSubmonoid L where
  carrier := {a | ∀ i ∉ S, 0 ≤ b.repr a i}
  add_mem' {a c} ha hc i hi := by
    rw [map_add, Finsupp.add_apply]
    exact add_nonneg (ha i hi) (hc i hi)
  zero_mem' i _ := by simp

theorem mem_basisMixedExponents {S : Set ι} {a : L} :
    a ∈ basisMixedExponents b S ↔ ∀ i ∉ S, 0 ≤ b.repr a i :=
  Iff.rfl

variable (R u Λ) in
/-- The mixed subalgebra of `T(R,u,Λ)` for a basis `b` of `L` and `S ⊆ ι`: the span of the
monomials `X ^ a` whose `b`-coordinates satisfy `a_i ≥ 0` for every `i ∉ S`. The variables
  `X^{b_i}`,
`i ∈ S`, are inverted, the others are not. For `L = M → ℤ` and the standard basis this is
`mixedSubalgebra`. -/
noncomputable def basisMixedSubalgebra (S : Set ι) : Subalgebra R (quantumTorus R u Λ) :=
  Submodule.toSubalgebra
    (Submodule.span R ((monomial : L → quantumTorus R u Λ) '' (basisMixedExponents b S : Set L)))
    (Submodule.subset_span ⟨0, zero_mem _, monomial_zero⟩)
    (by
      have hle : ∀ P : Submodule R (quantumTorus R u Λ),
          P = Submodule.span R ((monomial : L → quantumTorus R u Λ) ''
            (basisMixedExponents b S : Set L)) → P * P ≤ P := by
        rintro P rfl
        rw [Submodule.span_mul_span]
        refine Submodule.span_le.2 ?_
        rintro _ ⟨_, ⟨a, ha, rfl⟩, _, ⟨c, hc, rfl⟩, rfl⟩
        dsimp only
        rw [SetLike.mem_coe, monomial_mul_monomial]
        exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨a + c, add_mem ha hc, rfl⟩)
      exact fun _ _ hx hy ↦ hle _ rfl (Submodule.mul_mem_mul hx hy))

variable {S : Set ι}

theorem toSubmodule_basisMixedSubalgebra :
    Subalgebra.toSubmodule (basisMixedSubalgebra R u Λ b S) =
      Submodule.span R (monomial '' (basisMixedExponents b S : Set L)) :=
  Submodule.toSubalgebra_toSubmodule _ _ _

/-- **Membership by support.** -/
theorem mem_basisMixedSubalgebra_iff {f : quantumTorus R u Λ} :
    f ∈ basisMixedSubalgebra R u Λ b S ↔ ∀ a ∈ support f, ∀ i ∉ S, 0 ≤ b.repr a i := by
  rw [← Subalgebra.mem_toSubmodule, toSubmodule_basisMixedSubalgebra,
    show (monomial : L → quantumTorus R u Λ) = monomialBasis from
      funext fun a ↦ (monomialBasis_apply a).symm, Module.Basis.mem_span_image]
  rfl

end BasisSubalgebra

/-! ### The mixed subalgebra and its monomial basis -/

section Subalgebra

variable {R : Type*} [CommRing R] {u : Rˣ} {M : Type*} [Finite M]
  {Λ : LinearMap.BilinForm ℤ (M → ℤ)}

theorem basisMixedExponents_basisFun (S : Set M) :
    basisMixedExponents (Pi.basisFun ℤ M) S = mixedExponents S := by
  ext a
  simp [mem_basisMixedExponents, mem_mixedExponents]

variable (R u Λ) in
/-- The mixed subalgebra `T_S(R,u,Λ)` of the coordinate lattice `M → ℤ`: `basisMixedSubalgebra`
for the standard basis, the span of the monomials `X ^ a` with `a i ≥ 0` for every `i ∉ S`. For
`S = ∅` it is the quantum polynomial algebra, for `S = univ` the whole torus. -/
noncomputable abbrev mixedSubalgebra (S : Set M) : Subalgebra R (quantumTorus R u Λ) :=
  basisMixedSubalgebra R u Λ (Pi.basisFun ℤ M) S

variable (R u Λ) in
/-- The quantum polynomial algebra: the mixed subalgebra with no inverted variable. -/
noncomputable abbrev polynomialSubalgebra : Subalgebra R (quantumTorus R u Λ) :=
  mixedSubalgebra R u Λ (∅ : Set M)

variable {S : Set M}

theorem toSubmodule_mixedSubalgebra :
    Subalgebra.toSubmodule (mixedSubalgebra R u Λ S) =
      Submodule.span R (monomial '' (mixedExponents S : Set (M → ℤ))) := by
  rw [toSubmodule_basisMixedSubalgebra, basisMixedExponents_basisFun]

/-- **Membership by support.** -/
theorem mem_mixedSubalgebra_iff {f : quantumTorus R u Λ} :
    f ∈ mixedSubalgebra R u Λ S ↔ ∀ a ∈ support f, a ∈ mixedExponents S := by
  rw [← Subalgebra.mem_toSubmodule, toSubmodule_mixedSubalgebra,
    show (monomial : (M → ℤ) → quantumTorus R u Λ) = monomialBasis from
      funext fun a ↦ (monomialBasis_apply a).symm, Module.Basis.mem_span_image]
  rfl

theorem monomial_mem_mixedSubalgebra {a : M → ℤ} (ha : a ∈ mixedExponents S) :
    (monomial a : quantumTorus R u Λ) ∈ mixedSubalgebra R u Λ S := by
  rw [← Subalgebra.mem_toSubmodule, toSubmodule_mixedSubalgebra]
  exact Submodule.subset_span ⟨a, ha, rfl⟩

theorem mixedSubalgebra_mono {S' : Set M} (h : S ⊆ S') :
    mixedSubalgebra R u Λ S ≤ mixedSubalgebra R u Λ S' := fun _ hf ↦
  mem_mixedSubalgebra_iff.2 fun a ha ↦ mixedExponents_mono h (mem_mixedSubalgebra_iff.1 hf a ha)

/-- With every variable inverted, the mixed subalgebra is the whole torus. -/
theorem mixedSubalgebra_univ : mixedSubalgebra R u Λ (Set.univ : Set M) = ⊤ :=
  eq_top_iff.2 fun _ _ ↦ mem_mixedSubalgebra_iff.2 fun _ _ i hi ↦ absurd (Set.mem_univ i) hi

/--
Conjugation by a monomial preserves the mixed subalgebra: `X ^ a f = f' X ^ a` with `f'` in it.
-/
theorem exists_monomial_mul_eq_mul_monomial (a : M → ℤ) {f : quantumTorus R u Λ}
    (hf : f ∈ mixedSubalgebra R u Λ S) :
    ∃ f' ∈ mixedSubalgebra R u Λ S, monomial a * f = f' * monomial a := by
  have hconj : monomial a * f * monomial (-a) ∈ mixedSubalgebra R u Λ S := by
    rw [← Subalgebra.mem_toSubmodule, toSubmodule_mixedSubalgebra] at hf ⊢
    induction hf using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨b, hb, rfl⟩ := hx
      rw [monomial_mul_monomial, smul_mul_assoc, monomial_mul_monomial, smul_smul,
        show a + b + -a = b by abel]
      exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨b, hb, rfl⟩)
    | zero => simp
    | add x y _ _ hx hy =>
      rw [mul_add, add_mul]
      exact add_mem hx hy
    | smul c x _ hx =>
      rw [mul_smul_comm, smul_mul_assoc]
      exact Submodule.smul_mem _ c hx
  refine ⟨((u ^ (-Λ (-a) a) : Rˣ) : R) • (monomial a * f * monomial (-a)),
    Subalgebra.smul_mem _ hconj _, ?_⟩
  rw [smul_mul_assoc, mul_assoc (monomial a * f), monomial_mul_monomial, neg_add_cancel,
    monomial_zero, mul_smul_comm, mul_one, smul_smul, ← Units.val_mul, ← zpow_add, neg_add_cancel,
    zpow_zero, Units.val_one, one_smul]

/-- A monomial `X ^ a` with `a` and `-a` in the exponent monoid is a unit of the mixed
subalgebra. -/
theorem isUnit_monomial_of_neg_mem {a : M → ℤ} (ha : a ∈ mixedExponents S)
    (hna : -a ∈ mixedExponents S) :
    IsUnit (⟨monomial a, monomial_mem_mixedSubalgebra ha⟩ : mixedSubalgebra R u Λ S) := by
  refine ⟨⟨_, ⟨((u ^ (-Λ a (-a)) : Rˣ) : R) • monomial (-a),
    Subalgebra.smul_mem _ (monomial_mem_mixedSubalgebra hna) _⟩, ?_, ?_⟩, rfl⟩ <;>
    apply Subtype.ext <;>
    simp only [Subalgebra.coe_mul, Subalgebra.coe_one, mul_smul_comm,
      smul_mul_assoc, monomial_mul_monomial, smul_smul, ← Units.val_mul, ← zpow_add, add_neg_cancel,
      neg_add_cancel, monomial_zero, map_neg, LinearMap.neg_apply, neg_neg]
  · simp
  · simp

omit [Finite M] in
theorem linearIndependent_monomial_mixedExponents :
    LinearIndependent R fun a : mixedExponents S ↦ (monomial (a : M → ℤ) : quantumTorus R u Λ) := by
  have h := (monomialBasis : Module.Basis (M → ℤ) R (quantumTorus R u Λ)).linearIndependent.comp
    (Subtype.val : mixedExponents S → M → ℤ) Subtype.val_injective
  simpa [Function.comp_def] using h

variable (R u Λ S) in
/-- The monomial basis of the mixed subalgebra, indexed by the exponent monoid. -/
noncomputable def mixedBasis : Module.Basis (mixedExponents S) R (mixedSubalgebra R u Λ S) :=
  (Module.Basis.span linearIndependent_monomial_mixedExponents).map
    ((LinearEquiv.ofEq _ _ (by rw [toSubmodule_mixedSubalgebra, Set.image_eq_range]; rfl)).trans
      (Subalgebra.toSubmoduleEquiv _))

@[simp] theorem coe_mixedBasis (a : mixedExponents S) :
    (mixedBasis R u Λ S a : quantumTorus R u Λ) = monomial (a : M → ℤ) := by
  simp [mixedBasis]
  rfl

theorem mixedBasis_zero : mixedBasis R u Λ S 0 = 1 :=
  Subtype.ext (by simp)

/-- The multiplication table of the monomial basis. -/
theorem mixedBasis_mul_mixedBasis (a b : mixedExponents S) :
    mixedBasis R u Λ S a * mixedBasis R u Λ S b =
      ((u ^ Λ a b : Rˣ) : R) • mixedBasis R u Λ S (a + b) :=
  Subtype.ext (by simp [monomial_mul_monomial])

/-- An algebra map out of the mixed subalgebra is injective iff it keeps the basis monomials
linearly independent. -/
theorem mixedSubalgebra_algHom_injective_iff {A : Type*} [Ring A] [Algebra R A]
    (f : mixedSubalgebra R u Λ S →ₐ[R] A) :
    Function.Injective f ↔ LinearIndependent R fun a ↦ f (mixedBasis R u Λ S a) := by
  rw [linearIndependent_iff_injective_finsuppLinearCombination]
  have h : ⇑(Finsupp.linearCombination R fun a ↦ f (mixedBasis R u Λ S a)) =
      f ∘ (mixedBasis R u Λ S).repr.symm := by
    funext l
    rw [Function.comp_apply, Module.Basis.repr_symm_apply]
    exact (Finsupp.apply_linearCombination R f.toLinearMap _ l).symm
  rw [h, Function.Injective.of_comp_iff' _ (mixedBasis R u Λ S).repr.symm.bijective]

theorem polynomialSubalgebra_algHom_injective_iff {A : Type*} [Ring A] [Algebra R A]
    (f : polynomialSubalgebra R u Λ →ₐ[R] A) :
    Function.Injective f ↔ LinearIndependent R fun a ↦ f (mixedBasis R u Λ ∅ a) :=
  mixedSubalgebra_algHom_injective_iff f

/-- Every element of the quantum torus becomes polynomial after right multiplication by a
monomial. -/
theorem exists_mul_monomial_mem_polynomialSubalgebra (f : quantumTorus R u Λ) :
    ∃ N : M → ℤ, f * monomial N ∈ polynomialSubalgebra R u Λ := by
  let : Fintype M := Fintype.ofFinite M
  set N : M → ℤ := fun _ ↦ ∑ b ∈ support f, ∑ j, |b j| with hN
  refine ⟨N, ?_⟩
  rw [← sum_coeff_smul_monomial f, Finset.sum_mul]
  refine Subalgebra.sum_mem _ fun a ha ↦ ?_
  rw [smul_mul_assoc, monomial_mul_monomial, smul_smul]
  refine Subalgebra.smul_mem _ (monomial_mem_mixedSubalgebra fun i _ ↦ ?_) _
  have h1 : |a i| ≤ ∑ j, |a j| :=
    Finset.single_le_sum (fun j _ ↦ abs_nonneg (a j)) (Finset.mem_univ i)
  have h2 : ∑ j, |a j| ≤ ∑ b ∈ support f, ∑ j, |b j| :=
    Finset.single_le_sum (f := fun b : M → ℤ ↦ ∑ j, |b j|)
      (fun b _ ↦ Finset.sum_nonneg fun j _ ↦ abs_nonneg (b j)) ha
  have h3 := neg_abs_le (a i)
  simp only [Pi.add_apply, hN]
  linarith

variable [DecidableEq M]

omit [Finite M] in
theorem single_mem_mixedExponents (i : M) : Pi.single i (1 : ℤ) ∈ mixedExponents S := by
  simpa using zsmul_single_mem_mixedExponents (S := S) (i := i) (n := 1) (Or.inr zero_le_one)

variable (S) in
/-- The generator `X_i` of the mixed subalgebra. -/
noncomputable def mixedX (i : M) : mixedSubalgebra R u Λ S :=
  ⟨monomial (Pi.single i 1), monomial_mem_mixedSubalgebra (single_mem_mixedExponents i)⟩

@[simp] theorem coe_mixedX (i : M) :
    ((mixedX S i : mixedSubalgebra R u Λ S) : quantumTorus R u Λ) = monomial (Pi.single i 1) :=
  rfl

theorem mixedX_eq_mixedBasis (i : M) :
    mixedX S i = mixedBasis R u Λ S ⟨Pi.single i 1, single_mem_mixedExponents i⟩ :=
  Subtype.ext (by simp)

/-- For `i ∈ S` the generator `X_i` is a unit of the mixed subalgebra. -/
theorem isUnit_mixedX {i : M} (hi : i ∈ S) : IsUnit (mixedX S i : mixedSubalgebra R u Λ S) :=
  isUnit_monomial_of_neg_mem (single_mem_mixedExponents i) (by
    simpa using zsmul_single_mem_mixedExponents (S := S) (i := i) (n := -1) (Or.inl hi))

/-- The generators quasi-commute. -/
theorem isQuasiCommutingFamily_mixedX (hΛ : LinearMap.IsAlt Λ) :
    IsQuasiCommutingFamily u Λ (mixedX (R := R) (u := u) (Λ := Λ) S) := by
  intro i j
  apply Subtype.ext
  simpa using monomial_mul_monomial_comm (R := R) (u := u) hΛ (Pi.single i 1) (Pi.single j 1)

end Subalgebra

/-! ### The universal property -/

/-- A linear map out of an algebra with a basis is multiplicative once it is multiplicative on
pairs of basis elements. -/
theorem map_mul_of_basis {R : Type*} [CommRing R] {B : Type*} [Ring B] [Algebra R B]
    {A : Type*} [Ring A] [Algebra R A] {ι : Type*} (b : Module.Basis ι R B) (F : B →ₗ[R] A)
    (h : ∀ i j, F (b i * b j) = F (b i) * F (b j)) (x y : B) : F (x * y) = F x * F y := by
  have key : (LinearMap.mul R B).compr₂ F = (LinearMap.mul R A).compl₁₂ F F :=
    b.ext fun i ↦ b.ext fun j ↦ by simpa using h i j
  simpa using LinearMap.congr_fun₂ key x y

section Lift

variable {R : Type*} [CommRing R] {u : Rˣ} {M : Type*} [DecidableEq M] [Finite M]
  {Λ : LinearMap.BilinForm ℤ (M → ℤ)} {S : Set M} {A : Type*} [Ring A] [Algebra R A]
  {U : M → A} {hS : ∀ i ∈ S, IsUnit (U i)}

/-- The values of an algebra map on the powers of a generator. -/
theorem algHom_mixedBasis_zsmul_single (hΛ : LinearMap.IsAlt Λ)
    (f : mixedSubalgebra R u Λ S →ₐ[R] A) {i : M} {n : ℤ} (h : i ∈ S ∨ 0 ≤ n) :
    f (mixedBasis R u Λ S ⟨n • Pi.single i 1, zsmul_single_mem_mixedExponents h⟩) =
      mixedPow S (fun j ↦ f (mixedX S j)) (fun _ hj ↦ (isUnit_mixedX hj).map f) i n := by
  rcases le_or_gt 0 n with hn | hn
  · lift n to ℕ using hn
    have e : mixedBasis R u Λ S ⟨(n : ℤ) • Pi.single i 1, zsmul_single_mem_mixedExponents h⟩ =
        mixedX S i ^ n :=
      Subtype.ext (by
        simp only [coe_mixedBasis, SubmonoidClass.coe_pow, coe_mixedX]
        rw [natCast_zsmul, monomial_nsmul hΛ])
    rw [e, map_pow, mixedPow_natCast]
  · have hi : i ∈ S := h.resolve_right (not_le.2 hn)
    set w := (isUnit_mixedX (R := R) (u := u) (Λ := Λ) hi).unit
    have hW : Units.map (MonoidHom.ofClass (mixedSubalgebra R u Λ S).val :
        mixedSubalgebra R u Λ S →* quantumTorus R u Λ) w =
        monomialUnit hΛ (Pi.single i 1) :=
      Units.ext rfl
    have e : mixedBasis R u Λ S ⟨n • Pi.single i 1, zsmul_single_mem_mixedExponents h⟩ =
        ((w ^ n : (mixedSubalgebra R u Λ S)ˣ) : mixedSubalgebra R u Λ S) := by
      apply Subtype.ext
      rw [coe_mixedBasis, monomial_zsmul hΛ, ← hW, ← map_zpow]
      rfl
    have hf : Units.map (MonoidHom.ofClass f : mixedSubalgebra R u Λ S →* A) w =
        ((isUnit_mixedX hi).map f).unit :=
      Units.ext rfl
    rw [e, mixedPow_of_mem hi, ← hf, ← map_zpow]
    rfl

/-- An algebra map out of the mixed subalgebra sends the basis monomial `X ^ a` to the normalized
ordered product of the images of the generators, along any list enumerating `M` once. -/
theorem algHom_mixedBasis_eq (hΛ : LinearMap.IsAlt Λ)
    (f : mixedSubalgebra R u Λ S →ₐ[R] A) {l : List M} (hl : l.Nodup) (hlc : ∀ i, i ∈ l)
    (a : mixedExponents S) :
    f (mixedBasis R u Λ S a) = mixedNormalizedProd u Λ S (fun j ↦ f (mixedX S j))
      (fun _ hj ↦ (isUnit_mixedX hj).map f) l a := by
  let : Fintype M := Fintype.ofFinite M
  set V : M → A := fun j ↦ f (mixedX S j)
  have hV : ∀ j ∈ S, IsUnit (V j) := fun j hj ↦ (isUnit_mixedX hj).map f
  have key : ∀ l : List M, mixedOrderedProd S V hV l a =
      ((u ^ orderCorrection Λ l a : Rˣ) : R) •
        f (mixedBasis R u Λ S ⟨listExponent l a, listExponent_mem_mixedExponents a.2 l⟩) := by
    intro l
    induction l with
    | nil =>
      have e : (⟨listExponent [] (a : M → ℤ), listExponent_mem_mixedExponents a.2 []⟩ :
          mixedExponents S) = 0 := Subtype.ext (by simp)
      rw [mixedOrderedProd_nil, e, mixedBasis_zero, map_one]
      simp [orderCorrection]
    | cons i l ih =>
      have hi := zsmul_single_mem_mixedExponents (mem_mixedExponents_iff_or.1 a.2 i)
      have e : (⟨_, hi⟩ + ⟨listExponent l a, listExponent_mem_mixedExponents a.2 l⟩ :
          mixedExponents S) =
          ⟨listExponent (i :: l) a, listExponent_mem_mixedExponents a.2 (i :: l)⟩ :=
        Subtype.ext (by simp [listExponent_cons])
      have hsmul : ∀ (c : R) (x : mixedSubalgebra R u Λ S), f (c • x) = c • f x :=
        fun c x ↦ f.toLinearMap.map_smul c x
      rw [mixedOrderedProd_cons, ih, ← algHom_mixedBasis_zsmul_single hΛ f
        (mem_mixedExponents_iff_or.1 a.2 i),
        mul_smul_comm,
        ← map_mul, mixedBasis_mul_mixedBasis, hsmul, smul_smul, ← Units.val_mul, ← zpow_add, e,
        orderCorrection, add_comm (orderCorrection Λ l a)]
  have e : (⟨listExponent l a, listExponent_mem_mixedExponents a.2 l⟩ : mixedExponents S) = a :=
    Subtype.ext (listExponent_eq hl hlc a)
  rw [mixedNormalizedProd, key, e, smul_smul, ← Units.val_mul, ← zpow_add, neg_add_cancel,
    zpow_zero, Units.val_one, one_smul]

variable [Fintype M]

omit [Fintype M] in
/-- An algebra map out of the mixed subalgebra is determined by its values on the generators. -/
theorem mixedAlgHom_ext (hΛ : LinearMap.IsAlt Λ) {f g : mixedSubalgebra R u Λ S →ₐ[R] A}
    (h : ∀ i, f (mixedX S i) = g (mixedX S i)) : f = g := by
  let : Fintype M := Fintype.ofFinite M
  have hl := Finset.nodup_toList (Finset.univ : Finset M)
  have hlc : ∀ i, i ∈ (Finset.univ : Finset M).toList := fun i ↦ by simp
  refine AlgHom.toLinearMap_injective ((mixedBasis R u Λ S).ext fun a ↦ ?_)
  simp only [AlgHom.toLinearMap_apply]
  rw [algHom_mixedBasis_eq hΛ f hl hlc, algHom_mixedBasis_eq hΛ g hl hlc]
  exact mixedNormalizedProd_congr (funext h) _ _

/-- The algebra map out of the mixed subalgebra sending `X ^ a` to the normalized ordered product
along a list `l` enumerating `M` once. Use `TauCeti.QuantumTorus.mixedLift`. -/
noncomputable def mixedLiftList (hΛ : LinearMap.IsAlt Λ) (U : M → A)
    (hS : ∀ i ∈ S, IsUnit (U i)) (hU : IsQuasiCommutingFamily u Λ U) (l : List M) (hl : l.Nodup)
    (hlc : ∀ i, i ∈ l) : mixedSubalgebra R u Λ S →ₐ[R] A :=
  AlgHom.ofLinearMap
    ((mixedBasis R u Λ S).constr R fun a ↦ mixedNormalizedProd u Λ S U hS l a)
    (by rw [← mixedBasis_zero, Module.Basis.constr_basis]; simp)
    (map_mul_of_basis (mixedBasis R u Λ S) _ fun a b ↦ by
      rw [mixedBasis_mul_mixedBasis, map_smul, Module.Basis.constr_basis,
        Module.Basis.constr_basis, Module.Basis.constr_basis,
        hU.mixedNormalizedProd_mul hΛ l a.2 b.2, listExponent_eq hl hlc, listExponent_eq hl hlc]
      rfl)

omit [Fintype M] in
theorem mixedLiftList_mixedBasis (hΛ : LinearMap.IsAlt Λ) (hU : IsQuasiCommutingFamily u Λ U)
    {l : List M} (hl : l.Nodup) (hlc : ∀ i, i ∈ l) (a : mixedExponents S) :
    mixedLiftList hΛ U hS hU l hl hlc (mixedBasis R u Λ S a) =
      mixedNormalizedProd u Λ S U hS l a :=
  Module.Basis.constr_basis (S := R) _ _ _

omit [Fintype M] in
theorem mixedLiftList_mixedX (hΛ : LinearMap.IsAlt Λ) (hU : IsQuasiCommutingFamily u Λ U)
    {l : List M} (hl : l.Nodup) (hlc : ∀ i, i ∈ l) (i : M) :
    mixedLiftList hΛ U hS hU l hl hlc (mixedX S i) = U i := by
  let : Fintype M := Fintype.ofFinite M
  rw [mixedX_eq_mixedBasis, mixedLiftList_mixedBasis]
  exact mixedNormalizedProd_single hl (hlc i)

/-- **The universal property of the mixed subalgebra.** Elements `U_i` of an `R`-algebra with
`U_i U_j = u^{2Λ_ij} U_j U_i`, units for `i ∈ S`, define an `R`-algebra map
`T_S(R,u,Λ) → A` with `X_i ↦ U_i`. It is unique by `TauCeti.QuantumTorus.mixedAlgHom_ext`. -/
noncomputable def mixedLift (hΛ : LinearMap.IsAlt Λ) (U : M → A) (hS : ∀ i ∈ S, IsUnit (U i))
    (hU : IsQuasiCommutingFamily u Λ U) : mixedSubalgebra R u Λ S →ₐ[R] A :=
  mixedLiftList hΛ U hS hU (Finset.univ : Finset M).toList (Finset.nodup_toList _)
    (fun i ↦ by simp)

@[simp] theorem mixedLift_mixedX (hΛ : LinearMap.IsAlt Λ) (hU : IsQuasiCommutingFamily u Λ U)
    (i : M) : mixedLift hΛ U hS hU (mixedX S i) = U i :=
  mixedLiftList_mixedX hΛ hU _ _ i

/-- Uniqueness: an algebra map sending each `X_i` to `U_i` is `mixedLift`. -/
theorem eq_mixedLift (hΛ : LinearMap.IsAlt Λ) (hU : IsQuasiCommutingFamily u Λ U)
    (f : mixedSubalgebra R u Λ S →ₐ[R] A) (hf : ∀ i, f (mixedX S i) = U i) :
    f = mixedLift hΛ U hS hU :=
  mixedAlgHom_ext hΛ fun i ↦ by rw [hf, mixedLift_mixedX]

/-- **Independence of the order.** Along any list enumerating `M` once, `mixedLift` sends `X ^ a`
to `u^{-Σ_{i<j} a_i a_j Λ_ij} ∏_{i ∈ l} U_i^{a_i}`. -/
theorem mixedLift_mixedBasis (hΛ : LinearMap.IsAlt Λ) (hU : IsQuasiCommutingFamily u Λ U)
    {l : List M} (hl : l.Nodup) (hlc : ∀ i, i ∈ l) (a : mixedExponents S) :
    mixedLift hΛ U hS hU (mixedBasis R u Λ S a) = mixedNormalizedProd u Λ S U hS l a := by
  rw [← mixedLiftList_mixedBasis hΛ hU hl hlc a,
    eq_mixedLift hΛ hU (mixedLiftList hΛ U hS hU l hl hlc) (mixedLiftList_mixedX hΛ hU hl hlc)]

/-- On quasi-commuting units, `mixedLift` is the restriction of the lift of the whole torus. -/
theorem lift_comp_val (hΛ : LinearMap.IsAlt Λ) {U : M → Aˣ} (hU : IsQuasiCommuting u Λ U) :
    (lift hΛ U hU).comp (mixedSubalgebra R u Λ S).val =
      mixedLift hΛ (fun i ↦ (U i : A)) (fun i _ ↦ (U i).isUnit) hU.isQuasiCommutingFamily :=
  eq_mixedLift hΛ _ _ fun i ↦ by simp

end Lift

end TauCeti.QuantumTorus
