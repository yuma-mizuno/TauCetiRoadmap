module

public import TauCetiRoadmap.LaurentPhenomenon.Quantum.Coefficients
public import Mathlib.Algebra.Polynomial.Div

/-!
# Trivial cocycles and the classical limit

When `u ^ Λ a b = 1` for all `a, b`, in particular when `u = 1` or `Λ = 0`, the cocycle is
trivial and `T(R,u,Λ)` is the lattice group algebra `R[L]`, with `X ^ a ↦ x ^ a`. The identification
preserves coefficients, commutes with change of coefficients
(`mapRingHom_equivAddMonoidAlgebraOfZpowEqOne`), and matches evaluations: the algebra maps
`T(R,u,Λ) → A` are the evaluations `X ^ a ↦ χ(a)` at the characters `χ` of `L` in `A`
(`liftOfZpowEqOne`), computed from the coefficients (`lift_equivAddMonoidAlgebraOfZpowEqOne`).

Over `Zv = ℤ[v^{±1}]` the classical limit `sp : T(Zv,v,Λ) → ℤ[L]` is the change of coefficients
along the evaluation `v ↦ 1` followed by the identification `T(ℤ,1,Λ) ≃ ℤ[L]`. It sends
`Σ_a c_a(v) X ^ a` to `Σ_a c_a(1) x ^ a`, is surjective, and its kernel is the ideal generated by
  the
central element `v - 1`. Evaluating `sp f` at a character of `L` evaluates the coefficients of
`f` at `v = 1` (`lift_sp`).
-/

@[expose] public section

namespace TauCeti.QuantumTorus

open TauCeti

variable {L : Type*} [AddCommGroup L]

/-! ### Trivial cocycles -/

section Trivial

variable {R : Type*} [CommRing R]

/-- The cocycle is trivial when all the powers `u ^ Λ a b` are. -/
theorem cocycle_eq_one {u : Rˣ} {Λ : LinearMap.BilinForm ℤ L} (h : ∀ a b, u ^ Λ a b = 1) :
    cocycle u Λ = 1 := by
  funext a b
  exact h a.toAdd b.toAdd

/-- For `u = 1` the cocycle is trivial. -/
theorem cocycle_one (Λ : LinearMap.BilinForm ℤ L) : cocycle (1 : Rˣ) Λ = 1 :=
  cocycle_eq_one fun _ _ ↦ one_zpow _

/-- **A quantum torus with trivial cocycle is the lattice group algebra.** When
`u ^ Λ a b = 1` for all `a, b`, `T(R,u,Λ) ≃ₐ[R] R[L]` with `X ^ a ↦ x ^ a`. -/
noncomputable def equivAddMonoidAlgebraOfZpowEqOne {u : Rˣ} {Λ : LinearMap.BilinForm ℤ L}
    (h : ∀ a b, u ^ Λ a b = 1) : quantumTorus R u Λ ≃ₐ[R] AddMonoidAlgebra R L :=
  (TwistedMonoidAlgebra.equivOfCoboundary 1 (cocycle u Λ) 1
      (fun g g' ↦ by simp [cocycle_eq_one h])).trans
    ((TwistedMonoidAlgebra.monoidAlgebraEquiv R (Multiplicative L)).trans
      (AddMonoidAlgebra.toMultiplicativeAlgEquiv R R L).symm)

section ZpowEqOne

variable {u : Rˣ} {Λ : LinearMap.BilinForm ℤ L} (h : ∀ a b, u ^ Λ a b = 1)
include h

@[simp] theorem equivAddMonoidAlgebraOfZpowEqOne_monomial (a : L) :
    equivAddMonoidAlgebraOfZpowEqOne h (monomial a) = AddMonoidAlgebra.single a 1 := by
  rw [equivAddMonoidAlgebraOfZpowEqOne, AlgEquiv.trans_apply, AlgEquiv.trans_apply,
    AlgEquiv.symm_apply_eq]
  simp [monomial]

@[simp] theorem equivAddMonoidAlgebraOfZpowEqOne_symm_single (a : L) :
    (equivAddMonoidAlgebraOfZpowEqOne h).symm (AddMonoidAlgebra.single a 1) = monomial a := by
  rw [AlgEquiv.symm_apply_eq, equivAddMonoidAlgebraOfZpowEqOne_monomial]

/-- Coefficient extraction commutes with the identification `T(R,u,Λ) ≃ R[L]`. -/
theorem coeff_equivAddMonoidAlgebraOfZpowEqOne (f : quantumTorus R u Λ) (a : L) :
    (equivAddMonoidAlgebraOfZpowEqOne h f).coeff a = coeff a f := by
  classical
  conv_lhs => rw [← sum_coeff_smul_monomial f]
  simp only [map_sum, map_smul, equivAddMonoidAlgebraOfZpowEqOne_monomial,
    AddMonoidAlgebra.coeff_sum, AddMonoidAlgebra.coeff_smul, AddMonoidAlgebra.coeff_single,
    Finsupp.coe_finsetSum, Finset.sum_apply, Finsupp.smul_apply, Finsupp.single_apply,
    smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq']
  split_ifs with h
  · rfl
  · rw [coeff_eq_zero_of_notMem_support h]

/-- Change of coefficients commutes with the identification `T(R,u,Λ) ≃ R[L]`. -/
theorem mapRingHom_equivAddMonoidAlgebraOfZpowEqOne {R' : Type*} [CommRing R'] {u' : R'ˣ}
    (f : R →+* R') (hu : f u = u') (h' : ∀ a b, u' ^ Λ a b = 1) (x : quantumTorus R u Λ) :
    AddMonoidAlgebra.mapRingHom L f (equivAddMonoidAlgebraOfZpowEqOne h x) =
      equivAddMonoidAlgebraOfZpowEqOne h' (mapRangeRingHom f hu x) := by
  ext a
  rw [AddMonoidAlgebra.coeff_mapRingHom, coeff_equivAddMonoidAlgebraOfZpowEqOne,
    coeff_equivAddMonoidAlgebraOfZpowEqOne, coeff_mapRangeRingHom]

variable {A : Type*} [Semiring A] [Algebra R A]

/-- **Evaluation through the identification.** Evaluating the image of `f` in `R[L]` at a
character `χ` of `L` gives `Σ_a f_a χ(a)`. -/
theorem lift_equivAddMonoidAlgebraOfZpowEqOne (χ : Multiplicative L →* A)
    (f : quantumTorus R u Λ) :
    AddMonoidAlgebra.lift R A L χ (equivAddMonoidAlgebraOfZpowEqOne h f) =
      ∑ a ∈ support f, coeff a f • χ (Multiplicative.ofAdd a) := by
  conv_lhs => rw [← sum_coeff_smul_monomial f]
  simp only [map_sum, map_smul, equivAddMonoidAlgebraOfZpowEqOne_monomial,
    AddMonoidAlgebra.lift_single, one_smul]

/-- **Evaluations of a quantum torus with trivial cocycle.** The `R`-algebra maps
`T(R,u,Λ) → A` correspond to the characters `χ : Multiplicative L →* A`, through the evaluation
`X ^ a ↦ χ(a)` of `R[L]`. -/
noncomputable def liftOfZpowEqOne : (Multiplicative L →* A) ≃ (quantumTorus R u Λ →ₐ[R] A) :=
  (AddMonoidAlgebra.lift R A L).trans
    ((equivAddMonoidAlgebraOfZpowEqOne h).symm.arrowCongr AlgEquiv.refl)

theorem liftOfZpowEqOne_apply (χ : Multiplicative L →* A) (f : quantumTorus R u Λ) :
    liftOfZpowEqOne h χ f =
      AddMonoidAlgebra.lift R A L χ (equivAddMonoidAlgebraOfZpowEqOne h f) :=
  rfl

@[simp] theorem liftOfZpowEqOne_monomial (χ : Multiplicative L →* A) (a : L) :
    liftOfZpowEqOne h χ (monomial a) = χ (Multiplicative.ofAdd a) := by
  rw [liftOfZpowEqOne_apply, equivAddMonoidAlgebraOfZpowEqOne_monomial,
    AddMonoidAlgebra.lift_single, one_smul]

/-- The character of an algebra map out of `T(R,u,Λ)` is `a ↦ f(X ^ a)`. -/
@[simp] theorem liftOfZpowEqOne_symm_apply (f : quantumTorus R u Λ →ₐ[R] A)
    (a : Multiplicative L) : (liftOfZpowEqOne h).symm f a = f (monomial a.toAdd) := by
  obtain ⟨χ, rfl⟩ := (liftOfZpowEqOne h).surjective f
  rw [Equiv.symm_apply_apply, liftOfZpowEqOne_monomial, ofAdd_toAdd]

end ZpowEqOne

/-- **`T(R,1,Λ)` is the lattice group algebra `R[L]`.** -/
noncomputable def equivAddMonoidAlgebra (Λ : LinearMap.BilinForm ℤ L) :
    quantumTorus R 1 Λ ≃ₐ[R] AddMonoidAlgebra R L :=
  equivAddMonoidAlgebraOfZpowEqOne fun _ _ ↦ one_zpow _

@[simp] theorem equivAddMonoidAlgebra_monomial (Λ : LinearMap.BilinForm ℤ L) (a : L) :
    equivAddMonoidAlgebra (R := R) Λ (monomial a) = AddMonoidAlgebra.single a 1 :=
  equivAddMonoidAlgebraOfZpowEqOne_monomial _ a

@[simp] theorem equivAddMonoidAlgebra_symm_single (Λ : LinearMap.BilinForm ℤ L) (a : L) :
    (equivAddMonoidAlgebra (R := R) Λ).symm (AddMonoidAlgebra.single a 1) = monomial a :=
  equivAddMonoidAlgebraOfZpowEqOne_symm_single _ a

/-- Coefficient extraction commutes with the identification `T(R,1,Λ) ≃ R[L]`. -/
theorem coeff_equivAddMonoidAlgebra (Λ : LinearMap.BilinForm ℤ L) (f : quantumTorus R 1 Λ) (a : L) :
    (equivAddMonoidAlgebra Λ f).coeff a = coeff a f :=
  coeff_equivAddMonoidAlgebraOfZpowEqOne _ f a

/-- Change of coefficients commutes with the identification `T(R,1,Λ) ≃ R[L]`. -/
theorem mapRingHom_equivAddMonoidAlgebra {R' : Type*} [CommRing R'] (Λ : LinearMap.BilinForm ℤ L)
    (f : R →+* R') (x : quantumTorus R 1 Λ) :
    AddMonoidAlgebra.mapRingHom L f (equivAddMonoidAlgebra Λ x) =
      equivAddMonoidAlgebra Λ (mapRangeRingHom f (by simp) x) :=
  mapRingHom_equivAddMonoidAlgebraOfZpowEqOne _ f _ _ x

/-- Evaluation at a character commutes with the identification `T(R,1,Λ) ≃ R[L]`. -/
theorem lift_equivAddMonoidAlgebra {A : Type*} [Semiring A] [Algebra R A]
    (Λ : LinearMap.BilinForm ℤ L)
    (χ : Multiplicative L →* A) (f : quantumTorus R 1 Λ) :
    AddMonoidAlgebra.lift R A L χ (equivAddMonoidAlgebra Λ f) =
      ∑ a ∈ support f, coeff a f • χ (Multiplicative.ofAdd a) :=
  lift_equivAddMonoidAlgebraOfZpowEqOne _ χ f

/-- **`T(R,u,0)` is the lattice group algebra `R[L]`.** -/
noncomputable def equivAddMonoidAlgebraOfFormZero (u : Rˣ) :
    quantumTorus R u (0 : LinearMap.BilinForm ℤ L) ≃ₐ[R] AddMonoidAlgebra R L :=
  equivAddMonoidAlgebraOfZpowEqOne fun _ _ ↦ by simp

@[simp] theorem equivAddMonoidAlgebraOfFormZero_monomial (u : Rˣ) (a : L) :
    equivAddMonoidAlgebraOfFormZero u (monomial a) = AddMonoidAlgebra.single a 1 :=
  equivAddMonoidAlgebraOfZpowEqOne_monomial _ a

@[simp] theorem equivAddMonoidAlgebraOfFormZero_symm_single (u : Rˣ) (a : L) :
    (equivAddMonoidAlgebraOfFormZero u).symm (AddMonoidAlgebra.single a 1) =
      (monomial a : quantumTorus R u (0 : LinearMap.BilinForm ℤ L)) :=
  equivAddMonoidAlgebraOfZpowEqOne_symm_single _ a

/-- Coefficient extraction commutes with the identification `T(R,u,0) ≃ R[L]`. -/
theorem coeff_equivAddMonoidAlgebraOfFormZero (u : Rˣ)
    (f : quantumTorus R u (0 : LinearMap.BilinForm ℤ L)) (a : L) :
    (equivAddMonoidAlgebraOfFormZero u f).coeff a = coeff a f :=
  coeff_equivAddMonoidAlgebraOfZpowEqOne _ f a

/-- Change of coefficients commutes with the identification `T(R,u,0) ≃ R[L]`. -/
theorem mapRingHom_equivAddMonoidAlgebraOfFormZero {R' : Type*} [CommRing R'] (u : Rˣ)
    {u' : R'ˣ} (f : R →+* R') (hu : f u = u') (x : quantumTorus R u (0 : LinearMap.BilinForm ℤ L)) :
    AddMonoidAlgebra.mapRingHom L f (equivAddMonoidAlgebraOfFormZero u x) =
      equivAddMonoidAlgebraOfFormZero u' (mapRangeRingHom f hu x) :=
  mapRingHom_equivAddMonoidAlgebraOfZpowEqOne _ f hu _ x

/-- Evaluation at a character commutes with the identification `T(R,u,0) ≃ R[L]`. -/
theorem lift_equivAddMonoidAlgebraOfFormZero {A : Type*} [Semiring A] [Algebra R A] (u : Rˣ)
    (χ : Multiplicative L →* A) (f : quantumTorus R u (0 : LinearMap.BilinForm ℤ L)) :
    AddMonoidAlgebra.lift R A L χ (equivAddMonoidAlgebraOfFormZero u f) =
      ∑ a ∈ support f, coeff a f • χ (Multiplicative.ofAdd a) :=
  lift_equivAddMonoidAlgebraOfZpowEqOne _ χ f

end Trivial

/-! ### The classical limit `v ↦ 1` -/

/-- Evaluation of `Zv = ℤ[v^{±1}]` at `v = 1`. -/
noncomputable def evalOne : Zv →+* ℤ :=
  LaurentPolynomial.eval₂ (RingHom.id ℤ) 1

@[simp] theorem evalOne_T (n : ℤ) : evalOne (LaurentPolynomial.T n) = 1 := by
  simp [evalOne]

theorem evalOne_C (n : ℤ) : evalOne (LaurentPolynomial.C n) = n := by
  simp [evalOne]

theorem evalOne_vUnit : evalOne (vUnit : Zv) = ((1 : ℤˣ) : ℤ) := by
  simp

@[simp] theorem evalOne_vUnit_zpow (n : ℤ) : evalOne ((vUnit ^ n : Zvˣ) : Zv) = 1 := by
  have h : Units.map (evalOne : Zv →* ℤ) vUnit = 1 := Units.ext (by simp)
  have := congrArg Units.val (congrArg (· ^ n) h)
  simpa [← map_zpow] using this

/-- The kernel of the evaluation at `v = 1` is generated by `v - 1`. -/
theorem ker_evalOne : RingHom.ker evalOne = Ideal.span {(LaurentPolynomial.T 1 - 1 : Zv)} := by
  refine le_antisymm (fun c hc ↦ ?_) ?_
  · obtain ⟨n, p, hp⟩ := LaurentPolynomial.exists_T_pow c
    have hp1 : p.IsRoot 1 := by
      have := congrArg evalOne hp
      rw [map_mul, RingHom.mem_ker.1 hc, zero_mul, evalOne,
        LaurentPolynomial.eval₂_toLaurent, Polynomial.eval₂_id] at this
      simpa [Polynomial.IsRoot] using this
    obtain ⟨q, rfl⟩ := Polynomial.dvd_iff_isRoot.2 hp1
    refine Ideal.mem_span_singleton'.2 ⟨Polynomial.toLaurent q * LaurentPolynomial.T (-n), ?_⟩
    have hT : (LaurentPolynomial.T (n : ℤ) * LaurentPolynomial.T (-n) : Zv) = 1 := by
      rw [← LaurentPolynomial.T_add, add_neg_cancel, LaurentPolynomial.T_zero]
    calc Polynomial.toLaurent q * LaurentPolynomial.T (-n) * (LaurentPolynomial.T 1 - 1)
        = Polynomial.toLaurent ((Polynomial.X - Polynomial.C 1) * q) *
            LaurentPolynomial.T (-n) := by
          simp only [map_mul, map_sub, Polynomial.toLaurent_X, map_one]
          ring
      _ = c := by rw [hp, mul_assoc, hT, mul_one]
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, map_sub,
      evalOne_T, map_one, sub_self]

/-- **The classical limit** `sp : T(Zv,v,Λ) → ℤ[L]`: change of coefficients along `v ↦ 1`
followed by the identification `T(ℤ,1,Λ) ≃ ℤ[L]`, so `Σ_a c_a(v) X ^ a ↦ Σ_a c_a(1) x ^ a`. -/
noncomputable def sp
    (Λ : LinearMap.BilinForm ℤ L) : quantumTorus Zv vUnit Λ →+* AddMonoidAlgebra ℤ L :=
  ((equivAddMonoidAlgebra Λ).toRingEquiv.toRingHom).comp (mapRangeRingHom evalOne evalOne_vUnit)

variable {Λ : LinearMap.BilinForm ℤ L}

theorem sp_apply (f : quantumTorus Zv vUnit Λ) :
    sp Λ f = equivAddMonoidAlgebra Λ (mapRangeRingHom evalOne evalOne_vUnit f) :=
  rfl

@[simp] theorem sp_monomial (a : L) :
    sp Λ (monomial a) = AddMonoidAlgebra.single a 1 := by
  rw [sp_apply, mapRangeRingHom_monomial, equivAddMonoidAlgebra_monomial]

theorem sp_smul_monomial (c : Zv) (a : L) :
    sp Λ (c • monomial a) = AddMonoidAlgebra.single a (evalOne c) := by
  rw [sp_apply, mapRangeRingHom_smul_monomial, map_smul, equivAddMonoidAlgebra_monomial,
    AddMonoidAlgebra.smul_single', mul_one]

@[simp] theorem sp_algebraMap (c : Zv) :
    sp Λ (algebraMap Zv (quantumTorus Zv vUnit Λ) c) = AddMonoidAlgebra.single 0 (evalOne c) := by
  rw [Algebra.algebraMap_eq_smul_one, ← monomial_zero, sp_smul_monomial]

@[simp] theorem sp_smul (c : Zv) (f : quantumTorus Zv vUnit Λ) :
    sp Λ (c • f) = AddMonoidAlgebra.single 0 (evalOne c) * sp Λ f := by
  rw [Algebra.smul_def, map_mul, sp_algebraMap]

/-- `sp` evaluates each coefficient at `v = 1`. -/
theorem coeff_sp (f : quantumTorus Zv vUnit Λ) (a : L) :
    (sp Λ f).coeff a = evalOne (coeff a f) := by
  rw [sp_apply, coeff_equivAddMonoidAlgebra, coeff_mapRangeRingHom]

/-- **Evaluation of the classical limit.** Evaluating `sp f` at a character `χ` of `L` gives
`Σ_a f_a(1) χ(a)`. -/
theorem lift_sp {A : Type*} [Ring A] (χ : Multiplicative L →* A) (f : quantumTorus Zv vUnit Λ) :
    AddMonoidAlgebra.lift ℤ A L χ (sp Λ f) =
      ∑ a ∈ support f, evalOne (coeff a f) • χ (Multiplicative.ofAdd a) := by
  conv_lhs => rw [← sum_coeff_smul_monomial f]
  simp only [map_sum, sp_smul_monomial, AddMonoidAlgebra.lift_single]

/-- The classical limit is surjective. -/
theorem sp_surjective : Function.Surjective (sp Λ) := by
  intro y
  induction y using AddMonoidAlgebra.induction_linear with
  | zero => exact ⟨0, map_zero _⟩
  | add x y hx hy =>
    obtain ⟨x', rfl⟩ := hx
    obtain ⟨y', rfl⟩ := hy
    exact ⟨x' + y', map_add _ _ _⟩
  | single a n => exact ⟨LaurentPolynomial.C n • monomial a, by rw [sp_smul_monomial, evalOne_C]⟩

/-- **The kernel of the classical limit** is the ideal generated by the central element
`v - 1`. -/
theorem ker_sp : RingHom.ker (sp Λ) =
    Ideal.span {algebraMap Zv (quantumTorus Zv vUnit Λ) (LaurentPolynomial.T 1 - 1)} := by
  refine le_antisymm (fun f hf ↦ ?_) ?_
  · have hc (a : L) : coeff a f ∈ Ideal.span {(LaurentPolynomial.T 1 - 1 : Zv)} := by
      rw [← ker_evalOne, RingHom.mem_ker, ← coeff_sp, RingHom.mem_ker.1 hf]
      rfl
    choose d hd using fun a ↦ Ideal.mem_span_singleton'.1 (hc a)
    rw [← sum_coeff_smul_monomial f]
    refine Submodule.sum_mem _ fun a _ ↦ ?_
    have : (d a • monomial a : quantumTorus Zv vUnit Λ) *
        algebraMap Zv _ (LaurentPolynomial.T 1 - 1) = coeff a f • monomial a := by
      rw [smul_mul_assoc, ← Algebra.commutes, ← Algebra.smul_def, ← mul_smul, hd]
    rw [← this]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker, sp_algebraMap,
      map_sub, evalOne_T, map_one, sub_self, AddMonoidAlgebra.single_zero]

/-- `ℤ[L]` as a `Zv`-algebra through evaluation at `v = 1`. Not an instance. -/
noncomputable abbrev evalOneAlgebra : Algebra Zv (AddMonoidAlgebra ℤ L) :=
  (AddMonoidAlgebra.singleZeroRingHom.comp evalOne).toAlgebra

variable (Λ) in
/-- The classical limit as a `Zv`-algebra map, for the evaluation algebra structure. -/
noncomputable def spAlgHom :
    letI := evalOneAlgebra (L := L)
    quantumTorus Zv vUnit Λ →ₐ[Zv] AddMonoidAlgebra ℤ L :=
  letI := evalOneAlgebra (L := L)
  { sp Λ with commutes' := sp_algebraMap }

theorem spAlgHom_apply (f : quantumTorus Zv vUnit Λ) :
    letI := evalOneAlgebra (L := L)
    spAlgHom Λ f = sp Λ f :=
  rfl

end TauCeti.QuantumTorus
