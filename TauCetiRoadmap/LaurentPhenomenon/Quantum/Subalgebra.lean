module

public import TauCetiRoadmap.LaurentPhenomenon.Quantum.MixedSubalgebra
public import Mathlib.RingTheory.OreLocalization.OreSet
public import Mathlib.RingTheory.OreLocalization.Ring

/-! # Ore localization of quantum mixed subalgebras

The monomial Ore sets, their localization equivalences and the transport of
mixed lifts and localization to a lattice with a chosen basis.
-/

@[expose] public section

namespace TauCeti.QuantumTorus

open TauCeti

/-! ### Localization at monomials -/

section Localization

variable {R : Type*} [CommRing R] {u : Rˣ} {M : Type*} [DecidableEq M] [Finite M]
  {Λ : LinearMap.BilinForm ℤ (M → ℤ)}

variable (R u Λ) in
/-- The monoid generated by the generators `X_i`, `i ∈ T`, of the mixed subalgebra for `S`. -/
noncomputable def mixedMonomialSubmonoid (S T : Set M) : Submonoid (mixedSubalgebra R u Λ S) :=
  Submonoid.closure (mixedX S '' T)

variable {S T : Set M}

/-- The elements of the monoid generated by the `X_i`, `i ∈ T`, are units of the torus and are
normal in the mixed subalgebra. -/
theorem isUnit_and_normal_of_mem_mixedMonomialSubmonoid {s : mixedSubalgebra R u Λ S}
    (hs : s ∈ mixedMonomialSubmonoid R u Λ S T) :
    IsUnit (s : quantumTorus R u Λ) ∧ ∀ r : mixedSubalgebra R u Λ S, ∃ r', s * r = r' * s := by
  induction hs using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨i, -, rfl⟩ := hx
    refine ⟨?_, fun r ↦ ?_⟩
    · change IsUnit (monomial (Pi.single i 1) : quantumTorus R u Λ)
      exact TwistedMonoidAlgebra.isUnit_of _
    · obtain ⟨f', hf', h⟩ := exists_monomial_mul_eq_mul_monomial (Pi.single i 1) r.2
      exact ⟨⟨f', hf'⟩, Subtype.ext h⟩
  | one => exact ⟨isUnit_one, fun r ↦ ⟨r, by rw [one_mul, mul_one]⟩⟩
  | mul x y _ _ hx hy =>
    refine ⟨hx.1.mul hy.1, fun r ↦ ?_⟩
    obtain ⟨r₁, h₁⟩ := hy.2 r
    obtain ⟨r₂, h₂⟩ := hx.2 r₁
    exact ⟨r₂, by rw [mul_assoc, h₁, ← mul_assoc, h₂, mul_assoc]⟩

/-- **The monomials form a left Ore set** in the mixed subalgebra: they are normal, and they are
units of the torus, so they cancel. -/
noncomputable instance (S T : Set M) :
    OreLocalization.OreSet (mixedMonomialSubmonoid R u Λ S T) :=
  (OreLocalization.nonempty_oreSet_iff.2
    ⟨fun r₁ r₂ s h ↦ ⟨1, by
      simp only [OneMemClass.coe_one, one_mul]
      exact Subtype.ext ((isUnit_and_normal_of_mem_mixedMonomialSubmonoid s.2).1.mul_left_injective
        (congrArg Subtype.val h))⟩,
     fun r s ↦ by
      obtain ⟨r', h⟩ := (isUnit_and_normal_of_mem_mixedMonomialSubmonoid s.2).2 r
      exact ⟨r', s, h⟩⟩).some

omit [DecidableEq M] in
variable (R u Λ S T) in
theorem mixedSubalgebra_le_union : mixedSubalgebra R u Λ S ≤ mixedSubalgebra R u Λ (S ∪ T) :=
  mixedSubalgebra_mono Set.subset_union_left

/-- The generators `X_i`, `i ∈ T`, become units in the mixed subalgebra for `S ∪ T`. -/
theorem isUnit_inclusion_of_mem_mixedMonomialSubmonoid {s : mixedSubalgebra R u Λ S}
    (hs : s ∈ mixedMonomialSubmonoid R u Λ S T) :
    IsUnit (Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T) s) := by
  induction hs using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨i, hi, rfl⟩ := hx
    exact isUnit_mixedX (S := S ∪ T) (Or.inr hi)
  | one =>
    rw [map_one]
    exact isUnit_one
  | mul x y _ _ hx hy =>
    rw [map_mul]
    exact hx.mul hy

variable (R u Λ S T) in
/-- The monoid generated by the `X_i`, `i ∈ T`, mapped to the units of `T_{S ∪ T}`. -/
noncomputable def mixedMonomialUnits :
    mixedMonomialSubmonoid R u Λ S T →* (mixedSubalgebra R u Λ (S ∪ T))ˣ :=
  IsUnit.liftRight
    ((MonoidHom.ofClass (Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T))).comp
      (mixedMonomialSubmonoid R u Λ S T).subtype)
    fun s ↦ isUnit_inclusion_of_mem_mixedMonomialSubmonoid s.2

theorem coe_mixedMonomialUnits (s : mixedMonomialSubmonoid R u Λ S T) :
    (mixedMonomialUnits R u Λ S T s : mixedSubalgebra R u Λ (S ∪ T)) =
      Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T) s :=
  rfl

variable (R u Λ S T) in
/-- The comparison map from the Ore localization of `T_S` at the monomials of `T` to
`T_{S ∪ T}`, sending `s⁻¹ r` to `s⁻¹ r`. -/
noncomputable def mixedLocalizationHom :
    OreLocalization (mixedMonomialSubmonoid R u Λ S T) (mixedSubalgebra R u Λ S) →ₐ[R]
      mixedSubalgebra R u Λ (S ∪ T) :=
  { OreLocalization.universalHom (Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S
    T)).toRingHom
      (mixedMonomialUnits R u Λ S T) (fun _ ↦ rfl) with
    commutes' := fun r ↦ (OreLocalization.universalHom_commutes _ _ _).trans
      ((Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T)).commutes r) }

theorem mixedLocalizationHom_oreDiv (r : mixedSubalgebra R u Λ S)
    (s : mixedMonomialSubmonoid R u Λ S T) :
    mixedLocalizationHom R u Λ S T (r /ₒ s) =
      ((mixedMonomialUnits R u Λ S T s)⁻¹ : (mixedSubalgebra R u Λ (S ∪ T))ˣ) *
        Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T) r :=
  rfl

theorem mixedLocalizationHom_numeratorHom (r : mixedSubalgebra R u Λ S) :
    mixedLocalizationHom R u Λ S T (OreLocalization.numeratorHom r) =
      Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T) r :=
  OreLocalization.universalHom_commutes _ _ _

theorem mixedLocalizationHom_injective :
    Function.Injective (mixedLocalizationHom R u Λ S T) := by
  refine (injective_iff_map_eq_zero _).2 fun x hx ↦ ?_
  induction x using OreLocalization.ind with | _ r s
  rw [mixedLocalizationHom_oreDiv, Units.mul_right_eq_zero] at hx
  obtain rfl : r = 0 := Subalgebra.inclusion_injective _ (by rw [hx, map_zero])
  exact OreLocalization.zero_oreDiv s

/-- A monomial `X ^ b` with `b ≥ 0` supported in `T` lies, up to a unit scalar, in the monoid
generated by the `X_i`, `i ∈ T`. -/
theorem exists_mem_mixedMonomialSubmonoid_eq_smul_monomial {b : M → ℤ}
    (hb : ∀ i, 0 ≤ b i) (hbT : ∀ i ∉ T, b i = 0) :
    ∃ s ∈ mixedMonomialSubmonoid R u Λ S T, ∃ c : Rˣ,
      (s : quantumTorus R u Λ) = (c : R) • monomial b := by
  let : Fintype M := Fintype.ofFinite M
  let P : AddSubmonoid (M → ℤ) :=
    { carrier := {b | ∃ s ∈ mixedMonomialSubmonoid R u Λ S T, ∃ c : Rˣ,
        (s : quantumTorus R u Λ) = (c : R) • monomial b}
      add_mem' := by
        rintro b₁ b₂ ⟨s₁, hs₁, c₁, h₁⟩ ⟨s₂, hs₂, c₂, h₂⟩
        refine ⟨s₁ * s₂, mul_mem hs₁ hs₂, c₁ * c₂ * u ^ Λ b₁ b₂, ?_⟩
        rw [Subalgebra.coe_mul, h₁, h₂, smul_mul_smul_comm, monomial_mul_monomial, smul_smul,
          Units.val_mul, Units.val_mul]
      zero_mem' := ⟨1, one_mem _, 1, by simp⟩ }
  have hsum : (∑ i, (b i).toNat • Pi.single i (1 : ℤ)) ∈ P := by
    refine sum_mem fun i _ ↦ ?_
    by_cases hi : i ∈ T
    · refine nsmul_mem (show ∃ s ∈ mixedMonomialSubmonoid R u Λ S T, ∃ c : Rˣ,
        (s : quantumTorus R u Λ) = (c : R) • monomial (Pi.single i 1) from
          ⟨mixedX S i, Submonoid.subset_closure ⟨i, hi, rfl⟩, 1, by simp⟩) _
    · simp [hbT i hi, zero_mem]
  have hb' : (∑ i, (b i).toNat • Pi.single i (1 : ℤ)) = b := by
    ext j
    simp [Finset.sum_apply, Pi.single_apply, hb j]
  rw [hb'] at hsum
  exact hsum

/-- Every element of `T_{S ∪ T}` lies in `T_S` after multiplication on the left by an element of
the monoid generated by the `X_i`, `i ∈ T`. -/
theorem exists_mem_mixedMonomialSubmonoid_mul_mem {z : quantumTorus R u Λ}
    (hz : z ∈ mixedSubalgebra R u Λ (S ∪ T)) :
    ∃ s ∈ mixedMonomialSubmonoid R u Λ S T,
      (s : quantumTorus R u Λ) * z ∈ mixedSubalgebra R u Λ S := by
  let : Fintype M := Fintype.ofFinite M
  classical
  set N : ℕ := ∑ a ∈ support z, ∑ i, (a i).natAbs
  obtain ⟨s, hs, c, hsc⟩ := exists_mem_mixedMonomialSubmonoid_eq_smul_monomial (R := R) (u := u)
    (Λ := Λ) (S := S) (T := T) (b := fun i ↦ if i ∈ T then (N : ℤ) else 0)
    (fun i ↦ by by_cases hi : i ∈ T <;> simp [hi]) (fun i hi ↦ by simp [hi])
  refine ⟨s, hs, ?_⟩
  rw [hsc, smul_mul_assoc, ← sum_coeff_smul_monomial z, Finset.mul_sum]
  refine Subalgebra.smul_mem _ (Subalgebra.sum_mem _ fun a ha ↦ ?_) _
  rw [mul_smul_comm, monomial_mul_monomial]
  refine Subalgebra.smul_mem _ (Subalgebra.smul_mem _ (monomial_mem_mixedSubalgebra ?_) _) _
  intro i hi
  have h₁ : (a i).natAbs ≤ ∑ i, (a i).natAbs :=
    Finset.single_le_sum (f := fun i ↦ (a i).natAbs) (fun _ _ ↦ Nat.zero_le _) (Finset.mem_univ i)
  have h₂ : ∑ i, (a i).natAbs ≤ N :=
    Finset.single_le_sum (f := fun a : M → ℤ ↦ ∑ i, (a i).natAbs) (fun _ _ ↦ Nat.zero_le _) ha
  by_cases hiT : i ∈ T
  · simp only [Pi.add_apply, hiT, ite_true]
    omega
  · have := mem_mixedSubalgebra_iff.1 hz a ha i (by simp [hi, hiT])
    simp only [Pi.add_apply, hiT, ite_false]
    omega

theorem mixedLocalizationHom_surjective :
    Function.Surjective (mixedLocalizationHom R u Λ S T) := by
  let : Fintype M := Fintype.ofFinite M
  intro z
  obtain ⟨s, hs, hsz⟩ := exists_mem_mixedMonomialSubmonoid_mul_mem z.2
  refine ⟨⟨_, hsz⟩ /ₒ ⟨s, hs⟩, ?_⟩
  have e : Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T) ⟨_, hsz⟩ =
      (mixedMonomialUnits R u Λ S T ⟨s, hs⟩ : mixedSubalgebra R u Λ (S ∪ T)) * z :=
    Subtype.ext rfl
  rw [mixedLocalizationHom_oreDiv, e, Units.inv_mul_cancel_left]

variable (R u Λ S T) in
/-- **Localization at monomials.** The Ore localization of the mixed subalgebra `T_S(R,u,Λ)` at
the monoid generated by the `X_i`, `i ∈ T`, is `T_{S ∪ T}(R,u,Λ)`, via the map induced by the
inclusion. -/
noncomputable def mixedLocalizationEquiv :
    OreLocalization (mixedMonomialSubmonoid R u Λ S T) (mixedSubalgebra R u Λ S) ≃ₐ[R]
      mixedSubalgebra R u Λ (S ∪ T) :=
  AlgEquiv.ofBijective (mixedLocalizationHom R u Λ S T)
    ⟨mixedLocalizationHom_injective, mixedLocalizationHom_surjective⟩

theorem mixedLocalizationEquiv_numeratorHom (r : mixedSubalgebra R u Λ S) :
    mixedLocalizationEquiv R u Λ S T (OreLocalization.numeratorHom r) =
      Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T) r := by
  let : Fintype M := Fintype.ofFinite M
  exact mixedLocalizationHom_numeratorHom r

theorem mixedLocalizationEquiv_oreDiv (r : mixedSubalgebra R u Λ S)
    (s : mixedMonomialSubmonoid R u Λ S T) :
    mixedLocalizationEquiv R u Λ S T (r /ₒ s) =
      ((mixedMonomialUnits R u Λ S T s)⁻¹ : (mixedSubalgebra R u Λ (S ∪ T))ˣ) *
        Subalgebra.inclusion (mixedSubalgebra_le_union R u Λ S T) r := by
  let : Fintype M := Fintype.ofFinite M
  exact rfl

end Localization

/-! ### Mixed subalgebras of a lattice with a basis -/

section OreTransport

/-- A left Ore set pulls back along a multiplicative equivalence. -/
theorem nonempty_oreSet_of_mulEquiv {A B : Type*} [Monoid A] [Monoid B] (e : A ≃* B)
    {P : Submonoid A} {Q : Submonoid B} [OreLocalization.OreSet Q] (h : ∀ x, x ∈ P ↔ e x ∈ Q) :
    Nonempty (OreLocalization.OreSet P) := by
  obtain ⟨H₁, H₂⟩ :=
    OreLocalization.nonempty_oreSet_iff.1 ⟨(inferInstance : OreLocalization.OreSet Q)⟩
  refine OreLocalization.nonempty_oreSet_iff.2 ⟨fun r₁ r₂ s hrs ↦ ?_, fun r s ↦ ?_⟩
  · obtain ⟨s', hs'⟩ := H₁ (e r₁) (e r₂) ⟨e s, (h s).1 s.2⟩ (by simp only [← map_mul, hrs])
    refine ⟨⟨e.symm s', (h _).2 (by simp)⟩, e.injective ?_⟩
    simpa only [map_mul, MulEquiv.apply_symm_apply] using hs'
  · obtain ⟨r', s', hs'⟩ := H₂ (e r) ⟨e s, (h s).1 s.2⟩
    refine ⟨e.symm r', ⟨e.symm s', (h _).2 (by simp)⟩, e.injective ?_⟩
    simpa only [map_mul, MulEquiv.apply_symm_apply] using hs'

end OreTransport

section Basis

variable {R : Type*} [CommRing R] {u : Rˣ} {L : Type*} [AddCommGroup L]
    {Λ : LinearMap.BilinForm ℤ L}
  {ι : Type*} [Fintype ι] (b : Module.Basis ι ℤ L) {S : Set ι}

omit [Fintype ι] in
/-- The mixed subalgebra for `b` is the coordinate mixed subalgebra of `T(R,u,Λ_b)` pulled back
along `basisTorusEquiv b`. -/
theorem mem_basisMixedSubalgebra [Finite ι] {f : quantumTorus R u Λ} :
    f ∈ basisMixedSubalgebra R u Λ b S ↔
      basisTorusEquiv R u Λ b f ∈
        mixedSubalgebra R u (LinearMap.BilinForm.congr b.equivFun Λ) S := by
  let : Fintype ι := Fintype.ofFinite ι
  rw [mem_basisMixedSubalgebra_iff, mem_mixedSubalgebra_iff]
  constructor
  · intro h c hc i hi
    have ha : b.equivFun.symm c ∈ support f := by
      rw [mem_support_iff, ← coeff_basisTorusEquiv b, LinearEquiv.apply_symm_apply]
      exact mem_support_iff.1 hc
    have hci : b.repr (b.equivFun.symm c) i = c i := by
      rw [← Module.Basis.equivFun_apply, LinearEquiv.apply_symm_apply]
    exact hci ▸ h _ ha i hi
  · intro h a ha i hi
    have hc : b.equivFun a ∈ support (basisTorusEquiv R u Λ b f) := by
      rw [mem_support_iff, coeff_basisTorusEquiv]
      exact mem_support_iff.1 ha
    simpa [Module.Basis.equivFun_apply] using h _ hc i hi

omit [Fintype ι] in
theorem monomial_mem_basisMixedSubalgebra [Finite ι] {a : L} (ha : ∀ i ∉ S, 0 ≤ b.repr a i) :
    (monomial a : quantumTorus R u Λ) ∈ basisMixedSubalgebra R u Λ b S := by
  let : Fintype ι := Fintype.ofFinite ι
  rw [mem_basisMixedSubalgebra, basisTorusEquiv_monomial]
  exact monomial_mem_mixedSubalgebra fun i hi ↦ by simpa using ha i hi

omit [Fintype ι] in
theorem basisMixedSubalgebra_mono {S' : Set ι} (h : S ⊆ S') :
    basisMixedSubalgebra R u Λ b S ≤ basisMixedSubalgebra R u Λ b S' := fun _ hf ↦
  (mem_basisMixedSubalgebra_iff b).2 fun a ha i hi ↦
    (mem_basisMixedSubalgebra_iff b).1 hf a ha i fun h' ↦ hi (h h')

omit [Fintype ι] in
theorem basisMixedSubalgebra_univ : basisMixedSubalgebra R u Λ b (Set.univ : Set ι) = ⊤ :=
  eq_top_iff.2 fun _ _ ↦ (mem_basisMixedSubalgebra_iff b).2 fun _ _ i hi ↦
    absurd (Set.mem_univ i) hi

variable (R u Λ S) in
/-- The coordinates of `b` identify the mixed subalgebra for `b` with the coordinate mixed
subalgebra of `T(R,u,Λ_b)`. -/
noncomputable def basisMixedEquiv :
    basisMixedSubalgebra R u Λ b S ≃ₐ[R]
      mixedSubalgebra R u (LinearMap.BilinForm.congr b.equivFun Λ) S where
  toFun x := ⟨basisTorusEquiv R u Λ b x, (mem_basisMixedSubalgebra b).1 x.2⟩
  invFun y := ⟨(basisTorusEquiv R u Λ b).symm y, by
    rw [mem_basisMixedSubalgebra, AlgEquiv.apply_symm_apply]
    exact y.2⟩
  left_inv x := Subtype.ext ((basisTorusEquiv R u Λ b).symm_apply_apply x)
  right_inv y := Subtype.ext ((basisTorusEquiv R u Λ b).apply_symm_apply y)
  map_mul' x y := Subtype.ext (map_mul (basisTorusEquiv R u Λ b) (x : quantumTorus R u Λ) y)
  map_add' x y := Subtype.ext (map_add (basisTorusEquiv R u Λ b) (x : quantumTorus R u Λ) y)
  commutes' c := Subtype.ext ((basisTorusEquiv R u Λ b).commutes c)

@[simp] theorem coe_basisMixedEquiv (x : basisMixedSubalgebra R u Λ b S) :
    (basisMixedEquiv R u Λ b S x : quantumTorus R u (LinearMap.BilinForm.congr b.equivFun Λ)) =
      basisTorusEquiv R u Λ b x :=
  rfl

@[simp] theorem coe_basisMixedEquiv_symm
    (y : mixedSubalgebra R u (LinearMap.BilinForm.congr b.equivFun Λ) S) :
    ((basisMixedEquiv R u Λ b S).symm y : quantumTorus R u Λ) =
      (basisTorusEquiv R u Λ b).symm y :=
  rfl

/-! The multiplicativity of `basisMixedEquiv`, stated directly: instance search for the generic
`map_one`/`map_mul` on these subalgebra types is slow. -/

theorem basisMixedEquiv_one : basisMixedEquiv R u Λ b S 1 = 1 :=
  Subtype.ext (map_one (basisTorusEquiv R u Λ b))

theorem basisMixedEquiv_mul (x y : basisMixedSubalgebra R u Λ b S) :
    basisMixedEquiv R u Λ b S (x * y) = basisMixedEquiv R u Λ b S x * basisMixedEquiv R u Λ b S y :=
  Subtype.ext (map_mul (basisTorusEquiv R u Λ b) (x : quantumTorus R u Λ) y)

theorem basisMixedEquiv_symm_one : (basisMixedEquiv R u Λ b S).symm 1 = 1 :=
  Subtype.ext (map_one (basisTorusEquiv R u Λ b).symm)

theorem basisMixedEquiv_symm_mul
    (x y : mixedSubalgebra R u (LinearMap.BilinForm.congr b.equivFun Λ) S) :
    (basisMixedEquiv R u Λ b S).symm (x * y) =
      (basisMixedEquiv R u Λ b S).symm x * (basisMixedEquiv R u Λ b S).symm y :=
  Subtype.ext (map_mul (basisTorusEquiv R u Λ b).symm
    (x : quantumTorus R u (LinearMap.BilinForm.congr b.equivFun Λ)) y)

variable (R u Λ S) in
/-- The monomial basis of the mixed subalgebra for `b`, indexed by the `b`-coordinates of the
exponents: `basisMixedBasis a = X^{Σ a_i b_i}`. -/
noncomputable def basisMixedBasis :
    Module.Basis (mixedExponents S) R (basisMixedSubalgebra R u Λ b S) :=
  (mixedBasis R u (LinearMap.BilinForm.congr b.equivFun Λ) S).map
    (basisMixedEquiv R u Λ b S).symm.toLinearEquiv

@[simp] theorem coe_basisMixedBasis (a : mixedExponents S) :
    (basisMixedBasis R u Λ b S a : quantumTorus R u Λ) =
      monomial (b.equivFun.symm (a : ι → ℤ)) := by
  simp [basisMixedBasis]

theorem basisMixedEquiv_basisMixedBasis (a : mixedExponents S) :
    basisMixedEquiv R u Λ b S (basisMixedBasis R u Λ b S a) =
      mixedBasis R u (LinearMap.BilinForm.congr b.equivFun Λ) S a := by
  simp [basisMixedBasis]

variable [DecidableEq ι]

variable (S) in
/-- The generator `X^{b_i}` of the mixed subalgebra for `b`. -/
noncomputable def basisMixedX (i : ι) : basisMixedSubalgebra R u Λ b S :=
  (basisMixedEquiv R u Λ b S).symm (mixedX S i)

@[simp] theorem coe_basisMixedX (i : ι) :
    (basisMixedX (R := R) (u := u) (Λ := Λ) b S i : quantumTorus R u Λ) = monomial (b i) := by
  simp [basisMixedX]

@[simp] theorem basisMixedEquiv_basisMixedX (i : ι) :
    basisMixedEquiv R u Λ b S (basisMixedX (R := R) (u := u) (Λ := Λ) b S i) = mixedX S i :=
  AlgEquiv.apply_symm_apply _ _

/-- For `i ∈ S` the generator `X^{b_i}` is a unit of the mixed subalgebra. -/
theorem isUnit_basisMixedX {i : ι} (hi : i ∈ S) :
    IsUnit (basisMixedX (R := R) (u := u) (Λ := Λ) b S i) :=
  (isUnit_mixedX hi).map _

omit [Fintype ι] in
/-- The quasi-commutation of a family indexed by the basis, in the coordinates of `b`:
`U_i U_j = u^{2Λ(b_i,b_j)} U_j U_i`. -/
theorem isQuasiCommutingFamily_congr_equivFun_iff [Finite ι] {A : Type*} [Ring A] [Algebra R A]
  {U : ι → A} :
    IsQuasiCommutingFamily u (LinearMap.BilinForm.congr b.equivFun Λ) U ↔
      ∀ i j, U i * U j = ((u ^ (2 * Λ (b i) (b j)) : Rˣ) : R) • (U j * U i) := by
  let : Fintype ι := Fintype.ofFinite ι
  simp only [IsQuasiCommutingFamily, congr_equivFun_single_single]

variable {A : Type*} [Ring A] [Algebra R A] {U : ι → A} {hS : ∀ i ∈ S, IsUnit (U i)}

/-- An algebra map out of the mixed subalgebra for `b` is determined by its values on the
generators `X^{b_i}`. -/
theorem basisMixedAlgHom_ext (hΛ : LinearMap.IsAlt Λ) {f g : basisMixedSubalgebra R u Λ b S →ₐ[R] A}
    (h : ∀ i, f (basisMixedX b S i) = g (basisMixedX b S i)) : f = g := by
  have key : f.comp (basisMixedEquiv R u Λ b S).symm.toAlgHom =
      g.comp (basisMixedEquiv R u Λ b S).symm.toAlgHom :=
    mixedAlgHom_ext (isAlt_congr hΛ b.equivFun) fun i ↦ h i
  ext x
  simpa using congrArg (fun F ↦ F (basisMixedEquiv R u Λ b S x)) key

/-- **The universal property of the mixed subalgebra for `b`.** Elements `U_i` of an
`R`-algebra with `U_i U_j = u^{2Λ(b_i,b_j)} U_j U_i` (`isQuasiCommutingFamily_congr_equivFun_iff`),
units for `i ∈ S`, define an `R`-algebra map with `X^{b_i} ↦ U_i`; it is unique by
`basisMixedAlgHom_ext`. -/
noncomputable def basisMixedLift (hΛ : LinearMap.IsAlt Λ) (U : ι → A) (hS : ∀ i ∈ S, IsUnit (U i))
    (hU : IsQuasiCommutingFamily u (LinearMap.BilinForm.congr b.equivFun Λ) U) :
    basisMixedSubalgebra R u Λ b S →ₐ[R] A :=
  (mixedLift (isAlt_congr hΛ b.equivFun) U hS hU).comp (basisMixedEquiv R u Λ b S).toAlgHom

@[simp] theorem basisMixedLift_basisMixedX (hΛ : LinearMap.IsAlt Λ)
    (hU : IsQuasiCommutingFamily u (LinearMap.BilinForm.congr b.equivFun Λ) U) (i : ι) :
    basisMixedLift b hΛ U hS hU (basisMixedX b S i) = U i := by
  simp [basisMixedLift]

/-- Uniqueness: an algebra map sending each `X^{b_i}` to `U_i` is `basisMixedLift`. -/
theorem eq_basisMixedLift (hΛ : LinearMap.IsAlt Λ)
    (hU : IsQuasiCommutingFamily u (LinearMap.BilinForm.congr b.equivFun Λ) U)
    (f : basisMixedSubalgebra R u Λ b S →ₐ[R] A) (hf : ∀ i, f (basisMixedX b S i) = U i) :
    f = basisMixedLift b hΛ U hS hU :=
  basisMixedAlgHom_ext b hΛ fun i ↦ by rw [hf, basisMixedLift_basisMixedX]

/-- **Independence of the order.** Along any list `l` enumerating `ι` once, `basisMixedLift`
sends `X^{Σ a_i b_i}` to `u^{-Σ_{i<j} a_i a_j Λ(b_i,b_j)} ∏_{i ∈ l} U_i^{a_i}`. -/
theorem basisMixedLift_basisMixedBasis (hΛ : LinearMap.IsAlt Λ)
    (hU : IsQuasiCommutingFamily u (LinearMap.BilinForm.congr b.equivFun Λ) U) {l : List ι}
    (hl : l.Nodup) (hlc : ∀ i, i ∈ l) (a : mixedExponents S) :
    basisMixedLift b hΛ U hS hU (basisMixedBasis R u Λ b S a) =
      mixedNormalizedProd u (LinearMap.BilinForm.congr b.equivFun Λ) S U hS l a := by
  change mixedLift (isAlt_congr hΛ b.equivFun) U hS hU
    (basisMixedEquiv R u Λ b S (basisMixedBasis R u Λ b S a)) = _
  rw [basisMixedEquiv_basisMixedBasis, mixedLift_mixedBasis _ hU hl hlc]

/-! #### Localization at monomials -/

variable (R u Λ) in
/-- The monoid generated by the generators `X^{b_i}`, `i ∈ T`, of the mixed subalgebra for `S`. -/
noncomputable def basisMonomialSubmonoid (S T : Set ι) :
    Submonoid (basisMixedSubalgebra R u Λ b S) :=
  Submonoid.closure (basisMixedX b S '' T)

variable {T : Set ι}

theorem mem_basisMonomialSubmonoid_iff {s : basisMixedSubalgebra R u Λ b S} :
    s ∈ basisMonomialSubmonoid R u Λ b S T ↔
      basisMixedEquiv R u Λ b S s ∈
        mixedMonomialSubmonoid R u (LinearMap.BilinForm.congr b.equivFun Λ) S T := by
  constructor
  · intro hs
    induction hs using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      rw [basisMixedEquiv_basisMixedX]
      exact Submonoid.subset_closure ⟨i, hi, rfl⟩
    | one => rw [basisMixedEquiv_one]; exact one_mem _
    | mul x y _ _ hx hy => rw [basisMixedEquiv_mul]; exact mul_mem hx hy
  · intro hs
    rw [← (basisMixedEquiv R u Λ b S).symm_apply_apply s]
    generalize basisMixedEquiv R u Λ b S s = t at hs ⊢
    induction hs using Submonoid.closure_induction with
    | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      exact Submonoid.subset_closure ⟨i, hi, rfl⟩
    | one => rw [basisMixedEquiv_symm_one]; exact one_mem _
    | mul x y _ _ hx hy => rw [basisMixedEquiv_symm_mul]; exact mul_mem hx hy

/-- **The monomials form a left Ore set** in the mixed subalgebra for `b`. -/
noncomputable instance (S T : Set ι) :
    OreLocalization.OreSet (basisMonomialSubmonoid R u Λ b S T) :=
  (nonempty_oreSet_of_mulEquiv (basisMixedEquiv R u Λ b S).toRingEquiv.toMulEquiv
    fun _ ↦ mem_basisMonomialSubmonoid_iff b).some

omit [Fintype ι] [DecidableEq ι] in
variable (R u Λ S T) in
theorem basisMixedSubalgebra_le_union :
    basisMixedSubalgebra R u Λ b S ≤ basisMixedSubalgebra R u Λ b (S ∪ T) :=
  basisMixedSubalgebra_mono b Set.subset_union_left

/-- The generators `X^{b_i}`, `i ∈ T`, become units in the mixed subalgebra for `S ∪ T`. -/
theorem isUnit_inclusion_of_mem_basisMonomialSubmonoid {s : basisMixedSubalgebra R u Λ b S}
    (hs : s ∈ basisMonomialSubmonoid R u Λ b S T) :
    IsUnit (Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T) s) := by
  induction hs using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨i, hi, rfl⟩ := hx
    have e : Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T) (basisMixedX b S i) =
        basisMixedX b (S ∪ T) i :=
      Subtype.ext (by simp)
    rw [e]
    exact isUnit_basisMixedX b (Or.inr hi)
  | one =>
    rw [map_one]
    exact isUnit_one
  | mul x y _ _ hx hy =>
    rw [map_mul]
    exact hx.mul hy

variable (R u Λ S T) in
/-- The monoid generated by the `X^{b_i}`, `i ∈ T`, mapped to the units of the mixed subalgebra
for `S ∪ T`. -/
noncomputable def basisMonomialUnits :
    basisMonomialSubmonoid R u Λ b S T →* (basisMixedSubalgebra R u Λ b (S ∪ T))ˣ :=
  IsUnit.liftRight
    ((MonoidHom.ofClass (Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T))).comp
      (basisMonomialSubmonoid R u Λ b S T).subtype)
    fun s ↦ isUnit_inclusion_of_mem_basisMonomialSubmonoid b s.2

variable (R u Λ S T) in
/-- The comparison map from the Ore localization of the mixed subalgebra for `S` at the monomials
of `T` to the mixed subalgebra for `S ∪ T`, sending `s⁻¹ r` to `s⁻¹ r`. -/
noncomputable def basisMixedLocalizationHom :
    OreLocalization (basisMonomialSubmonoid R u Λ b S T) (basisMixedSubalgebra R u Λ b S) →ₐ[R]
      basisMixedSubalgebra R u Λ b (S ∪ T) :=
  { OreLocalization.universalHom
      (Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T)).toRingHom
      (basisMonomialUnits R u Λ b S T) (fun _ ↦ rfl) with
    commutes' := fun r ↦ (OreLocalization.universalHom_commutes _ _ _).trans
      ((Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T)).commutes r) }

theorem basisMixedLocalizationHom_oreDiv (r : basisMixedSubalgebra R u Λ b S)
    (s : basisMonomialSubmonoid R u Λ b S T) :
    basisMixedLocalizationHom R u Λ b S T (r /ₒ s) =
      ((basisMonomialUnits R u Λ b S T s)⁻¹ : (basisMixedSubalgebra R u Λ b (S ∪ T))ˣ) *
        Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T) r :=
  rfl

theorem basisMixedLocalizationHom_numeratorHom (r : basisMixedSubalgebra R u Λ b S) :
    basisMixedLocalizationHom R u Λ b S T (OreLocalization.numeratorHom r) =
      Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T) r :=
  OreLocalization.universalHom_commutes _ _ _

theorem basisMixedLocalizationHom_injective :
    Function.Injective (basisMixedLocalizationHom R u Λ b S T) := by
  refine (injective_iff_map_eq_zero _).2 fun x hx ↦ ?_
  induction x using OreLocalization.ind with | _ r s
  rw [basisMixedLocalizationHom_oreDiv, Units.mul_right_eq_zero] at hx
  obtain rfl : r = 0 := Subalgebra.inclusion_injective _ (by rw [hx, map_zero])
  exact OreLocalization.zero_oreDiv s

theorem basisMixedLocalizationHom_surjective :
    Function.Surjective (basisMixedLocalizationHom R u Λ b S T) := by
  intro z
  obtain ⟨s, hs, hsz⟩ := exists_mem_mixedMonomialSubmonoid_mul_mem (T := T)
    ((mem_basisMixedSubalgebra b).1 (show (z : quantumTorus R u Λ) ∈
      basisMixedSubalgebra R u Λ b (S ∪ T) from z.2))
  set s₀ := (basisMixedEquiv R u Λ b S).symm s
  have hs₀ : s₀ ∈ basisMonomialSubmonoid R u Λ b S T := by
    rw [mem_basisMonomialSubmonoid_iff, AlgEquiv.apply_symm_apply]
    exact hs
  have hs₀z : (s₀ : quantumTorus R u Λ) * z ∈ basisMixedSubalgebra R u Λ b S := by
    rw [mem_basisMixedSubalgebra, map_mul, coe_basisMixedEquiv_symm, AlgEquiv.apply_symm_apply]
    exact hsz
  refine ⟨⟨_, hs₀z⟩ /ₒ ⟨s₀, hs₀⟩, ?_⟩
  have e : Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T) ⟨_, hs₀z⟩ =
      (basisMonomialUnits R u Λ b S T ⟨s₀, hs₀⟩ : basisMixedSubalgebra R u Λ b (S ∪ T)) * z :=
    Subtype.ext rfl
  rw [basisMixedLocalizationHom_oreDiv, e, Units.inv_mul_cancel_left]

variable (R u Λ S T) in
/-- **Localization at monomials for a basis.** The Ore localization of the mixed subalgebra for
`S` at the monoid generated by the `X^{b_i}`, `i ∈ T`, is the mixed subalgebra for `S ∪ T`. -/
noncomputable def basisMixedLocalizationEquiv :
    OreLocalization (basisMonomialSubmonoid R u Λ b S T) (basisMixedSubalgebra R u Λ b S) ≃ₐ[R]
      basisMixedSubalgebra R u Λ b (S ∪ T) :=
  AlgEquiv.ofBijective (basisMixedLocalizationHom R u Λ b S T)
    ⟨basisMixedLocalizationHom_injective b, basisMixedLocalizationHom_surjective b⟩

theorem basisMixedLocalizationEquiv_numeratorHom (r : basisMixedSubalgebra R u Λ b S) :
    basisMixedLocalizationEquiv R u Λ b S T (OreLocalization.numeratorHom r) =
      Subalgebra.inclusion (basisMixedSubalgebra_le_union R u Λ b S T) r :=
  basisMixedLocalizationHom_numeratorHom b r

end Basis

end TauCeti.QuantumTorus
