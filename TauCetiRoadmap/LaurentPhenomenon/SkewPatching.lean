/-!
# Two-denominator patching in a division ring

Seed-free algebra for intersections of embedded skew charts; no commutativity is
assumed. `mem_of_patching` recovers membership in a subring from two right
denominators and a Bézout identity for their powers. In the embedded skew
polynomial ring `skewPolyRing C y`, an element with unit constant term has a right
inverse modulo every power of `y`, and right denominators `y ^ s` exist after
adjoining `y⁻¹` to a ring normalized by `y`. `inf_eq_of_unitConstantTerm`
combines these into the two-chart intersection of the interacting rank-two case.
-/

@[expose] public section

namespace TauCeti.Laurent

section Ring

variable {R : Type*} [Ring R]

/-- Two right denominators whose powers satisfy a Bézout identity clear each other. -/
theorem mem_of_patching (H : Subring R) {f x y U V : R} {r s : ℕ}
    (hx : f * x ^ r ∈ H) (hy : f * y ^ s ∈ H) (hU : U ∈ H) (hV : V ∈ H)
    (hUV : x ^ r * U + y ^ s * V = 1) : f ∈ H := by
  have hf : f = f * x ^ r * U + f * y ^ s * V := by
    rw [mul_assoc, mul_assoc, ← mul_add, hUV, mul_one]
  rw [hf]
  exact H.add_mem (H.mul_mem hx hU) (H.mul_mem hy hV)

/-- If elements of `Hi` have right denominators `y ^ s` in `H`, elements of `Hj` have
right denominators `x ^ r` in `H`, and all powers of `x` and `y` satisfy a Bézout
identity in `H`, then `Hi ⊓ Hj = H`. -/
theorem inf_eq_of_patching {H Hi Hj : Subring R} {x y : R}
    (hHi : H ≤ Hi) (hHj : H ≤ Hj)
    (hi : ∀ f ∈ Hi, ∃ s : ℕ, f * y ^ s ∈ H)
    (hj : ∀ f ∈ Hj, ∃ r : ℕ, f * x ^ r ∈ H)
    (hbezout : ∀ r s : ℕ, ∃ U ∈ H, ∃ V ∈ H, x ^ r * U + y ^ s * V = 1) :
    Hi ⊓ Hj = H := by
  apply le_antisymm _ (le_inf hHi hHj)
  intro f hf
  obtain ⟨hfi, hfj⟩ := Subring.mem_inf.mp hf
  obtain ⟨s, hs⟩ := hi f hfi
  obtain ⟨r, hr⟩ := hj f hfj
  obtain ⟨U, hU, V, hV, hUV⟩ := hbezout r s
  exact mem_of_patching H hr hs hU hV hUV

/-- The subring generated by `C` and `y`, without `y⁻¹`. When `y` normalizes `C`
this is the skew polynomial ring `C[y; σ]` embedded in the ambient ring. -/
def skewPolyRing (C : Subring R) (y : R) : Subring R :=
  Subring.closure ((C : Set R) ∪ {y})

theorem coefficient_mem_skewPolyRing (C : Subring R) (y : R) {c : R} (hc : c ∈ C) :
    c ∈ skewPolyRing C y :=
  Subring.subset_closure (Or.inl hc)

theorem le_skewPolyRing (C : Subring R) (y : R) : C ≤ skewPolyRing C y :=
  fun _ hc ↦ coefficient_mem_skewPolyRing C y hc

theorem generator_mem_skewPolyRing (C : Subring R) (y : R) : y ∈ skewPolyRing C y :=
  Subring.subset_closure (Or.inr rfl)

theorem skewPolyRing_le {C L : Subring R} {y : R} (hC : C ≤ L) (hy : y ∈ L) :
    skewPolyRing C y ≤ L := by
  apply Subring.closure_le.mpr
  rintro a (ha | ha)
  · exact hC ha
  · rw [Set.mem_singleton_iff.mp ha]
    exact hy

end Ring

section DivisionRing

variable {D : Type*} [DivisionRing D]

/-- `y` is nonzero and conjugation by `y` and by `y⁻¹` preserves `C`. -/
def Normalizes (C : Subring D) (y : D) : Prop :=
  y ≠ 0 ∧ (∀ c ∈ C, y * c * y⁻¹ ∈ C) ∧ ∀ c ∈ C, y⁻¹ * c * y ∈ C

namespace Normalizes

variable {C : Subring D} {y z : D}

theorem ne_zero (h : Normalizes C y) : y ≠ 0 := h.1
theorem conj_mem (h : Normalizes C y) {c : D} (hc : c ∈ C) : y * c * y⁻¹ ∈ C :=
  h.2.1 c hc

theorem inv_conj_mem (h : Normalizes C y) {c : D} (hc : c ∈ C) : y⁻¹ * c * y ∈ C :=
  h.2.2 c hc

theorem one : Normalizes C 1 :=
  ⟨one_ne_zero, fun c hc ↦ by simpa using hc, fun c hc ↦ by simpa using hc⟩

theorem inv (h : Normalizes C y) : Normalizes C y⁻¹ :=
  ⟨inv_ne_zero h.1, fun c hc ↦ by simpa using h.inv_conj_mem hc,
    fun c hc ↦ by simpa using h.conj_mem hc⟩

theorem mul (hy : Normalizes C y) (hz : Normalizes C z) : Normalizes C (y * z) := by
  refine ⟨mul_ne_zero hy.1 hz.1, fun c hc ↦ ?_, fun c hc ↦ ?_⟩
  · convert hy.conj_mem (hz.conj_mem hc) using 1
    simp only [mul_inv_rev, mul_assoc]
  · convert hz.inv_conj_mem (hy.inv_conj_mem hc) using 1
    simp only [mul_inv_rev, mul_assoc]

theorem pow (h : Normalizes C y) (n : ℕ) : Normalizes C (y ^ n) := by
  induction n with
  | zero => rw [pow_zero]; exact Normalizes.one
  | succ n ih => rw [pow_succ]; exact ih.mul h

/-- A nonzero element commuting with `C` normalizes `C`: the trivial automorphism. -/
theorem of_forall_commute (hy : y ≠ 0) (h : ∀ c ∈ C, Commute y c) : Normalizes C y := by
  refine ⟨hy, fun c hc ↦ ?_, fun c hc ↦ ?_⟩
  · rw [(h c hc).eq, mul_inv_cancel_right₀ hy]
    exact hc
  · rw [((h c hc).inv_left₀).eq, inv_mul_cancel_right₀ hy]
    exact hc

/-- In a field every nonzero element normalizes every subring. -/
theorem of_ne_zero {F : Type*} [Field F] {C : Subring F} {y : F} (hy : y ≠ 0) :
    Normalizes C y :=
  of_forall_commute hy fun c _ ↦ Commute.all y c

end Normalizes

/-- Conjugation by a nonzero `z` maps a subring closure into `T` once it maps the
generators into `T`. -/
theorem conj_mem_of_mem_closure {z : D} (hz : z ≠ 0) {s : Set D} {T : Subring D}
    (hs : ∀ a ∈ s, z * a * z⁻¹ ∈ T) {a : D} (ha : a ∈ Subring.closure s) :
    z * a * z⁻¹ ∈ T := by
  induction ha using Subring.closure_induction with
  | mem a ha => exact hs a ha
  | zero => simp
  | one => simp [hz]
  | add a b _ _ ha hb => simpa [mul_add, add_mul] using T.add_mem ha hb
  | neg a _ ha => simpa using T.neg_mem ha
  | mul a b _ _ ha hb =>
    convert T.mul_mem ha hb using 1
    simp only [mul_assoc, inv_mul_cancel_left₀ hz]

section Scalars

variable {R : Type*} [CommRing R] [Algebra R D]

/-- Any nonzero element normalizes the image of the scalars. -/
theorem normalizes_algebraMap_range {z : D} (hz : z ≠ 0) :
    Normalizes (algebraMap R D).range z := by
  refine ⟨hz, ?_, ?_⟩
  · rintro _ ⟨r, rfl⟩
    exact ⟨r, by rw [← Algebra.commutes, mul_assoc, mul_inv_cancel₀ hz, mul_one]⟩
  · rintro _ ⟨r, rfl⟩
    exact ⟨r, by rw [← Algebra.commutes, mul_assoc, inv_mul_cancel₀ hz, mul_one]⟩

/-- `z` normalizes `C⟨T⟩` when it normalizes `C`, `C` contains the scalars, and `z` commutes
with every element of `T` up to a unit scalar. -/
theorem normalizes_closure {C : Subring D} {T : Set D} {z : D} (hz : Normalizes C z)
    (hC : ∀ r : R, algebraMap R D r ∈ C)
    (hT : ∀ g ∈ T, ∃ u : Rˣ, z * g = algebraMap R D (u : R) * (g * z)) :
    Normalizes (Subring.closure ((C : Set D) ∪ T)) z := by
  have hz0 := hz.ne_zero
  refine ⟨hz0, fun c hc ↦ conj_mem_of_mem_closure hz0 ?_ hc, fun c hc ↦ ?_⟩
  · rintro g (hg | hg)
    · exact Subring.subset_closure (Or.inl (hz.conj_mem hg))
    · obtain ⟨u, hu⟩ := hT g hg
      rw [hu, mul_assoc, mul_assoc, mul_inv_cancel₀ hz0, mul_one]
      exact Subring.mul_mem _ (Subring.subset_closure (Or.inl (hC _)))
        (Subring.subset_closure (Or.inr hg))
  · have h := conj_mem_of_mem_closure (inv_ne_zero hz0)
      (T := Subring.closure ((C : Set D) ∪ T)) ?_ hc
    · simpa using h
    rintro g (hg | hg)
    · simpa using Subring.subset_closure (s := (C : Set D) ∪ T) (Or.inl (hz.inv_conj_mem hg))
    · obtain ⟨u, hu⟩ := hT g hg
      have e : z⁻¹ * g * z⁻¹⁻¹ = algebraMap R D ((u⁻¹ : Rˣ) : R) * g := by
        rw [inv_inv]
        apply mul_left_cancel₀ hz0
        calc z * (z⁻¹ * g * z) = g * z := by
              simp only [← mul_assoc, mul_inv_cancel₀ hz0, one_mul]
          _ = algebraMap R D ((u⁻¹ : Rˣ) : R) * (z * g) := by
              rw [hu, ← mul_assoc, ← map_mul, Units.inv_mul, map_one, one_mul]
          _ = z * (algebraMap R D ((u⁻¹ : Rˣ) : R) * g) := by
              rw [← mul_assoc, ← mul_assoc, Algebra.commutes]
      rw [e]
      exact Subring.mul_mem _ (Subring.subset_closure (Or.inl (hC _)))
        (Subring.subset_closure (Or.inr hg))

end Scalars

variable {C : Subring D} {x y z : D}

/-- Conjugation by `y ^ {± 1}` preserves the skew polynomial ring `C[y]`. -/
theorem normalizes_skewPolyRing (h : Normalizes C y) : Normalizes (skewPolyRing C y) y := by
  refine ⟨h.ne_zero, fun w hw ↦ ?_, fun w hw ↦ ?_⟩
  · refine conj_mem_of_mem_closure h.ne_zero ?_ hw
    rintro a (ha | ha)
    · exact coefficient_mem_skewPolyRing C y (h.conj_mem ha)
    · rw [Set.mem_singleton_iff.mp ha, mul_inv_cancel_right₀ h.ne_zero]
      exact generator_mem_skewPolyRing C y
  · have hw' := conj_mem_of_mem_closure (inv_ne_zero h.ne_zero) (T := skewPolyRing C y)
      ?_ hw
    · simpa using hw'
    rintro a (ha | ha)
    · simpa using coefficient_mem_skewPolyRing C y (h.inv_conj_mem ha)
    · rw [Set.mem_singleton_iff.mp ha, inv_inv, inv_mul_cancel₀ h.ne_zero, one_mul]
      exact generator_mem_skewPolyRing C y

/-- Powers of `y * w` with `w ∈ C[y]` are left divisible by the same power of `y`. -/
theorem exists_mul_pow_eq (h : Normalizes C y) {w : D} (hw : w ∈ skewPolyRing C y)
    (s : ℕ) : ∃ V ∈ skewPolyRing C y, (y * w) ^ s = y ^ s * V := by
  induction s with
  | zero => exact ⟨1, Subring.one_mem _, by simp⟩
  | succ s ih =>
    obtain ⟨V, hV, hs⟩ := ih
    refine ⟨y⁻¹ * V * y * w,
      Subring.mul_mem _ ((normalizes_skewPolyRing h).inv_conj_mem hV) hw, ?_⟩
    rw [pow_succ, hs, pow_succ]
    simp only [mul_assoc, mul_inv_cancel_left₀ h.ne_zero]

/-- The constant term of a power: `(c + y * w) ^ n = c ^ n + y * w'` with `w' ∈ C[y]`. -/
theorem exists_pow_eq_add_mul (h : Normalizes C y) {c w : D} (hc : c ∈ C)
    (hw : w ∈ skewPolyRing C y) (n : ℕ) :
    ∃ w' ∈ skewPolyRing C y, (c + y * w) ^ n = c ^ n + y * w' := by
  induction n with
  | zero => exact ⟨0, Subring.zero_mem _, by simp⟩
  | succ n ih =>
    obtain ⟨w', hw', hn⟩ := ih
    let S := skewPolyRing C y
    refine ⟨y⁻¹ * c ^ n * y * w + w' * c + w' * y * w,
      S.add_mem (S.add_mem (S.mul_mem (le_skewPolyRing C y
        (h.inv_conj_mem (C.pow_mem hc n))) hw) (S.mul_mem hw' (le_skewPolyRing C y hc)))
        (S.mul_mem (S.mul_mem hw' (generator_mem_skewPolyRing C y)) hw), ?_⟩
    rw [pow_succ, hn, pow_succ]
    simp only [mul_add, add_mul, mul_assoc, mul_inv_cancel_left₀ h.ne_zero]
    abel

/-- `g = a * (1 + y * w)` with `a` a unit of `C` and `w ∈ C[y]`. -/
def UnitConstantTerm (C : Subring D) (y g : D) : Prop :=
  ∃ a ∈ C, a ≠ 0 ∧ a⁻¹ ∈ C ∧ ∃ w ∈ skewPolyRing C y, g = a * (1 + y * w)

/-- A unit coefficient plus a positive skew-polynomial remainder has unit constant term. -/
theorem unitConstantTerm_add (hy : Normalizes C y) {a w : D} (ha : a ∈ C)
    (ha0 : a ≠ 0) (hai : a⁻¹ ∈ C) (hw : w ∈ skewPolyRing C y) :
    UnitConstantTerm C y (a + y * w) := by
  refine ⟨a, ha, ha0, hai, y⁻¹ * a⁻¹ * y * w,
    (skewPolyRing C y).mul_mem (le_skewPolyRing _ _ (hy.inv_conj_mem hai)) hw, ?_⟩
  rw [mul_add, mul_one]
  congr 1
  simp only [mul_assoc, mul_inv_cancel_left₀ hy.ne_zero, mul_inv_cancel_left₀ ha0]

theorem unitConstantTerm_one (C : Subring D) (y : D) : UnitConstantTerm C y 1 :=
  ⟨1, C.one_mem, one_ne_zero, by simp, 0, Subring.zero_mem _, by simp⟩

namespace UnitConstantTerm

/-- Elements with unit constant term are closed under multiplication. -/
theorem mul (hy : Normalizes C y) {g g' : D} (hg : UnitConstantTerm C y g)
    (hg' : UnitConstantTerm C y g') : UnitConstantTerm C y (g * g') := by
  obtain ⟨a, ha, ha0, hai, w, hw, rfl⟩ := hg
  obtain ⟨a', ha', ha'0, ha'i, w', hw', rfl⟩ := hg'
  let S := skewPolyRing C y
  obtain ⟨u, hu_def⟩ : ∃ u, u = y⁻¹ * a'⁻¹ * y * w * a' := ⟨_, rfl⟩
  have hu : u ∈ S := by
    rw [hu_def]
    exact S.mul_mem (S.mul_mem (le_skewPolyRing C y (hy.inv_conj_mem ha'i)) hw)
      (le_skewPolyRing C y ha')
  have hswap : (1 + y * w) * a' = a' * (1 + y * u) := by
    rw [add_mul, mul_add, one_mul, mul_one, hu_def]
    simp only [mul_assoc, mul_inv_cancel_left₀ hy.ne_zero, mul_inv_cancel_left₀ ha'0]
  refine ⟨a * a', C.mul_mem ha ha', mul_ne_zero ha0 ha'0, ?_, u + w' + u * y * w', ?_, ?_⟩
  · rw [mul_inv_rev]
    exact C.mul_mem ha'i hai
  · exact S.add_mem (S.add_mem hu hw')
      (S.mul_mem (S.mul_mem hu (generator_mem_skewPolyRing C y)) hw')
  · calc a * (1 + y * w) * (a' * (1 + y * w')) =
          a * ((1 + y * w) * a') * (1 + y * w') := by simp only [mul_assoc]
      _ = a * (a' * (1 + y * u)) * (1 + y * w') := by rw [hswap]
      _ = a * a' * (1 + y * (u + w' + u * y * w')) := by noncomm_ring

/-- Conjugation by `z` preserves unit constant terms when `z` normalizes `C` and
`z * y * z⁻¹ = y * e` with `e ∈ C`. -/
theorem conj (hz : Normalizes C z) {e : D} (he : e ∈ C) (hzy : z * y * z⁻¹ = y * e)
    {g : D} (hg : UnitConstantTerm C y g) : UnitConstantTerm C y (z * g * z⁻¹) := by
  obtain ⟨a, ha, ha0, hai, w, hw, rfl⟩ := hg
  let S := skewPolyRing C y
  have hzS : ∀ v ∈ S, z * v * z⁻¹ ∈ S := by
    intro v hv
    refine conj_mem_of_mem_closure hz.ne_zero ?_ hv
    rintro b (hb | hb)
    · exact le_skewPolyRing C y (hz.conj_mem hb)
    · rw [Set.mem_singleton_iff.mp hb, hzy]
      exact S.mul_mem (generator_mem_skewPolyRing C y) (le_skewPolyRing C y he)
  refine ⟨z * a * z⁻¹, hz.conj_mem ha, by simp [hz.ne_zero, ha0], ?_,
    e * (z * w * z⁻¹), S.mul_mem (le_skewPolyRing C y he) (hzS w hw), ?_⟩
  · have hinv : (z * a * z⁻¹)⁻¹ = z * a⁻¹ * z⁻¹ := by
      simp only [mul_inv_rev, inv_inv, mul_assoc]
    rw [hinv]
    exact hz.conj_mem hai
  · rw [← mul_assoc y e, ← hzy]
    simp only [mul_add, add_mul, mul_one, mul_assoc, inv_mul_cancel_left₀ hz.ne_zero]

/-- A right inverse modulo `y ^ s`: `g * W = 1 - y ^ s * V` in `C[y]`. -/
theorem exists_mul_eq (hy : Normalizes C y) {g : D} (hg : UnitConstantTerm C y g) (s : ℕ) :
    ∃ W ∈ skewPolyRing C y, ∃ V ∈ skewPolyRing C y, g * W = 1 - y ^ s * V := by
  obtain ⟨a, ha, ha0, hai, w, hw, rfl⟩ := hg
  let S := skewPolyRing C y
  obtain ⟨V₀, hV₀, hpow⟩ := exists_mul_pow_eq hy (S.neg_mem hw) s
  refine ⟨(∑ h ∈ Finset.range s, (-(y * w)) ^ h) * a⁻¹, ?_,
    (y ^ s)⁻¹ * a * y ^ s * V₀ * a⁻¹, ?_, ?_⟩
  · exact S.mul_mem (sum_mem fun h _ ↦ S.pow_mem
      (S.neg_mem (S.mul_mem (generator_mem_skewPolyRing C y) hw)) h)
      (le_skewPolyRing C y hai)
  · exact S.mul_mem (S.mul_mem (le_skewPolyRing C y ((hy.pow s).inv_conj_mem ha)) hV₀)
      (le_skewPolyRing C y hai)
  · have hgeom := mul_neg_geom_sum (-(y * w)) s
    rw [sub_neg_eq_add] at hgeom
    calc a * (1 + y * w) * ((∑ h ∈ Finset.range s, (-(y * w)) ^ h) * a⁻¹) =
          a * ((1 + y * w) * ∑ h ∈ Finset.range s, (-(y * w)) ^ h) * a⁻¹ := by
            simp only [mul_assoc]
      _ = a * (1 - (y * -w) ^ s) * a⁻¹ := by rw [hgeom, mul_neg]
      _ = 1 - y ^ s * ((y ^ s)⁻¹ * a * y ^ s * V₀ * a⁻¹) := by
          rw [hpow]
          simp only [mul_sub, sub_mul, mul_one, mul_assoc, mul_inv_cancel₀ ha0,
            mul_inv_cancel_left₀ (pow_ne_zero s hy.ne_zero)]

end UnitConstantTerm

/-- If `x * xs` has unit constant term, so does `x ^ r * xs ^ r`, through
`x ^ (r + 1) * xs ^ (r + 1) = x * (x ^ r * xs ^ r) * x⁻¹ * (x * xs)`. -/
theorem unitConstantTerm_pow_mul_pow (hy : Normalizes C y) (hx : Normalizes C x)
    {e : D} (he : e ∈ C) (hxy : x * y * x⁻¹ = y * e) {xs : D}
    (h : UnitConstantTerm C y (x * xs)) (r : ℕ) :
    UnitConstantTerm C y (x ^ r * xs ^ r) := by
  induction r with
  | zero => simpa using unitConstantTerm_one C y
  | succ r ih =>
    have heq : x ^ (r + 1) * xs ^ (r + 1) = x * (x ^ r * xs ^ r) * x⁻¹ * (x * xs) := by
      rw [pow_succ' x, pow_succ xs]
      simp only [mul_assoc, inv_mul_cancel_left₀ hx.ne_zero]
    rw [heq]
    exact (ih.conj hx he hxy).mul hy h

/-- Adjoining `y⁻¹` to a ring `H ∋ y` normalized by `y` only adds elements with a
right denominator `y ^ s`. -/
theorem exists_mul_pow_mem_of_mem_closure {H : Subring D} (hy : Normalizes H y)
    (hyH : y ∈ H) {f : D} (hf : f ∈ Subring.closure ((H : Set D) ∪ {y⁻¹})) :
    ∃ s : ℕ, f * y ^ s ∈ H := by
  induction hf using Subring.closure_induction with
  | mem f hf =>
    rcases hf with hf | hf
    · exact ⟨0, by simpa using hf⟩
    · rw [Set.mem_singleton_iff.mp hf]
      exact ⟨1, by simp [hy.ne_zero, H.one_mem]⟩
  | zero => exact ⟨0, by simp⟩
  | one => exact ⟨0, by simp⟩
  | add f g _ _ hf hg =>
    obtain ⟨s, hs⟩ := hf
    obtain ⟨t, ht⟩ := hg
    refine ⟨s + t, ?_⟩
    have e₁ : f * y ^ (s + t) = f * y ^ s * y ^ t := by rw [pow_add, mul_assoc]
    have e₂ : g * y ^ (s + t) = g * y ^ t * y ^ s := by rw [add_comm s t, pow_add, mul_assoc]
    rw [add_mul, e₁, e₂]
    exact H.add_mem (H.mul_mem hs (H.pow_mem hyH t)) (H.mul_mem ht (H.pow_mem hyH s))
  | neg f _ hf =>
    obtain ⟨s, hs⟩ := hf
    exact ⟨s, by rw [neg_mul]; exact H.neg_mem hs⟩
  | mul f g _ _ hf hg =>
    obtain ⟨s, hs⟩ := hf
    obtain ⟨t, ht⟩ := hg
    refine ⟨t + s, ?_⟩
    have e : f * g * y ^ (t + s) = f * y ^ s * ((y ^ s)⁻¹ * (g * y ^ t) * y ^ s) := by
      rw [pow_add]
      simp only [mul_assoc, mul_inv_cancel_left₀ (pow_ne_zero s hy.ne_zero)]
    rw [e]
    exact H.mul_mem hs ((hy.pow s).inv_conj_mem ht)

/-- The Bézout identity `x ^ r * U + y ^ s * V = 1` in `H`, with `U = xs ^ r * W`. -/
theorem exists_bezout_of_unitConstantTerm {H : Subring D} {xs e : D}
    (hy : Normalizes C y) (hx : Normalizes C x) (he : e ∈ C) (hxy : x * y * x⁻¹ = y * e)
    (hxs : UnitConstantTerm C y (x * xs)) (hCH : skewPolyRing C y ≤ H) (hxsH : xs ∈ H)
    (r s : ℕ) : ∃ U ∈ H, ∃ V ∈ H, x ^ r * U + y ^ s * V = 1 := by
  obtain ⟨W, hW, V, hV, hWV⟩ :=
    (unitConstantTerm_pow_mul_pow hy hx he hxy hxs r).exists_mul_eq hy s
  refine ⟨xs ^ r * W, H.mul_mem (H.pow_mem hxsH r) (hCH hW), V, hCH hV, ?_⟩
  rw [← mul_assoc, hWV, sub_add_cancel]

/-- The interacting two-chart intersection: right `y`-denominators on `Hi`, right
`x`-denominators on `Hj` and a unit constant term of `x * xs` in `C[y]` give
`Hi ⊓ Hj = H`. -/
theorem inf_eq_of_unitConstantTerm {H Hi Hj : Subring D} {xs e : D}
    (hy : Normalizes C y) (hx : Normalizes C x) (he : e ∈ C) (hxy : x * y * x⁻¹ = y * e)
    (hxs : UnitConstantTerm C y (x * xs)) (hCH : skewPolyRing C y ≤ H) (hxsH : xs ∈ H)
    (hHi : H ≤ Hi) (hHj : H ≤ Hj)
    (hi : ∀ f ∈ Hi, ∃ s : ℕ, f * y ^ s ∈ H) (hj : ∀ f ∈ Hj, ∃ r : ℕ, f * x ^ r ∈ H) :
    Hi ⊓ Hj = H :=
  inf_eq_of_patching hHi hHj hi hj
    (exists_bezout_of_unitConstantTerm hy hx he hxy hxs hCH hxsH)

end DivisionRing

end TauCeti.Laurent
