-/

noncomputable section

open scoped TensorProduct

namespace TauCetiRoadmap.QuantumEnvelopingAlgebras

universe u v w

/-! ## Layer 0: the datum, quantum integers and Gaussian binomials -/

/-- A symmetrizable Cartan realization (Layer 0) with a perfect integer pairing, independent
simple roots and coroots indexed by an arbitrary type, and a positive symmetrizer. -/
structure CartanDatum (ι : Type u) (X : Type v) (Y : Type w)
    [AddCommGroup X] [AddCommGroup Y] where
  /-- The perfect integer pairing of the two lattices. -/
  pairing : X →ₗ[ℤ] Y →ₗ[ℤ] ℤ
  [isPerfPair_pairing : pairing.IsPerfPair]
  /-- The simple roots `αᵢ ∈ X`. -/
  root : ι → X
  /-- The simple coroots `hᵢ ∈ Y`. -/
  coroot : ι → Y
  root_independent : LinearIndependent ℤ root
  coroot_independent : LinearIndependent ℤ coroot
  /-- The generalized Cartan matrix. -/
  cartan : ι → ι → ℤ
  cartan_eq : ∀ i j, cartan i j = pairing (root j) (coroot i)
  diagonal : ∀ i, cartan i i = 2
  offDiagonal : ∀ i j, i ≠ j → cartan i j ≤ 0
  zeroSymmetry : ∀ i j, cartan i j = 0 ↔ cartan j i = 0
  /-- The symmetrizer `dᵢ`. -/
  symmetrizer : ι → ℕ
  symmetrizer_pos : ∀ i, 0 < symmetrizer i
  symmetrizes : ∀ i j,
    (symmetrizer i : ℤ) * cartan i j = (symmetrizer j : ℤ) * cartan j i

namespace CartanDatum

variable {ι : Type u} {X : Type v} {Y : Type w}
  [AddCommGroup X] [AddCommGroup Y]
  (D : CartanDatum ι X Y)

/-- The pairing value `⟨αᵢ, y⟩`. -/
def pairingValue (i : ι) (y : Y) : ℤ := D.pairing (D.root i) y

/-- The toral direction `dᵢ hᵢ`, so that `Kᵢ = K_(dᵢ hᵢ)`. -/
def simpleTorus (i : ι) : Y := D.symmetrizer i • D.coroot i

/-- The simple reflection `sᵢ y = y − ⟨αᵢ, y⟩ hᵢ` of the cocharacter lattice `Y`. -/
def reflect (i : ι) (y : Y) : Y := y - D.pairingValue i y • D.coroot i

/-- The order `mᵢⱼ` of `sᵢ sⱼ` for `i ≠ j` when `aᵢⱼ aⱼᵢ ≤ 3`: `2, 3, 4, 6` for
`aᵢⱼ aⱼᵢ = 0, 1, 2, 3`. -/
def braidLength (i j : ι) : ℕ :=
  if D.cartan i j * D.cartan j i = 0 then 2
  else if D.cartan i j * D.cartan j i = 1 then 3
  else if D.cartan i j * D.cartan j i = 2 then 4
  else 6

end CartanDatum

/-- The symmetric quantum integer `[r]_q = (q^r − q^(−r))/(q − q⁻¹)` in a field. At `q = ±1` the
denominator vanishes and the value is `0`; the theorems below assume that `q` is not a root of
unity, where it is the honest quotient. -/
def qInt {K : Type*} [Field K] (q : K) (r : ℕ) : K :=
  TauCeti.quantumInteger q r

/-- The quantum factorial `[r]_q! = [1]_q ⋯ [r]_q`. -/
def qFactorial {K : Type*} [Field K] (q : K) (r : ℕ) : K :=
  ∏ j ∈ Finset.range r, qInt q (j + 1)

open LaurentPolynomial in
/-- The symmetric Gaussian binomial `[n choose r]_v ∈ ℤ[v, v⁻¹]`, by the denominator-free Pascal
recurrence `[n+1 choose r+1] = v^(−(r+1)) [n choose r+1] + v^(n−r) [n choose r]`; it is `0` for
`r > n`. -/
def gaussian : ℕ → ℕ → LaurentPolynomial ℤ
  | _, 0 => 1
  | 0, _ + 1 => 0
  | n + 1, r + 1 => T (-(r + 1 : ℤ)) * gaussian n (r + 1) + T ((n : ℤ) - r) * gaussian n r

/-- The Gaussian binomial with signed upper argument: the Laurent polynomial extending
`∏_(j=1)^r [m−j+1]_v / [j]_v` to `m ∈ ℤ`, so that `[−a choose r]_v = (−1)^r [a+r−1 choose r]_v`
for `a > 0`. -/
def signedGaussian : ℤ → ℕ → LaurentPolynomial ℤ
  | (n : ℕ), r => gaussian n r
  | Int.negSucc a, r => (-1) ^ r * gaussian (a + r) r

/-- Specialization `ℤ[v, v⁻¹] → K`, `v ↦ ζ`, at a unit `ζ`. -/
def specialize {K : Type*} [CommRing K] (ζ : Kˣ) : LaurentPolynomial ℤ →+* K :=
  LaurentPolynomial.eval₂ (Int.castRingHom K) ζ

/-- **Quantum Lucas theorem**, for every root of unity and every signed upper argument
(McGerty2006 Lemma 2.7, after Lusztig1993 Chapter 34). Let `ζ²` be a primitive `l`-th root of
unity, `m = m₁ l + m₀` and `r = r₁ l + r₀` the Euclidean decompositions with `0 ≤ m₀, r₀ < l`. Then
`[m choose r]_ζ = ζ^(l(r₁m₀ − m₁r₀) + (m₁+1) r₁ l²) [m₀ choose r₀]_ζ · binom(m₁, r₁)`, with the
integer-valued binomial `Ring.choose`; for odd order of `ζ` the power of `ζ` is `1`. -/
theorem quantumLucas {K : Type*} [Field K] (ζ : Kˣ) (l : ℕ) (hl : 0 < l)
    (hζ : IsPrimitiveRoot ((ζ : K) ^ 2) l) (m : ℤ) (r : ℕ) :
    specialize ζ (signedGaussian m r) =
      ((ζ ^ ((l : ℤ) * (((r / l : ℕ) : ℤ) * (m % l) - (m / l) * ((r % l : ℕ) : ℤ)) +
          (m / l + 1) * ((r / l : ℕ) : ℤ) * (l : ℤ) ^ 2) : Kˣ) : K) *
        specialize ζ (gaussian (m % l).toNat (r % l)) *
        ((Ring.choose (m / l) (r / l) : ℤ) : K) := by
  sorry

/-! ## Layer 1.0: the algebra f and its bilinear form -/

section HalfAlgebra

variable {K ι : Type*} [Field K]

local instance halfDecidableEq : DecidableEq ι := Classical.decEq ι

/-- The free associative algebra, with words as a basis. -/
abbrev HalfWordAlgebra (K ι : Type*) [Field K] := MonoidAlgebra K (FreeMonoid ι)

/-- A basis word. -/
def halfWord (w : List ι) : HalfWordAlgebra K ι :=
  MonoidAlgebra.single (FreeMonoid.ofList w) 1

/-- Diagonal scaling, transported through Mathlib's free-algebra equivalence. -/
def freeHalfScale (c : ι → K) : HalfWordAlgebra K ι →ₐ[K] HalfWordAlgebra K ι :=
  (FreeAlgebra.lift K fun i => c i • halfWord [i]).comp
    (FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := K) (X := ι)).symm.toAlgHom

/-- The left skew derivative on words, before any relation is imposed. -/
def removeWord (χ : ι → ι → K) (i : ι) : List ι → HalfWordAlgebra K ι
  | [] => 0
  | j :: w => (if j = i then halfWord w else 0) +
      χ j i • (halfWord [j] * removeWord χ i w)

/-- Linear extension of the word derivative. -/
def freeRemove (χ : ι → ι → K) (i : ι) :
    HalfWordAlgebra K ι →ₗ[K] HalfWordAlgebra K ι :=
  (Finsupp.linearCombination K fun w : FreeMonoid ι => removeWord χ i w.toList).comp
    (MonoidAlgebra.coeffLinearEquiv K).toLinearMap

/-- The row of the normalized pairing indexed by a word. -/
def pairingRow (χ : ι → ι → K) : List ι → Module.Dual K (HalfWordAlgebra K ι)
  | [] => (Finsupp.lapply (1 : FreeMonoid ι)).comp
      (MonoidAlgebra.coeffLinearEquiv K).toLinearMap
  | i :: w => (pairingRow χ w).comp (freeRemove χ i)

/-- The normalized bilinear form on the free algebra, defined recursively on words. -/
def freePairing (χ : ι → ι → K) : LinearMap.BilinForm K (HalfWordAlgebra K ι) :=
  (Finsupp.linearCombination K fun w : FreeMonoid ι => pairingRow χ w.toList).comp
    (MonoidAlgebra.coeffLinearEquiv K).toLinearMap

/-- The braided coproduct on a word, with primitive generators. -/
def halfDeltaWord (χ : ι → ι → K) :
    List ι → HalfWordAlgebra K ι ⊗[K] HalfWordAlgebra K ι
  | [] => 1 ⊗ₜ[K] 1
  | i :: w =>
      (TensorProduct.map (LinearMap.mul K (HalfWordAlgebra K ι) (halfWord [i]))
          (LinearMap.id : HalfWordAlgebra K ι →ₗ[K] HalfWordAlgebra K ι) +
        TensorProduct.map (freeHalfScale (χ i)).toLinearMap
          (LinearMap.mul K (HalfWordAlgebra K ι) (halfWord [i]))) (halfDeltaWord χ w)

/-- Linear extension of the braided coproduct. -/
def freeHalfDelta (χ : ι → ι → K) :
    HalfWordAlgebra K ι →ₗ[K] HalfWordAlgebra K ι ⊗[K] HalfWordAlgebra K ι :=
  (Finsupp.linearCombination K fun w : FreeMonoid ι => halfDeltaWord χ w.toList).comp
    (MonoidAlgebra.coeffLinearEquiv K).toLinearMap

/-- The left radical of `freePairing`. -/
def halfRadical (χ : ι → ι → K) : Submodule K (HalfWordAlgebra K ι) :=
  LinearMap.ker (freePairing χ)

/-- The algebra `f`, presented by the relations `x = y` whenever `x - y` lies in the radical. -/
abbrev Half (χ : ι → ι → K) :=
  RingQuot (fun x y : HalfWordAlgebra K ι => x - y ∈ halfRadical χ)

/-- The quotient homomorphism from the free algebra to `f`. -/
def halfMk (χ : ι → ι → K) : HalfWordAlgebra K ι →ₐ[K] Half χ :=
  RingQuot.mkAlgHom K _

/-- The image of a simple generator in `f`. -/
def halfGenerator (χ : ι → ι → K) (i : ι) : Half χ :=
  halfMk χ (halfWord [i])

/-- Symmetry, the prescribed generator norms, and multiplication/comultiplication adjunction. -/
theorem freePairing_characterisation (χ : ι → ι → K) (hχ : ∀ i j, χ i j = χ j i) :
    (∀ x y, freePairing χ x y = freePairing χ y x) ∧
    (∀ i j, freePairing χ (halfWord [i]) (halfWord [j]) = if i = j then 1 else 0) ∧
    (∀ x y z, freePairing χ (x * y) z =
      (freePairing χ).tmul (freePairing χ) (x ⊗ₜ[K] y) (freeHalfDelta χ z)) := by
  sorry

/-- The unit and generator norms, grading and multiplication adjunction characterize the form. -/
theorem freePairing_unique (χ : ι → ι → K) (hχ : ∀ i j, χ i j = χ j i)
    (B : LinearMap.BilinForm K (HalfWordAlgebra K ι))
    (hunit : B 1 1 = 1)
    (hgen : ∀ i j, B (halfWord [i]) (halfWord [j]) = if i = j then 1 else 0)
    (hgraded : ∀ u v : List ι, ¬u.Perm v → B (halfWord u) (halfWord v) = 0)
    (hmul : ∀ x y z, B (x * y) z = B.tmul B (x ⊗ₜ[K] y) (freeHalfDelta χ z)) :
    B = freePairing χ := by
  sorry

/-- The radical is a two-sided ideal and the algebra quotient has exactly that kernel. -/
theorem halfRadical_ideal_and_kernel (χ : ι → ι → K) (hχ : ∀ i j, χ i j = χ j i) :
    (∀ x ∈ halfRadical χ, ∀ y,
      x * y ∈ halfRadical χ ∧ y * x ∈ halfRadical χ) ∧
    LinearMap.ker (halfMk χ).toLinearMap = halfRadical χ := by
  sorry

/-- The radical is a coideal for the braided coproduct. -/
theorem halfRadical_coideal (χ : ι → ι → K) (hχ : ∀ i j, χ i j = χ j i)
    (x : HalfWordAlgebra K ι) (hx : x ∈ halfRadical χ) :
    TensorProduct.map (halfMk χ).toLinearMap (halfMk χ).toLinearMap
      (freeHalfDelta χ x) = 0 := by
  sorry

/-- The coproduct, counit and antipode on `f`, with coassociativity and both convolution laws.
The braided multiplication compatibility is specified in 1.0. -/
theorem half_coalgebra_antipode (χ : ι → ι → K) (hχ : ∀ i j, χ i j = χ j i) :
    ∃ (r : Half χ →ₗ[K] Half χ ⊗[K] Half χ)
      (ε : Half χ →ₐ[K] K) (S : Half χ →ₗ[K] Half χ),
      (∀ x, r (halfMk χ x) =
        TensorProduct.map (halfMk χ).toLinearMap (halfMk χ).toLinearMap (freeHalfDelta χ x)) ∧
      (∀ x, ε (halfMk χ x) = x.coeff 1) ∧
      (TensorProduct.assoc K (Half χ) (Half χ) (Half χ)).toLinearMap ∘ₗ
        TensorProduct.map r LinearMap.id ∘ₗ r =
          TensorProduct.map LinearMap.id r ∘ₗ r ∧
      (TensorProduct.lid K (Half χ)).toLinearMap ∘ₗ
        TensorProduct.map ε.toLinearMap LinearMap.id ∘ₗ r = LinearMap.id ∧
      (TensorProduct.rid K (Half χ)).toLinearMap ∘ₗ
        TensorProduct.map LinearMap.id ε.toLinearMap ∘ₗ r = LinearMap.id ∧
      LinearMap.mul' K (Half χ) ∘ₗ TensorProduct.map S LinearMap.id ∘ₗ r =
        Algebra.linearMap K (Half χ) ∘ₗ ε.toLinearMap ∧
      LinearMap.mul' K (Half χ) ∘ₗ TensorProduct.map LinearMap.id S ∘ₗ r =
        Algebra.linearMap K (Half χ) ∘ₗ ε.toLinearMap := by
  sorry

end HalfAlgebra

section CartanHalf

variable {K ι X Y : Type*} [Field K] [AddCommGroup X] [AddCommGroup Y]
  (D : CartanDatum ι X Y) (q : K)

/-- The diagonal character associated to the symmetrized Cartan pairing. -/
def cartanBraiding (i j : ι) : K :=
  q ^ ((D.symmetrizer i : ℤ) * D.cartan i j)

/-- The divided power of an element of any algebra. -/
def dividedPower {B : Type*} [Ring B] [Algebra K B] (t : K) (x : B) (n : ℕ) : B :=
  (qFactorial t n)⁻¹ • x ^ n

/-- The Serre polynomial in the free algebra. -/
def halfSerre (i j : ι) : HalfWordAlgebra K ι :=
  ∑ r ∈ Finset.range ((1 - D.cartan i j).toNat + 1), (-1 : K) ^ r •
    (dividedPower (q ^ D.symmetrizer i) (halfWord [i]) r * halfWord [j] *
      dividedPower (q ^ D.symmetrizer i) (halfWord [i]) ((1 - D.cartan i j).toNat - r))

/-- The Serre relations in the free algebra. -/
inductive HalfSerreRelation : HalfWordAlgebra K ι → HalfWordAlgebra K ι → Prop
  | serre (i j : ι) (hij : i ≠ j) : HalfSerreRelation (halfSerre D q i j) 0

/-- The algebra defined by the positive Serre presentation. -/
abbrev SerreHalf := RingQuot (HalfSerreRelation D q)

/- The hypotheses `hq` and `hfac` retain the original parameter range: if `ι` is empty,
`hfac` is vacuous, so every nonzero `q` is allowed. -/

/-- Every Serre element lies in the radical, for any symmetrizable Cartan datum over a field
with the required quantum factorials nonzero. -/
theorem halfSerre_mem_radical (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0)
    (i j : ι) (hij : i ≠ j) :
    halfSerre D q i j ∈ halfRadical (cartanBraiding D q) := by
  sorry

/-- The radical is the ideal generated by the Serre elements: the presentation theorem for `f`. -/
theorem halfRadical_eq_serreKernel (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    halfRadical (cartanBraiding D q) =
      LinearMap.ker (RingQuot.mkAlgHom K (HalfSerreRelation D q)).toLinearMap := by
  sorry

/-- Inverse parameters define the same radical inside the same word algebra. -/
theorem halfRadical_inverse_parameter (hq : q ≠ 0) :
    halfRadical (cartanBraiding D q⁻¹) = halfRadical (cartanBraiding D q) := by
  sorry

/-- Scaling the generators by `q^⟨αᵢ,y⟩` preserves the radical, for every `y ∈ Y`. -/
theorem fullTorus_preserves_radical (hq : q ≠ 0)
    (y : Y) (x : HalfWordAlgebra K ι) (hx : x ∈ halfRadical (cartanBraiding D q)) :
    freeHalfScale (fun i => q ^ D.pairingValue i y) x ∈
      halfRadical (cartanBraiding D q) := by
  sorry

end CartanHalf

/-! ## Layer 1: the Drinfeld–Jimbo algebra and its Hopf structure -/

/-- Generators of the free algebra: `Eᵢ`, `Fᵢ` and a toral symbol `K_y` for every `y ∈ Y`, so
that central and isogeny directions of `Y` are retained. -/
inductive Generator (ι : Type u) (Y : Type v)
  | E (i : ι)
  | F (i : ι)
  | K (y : Y)

section Presentation

variable {ι : Type u} {X : Type v} {Y : Type w} {K : Type*}
  [AddCommGroup X] [AddCommGroup Y] [Field K]
  (D : CartanDatum ι X Y) (q : K)

local instance presentationDecidableEq : DecidableEq ι := Classical.decEq ι

local notation "Free" => FreeAlgebra K (Generator ι Y)

/-- The generator `Eᵢ` of the free algebra. -/
def genE (i : ι) : Free := FreeAlgebra.ι K (.E i)
/-- The generator `Fᵢ` of the free algebra. -/
def genF (i : ι) : Free := FreeAlgebra.ι K (.F i)
/-- The toral generator `K_y` of the free algebra. -/
def genK (y : Y) : Free := FreeAlgebra.ι K (.K y)

/-- The toral generator `Kᵢ = K_(dᵢ hᵢ)` of the free algebra. -/
def simpleK (i : ι) : Free := genK (D.simpleTorus i)

/-- The Serre length `1 − aᵢⱼ`. -/
def serreLength (i j : ι) : ℕ := (1 - D.cartan i j).toNat

/-- The positive quantum Serre element `Σ_(r+s=1−aᵢⱼ) (−1)^r Eᵢ^(r) Eⱼ Eᵢ^(s)`, with divided
powers at `qᵢ = q^dᵢ`. -/
def serreE (i j : ι) : Free :=
  ∑ r ∈ Finset.range (serreLength D i j + 1),
    ((-1 : K) ^ r) •
      (dividedPower (q ^ D.symmetrizer i) (genE i) r *
        genE j *
        dividedPower (q ^ D.symmetrizer i) (genE i)
          (serreLength D i j - r))

/-- The negative quantum Serre element `Σ_(r+s=1−aᵢⱼ) (−1)^r Fᵢ^(r) Fⱼ Fᵢ^(s)`. -/
def serreF (i j : ι) : Free :=
  ∑ r ∈ Finset.range (serreLength D i j + 1),
    ((-1 : K) ^ r) •
      (dividedPower (q ^ D.symmetrizer i) (genF i) r *
        genF j *
        dividedPower (q ^ D.symmetrizer i) (genF i)
          (serreLength D i j - r))

/-- The homomorphism from the free algebra on `θᵢ` sending `θᵢ` to `Eᵢ`. -/
def positiveFree : HalfWordAlgebra K ι →ₐ[K] Free :=
  (FreeAlgebra.lift K fun i => genE (K := K) (Y := Y) i).comp
    (FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := K) (X := ι)).symm.toAlgHom

/-- The homomorphism from the free algebra on `θᵢ` sending `θᵢ` to `Fᵢ`. -/
def negativeFree : HalfWordAlgebra K ι →ₐ[K] Free :=
  (FreeAlgebra.lift K fun i => genF (K := K) (Y := Y) i).comp
    (FreeAlgebra.equivMonoidAlgebraFreeMonoid (R := K) (X := ι)).symm.toAlgHom

/-- The defining relations of Layer 1: the torus is the group algebra of `Y`, `K_y` conjugates
`Eᵢ` and `Fᵢ` by `q^(±⟨αᵢ, y⟩)`, `EᵢFⱼ − FⱼEᵢ = δᵢⱼ (Kᵢ − Kᵢ⁻¹)/(qᵢ − qᵢ⁻¹)`, and both
images of the pairing radical vanish. -/
inductive Relation : Free → Free → Prop
  | torusUnit : Relation (genK 0) 1
  | torusMul (y z : Y) :
      Relation (genK y * genK z) (genK (y + z))
  | conjugateE (y : Y) (i : ι) :
      Relation
        (genK y * genE i * genK (-y))
        ((q ^ D.pairingValue i y) • genE i)
  | conjugateF (y : Y) (i : ι) :
      Relation
        (genK y * genF i * genK (-y))
        ((q ^ (-(D.pairingValue i y))) • genF i)
  | commutator (i j : ι) :
      Relation
        (genE i * genF j - genF j * genE i)
        (if i = j then
          (q ^ D.symmetrizer i - (q ^ D.symmetrizer i)⁻¹)⁻¹ •
            (simpleK D i - genK (-(D.simpleTorus i)))
        else 0)
  | positiveRadical (x : HalfWordAlgebra K ι) (hx : x ∈ halfRadical (cartanBraiding D q)) :
      Relation (positiveFree x) 0
  | negativeRadical (x : HalfWordAlgebra K ι) (hx : x ∈ halfRadical (cartanBraiding D q)) :
      Relation (negativeFree x) 0

/-- The quantized enveloping algebra `U_q(A, X, Y)` of Layer 1, as a `RingQuot` of the free
algebra. -/
abbrev U := RingQuot (Relation D q)

/-- The image in `U` of a generator of the free algebra. -/
def generator (g : Generator ι Y) : U D q :=
  RingQuot.mkAlgHom K (Relation D q) (FreeAlgebra.ι K g)

/-- The generator `Eᵢ` of `U`. -/
def E (i : ι) : U D q := generator D q (.E i)
/-- The generator `Fᵢ` of `U`. -/
def F (i : ι) : U D q := generator D q (.F i)
/-- The toral generator `K_y` of `U`. -/
def Ktorus (y : Y) : U D q := generator D q (.K y)
/-- `Kᵢ = K_(dᵢ hᵢ)`. -/
def Ki (i : ι) : U D q := Ktorus D q (D.simpleTorus i)
/-- `Kᵢ⁻¹ = K_(−dᵢ hᵢ)`. -/
def KiInv (i : ι) : U D q := Ktorus D q (-(D.simpleTorus i))

/-- The algebra map out of `U` determined by images of the generators satisfying the
relations (the universal property of the presentation). -/
def lift {B : Type*} [Ring B] [Algebra K B]
    (f : Generator ι Y → B)
    (hrel : ∀ a b, Relation D q a b →
      (FreeAlgebra.lift K f) a = (FreeAlgebra.lift K f) b) :
    U D q →ₐ[K] B :=
  RingQuot.liftAlgHom K ⟨FreeAlgebra.lift K f, fun {_ _} h => hrel _ _ h⟩

/-- The coproduct on generators, in the convention of QuantumGroups Q8:
`Δ(Eᵢ) = Eᵢ ⊗ 1 + Kᵢ ⊗ Eᵢ`, `Δ(Fᵢ) = Fᵢ ⊗ Kᵢ⁻¹ + 1 ⊗ Fᵢ`, `Δ(K_y) = K_y ⊗ K_y`. -/
def comulGenerator : Generator ι Y → U D q ⊗[K] U D q
  | .E i => E D q i ⊗ₜ[K] (1 : U D q) + Ki D q i ⊗ₜ[K] E D q i
  | .F i => F D q i ⊗ₜ[K] KiInv D q i + (1 : U D q) ⊗ₜ[K] F D q i
  | .K y => Ktorus D q y ⊗ₜ[K] Ktorus D q y

/-- The coproduct images satisfy every defining relation under the Layer 1 parameter hypotheses. -/
theorem comul_relations (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0)
    (a b : Free) (h : Relation D q a b) :
    (FreeAlgebra.lift K (comulGenerator D q)) a =
      (FreeAlgebra.lift K (comulGenerator D q)) b := by
  sorry

/-- The coproduct `Δ : U → U ⊗ U` as an algebra map. -/
def comulAlgHom (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    U D q →ₐ[K] U D q ⊗[K] U D q :=
  lift D q (comulGenerator D q) (comul_relations D q hq hfac)

/-- The counit on generators: `ε(Eᵢ) = ε(Fᵢ) = 0`, `ε(K_y) = 1`. -/
def counitGenerator : Generator ι Y → K
  | .E _ => 0
  | .F _ => 0
  | .K _ => 1

/-- The counit values satisfy every defining relation. -/
theorem counit_relations (a b : Free) (h : Relation D q a b) :
    (FreeAlgebra.lift K (counitGenerator (K := K) (ι := ι) (Y := Y))) a =
      (FreeAlgebra.lift K (counitGenerator (K := K) (ι := ι) (Y := Y))) b := by
  sorry

/-- The counit `ε : U → K` as an algebra map. -/
def counitAlgHom : U D q →ₐ[K] K :=
  lift D q counitGenerator (counit_relations D q)

/-- Coassociativity of the Layer 1 coproduct. -/
theorem comul_coassoc (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    (Algebra.TensorProduct.assoc K K K (U D q) (U D q) (U D q)).toAlgHom.comp
        ((Algebra.TensorProduct.map (comulAlgHom D q hq hfac) (.id K (U D q))).comp
          (comulAlgHom D q hq hfac)) =
      (Algebra.TensorProduct.map (.id K (U D q)) (comulAlgHom D q hq hfac)).comp
        (comulAlgHom D q hq hfac) := by
  sorry

/-- The left counit law `(ε ⊗ id) ∘ Δ = id` (Layer 1). -/
theorem counit_comul_left (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    (Algebra.TensorProduct.map (counitAlgHom D q) (.id K (U D q))).comp
        (comulAlgHom D q hq hfac) =
      ((Algebra.TensorProduct.lid K (U D q)).symm : U D q →ₐ[K] K ⊗[K] U D q) := by
  sorry

/-- The right counit law `(id ⊗ ε) ∘ Δ = id` (Layer 1). -/
theorem counit_comul_right (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    (Algebra.TensorProduct.map (.id K (U D q)) (counitAlgHom D q)).comp
        (comulAlgHom D q hq hfac) =
      ((Algebra.TensorProduct.rid K K (U D q)).symm : U D q →ₐ[K] U D q ⊗[K] K) := by
  sorry

/-- The native Mathlib bialgebra structure on `U` with the Layer 1 coproduct and counit. -/
abbrev bialgebra (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    Bialgebra K (U D q) :=
  Bialgebra.ofAlgHom (comulAlgHom D q hq hfac) (counitAlgHom D q)
    (comul_coassoc D q hq hfac) (counit_comul_left D q hq hfac)
    (counit_comul_right D q hq hfac)

/-- The bialgebra `U` has an antipode, i.e. it is a Hopf algebra (Layer 1): a linear map `S` that
is a convolution inverse of the identity on both sides, is bijective, and takes the values
`S(Eᵢ) = −Kᵢ⁻¹Eᵢ`, `S(Fᵢ) = −FᵢKᵢ`, `S(K_y) = K_(−y)`. -/
theorem exists_antipode (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    ∃ S : U D q →ₗ[K] U D q,
      LinearMap.mul' K (U D q) ∘ₗ S.rTensor (U D q) ∘ₗ (comulAlgHom D q hq hfac).toLinearMap =
          Algebra.linearMap K (U D q) ∘ₗ (counitAlgHom D q).toLinearMap ∧
        LinearMap.mul' K (U D q) ∘ₗ S.lTensor (U D q) ∘ₗ (comulAlgHom D q hq hfac).toLinearMap =
          Algebra.linearMap K (U D q) ∘ₗ (counitAlgHom D q).toLinearMap ∧
        Function.Bijective S ∧
        (∀ i, S (E D q i) = -(KiInv D q i * E D q i)) ∧
        (∀ i, S (F D q i) = -(F D q i * Ki D q i)) ∧
        ∀ y, S (Ktorus D q y) = Ktorus D q (-y) := by
  sorry

/-- Triangular decomposition (Layer 1): multiplication `U⁻ ⊗ U⁰ ⊗ U⁺ → U` is a linear
isomorphism, where `U⁻`, `U⁰`, `U⁺` are the subalgebras generated by the `Fᵢ`, by the `K_y`, and
by the `Eᵢ`. -/
theorem triangular_bijective (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    Function.Bijective
      (LinearMap.mul' K (U D q) ∘ₗ
        TensorProduct.map (Algebra.adjoin K (Set.range (F D q))).val.toLinearMap
          (LinearMap.mul' K (U D q) ∘ₗ
            TensorProduct.map (Algebra.adjoin K (Set.range (Ktorus D q))).val.toLinearMap
              (Algebra.adjoin K (Set.range (E D q))).val.toLinearMap)) := by
  sorry

/-- The full-`Y` torus is the group algebra of `Y` (Layer 1): the `K_y`, `y ∈ Y`, are linearly
independent in `U`; no central direction of `Y` is collapsed. -/
theorem Ktorus_linearIndependent (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    LinearIndependent K (Ktorus D q) := by
  sorry

/-- Triangular decomposition `f ⊗ K[Y] ⊗ f → U`, with the two copies of `f` mapped to the
negative and positive parts. -/
theorem exists_triangularDecomposition (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    ∃ (negative : Half (cartanBraiding D q) →ₐ[K] U D q)
      (toral : MonoidAlgebra K (Multiplicative Y) →ₐ[K] U D q)
      (positive : Half (cartanBraiding D q) →ₐ[K] U D q),
      (∀ i, negative (halfGenerator (cartanBraiding D q) i) = F D q i) ∧
      (∀ y, toral (MonoidAlgebra.single (Multiplicative.ofAdd y) 1) = Ktorus D q y) ∧
      (∀ i, positive (halfGenerator (cartanBraiding D q) i) = E D q i) ∧
      Function.Bijective
        (LinearMap.mul' K (U D q) ∘ₗ TensorProduct.map negative.toLinearMap
          (LinearMap.mul' K (U D q) ∘ₗ
            TensorProduct.map toral.toLinearMap positive.toLinearMap)) := by
  sorry

/-- The Drinfeld–Jimbo defining relations of 1.3a: the torus is the group algebra of `Y`, `K_y` conjugates
`Eᵢ` and `Fᵢ` by `q^(±⟨αᵢ, y⟩)`, `EᵢFⱼ − FⱼEᵢ = δᵢⱼ (Kᵢ − Kᵢ⁻¹)/(qᵢ − qᵢ⁻¹)`, and the quantum
Serre relations. -/
inductive DJRelation : Free → Free → Prop
  | torusUnit : DJRelation (genK 0) 1
  | torusMul (y z : Y) :
      DJRelation (genK y * genK z) (genK (y + z))
  | conjugateE (y : Y) (i : ι) :
      DJRelation
        (genK y * genE i * genK (-y))
        ((q ^ D.pairingValue i y) • genE i)
  | conjugateF (y : Y) (i : ι) :
      DJRelation
        (genK y * genF i * genK (-y))
        ((q ^ (-(D.pairingValue i y))) • genF i)
  | commutator (i j : ι) :
      DJRelation
        (genE i * genF j - genF j * genE i)
        (if i = j then
          (q ^ D.symmetrizer i - (q ^ D.symmetrizer i)⁻¹)⁻¹ •
            (simpleK D i - genK (-(D.simpleTorus i)))
        else 0)
  | serrePositive (i j : ι) (hij : i ≠ j) :
      DJRelation (serreE D q i j) 0
  | serreNegative (i j : ι) (hij : i ≠ j) :
      DJRelation (serreF D q i j) 0

/-- The algebra defined by the Drinfeld–Jimbo presentation. -/
abbrev DJPresentation := RingQuot (DJRelation D q)

/-- The Drinfeld–Jimbo presentation defines an algebra isomorphic to `U`, with the same generators. -/
theorem drinfeldJimbo_equiv (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) :
    ∃ e : DJPresentation D q ≃ₐ[K] U D q,
      ∀ g, e (RingQuot.mkAlgHom K (DJRelation D q) (FreeAlgebra.ι K g)) =
        generator D q g := by
  sorry

/-! ## Layer 2: braid operators -/

/-- The images of the generators under the braid operator `Tᵢ`, as elements of the free algebra,
with `qᵢ = q^dᵢ` and `n = −aᵢⱼ`: `Tᵢ(Eᵢ) = −FᵢKᵢ`, `Tᵢ(Fᵢ) = −Kᵢ⁻¹Eᵢ`, `Tᵢ(K_y) = K_(sᵢ y)`, and
for `j ≠ i`
`Tᵢ(Eⱼ) = Σ_(r=0)^n (−1)^r qᵢ^(−r) Eᵢ^(n−r) Eⱼ Eᵢ^(r)`,
`Tᵢ(Fⱼ) = Σ_(r=0)^n (−1)^r qᵢ^r Fᵢ^(r) Fⱼ Fᵢ^(n−r)` (the standard normalization, Lusztig1993
§37.1.3, fixed by `Tᵢ(Eᵢ) = −FᵢKᵢ` and the coefficient `qᵢ^(−r)` on the term with `Eᵢ^(r)` on
the right). -/
def braidImageFree (i : ι) : Generator ι Y → Free
  | .E j =>
      if j = i then -(genF i * simpleK D i) else
        ∑ r ∈ Finset.range ((-D.cartan i j).toNat + 1),
          ((-1 : K) ^ r * ((q ^ D.symmetrizer i) ^ r)⁻¹) •
            (dividedPower (q ^ D.symmetrizer i) (genE i) ((-D.cartan i j).toNat - r) *
              genE j * dividedPower (q ^ D.symmetrizer i) (genE i) r)
  | .F j =>
      if j = i then -(genK (-(D.simpleTorus i)) * genE i) else
        ∑ r ∈ Finset.range ((-D.cartan i j).toNat + 1),
          ((-1 : K) ^ r * (q ^ D.symmetrizer i) ^ r) •
            (dividedPower (q ^ D.symmetrizer i) (genF i) r * genF j *
              dividedPower (q ^ D.symmetrizer i) (genF i) ((-D.cartan i j).toNat - r))
  | .K y => genK (D.reflect i y)

/-- The braid-operator images of the generators in `U`. -/
def braidImage (i : ι) (g : Generator ι Y) : U D q :=
  RingQuot.mkAlgHom K (Relation D q) (braidImageFree D q i g)

/-- **Braid automorphisms** (Layer 2; Lusztig1993 Chapter 37; in finite type Lentner2014
Definition 3.4): for every `i` there is a `K`-algebra automorphism `Tᵢ` of `U` with the generator
values of `braidImage`. Generators determine it, so it is unique. -/
theorem exists_braidOperator (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) (i : ι) :
    ∃ T : U D q ≃ₐ[K] U D q, ∀ g, T (generator D q g) = braidImage D q i g := by
  sorry

/-- The alternating composite `Tᵢ ∘ Tⱼ ∘ Tᵢ ∘ ⋯` with `n` factors. -/
def braidWord (T : ι → U D q ≃ₐ[K] U D q) : ι → ι → ℕ → (U D q ≃ₐ[K] U D q)
  | _, _, 0 => AlgEquiv.refl
  | i, j, n + 1 => (braidWord T j i n).trans (T i)

/-- **Braid relations** (Layer 2; Lusztig1993 Chapter 39): for `i ≠ j` with `aᵢⱼ aⱼᵢ ≤ 3`, the braid
operators satisfy `Tᵢ Tⱼ Tᵢ ⋯ = Tⱼ Tᵢ Tⱼ ⋯` with `mᵢⱼ` factors on each side. -/
theorem braid_relation (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0)
    (T : ι → U D q ≃ₐ[K] U D q)
    (hT : ∀ i g, T i (generator D q g) = braidImage D q i g)
    (i j : ι) (hij : i ≠ j) (hm : D.cartan i j * D.cartan j i ≤ 3) :
    braidWord D q T i j (D.braidLength i j) = braidWord D q T j i (D.braidLength i j) := by
  sorry

end Presentation

section NativeRankOne

variable {ι X Y : Type*} [AddCommGroup X] [AddCommGroup Y]
  (D : CartanDatum ι X Y) (q : ℂ)

/-- Each simple root gives an injective map from `TauCeti.UqSl2` to `U`, with the displayed
generator values. -/
theorem exists_rankOneEmbedding (hq : q ≠ 0)
    (hfac : ∀ i n, qFactorial (q ^ D.symmetrizer i) n ≠ 0) (i : ι) :
    ∃ f : TauCeti.UqSl2 (q ^ D.symmetrizer i) →ₐ[ℂ] U D q,
      f (TauCeti.UqSl2.e _) = E D q i ∧
      f (TauCeti.UqSl2.f _) = F D q i ∧
      f (TauCeti.UqSl2.k _) = Ki D q i ∧
      f (TauCeti.UqSl2.kInv _) = KiInv D q i ∧ Function.Injective f := by
  sorry

end NativeRankOne

/-! ## Layer 8: quantum-plane integral lattices, as native matrices -/

section QuantumPlaneLattice

/-!
**This section is not the roadmap and is not exhaustive.** The README is the
specification. These native matrices illustrate QEA8.1–8.2; they do not assume
that the future integral quantum algebra or its modules have been constructed.
The full divided-power, toral, Hopf-dual and exact-sequence comparisons remain
README targets. The admitted theorems here are targets, not proved results.

The Gaussian binomial `gaussian` and the specialization map `specialize` are those of Layer 0
above.
-/

open LaurentPolynomial

abbrev A := LaurentPolynomial ℤ

/-- Column j is the image of the jth divided-power Weyl vector. -/
def comparison (n : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  Matrix.diagonal fun j => gaussian n j.val

def monomialE (n r : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  fun i j => if j.val = i.val + r then gaussian j.val r else 0

def monomialF (n r : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  fun i j => if i.val = j.val + r then gaussian (n - j.val) r else 0

def weylE (n r : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  fun i j => if j.val = i.val + r then gaussian (n - j.val + r) r else 0

def weylF (n r : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  fun i j => if i.val = j.val + r then gaussian (j.val + r) r else 0

def torus (n : ℕ) (sign : ℤ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  Matrix.diagonal fun j => T (sign * ((n : ℤ) - 2 * (j.val : ℤ)))

/-- All divided-power intertwiners, including r = 0 and r > n. -/
theorem comparison_intertwines (n r : ℕ) :
    comparison n * weylE n r = monomialE n r * comparison n ∧
    comparison n * weylF n r = monomialF n r * comparison n ∧
    comparison n * torus n 1 = torus n 1 * comparison n := by
  sorry

/-- Injectivity is an integral assertion; it is not asserted after arbitrary base change. -/
theorem comparison_injective (n : ℕ) :
    Function.Injective (comparison n).mulVecLin := by
  sorry

/-- Coordinates in the dual Weyl basis, with QEA1's actual antipode. -/
def hopfDualComparison (n : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  fun i j => if i.val + j.val = n then
    (-1 : A) ^ j.val * T ((j.val : ℤ) * ((j.val : ℤ) + 1 - (n : ℤ))) else 0

/-- E and F on the left Hopf dual are transposes of the actual antipode matrices. -/
def dualE (n : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  (-(torus n (-1) * weylE n 1)).transpose

def dualF (n : ℕ) : Matrix (Fin (n + 1)) (Fin (n + 1)) A :=
  (-(weylF n 1 * torus n 1)).transpose

theorem hopfDualComparison_bijective (n : ℕ) :
    Function.Bijective (hopfDualComparison n).mulVecLin := by
  sorry

theorem hopfDualComparison_intertwines (n : ℕ) :
    hopfDualComparison n * monomialE n 1 = dualE n * hopfDualComparison n ∧
    hopfDualComparison n * monomialF n 1 = dualF n * hopfDualComparison n ∧
    hopfDualComparison n * torus n 1 =
      (torus n (-1)).transpose * hopfDualComparison n := by
  sorry

section Specialization

variable {k : Type*} [Field k] [CharZero k]

def specializedComparison (n : ℕ) (z : kˣ) :
    Matrix (Fin (n + 1)) (Fin (n + 1)) k :=
  fun i j => specialize z (comparison n i j)

theorem gaussian_at_one (n j : ℕ) :
    specialize (1 : kˣ) (gaussian n j) = (Nat.choose n j : k) := by
  sorry

theorem gaussian_first_root (ell : ℕ) (hell : 3 ≤ ell) (hodd : Odd ell)
    (z : kˣ) (hz : IsPrimitiveRoot (z : k) ell) (j : Fin (ell + 1)) :
    specialize z (gaussian ell j.val) =
      if j.val = 0 ∨ j.val = ell then 1 else 0 := by
  sorry

/-- Actual kernel and range, expressed in the native coordinate module.
The endpoint spans remain distinct from the interior kernel. -/
theorem specializedComparison_ker_range (ell : ℕ) (hell : 3 ≤ ell)
    (hodd : Odd ell) (z : kˣ) (hz : IsPrimitiveRoot (z : k) ell) :
    LinearMap.ker (specializedComparison ell z).mulVecLin =
      Submodule.span k {f | ∃ j : Fin (ell + 1),
        0 < j.val ∧ j.val < ell ∧ f = Pi.single j 1} ∧
    LinearMap.range (specializedComparison ell z).mulVecLin =
      Submodule.span k {f | ∃ j : Fin (ell + 1),
        (j.val = 0 ∨ j.val = ell) ∧ f = Pi.single j 1} := by
  sorry

end Specialization

end QuantumPlaneLattice

end TauCetiRoadmap.QuantumEnvelopingAlgebras

